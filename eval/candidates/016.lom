fn fib(n: Int) -> Int
    if n == 0
        0
    elif n == 1
        1
    else
        let mut a = 0
        let mut b = 1
        let mut i = 2
        while i <= n
            let tmp = a + b
            a = b
            b = tmp
            i = i + 1
        end
        b
    end
end

fn main() -> Unit
    println(fib(0))
    println(fib(1))
    println(fib(10))
    println(fib(20))
end
