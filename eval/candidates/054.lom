fn classify_age(age: Int) -> String
    if age < 1
        "baby"
    elif age < 13
        "child"
    elif age < 20
        "teen"
    elif age < 65
        "adult"
    else
        "senior"
    end
end

fn main() -> Unit
    println(classify_age(0))
    println(classify_age(5))
    println(classify_age(15))
    println(classify_age(30))
    println(classify_age(70))
end
