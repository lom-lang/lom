# Phase 4.4 包管理示例 — 主程序
#
# 演示从外部包 mathlib 导入符号并调用
# mathlib 包定义在 ./mathlib/ 目录，其 lom.toml 声明了 name = "mathlib"

from mathlib import { square, cube, factorial }

fn main() -> Unit
    # 调用外部包函数
    println(square(5))      # 25
    println(cube(3))        # 27
    println(factorial(5))   # 120

    # 组合使用
    let x = 4
    println(square(x) + cube(2))   # 16 + 8 = 24
end
