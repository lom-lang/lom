# Phase 4.4 包管理示例 — mathlib 包源码
#
# 定义数学工具函数：square / cube / factorial
# 这些函数被主项目通过 `from mathlib import { ... }` 导入

fn square(x: Int) -> Int
    x * x
end

fn cube(x: Int) -> Int
    x * x * x
end

fn factorial(n: Int) -> Int
    if n <= 1
        1
    else
        n * factorial(n - 1)
    end
end
