# ============================================================================
# self_interp.lom — Lom 全量自举（RFC-0003，Phase 8）
#
# 当前阶段：8.1 完整前端 + 8.2 静态检查（NAM003/TYPE003-arity/EFF001/MAT001 子集，RFC-0003）
# 后续阶段：8.3 树遍历求值器 / 8.4 WASM 载体自证闭环
#
# 用法：
#   lom self_interp.lom -- <file>          # 解析 <file> 并打印 AST dump（对齐宿主 --dump-ast 格式）
#   lom self_interp.lom -- <file> --diags  # 只打印词法+语法诊断（行|列|消息，供与宿主 --json 对账）
#   lom self_interp.lom -- <file> --tokens # 打印 token 流（对齐宿主 --dump-tokens，lexer 对账）
#   lom self_interp.lom -- <file> --check  # 词法+语法+静态检查（8.2：NAM003/TYPE003/EFF001/MAT001）
#
# 契约（RFC-0003 §8.1，格式基准 = src/dump.rs 文件头注释）：
#   - dump 不含 span（宿主字节列 vs 本实现字符列在非 ASCII 行分叉，结构比对不需要位置；
#     验收集 = examples/*.lom + eval 113 参考解，除 todo.lom 字符串外全部纯 ASCII）
#   - Hole 节点照常输出（Hole @line:col）——本实现的 col 是 1-based 字符列
#   - Float dump = Rust Display 语义（整数值无 .0、最短形式）——本实现按"字面量规范化"
#     （去小数尾零 / .0 全零只留整数 / 整数部分去前导零）实现，前提由宿主侧测试钉住
#   - Str dump = Rust Debug 转义（\" \\ \n \r \t 转义，其余可打印字符原样）
#
# 实现说明（对照宿主 src/lexer.rs + src/parser.rs 的平移决策）：
#   - token 流存 Map<String 索引, {t, ln, cl}>（Map 引用语义 + O(1) 随机访问，
#     对齐宿主 Vec<SpannedToken> + pos 游标模型；list_get 是 O(n) 走查，不能用于 token 流）
#   - parser 的 pos / errors 也走 Map 引用语义跨函数共享（对齐宿主 &mut self）
#   - 主循环全部 while + 滑动窗口（list_head/list_tail O(1)），无逐字符递归——
#     45KB 级源文件在树遍历解释器 ~10^4 递归天花板下必须避免线性递归
#   - List 构建一律头插逆序 + 循环版 reverse（同因栈深）
#   - 位置：ln 从 1，cl 从 1（字符列；纯 ASCII 下与宿主字节列一致）
# ============================================================================

from string import { split, contains, len, string_to_int, int_to_string, starts_with, ends_with, trim, upper, lower, replace }
from list import { list_empty, list_cons, list_head, list_tail, list_is_empty, list_length, list_get }
from map import { map_empty, map_set, map_get, map_has, map_size, map_keys, map_remove }
from file import { file_read, file_exists, file_write, file_append }
from math import { sqrt }
from env import { args }

# ============================================================================
# Part A：Token 定义（对齐宿主 src/lexer.rs Token 枚举，Tk 前缀避免变体名冲突）
# ============================================================================

enum Tok
    # 关键字（20 个，宿主保留字全表）
    | TkFn
    | TkLet
    | TkMut
    | TkIf
    | TkElif
    | TkElse
    | TkWhile
    | TkFor
    | TkIn
    | TkReturn
    | TkEnd
    | TkTrue
    | TkFalse
    | TkAnd
    | TkOr
    | TkFrom
    | TkImport
    | TkAs
    | TkMatch
    | TkEnum
    # 字面量（Float 存规范化文本——见文件头契约）
    | TkInt(Int)
    | TkFloat(String)
    | TkStr(String)
    | TkIdent(String)
    # 运算符
    | TkPlus
    | TkMinus
    | TkStar
    | TkSlash
    | TkPercent
    | TkPlusEq
    | TkMinusEq
    | TkStarEq
    | TkSlashEq
    | TkEq
    | TkNotEq
    | TkLt
    | TkGt
    | TkLtEq
    | TkGtEq
    | TkAssign
    | TkBang
    | TkQuestion
    | TkPipe
    | TkBar
    | TkArrow
    | TkFatArrow
    # 标点
    | TkLParen
    | TkRParen
    | TkLBrace
    | TkRBrace
    | TkLBracket
    | TkRBracket
    | TkComma
    | TkColon
    | TkDot
    | TkDotDot
    | TkSemi
    # 结束
    | TkEof
end

# ============================================================================
# Part B：字符串辅助 + 字面量规范化
# ============================================================================

# 前缀截取：s 的前 k 个字符（k 超长返回全串）
fn str_take(s: String, k: Int) -> String
    let mut out = ""
    let mut i = 0
    for c in split(s, "")
        if i < k
            out = out + c
        end
        i += 1
    end
    out
end

# 从右去 '0'（小数部分规范化用）
fn rstrip_zero(s: String) -> String
    let mut last_nz = -1
    let mut i = 0
    for c in split(s, "")
        if c != "0"
            last_nz = i
        end
        i += 1
    end
    if last_nz < 0
        ""
    else
        str_take(s, last_nz + 1)
    end
end

# 从左去 '0'（全零收敛为 "0"；整数部分规范化用）
fn lstrip_zero(s: String) -> String
    let mut out = ""
    let mut started = False
    for c in split(s, "")
        if started or c != "0"
            started = True
            out = out + c
        end
    end
    if len(out) == 0
        "0"
    else
        out
    end
end

# Float 字面量规范化（宿主 Rust Display 契约的验收集实现，见文件头）
#   "5.20" -> "5.2"；"2.0" -> "2"；"3.14" -> "3.14"；"0.50" -> "0.5"
fn norm_float(ip: String, fp: String) -> String
    let f2 = rstrip_zero(fp)
    let i2 = lstrip_zero(ip)
    if len(f2) == 0
        i2
    else
        i2 + "." + f2
    end
end

# 转义字符还原（宿主 lex_string 的 Some(c) => push(c as char) 泛化规则）
fn unesc(nc: String) -> String
    if nc == "n"
        "\n"
    elif nc == "t"
        "\t"
    elif nc == "r"
        "\r"
    elif nc == "\""
        "\""
    elif nc == "\\"
        "\\"
    else
        nc
    end
end

# 字符分类（纯 ASCII；宿主按字节判定，纯 ASCII 源下语义一致）
fn is_digit(c: String) -> Bool
    contains("0123456789", c)
end

fn is_alpha(c: String) -> Bool
    contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_", c)
end

fn is_alnum(c: String) -> Bool
    if is_alpha(c)
        True
    elif is_digit(c)
        True
    else
        False
    end
end

# 关键字识别（宿主 lex_ident 的 match 全表，20 个保留字）
fn keyword_or_ident(s: String) -> Tok
    if s == "fn"
        TkFn
    elif s == "let"
        TkLet
    elif s == "mut"
        TkMut
    elif s == "if"
        TkIf
    elif s == "elif"
        TkElif
    elif s == "else"
        TkElse
    elif s == "while"
        TkWhile
    elif s == "for"
        TkFor
    elif s == "in"
        TkIn
    elif s == "return"
        TkReturn
    elif s == "end"
        TkEnd
    elif s == "True"
        TkTrue
    elif s == "False"
        TkFalse
    elif s == "and"
        TkAnd
    elif s == "or"
        TkOr
    elif s == "from"
        TkFrom
    elif s == "import"
        TkImport
    elif s == "as"
        TkAs
    elif s == "match"
        TkMatch
    elif s == "enum"
        TkEnum
    else
        TkIdent(s)
    end
end

# ---- 循环版 reverse（各类型一份；线性递归版在万级 token 上会爆 ~10^4 栈深天花板）----

fn rev_tok(xs: List<{t: Tok, ln: Int, cl: Int}>) -> List<{t: Tok, ln: Int, cl: Int}>
    let mut acc = list_empty()
    let mut cur = xs
    while !list_is_empty(cur)
        acc = list_cons(list_head(cur), acc)
        cur = list_tail(cur)
    end
    acc
end

fn rev_err(xs: List<{code: String, msg: String, ln: Int, cl: Int}>) -> List<{code: String, msg: String, ln: Int, cl: Int}>
    let mut acc = list_empty()
    let mut cur = xs
    while !list_is_empty(cur)
        acc = list_cons(list_head(cur), acc)
        cur = list_tail(cur)
    end
    acc
end

fn rev_str(xs: List<String>) -> List<String>
    let mut acc = list_empty()
    let mut cur = xs
    while !list_is_empty(cur)
        acc = list_cons(list_head(cur), acc)
        cur = list_tail(cur)
    end
    acc
end

# ============================================================================
# Part B2：lexer 主循环（对齐宿主 Lexer::tokenize_recover 的容错语义）
#   产出 {toks: Map<索引, TokR>, n: Int, errs: List<ErrR>}；EOF 也入表（key = n-1）
#   错误对齐宿主：记录错误 + 回退跳 1 字节继续（意外字符 / 未闭合字符串 / 无效整数）
# ============================================================================

fn lex(src: String) -> {toks: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, errs: List<{code: String, msg: String, ln: Int, cl: Int}>}
    let chars = split(src, "")
    let mut rest = chars
    let mut ln = 1
    let mut cl = 1
    let mut acc = list_empty()
    let mut errs = list_empty()
    while !list_is_empty(rest)
        let c = list_head(rest)
        let ln0 = ln
        let cl0 = cl
        if c == " " or c == "\t" or c == "\r"
            rest = list_tail(rest)
            cl += 1
        elif c == "\n"
            rest = list_tail(rest)
            ln += 1
            cl = 1
        elif c == "#"
            # 注释：# 行注释 / #- 块注释 -#
            if !list_is_empty(list_tail(rest)) and list_head(list_tail(rest)) == "-"
                # 块注释：跳过 #- 后找 -#（未闭合静默结束，宿主语义）
                let mut r2 = list_tail(list_tail(rest))
                cl += 2
                let mut done = False
                while !list_is_empty(r2) and done == False
                    if !list_is_empty(list_tail(r2)) and list_head(r2) == "-" and list_head(list_tail(r2)) == "#"
                        r2 = list_tail(list_tail(r2))
                        cl += 2
                        done = True
                    else
                        if list_head(r2) == "\n"
                            ln += 1
                            cl = 1
                        else
                            cl += 1
                        end
                        r2 = list_tail(r2)
                    end
                end
                rest = r2
            else
                # 行注释：跳到换行前（换行留给主循环计数）
                let mut r2 = list_tail(rest)
                cl += 1
                let mut done = False
                while !list_is_empty(r2) and done == False
                    if list_head(r2) == "\n"
                        done = True
                    else
                        cl += 1
                        r2 = list_tail(r2)
                    end
                end
                rest = r2
            end
        elif is_digit(c)
            # 数字字面量（对齐宿主 lex_number：digit+ [ . digit+ ]）
            let mut ip = ""
            let mut r2 = rest
            while !list_is_empty(r2) and is_digit(list_head(r2))
                ip = ip + list_head(r2)
                r2 = list_tail(r2)
                cl += 1
            end
            # 浮点前瞻：'.' 后必须紧跟 digit（1..10 中 1 是 Int）
            if !list_is_empty(r2) and list_head(r2) == "."
                let r3 = list_tail(r2)
                if !list_is_empty(r3) and is_digit(list_head(r3))
                    let mut fp = ""
                    let mut r4 = r3
                    while !list_is_empty(r4) and is_digit(list_head(r4))
                        fp = fp + list_head(r4)
                        r4 = list_tail(r4)
                        cl += 1
                    end
                    cl += 1
                    acc = list_cons({t: TkFloat(norm_float(ip, fp)), ln: ln0, cl: cl0}, acc)
                    rest = r4
                else
                    match try_sti(ip)
                        Some(v) =>
                            acc = list_cons({t: TkInt(v), ln: ln0, cl: cl0}, acc)
                            rest = r2
                        end
                        None =>
                            errs = list_cons({msg: "无效整数: " + ip, ln: ln0, cl: cl0}, errs)
                            rest = list_tail(rest)
                            cl = cl0 + 1
                        end
                    end
                end
            else
                match try_sti(ip)
                    Some(v) =>
                        acc = list_cons({t: TkInt(v), ln: ln0, cl: cl0}, acc)
                        rest = r2
                    end
                    None =>
                        errs = list_cons({msg: "无效整数: " + ip, ln: ln0, cl: cl0}, errs)
                        rest = list_tail(rest)
                        cl = cl0 + 1
                    end
                end
            end
        elif c == "\""
            # 字符串字面量（对齐宿主 lex_string 的容错：未闭合 → 错误 + 回退跳 1 字节）
            let mut r2 = list_tail(rest)
            let mut s = ""
            let mut cl2 = cl + 1
            let mut ln2 = ln
            let mut closed = False
            let mut esc_eof = False
            while !list_is_empty(r2) and closed == False
                let ch = list_head(r2)
                if ch == "\""
                    r2 = list_tail(r2)
                    cl2 += 1
                    closed = True
                elif ch == "\\"
                    let r3 = list_tail(r2)
                    if list_is_empty(r3)
                        # \ 后 EOF：未闭合的字符串转义（宿主 LEX002）
                        esc_eof = True
                        r2 = list_empty()
                    else
                        s = s + unesc(list_head(r3))
                        r2 = list_tail(r3)
                        cl2 += 2
                    end
                else
                    s = s + ch
                    r2 = list_tail(r2)
                    if ch == "\n"
                        ln2 += 1
                        cl2 = 1
                    else
                        cl2 += 1
                    end
                end
            end
            if closed
                acc = list_cons({t: TkStr(s), ln: ln0, cl: cl0}, acc)
                rest = r2
                ln = ln2
                cl = cl2
            else
                # 未闭合：记录错误，回退跳过开头引号（宿主 saved_pos 回退 + advance 1）
                let unclosed_msg =
                if esc_eof
                    "未闭合的字符串转义"
                else
                    "未闭合的字符串"
                end
                errs = list_cons({msg: unclosed_msg, ln: ln0, cl: cl0}, errs)
                rest = list_tail(rest)
                cl += 1
            end
        elif is_alpha(c)
            # 标识符 / 关键字
            let mut word = ""
            let mut r2 = rest
            while !list_is_empty(r2) and is_alnum(list_head(r2))
                word = word + list_head(r2)
                r2 = list_tail(r2)
                cl += 1
            end
            acc = list_cons({t: keyword_or_ident(word), ln: ln0, cl: cl0}, acc)
            rest = r2
        elif c == "+"
            if !list_is_empty(list_tail(rest)) and list_head(list_tail(rest)) == "="
                acc = list_cons({t: TkPlusEq, ln: ln0, cl: cl0}, acc)
                rest = list_tail(list_tail(rest))
                cl += 2
            else
                acc = list_cons({t: TkPlus, ln: ln0, cl: cl0}, acc)
                rest = list_tail(rest)
                cl += 1
            end
        elif c == "-"
            if !list_is_empty(list_tail(rest)) and list_head(list_tail(rest)) == ">"
                acc = list_cons({t: TkArrow, ln: ln0, cl: cl0}, acc)
                rest = list_tail(list_tail(rest))
                cl += 2
            elif !list_is_empty(list_tail(rest)) and list_head(list_tail(rest)) == "="
                acc = list_cons({t: TkMinusEq, ln: ln0, cl: cl0}, acc)
                rest = list_tail(list_tail(rest))
                cl += 2
            else
                acc = list_cons({t: TkMinus, ln: ln0, cl: cl0}, acc)
                rest = list_tail(rest)
                cl += 1
            end
        elif c == "*"
            if !list_is_empty(list_tail(rest)) and list_head(list_tail(rest)) == "="
                acc = list_cons({t: TkStarEq, ln: ln0, cl: cl0}, acc)
                rest = list_tail(list_tail(rest))
                cl += 2
            else
                acc = list_cons({t: TkStar, ln: ln0, cl: cl0}, acc)
                rest = list_tail(rest)
                cl += 1
            end
        elif c == "/"
            if !list_is_empty(list_tail(rest)) and list_head(list_tail(rest)) == "="
                acc = list_cons({t: TkSlashEq, ln: ln0, cl: cl0}, acc)
                rest = list_tail(list_tail(rest))
                cl += 2
            else
                acc = list_cons({t: TkSlash, ln: ln0, cl: cl0}, acc)
                rest = list_tail(rest)
                cl += 1
            end
        elif c == "%"
            acc = list_cons({t: TkPercent, ln: ln0, cl: cl0}, acc)
            rest = list_tail(rest)
            cl += 1
        elif c == "!"
            if !list_is_empty(list_tail(rest)) and list_head(list_tail(rest)) == "="
                acc = list_cons({t: TkNotEq, ln: ln0, cl: cl0}, acc)
                rest = list_tail(list_tail(rest))
                cl += 2
            else
                acc = list_cons({t: TkBang, ln: ln0, cl: cl0}, acc)
                rest = list_tail(rest)
                cl += 1
            end
        elif c == "="
            if !list_is_empty(list_tail(rest)) and list_head(list_tail(rest)) == "="
                acc = list_cons({t: TkEq, ln: ln0, cl: cl0}, acc)
                rest = list_tail(list_tail(rest))
                cl += 2
            elif !list_is_empty(list_tail(rest)) and list_head(list_tail(rest)) == ">"
                acc = list_cons({t: TkFatArrow, ln: ln0, cl: cl0}, acc)
                rest = list_tail(list_tail(rest))
                cl += 2
            else
                acc = list_cons({t: TkAssign, ln: ln0, cl: cl0}, acc)
                rest = list_tail(rest)
                cl += 1
            end
        elif c == "<"
            if !list_is_empty(list_tail(rest)) and list_head(list_tail(rest)) == "="
                acc = list_cons({t: TkLtEq, ln: ln0, cl: cl0}, acc)
                rest = list_tail(list_tail(rest))
                cl += 2
            else
                acc = list_cons({t: TkLt, ln: ln0, cl: cl0}, acc)
                rest = list_tail(rest)
                cl += 1
            end
        elif c == ">"
            if !list_is_empty(list_tail(rest)) and list_head(list_tail(rest)) == "="
                acc = list_cons({t: TkGtEq, ln: ln0, cl: cl0}, acc)
                rest = list_tail(list_tail(rest))
                cl += 2
            else
                acc = list_cons({t: TkGt, ln: ln0, cl: cl0}, acc)
                rest = list_tail(rest)
                cl += 1
            end
        elif c == "|"
            if !list_is_empty(list_tail(rest)) and list_head(list_tail(rest)) == ">"
                acc = list_cons({t: TkPipe, ln: ln0, cl: cl0}, acc)
                rest = list_tail(list_tail(rest))
                cl += 2
            else
                acc = list_cons({t: TkBar, ln: ln0, cl: cl0}, acc)
                rest = list_tail(rest)
                cl += 1
            end
        elif c == "?"
            acc = list_cons({t: TkQuestion, ln: ln0, cl: cl0}, acc)
            rest = list_tail(rest)
            cl += 1
        elif c == "("
            acc = list_cons({t: TkLParen, ln: ln0, cl: cl0}, acc)
            rest = list_tail(rest)
            cl += 1
        elif c == "{"
            acc = list_cons({t: TkLBrace, ln: ln0, cl: cl0}, acc)
            rest = list_tail(rest)
            cl += 1
        elif c == ")"
            acc = list_cons({t: TkRParen, ln: ln0, cl: cl0}, acc)
            rest = list_tail(rest)
            cl += 1
        elif c == "}"
            acc = list_cons({t: TkRBrace, ln: ln0, cl: cl0}, acc)
            rest = list_tail(rest)
            cl += 1
        elif c == "["
            acc = list_cons({t: TkLBracket, ln: ln0, cl: cl0}, acc)
            rest = list_tail(rest)
            cl += 1
        elif c == "]"
            acc = list_cons({t: TkRBracket, ln: ln0, cl: cl0}, acc)
            rest = list_tail(rest)
            cl += 1
        elif c == ","
            acc = list_cons({t: TkComma, ln: ln0, cl: cl0}, acc)
            rest = list_tail(rest)
            cl += 1
        elif c == ":"
            acc = list_cons({t: TkColon, ln: ln0, cl: cl0}, acc)
            rest = list_tail(rest)
            cl += 1
        elif c == "."
            if !list_is_empty(list_tail(rest)) and list_head(list_tail(rest)) == "."
                acc = list_cons({t: TkDotDot, ln: ln0, cl: cl0}, acc)
                rest = list_tail(list_tail(rest))
                cl += 2
            else
                acc = list_cons({t: TkDot, ln: ln0, cl: cl0}, acc)
                rest = list_tail(rest)
                cl += 1
            end
        elif c == ";"
            acc = list_cons({t: TkSemi, ln: ln0, cl: cl0}, acc)
            rest = list_tail(rest)
            cl += 1
        else
            # 意外字符（宿主 LexError "意外字符 'x'"，tokenize_recover 跳过该字节）
            errs = list_cons({msg: "意外字符 '" + c + "'", ln: ln0, cl: cl0}, errs)
            rest = list_tail(rest)
            cl += 1
        end
    end
    # EOF token（宿主：is_at_end 时 push Eof，位置 = 结束时的 line/col）
    acc = list_cons({t: TkEof, ln: ln, cl: cl}, acc)
    # 逆序 → 正序 → Map 索引表
    let ordered = rev_tok(acc)
    let toks = map_empty()
    let mut i = 0
    for tk in ordered
        map_set(toks, int_to_string(i), tk)
        i += 1
    end
    {toks: toks, n: i, errs: rev_err(errs)}
end

# 整数字面量辅助：string_to_int 的返回约定是裸 Int（成功）或 Unit（失败）——
# 内建协议层 Ok(Some(Value)) 解包后用户拿到的不是 Option 枚举（与 map_get 不同）。
# 无 type_of 反射（RFC-0003 冻结），用拼接提升的 to_display 形态判定：Unit 显示为 "()"
fn try_sti(s: String) -> Option<Int>
    if "" + string_to_int(s) == "()"
        None
    else
        Some(string_to_int(s))
    end
end

# ============================================================================
# Part C：AST 定义（对齐宿主 src/ast.rs；span 不建模——dump 契约不含位置）
#   Blk/IfR/Prm/ArmR/ArmB/VarR/ImpI 用单变体 enum 包装（签名书写一个词，
#   且避开匿名记录类型在深层泛型参数里的书写负担）
# ============================================================================

enum Ty
    | TyInt
    | TyFloat
    | TyBool
    | TyString
    | TyUnit
    | TyNamed(String)
    | TyOption(Ty)
    | TResult(Ty, Ty)
    | TyGeneric(String, List<Ty>)
    | TyRecord(List<(String, Ty)>)
    | TyTuple(List<Ty>)
end

enum Blk
    | BlkOf(List<St>, Option<Ex>)
end

enum St
    | StLet(Bool, String, Option<Ty>, Ex)
    | StDestruct(List<String>, Ex)
    | StAssign(String, Int, Int, Ex)
    | StIf(IfR)
    | StWhile(Ex, Blk)
    | StFor(String, Ex, Blk)
    | StReturn(Option<Ex>)
    | StExpr(Ex)
    | StHole(Int, Int)
end

enum IfR
    | IfR(List<(Ex, Blk)>, Option<Blk>)
end

enum Ex
    | ExInt(Int)
    | ExFloat(String)
    | ExBool(Bool)
    | ExStr(String)
    | ExUnit
    | ExIdent(String, Int, Int)
    | ExBinary(String, Ex, Ex)
    | ExUnary(String, Ex)
    | ExLogical(String, Ex, Ex)
    | ExCall(Ex, List<Ex>)
    | ExIndex(Ex, Ex)
    | ExField(Ex, String)
    | ExGroup(Ex)
    | ExIf(IfR)
    | ExClosure(List<Prm>, Option<Ty>, Blk)
    | ExMatch(Ex, List<ArmR>, Int)
    | ExTry(Ex)
    | ExPipe(Ex, Ex)
    | ExRange(Ex, Ex)
    | ExRecord(List<(String, Ex)>)
    | ExTuple(List<Ex>)
end

enum Prm
    | Prm(String, Ty)
end

enum ArmR
    | ArmR(Pat, Option<Ex>, ArmB)
end

enum ArmB
    | ABExpr(Ex)
    | ABBlock(Blk)
end

enum Pat
    | PatLit(Ex)
    | PatBinder(String)
    | PatWildcard
    | PatVariant(String, List<Pat>)
end

enum Itm
    | ItFn(String, List<Prm>, Option<Ty>, List<String>, Blk, Int, Int)
    | ItEnum(String, List<String>, List<VarR>)
    | ItImport(String, List<ImpI>)
end

enum VarR
    | VarR(String, List<Ty>)
end

enum ImpI
    | ImpI(String, String)
end

enum Prg
    | Prg(List<Itm>)
end

# 块元素（parse_block 循环体产出；对齐宿主 BlockEl）
enum Bel
    | BStmt(St)
    | BTail(Ex)
end

# ---- 各类型循环版 reverse（构建一律头插逆序）----

fn rev_itm(xs: List<Itm>) -> List<Itm>
    let mut acc = list_empty()
    let mut cur = xs
    while !list_is_empty(cur)
        acc = list_cons(list_head(cur), acc)
        cur = list_tail(cur)
    end
    acc
end

fn rev_st(xs: List<St>) -> List<St>
    let mut acc = list_empty()
    let mut cur = xs
    while !list_is_empty(cur)
        acc = list_cons(list_head(cur), acc)
        cur = list_tail(cur)
    end
    acc
end

fn rev_ex(xs: List<Ex>) -> List<Ex>
    let mut acc = list_empty()
    let mut cur = xs
    while !list_is_empty(cur)
        acc = list_cons(list_head(cur), acc)
        cur = list_tail(cur)
    end
    acc
end

fn rev_pat(xs: List<Pat>) -> List<Pat>
    let mut acc = list_empty()
    let mut cur = xs
    while !list_is_empty(cur)
        acc = list_cons(list_head(cur), acc)
        cur = list_tail(cur)
    end
    acc
end

fn rev_prm(xs: List<Prm>) -> List<Prm>
    let mut acc = list_empty()
    let mut cur = xs
    while !list_is_empty(cur)
        acc = list_cons(list_head(cur), acc)
        cur = list_tail(cur)
    end
    acc
end

fn rev_branch(xs: List<(Ex, Blk)>) -> List<(Ex, Blk)>
    let mut acc = list_empty()
    let mut cur = xs
    while !list_is_empty(cur)
        acc = list_cons(list_head(cur), acc)
        cur = list_tail(cur)
    end
    acc
end

fn rev_arm(xs: List<ArmR>) -> List<ArmR>
    let mut acc = list_empty()
    let mut cur = xs
    while !list_is_empty(cur)
        acc = list_cons(list_head(cur), acc)
        cur = list_tail(cur)
    end
    acc
end

fn rev_var(xs: List<VarR>) -> List<VarR>
    let mut acc = list_empty()
    let mut cur = xs
    while !list_is_empty(cur)
        acc = list_cons(list_head(cur), acc)
        cur = list_tail(cur)
    end
    acc
end

fn rev_impi(xs: List<ImpI>) -> List<ImpI>
    let mut acc = list_empty()
    let mut cur = xs
    while !list_is_empty(cur)
        acc = list_cons(list_head(cur), acc)
        cur = list_tail(cur)
    end
    acc
end

fn rev_sfld(xs: List<(String, Ex)>) -> List<(String, Ex)>
    let mut acc = list_empty()
    let mut cur = xs
    while !list_is_empty(cur)
        acc = list_cons(list_head(cur), acc)
        cur = list_tail(cur)
    end
    acc
end

fn rev_sfty(xs: List<(String, Ty)>) -> List<(String, Ty)>
    let mut acc = list_empty()
    let mut cur = xs
    while !list_is_empty(cur)
        acc = list_cons(list_head(cur), acc)
        cur = list_tail(cur)
    end
    acc
end

fn rev_ty(xs: List<Ty>) -> List<Ty>
    let mut acc = list_empty()
    let mut cur = xs
    while !list_is_empty(cur)
        acc = list_cons(list_head(cur), acc)
        cur = list_tail(cur)
    end
    acc
end

# ============================================================================
# Part C2：parser 基础设施（对齐宿主 Parser 的游标模型）
#   ts = token 索引表（lex 产出）；pm = Map 持 "pos"（引用语义跨函数共享，对齐 &mut self）
#   错误走 Result<_, String>（打包 "ln|cl|msg"，? 传播；Hole 插入点解包）
# ============================================================================

# token 判别编号（对齐宿主 std::mem::discriminant 的判等用途；只对无载荷变体比较判别）
fn tok_disc(t: Tok) -> Int
    match t
        TkFn => 1
        TkLet => 2
        TkMut => 3
        TkIf => 4
        TkElif => 5
        TkElse => 6
        TkWhile => 7
        TkFor => 8
        TkIn => 9
        TkReturn => 10
        TkEnd => 11
        TkTrue => 12
        TkFalse => 13
        TkAnd => 14
        TkOr => 15
        TkFrom => 16
        TkImport => 17
        TkAs => 18
        TkMatch => 19
        TkEnum => 20
        TkInt(_) => 21
        TkFloat(_) => 22
        TkStr(_) => 23
        TkIdent(_) => 24
        TkPlus => 25
        TkMinus => 26
        TkStar => 27
        TkSlash => 28
        TkPercent => 29
        TkPlusEq => 30
        TkMinusEq => 31
        TkStarEq => 32
        TkSlashEq => 33
        TkEq => 34
        TkNotEq => 35
        TkLt => 36
        TkGt => 37
        TkLtEq => 38
        TkGtEq => 39
        TkAssign => 40
        TkBang => 41
        TkQuestion => 42
        TkPipe => 43
        TkBar => 44
        TkArrow => 45
        TkFatArrow => 46
        TkLParen => 47
        TkRParen => 48
        TkLBrace => 49
        TkRBrace => 50
        TkLBracket => 51
        TkRBracket => 52
        TkComma => 53
        TkColon => 54
        TkDot => 55
        TkDotDot => 56
        TkSemi => 57
        TkEof => 58
    end
end

# 无载荷 token 的 Rust Debug 名（宿主 token_name 的 `{:?}` 分支，去 Tk 前缀即宿主变体名）
fn tk_dbg(t: Tok) -> String
    match t
        TkFn => "Fn"
        TkLet => "Let"
        TkMut => "Mut"
        TkIf => "If"
        TkElif => "Elif"
        TkElse => "Else"
        TkWhile => "While"
        TkFor => "For"
        TkIn => "In"
        TkReturn => "Return"
        TkEnd => "End"
        TkTrue => "True"
        TkFalse => "False"
        TkAnd => "And"
        TkOr => "Or"
        TkFrom => "From"
        TkImport => "Import"
        TkAs => "As"
        TkMatch => "Match"
        TkEnum => "Enum"
        TkInt(_) => "Int"
        TkFloat(_) => "Float"
        TkStr(_) => "Str"
        TkIdent(_) => "Ident"
        TkPlus => "Plus"
        TkMinus => "Minus"
        TkStar => "Star"
        TkSlash => "Slash"
        TkPercent => "Percent"
        TkPlusEq => "PlusEq"
        TkMinusEq => "MinusEq"
        TkStarEq => "StarEq"
        TkSlashEq => "SlashEq"
        TkEq => "Eq"
        TkNotEq => "NotEq"
        TkLt => "Lt"
        TkGt => "Gt"
        TkLtEq => "LtEq"
        TkGtEq => "GtEq"
        TkAssign => "Assign"
        TkBang => "Bang"
        TkQuestion => "Question"
        TkPipe => "Pipe"
        TkBar => "Bar"
        TkArrow => "Arrow"
        TkFatArrow => "FatArrow"
        TkLParen => "LParen"
        TkRParen => "RParen"
        TkLBrace => "LBrace"
        TkRBrace => "RBrace"
        TkLBracket => "LBracket"
        TkRBracket => "RBracket"
        TkComma => "Comma"
        TkColon => "Colon"
        TkDot => "Dot"
        TkDotDot => "DotDot"
        TkSemi => "Semi"
        TkEof => "Eof"
    end
end

# token 的诊断名（对齐宿主 token_name：字面量有值形态，其余 Rust Debug 名）
fn tok_name(t: Tok) -> String
    match t
        TkEof => "文件结束"
        TkInt(v) => "整数 " + int_to_string(v)
        TkFloat(s) => "浮点数 " + s
        TkStr(s) => "字符串 \"" + s + "\""
        TkIdent(s) => "标识符 '" + s + "'"
        _ => tk_dbg(t)
    end
end

# ---- 游标操作 ----

fn get_pos(pm: Map<String, Int>) -> Int
    match map_get(pm, "pos")
        Some(v) => v
        None => 0
    end
end

# 按索引取 token（越界回落到 EOF——对齐宿主 tokens 向量以 Eof 收尾且 advance 不越过）
fn tok_at(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, i: Int) -> {t: Tok, ln: Int, cl: Int}
    let k = if i < n - 1
        i
    else
        n - 1
    end
    match map_get(ts, int_to_string(k))
        Some(r) => r
        None => {t: TkEof, ln: 0, cl: 0}
    end
end

# 当前 token 的 Tok 部分（宿主 peek）
fn pk_tk(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>) -> Tok
    tok_at(ts, n, get_pos(pm)).t
end

# advance：Eof 不前进（对齐宿主）
fn adv(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>) -> Unit
    match pk_tk(ts, n, pm)
        TkEof => ()
        _ => map_set(pm, "pos", get_pos(pm) + 1)
    end
end

# check：判别相等（只对无载荷 token 使用，对齐宿主 discriminant 比较）
fn chk(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, t: Tok) -> Bool
    tok_disc(pk_tk(ts, n, pm)) == tok_disc(t)
end

# matches：check + advance
fn mt(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, t: Tok) -> Bool
    if chk(ts, n, pm, t)
        adv(ts, n, pm)
        True
    else
        False
    end
end

# 错误打包（"ln|cl|msg"）与解包
fn perr(ln: Int, cl: Int, msg: String) -> String
    int_to_string(ln) + "|" + int_to_string(cl) + "|" + msg
end

fn unpack_err(e: String) -> {ln: Int, cl: Int, msg: String}
    let parts = split(e, "|")
    if list_length(parts) >= 3
        {ln: or_zero(list_get(parts, 0)), cl: or_zero(list_get(parts, 1)), msg: list_get(parts, 2)}
    else
        {ln: 0, cl: 0, msg: e}
    end
end

fn or_zero(s: String) -> Int
    match try_sti(s)
        Some(v) => v
        None => 0
    end
end

# 当前位置错误（宿主 self.err：位置 = 当前 token）
fn err_here(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, msg: String) -> String
    let cur = tok_at(ts, n, get_pos(pm))
    perr(cur.ln, cur.cl, msg)
end

# expect（宿主：期望 X，得到 Y；位置 = 当前 token）
fn expt(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, want: Tok, what: String) -> Result<Unit, String>
    if chk(ts, n, pm, want)
        adv(ts, n, pm)
        Ok(())
    else
        Err(err_here(ts, n, pm, "期望 " + what + "，得到 " + tok_name(pk_tk(ts, n, pm))))
    end
end

# is_newline_before：当前 token 与前一个 token 不同行（宿主换行守卫的判定）
fn newline_before(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>) -> Bool
    let p = get_pos(pm)
    if p == 0
        False
    else
        tok_at(ts, n, p).ln != tok_at(ts, n, p - 1).ln
    end
end

# 错误累积（em 的 value 记录；map_size 计数键）
fn em_add(em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>, code: String, ln: Int, cl: Int, msg: String) -> Unit
    map_set(em, int_to_string(map_size(em)), {code: code, msg: msg, ln: ln, cl: cl})
end

# 错误码分类（对齐宿主 diagnostics.rs 的关键字匹配；lex 与 parse 分表——宿主按阶段分，这里按记录点分）
fn classify_lex_msg(msg: String) -> String
    if contains(msg, "未闭合的字符串转义")
        "LEX002"
    elif contains(msg, "未闭合的字符串")
        "LEX001"
    elif contains(msg, "无效浮点数")
        "LEX003"
    elif contains(msg, "无效整数")
        "LEX004"
    elif contains(msg, "意外字符")
        "LEX005"
    else
        "LEX000"
    end
end

fn classify_parse_msg(msg: String) -> String
    if contains(msg, "Result") and contains(msg, "类型参数")
        "PARSE002"
    elif contains(msg, "Option") and contains(msg, "类型参数")
        "PARSE003"
    elif starts_with(msg, "期望")
        "PARSE001"
    else
        "PARSE000"
    end
end

# ---- 容错同步点（宿主 Phase 2.2）----

# 同步到顶层 item 起点：跳到 fn/enum/from/EOF
fn sync_to_top(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>) -> Unit
    let mut d = tok_disc(pk_tk(ts, n, pm))
    while d != tok_disc(TkEof) and d != tok_disc(TkFn) and d != tok_disc(TkEnum) and d != tok_disc(TkFrom)
        adv(ts, n, pm)
        d = tok_disc(pk_tk(ts, n, pm))
    end
end

# 语句起始 token 判定（宿主 is_block_stmt_start；不含 fn/enum/from——顶层声明留给 sync_to_top）
# 带载荷变体的判别值用哨兵构造（_ 只能出现在模式位置，表达式位置不合法）
fn d_int_lit() -> Int
    tok_disc(TkInt(0))
end

fn d_float_lit() -> Int
    tok_disc(TkFloat("0"))
end

fn d_str_lit() -> Int
    tok_disc(TkStr(""))
end

fn d_ident() -> Int
    tok_disc(TkIdent(""))
end

fn is_block_stmt_start(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>) -> Bool
    let d = tok_disc(pk_tk(ts, n, pm))
    if d == tok_disc(TkLet) or d == tok_disc(TkIf) or d == tok_disc(TkWhile) or d == tok_disc(TkFor) or d == tok_disc(TkReturn) or d == tok_disc(TkMatch) or d == d_ident() or d == d_int_lit() or d == d_float_lit() or d == d_str_lit() or d == tok_disc(TkTrue) or d == tok_disc(TkFalse) or d == tok_disc(TkLParen) or d == tok_disc(TkLBrace)
        True
    else
        False
    end
end

# 同步到语句边界：跳到块终止符或新行上的语句起始 token（Lom 无 break，用 flag 退出）
fn sync_to_stmt_boundary(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>) -> Unit
    let mut go = True
    while go and !chk(ts, n, pm, TkEof) and !chk(ts, n, pm, TkEnd) and !chk(ts, n, pm, TkElif) and !chk(ts, n, pm, TkElse)
        if newline_before(ts, n, pm) and is_block_stmt_start(ts, n, pm)
            go = False
        else
            adv(ts, n, pm)
        end
    end
end

# 保证解析进度（宿主 ensure_progress）
fn ensure_progress(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, saved: Int) -> Unit
    if get_pos(pm) <= saved
        adv(ts, n, pm)
    end
end

# ============================================================================
# Part C3：顶层与声明解析（对齐宿主 parse_program / parse_item / 声明族）
# ============================================================================

fn parse_program(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Prg
    let mut items = list_empty()
    while !chk(ts, n, pm, TkEof)
        let saved = get_pos(pm)
        match parse_item(ts, n, pm, em)
            Ok(it) =>
                items = list_cons(it, items)
            end
            Err(e) =>
                let r = unpack_err(e)
                em_add(em, classify_parse_msg(r.msg), r.ln, r.cl, r.msg)
                sync_to_top(ts, n, pm)
                ensure_progress(ts, n, pm, saved)
            end
        end
    end
    Prg(rev_itm(items))
end

fn parse_item(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Result<Itm, String>
    let d = tok_disc(pk_tk(ts, n, pm))
    if d == tok_disc(TkFn)
        parse_fn_decl(ts, n, pm, em)
    elif d == tok_disc(TkEnum)
        parse_enum_decl(ts, n, pm)
    elif d == tok_disc(TkFrom)
        parse_import_decl(ts, n, pm)
    else
        Err(err_here(ts, n, pm, "期望函数声明 'fn'、枚举声明 'enum' 或导入声明 'from'，得到 " + tok_name(pk_tk(ts, n, pm))))
    end
end

# 解析标识符（宿主 parse_ident）
fn parse_ident(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>) -> Result<String, String>
    let tk = pk_tk(ts, n, pm)
    adv(ts, n, pm)
    match tk
        TkIdent(s) => Ok(s)
        _ => Err(err_here(ts, n, pm, "期望标识符，得到 " + tok_name(tk)))
    end
end

# 点分模块路径（宿主 parse_module_path）
fn parse_module_path(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>) -> Result<String, String>
    let first = parse_ident(ts, n, pm)?
    let mut path = first
    let mut go = True
    while go
        if mt(ts, n, pm, TkDot)
            path = path + "." + parse_ident(ts, n, pm)?
        else
            go = False
        end
    end
    Ok(path)
end

# 导入声明（宿主 parse_import_decl：from mod import { a, b as c }，允许尾随逗号与空列表）
fn parse_import_decl(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>) -> Result<Itm, String>
    adv(ts, n, pm)
    let module = parse_module_path(ts, n, pm)?
    expt(ts, n, pm, TkImport, "'import'")?
    expt(ts, n, pm, TkLBrace, "'{' (导入列表开始)")?
    let mut items = list_empty()
    if !chk(ts, n, pm, TkRBrace)
        let mut go = True
        while go
            if chk(ts, n, pm, TkRBrace)
                go = False
            else
                let iname = parse_ident(ts, n, pm)?
                let alias =
                if mt(ts, n, pm, TkAs)
                    parse_ident(ts, n, pm)?
                else
                    iname
                end
                items = list_cons(ImpI(iname, alias), items)
                if !mt(ts, n, pm, TkComma)
                    go = False
                end
            end
        end
    end
    expt(ts, n, pm, TkRBrace, "'}' (导入列表结束)")?
    Ok(ItImport(module, rev_impi(items)))
end

# 参数列表（宿主 parse_params：name: type 逗号分隔）
fn parse_params(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>) -> Result<List<Prm>, String>
    let mut params = list_empty()
    if !chk(ts, n, pm, TkRParen)
        let mut go = True
        while go
            let pname = parse_ident(ts, n, pm)?
            expt(ts, n, pm, TkColon, "':'")?
            let pty = parse_type(ts, n, pm)?
            params = list_cons(Prm(pname, pty), params)
            if !mt(ts, n, pm, TkComma)
                go = False
            end
        end
    end
    expt(ts, n, pm, TkRParen, "')'")?
    Ok(rev_prm(params))
end

# 效应注解（宿主 parse_effects：可选 ! [E1, E2]，空列表允许）
fn parse_effects(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>) -> Result<List<String>, String>
    if !mt(ts, n, pm, TkBang)
        Ok(list_empty())
    else
        expt(ts, n, pm, TkLBracket, "'[' (效应列表开始)")?
        let mut effs = list_empty()
        if !chk(ts, n, pm, TkRBracket)
            let mut go = True
            while go
                let e = parse_ident(ts, n, pm)?
                effs = list_cons(e, effs)
                if !mt(ts, n, pm, TkComma)
                    go = False
                end
            end
        end
        expt(ts, n, pm, TkRBracket, "']' (效应列表结束)")?
        Ok(rev_str(effs))
    end
end

# 函数声明（宿主 parse_fn_decl；span 省略）
fn parse_fn_decl(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Result<Itm, String>
    let fn_rec = tok_at(ts, n, get_pos(pm))
    adv(ts, n, pm)
    let name = parse_ident(ts, n, pm)?
    expt(ts, n, pm, TkLParen, "'('")?
    let params = parse_params(ts, n, pm)?
    let ret =
    if mt(ts, n, pm, TkArrow)
        Some(parse_type(ts, n, pm)?)
    else
        None
    end
    let effs = parse_effects(ts, n, pm)?
    let body = parse_block(ts, n, pm, em)?
    Ok(ItFn(name, params, ret, effs, body, fn_rec.ln, fn_rec.cl))
end

# 标识符 → 基础类型（宿主 Type::from_name）
fn ty_from_name(s: String) -> Ty
    if s == "Int"
        TyInt
    elif s == "Float"
        TyFloat
    elif s == "Bool"
        TyBool
    elif s == "String"
        TyString
    elif s == "Unit"
        TyUnit
    else
        TyNamed(s)
    end
end

# 类型的 Debug 名（宿主 "类型 {:?} 不支持泛型参数" 消息用；仅覆盖所需形态）
fn ty_dbg(t: Ty) -> String
    match t
        TyInt => "Int"
        TyFloat => "Float"
        TyBool => "Bool"
        TyString => "String"
        TyUnit => "Unit"
        TyNamed(s) => "Named(\"" + s + "\")"
        TyOption(_) => "Option"
        TResult(_, _) => "Result"
        TyGeneric(_, _) => "Generic"
        TyRecord(_) => "Record"
        TyTuple(_) => "Tuple"
    end
end

# 类型解析（宿主 parse_type：记录/元组/命名+泛型，Result/Option 特判）
fn parse_type(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>) -> Result<Ty, String>
    if chk(ts, n, pm, TkLBrace)
        adv(ts, n, pm)
        let mut fields = list_empty()
        if !chk(ts, n, pm, TkRBrace)
            let mut go = True
            while go
                let fname = parse_ident(ts, n, pm)?
                expt(ts, n, pm, TkColon, "':' (记录字段类型分隔)")?
                let fty = parse_type(ts, n, pm)?
                fields = list_cons((fname, fty), fields)
                if !mt(ts, n, pm, TkComma)
                    go = False
                end
            end
        end
        expt(ts, n, pm, TkRBrace, "'}' (闭合记录类型)")?
        Ok(TyRecord(rev_sfty(fields)))
    elif chk(ts, n, pm, TkLParen)
        let _ = adv(ts, n, pm)
        if mt(ts, n, pm, TkRParen)
            Ok(TyUnit)
        else
            let first = parse_type(ts, n, pm)?
            if mt(ts, n, pm, TkComma)
                let mut elems = list_cons(first, list_empty())
                let mut go = True
                while go
                    elems = list_cons(parse_type(ts, n, pm)?, elems)
                    if !mt(ts, n, pm, TkComma)
                        go = False
                    end
                end
                expt(ts, n, pm, TkRParen, "')' (闭合元组类型)")?
                Ok(TyTuple(rev_ty(elems)))
            else
                expt(ts, n, pm, TkRParen, "')'")?
                Ok(first)
            end
        end
    else
        let name = parse_ident(ts, n, pm)?
        let base = ty_from_name(name)
        if chk(ts, n, pm, TkLt)
            adv(ts, n, pm)
            let mut args = list_cons(parse_type(ts, n, pm)?, list_empty())
            let mut go = True
            while go
                if mt(ts, n, pm, TkComma)
                    args = list_cons(parse_type(ts, n, pm)?, args)
                else
                    go = False
                end
            end
            expt(ts, n, pm, TkGt, "'>' (闭合泛型参数)")?
            let args2 = rev_ty(args)
            match base
                TyNamed(bn) =>
                    if bn == "Result"
                        if list_length(args2) != 2
                            Err(err_here(ts, n, pm, "Result 期望 2 个类型参数，得到 " + int_to_string(list_length(args2)) + " 个"))
                        else
                            Ok(TResult(list_get(args2, 0), list_get(args2, 1)))
                        end
                    elif bn == "Option"
                        if list_length(args2) != 1
                            Err(err_here(ts, n, pm, "Option 期望 1 个类型参数，得到 " + int_to_string(list_length(args2)) + " 个"))
                        else
                            Ok(TyOption(list_get(args2, 0)))
                        end
                    else
                        Ok(TyGeneric(bn, args2))
                    end
                end
                _ => Err(err_here(ts, n, pm, "类型 " + ty_dbg(base) + " 不支持泛型参数"))
            end
        else
            Ok(base)
        end
    end
end

# 枚举声明（宿主 parse_enum_decl：单行 = 形式 / 多行 end 形式）
fn parse_enum_decl(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>) -> Result<Itm, String>
    adv(ts, n, pm)
    let name = parse_ident(ts, n, pm)?
    let mut tparams = list_empty()
    if chk(ts, n, pm, TkLt)
        adv(ts, n, pm)
        let mut go = True
        while go
            tparams = list_cons(parse_ident(ts, n, pm)?, tparams)
            if !mt(ts, n, pm, TkComma)
                go = False
            end
        end
        expt(ts, n, pm, TkGt, "'>' (闭合类型参数)")?
    end
    let mut variants = list_empty()
    if mt(ts, n, pm, TkAssign)
        # 单行形式：V1 | V2 | V3（无 end）
        let mut go = True
        while go
            variants = list_cons(parse_enum_variant(ts, n, pm)?, variants)
            if mt(ts, n, pm, TkBar)
                ()
            else
                go = False
            end
        end
    else
        # 多行形式：每行一个变体（可选 | 前缀），以 end 闭合
        while !chk(ts, n, pm, TkEnd) and !chk(ts, n, pm, TkEof)
            mt(ts, n, pm, TkBar)
            variants = list_cons(parse_enum_variant(ts, n, pm)?, variants)
        end
        expt(ts, n, pm, TkEnd, "'end' (闭合 enum)")?
    end
    Ok(ItEnum(name, rev_str(tparams), rev_var(variants)))
end

# 枚举变体（宿主 parse_enum_variant：Name 或 Name(Types)；跨行 ( 不视为参数）
fn parse_enum_variant(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>) -> Result<VarR, String>
    let vname = parse_ident(ts, n, pm)?
    if chk(ts, n, pm, TkLParen) and !newline_before(ts, n, pm)
        adv(ts, n, pm)
        let mut fs = list_empty()
        if !chk(ts, n, pm, TkRParen)
            let mut go = True
            while go
                fs = list_cons(parse_type(ts, n, pm)?, fs)
                if !mt(ts, n, pm, TkComma)
                    go = False
                end
            end
        end
        expt(ts, n, pm, TkRParen, "')' (闭合变体参数)")?
        Ok(VarR(vname, rev_ty(fs)))
    else
        Ok(VarR(vname, list_empty()))
    end
end

# ============================================================================
# Part C4：块 / 语句 / 表达式 / 模式解析（对齐宿主 parse_block 族 + Pratt 链）
#   注意：Lom 无 break/continue，循环提前退出一律用 flag；无 TCO，链式左结合
#   在宿主是循环、这里也保持循环（不递归）
# ============================================================================

# stmts 中是否存在裸表达式语句（parse_block 的 if_can_be_tail 判定用）
fn has_expr_stmt(stmts: List<St>) -> Bool
    let mut cur = stmts
    let mut found = False
    while !list_is_empty(cur) and found == False
        match list_head(cur)
            StExpr(_) =>
                found = True
            end
            _ =>
                cur = list_tail(cur)
            end
        end
    end
    found
end

# 复合赋值（宿主 match_compound_assign：换行守卫 + op 映射；返回 dump 形态 op 名）
fn match_compound_assign(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>) -> Option<String>
    if newline_before(ts, n, pm)
        None
    else
        match pk_tk(ts, n, pm)
            TkPlusEq =>
                adv(ts, n, pm)
                Some("Add")
            end
            TkMinusEq =>
                adv(ts, n, pm)
                Some("Sub")
            end
            TkStarEq =>
                adv(ts, n, pm)
                Some("Mul")
            end
            TkSlashEq =>
                adv(ts, n, pm)
                Some("Div")
            end
            _ => None
        end
    end
end

# 块元素解析（宿主 parse_block_el；ict = if_can_be_tail）
fn parse_block_el(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>, ict: Bool) -> Result<Bel, String>
    let d = tok_disc(pk_tk(ts, n, pm))
    if d == tok_disc(TkLet) or d == tok_disc(TkWhile) or d == tok_disc(TkFor) or d == tok_disc(TkReturn)
        match parse_stmt(ts, n, pm, em)
            Ok(s) => Ok(BStmt(s))
            Err(e) => Err(e)
        end
    elif d == tok_disc(TkIf)
        let ifr = parse_if(ts, n, pm, em)?
        let d2 = tok_disc(pk_tk(ts, n, pm))
        if ict and (d2 == tok_disc(TkEnd) or d2 == tok_disc(TkElif) or d2 == tok_disc(TkElse) or d2 == tok_disc(TkEof))
            Ok(BTail(ExIf(ifr)))
        else
            Ok(BStmt(StIf(ifr)))
        end
    else
        let e = parse_expr(ts, n, pm, em)?
        if chk(ts, n, pm, TkAssign)
            adv(ts, n, pm)
            let value = parse_expr(ts, n, pm, em)?
            match e
                ExIdent(name, tln, tcl) => Ok(BStmt(StAssign(name, tln, tcl, value)))
                _ => Err(err_here(ts, n, pm, "赋值目标必须是变量"))
            end
        else
            match match_compound_assign(ts, n, pm)
                Some(op) =>
                    let rhs = parse_expr(ts, n, pm, em)?
                    match e
                        ExIdent(name, tln, tcl) => Ok(BStmt(StAssign(name, tln, tcl, ExBinary(op, ExIdent(name, tln, tcl), rhs))))
                        _ => Err(err_here(ts, n, pm, "复合赋值目标必须是变量"))
                    end
                end
                None =>
                    let d3 = tok_disc(pk_tk(ts, n, pm))
                    if d3 == tok_disc(TkEnd) or d3 == tok_disc(TkElif) or d3 == tok_disc(TkElse) or d3 == tok_disc(TkEof)
                        Ok(BTail(e))
                    else
                        Ok(BStmt(StExpr(e)))
                    end
                end
            end
        end
    end
end

# 块解析（宿主 parse_block：终止于 end/elif/else/eof，只消费 end；容错插 Hole）
fn parse_block(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Result<Blk, String>
    let mut stmts = list_empty()
    let mut tail = None
    let mut has_tail = False
    let mut go = True
    while go and !chk(ts, n, pm, TkEnd) and !chk(ts, n, pm, TkElif) and !chk(ts, n, pm, TkElse) and !chk(ts, n, pm, TkEof)
        let ict = has_tail == False and has_expr_stmt(stmts) == False
        let saved = get_pos(pm)
        match parse_block_el(ts, n, pm, em, ict)
            Ok(BStmt(s)) =>
                stmts = list_cons(s, stmts)
            end
            Ok(BTail(e)) =>
                tail = Some(e)
                has_tail = True
                go = False
            end
            Err(e) =>
                let r = unpack_err(e)
                em_add(em, classify_parse_msg(r.msg), r.ln, r.cl, r.msg)
                stmts = list_cons(StHole(r.ln, r.cl), stmts)
                sync_to_stmt_boundary(ts, n, pm)
                ensure_progress(ts, n, pm, saved)
            end
        end
    end
    if chk(ts, n, pm, TkEnd)
        adv(ts, n, pm)
    end
    Ok(BlkOf(rev_st(stmts), tail))
end

# 语句解析（宿主 parse_stmt）
fn parse_stmt(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Result<St, String>
    let d = tok_disc(pk_tk(ts, n, pm))
    if d == tok_disc(TkLet)
        parse_let(ts, n, pm, em)
    elif d == tok_disc(TkIf)
        Ok(StIf(parse_if(ts, n, pm, em)?))
    elif d == tok_disc(TkWhile)
        parse_while(ts, n, pm, em)
    elif d == tok_disc(TkFor)
        parse_for(ts, n, pm, em)
    elif d == tok_disc(TkReturn)
        parse_return(ts, n, pm, em)
    else
        Ok(StExpr(parse_expr(ts, n, pm, em)?))
    end
end

# let [mut] name [: type] = expr / let (a, b) = expr（宿主 parse_let + parse_let_destruct）
fn parse_let(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Result<St, String>
    let _ = adv(ts, n, pm)
    let mutable = mt(ts, n, pm, TkMut)
    if chk(ts, n, pm, TkLParen)
        if mutable
            Err(err_here(ts, n, pm, "元组解构不支持 mut（解构绑定不可变）"))
        else
            adv(ts, n, pm)
            let mut names = list_empty()
            let mut go = True
            while go
                names = list_cons(parse_ident(ts, n, pm)?, names)
                if !mt(ts, n, pm, TkComma)
                    go = False
                elif chk(ts, n, pm, TkRParen)
                    go = False
                else
                    ()
                end
            end
            expt(ts, n, pm, TkRParen, "')'")?
            expt(ts, n, pm, TkAssign, "'='")?
            let value = parse_expr(ts, n, pm, em)?
            Ok(StDestruct(rev_str(names), value))
        end
    else
        let name = parse_ident(ts, n, pm)?
        let ty =
        if mt(ts, n, pm, TkColon)
            Some(parse_type(ts, n, pm)?)
        else
            None
        end
        expt(ts, n, pm, TkAssign, "'='")?
        let value = parse_expr(ts, n, pm, em)?
        Ok(StLet(mutable, name, ty, value))
    end
end

# if/elif/else（宿主 parse_if：分支与 else 块都由 parse_block 闭合）
fn parse_if(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Result<IfR, String>
    adv(ts, n, pm)
    let cond = parse_expr(ts, n, pm, em)?
    let body = parse_block(ts, n, pm, em)?
    let mut branches = list_cons((cond, body), list_empty())
    let mut els = None
    let mut has_else = False
    let mut go = True
    while go
        if mt(ts, n, pm, TkElif)
            let c = parse_expr(ts, n, pm, em)?
            let b = parse_block(ts, n, pm, em)?
            branches = list_cons((c, b), branches)
        else
            go = False
        end
    end
    if mt(ts, n, pm, TkElse)
        els = Some(parse_block(ts, n, pm, em)?)
        has_else = True
    else
        ()
    end
    Ok(IfR(rev_branch(branches), els))
end

fn parse_while(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Result<St, String>
    adv(ts, n, pm)
    let cond = parse_expr(ts, n, pm, em)?
    let body = parse_block(ts, n, pm, em)?
    Ok(StWhile(cond, body))
end

fn parse_for(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Result<St, String>
    adv(ts, n, pm)
    let var = parse_ident(ts, n, pm)?
    expt(ts, n, pm, TkIn, "'in'")?
    let iter = parse_expr(ts, n, pm, em)?
    let body = parse_block(ts, n, pm, em)?
    Ok(StFor(var, iter, body))
end

fn parse_return(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Result<St, String>
    let _ = adv(ts, n, pm)
    if chk(ts, n, pm, TkEnd) or chk(ts, n, pm, TkEof)
        Ok(StReturn(None))
    else
        Ok(StReturn(Some(parse_expr(ts, n, pm, em)?)))
    end
end

# ============================================================================
# Pratt 优先级链（宿主 parse_expr 族；span 逻辑全部省略——dump 契约无位置）
#   range(最低，非结合) < or < and < comparison < pipeline < add < mul < unary < ? < postfix
# ============================================================================

fn parse_expr(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Result<Ex, String>
    parse_range(ts, n, pm, em)
end

# range：a..b 非结合，换行守卫（宿主 parse_range）
fn parse_range(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Result<Ex, String>
    let start = parse_or(ts, n, pm, em)?
    if newline_before(ts, n, pm) == False and mt(ts, n, pm, TkDotDot)
        let end_e = parse_or(ts, n, pm, em)?
        Ok(ExRange(start, end_e))
    else
        Ok(start)
    end
end

fn parse_or(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Result<Ex, String>
    let mut left = parse_and(ts, n, pm, em)?
    let mut go = True
    while go
        if mt(ts, n, pm, TkOr)
            let right = parse_and(ts, n, pm, em)?
            left = ExLogical("Or", left, right)
        else
            go = False
        end
    end
    Ok(left)
end

fn parse_and(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Result<Ex, String>
    let mut left = parse_comparison(ts, n, pm, em)?
    let mut go = True
    while go
        if mt(ts, n, pm, TkAnd)
            let right = parse_comparison(ts, n, pm, em)?
            left = ExLogical("And", left, right)
        else
            go = False
        end
    end
    Ok(left)
end

fn parse_comparison(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Result<Ex, String>
    let mut left = parse_pipeline(ts, n, pm, em)?
    let mut go = True
    while go
        let d = tok_disc(pk_tk(ts, n, pm))
        if d == tok_disc(TkEq)
            adv(ts, n, pm)
            left = ExBinary("Eq", left, parse_pipeline(ts, n, pm, em)?)
        elif d == tok_disc(TkNotEq)
            adv(ts, n, pm)
            left = ExBinary("NotEq", left, parse_pipeline(ts, n, pm, em)?)
        elif d == tok_disc(TkLt)
            adv(ts, n, pm)
            left = ExBinary("Lt", left, parse_pipeline(ts, n, pm, em)?)
        elif d == tok_disc(TkGt)
            adv(ts, n, pm)
            left = ExBinary("Gt", left, parse_pipeline(ts, n, pm, em)?)
        elif d == tok_disc(TkLtEq)
            adv(ts, n, pm)
            left = ExBinary("LtEq", left, parse_pipeline(ts, n, pm, em)?)
        elif d == tok_disc(TkGtEq)
            adv(ts, n, pm)
            left = ExBinary("GtEq", left, parse_pipeline(ts, n, pm, em)?)
        else
            go = False
        end
    end
    Ok(left)
end

# pipeline：|> 左结合（宿主 parse_pipeline）
fn parse_pipeline(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Result<Ex, String>
    let mut left = parse_addition(ts, n, pm, em)?
    let mut go = True
    while go
        if mt(ts, n, pm, TkPipe)
            let right = parse_addition(ts, n, pm, em)?
            left = ExPipe(left, right)
        else
            go = False
        end
    end
    Ok(left)
end

fn parse_addition(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Result<Ex, String>
    let mut left = parse_multiplication(ts, n, pm, em)?
    let mut go = True
    while go
        let d = tok_disc(pk_tk(ts, n, pm))
        if d == tok_disc(TkPlus)
            adv(ts, n, pm)
            left = ExBinary("Add", left, parse_multiplication(ts, n, pm, em)?)
        elif d == tok_disc(TkMinus)
            # 跨行的 - 视为一元取负（宿主：避免 "0\n-1" 解析为 "0 - 1"）
            if newline_before(ts, n, pm)
                go = False
            else
                adv(ts, n, pm)
                left = ExBinary("Sub", left, parse_multiplication(ts, n, pm, em)?)
            end
        else
            go = False
        end
    end
    Ok(left)
end

fn parse_multiplication(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Result<Ex, String>
    let mut left = parse_unary(ts, n, pm, em)?
    let mut go = True
    while go
        let d = tok_disc(pk_tk(ts, n, pm))
        if d == tok_disc(TkStar)
            adv(ts, n, pm)
            left = ExBinary("Mul", left, parse_unary(ts, n, pm, em)?)
        elif d == tok_disc(TkSlash)
            adv(ts, n, pm)
            left = ExBinary("Div", left, parse_unary(ts, n, pm, em)?)
        elif d == tok_disc(TkPercent)
            adv(ts, n, pm)
            left = ExBinary("Mod", left, parse_unary(ts, n, pm, em)?)
        else
            go = False
        end
    end
    Ok(left)
end

fn parse_unary(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Result<Ex, String>
    let d = tok_disc(pk_tk(ts, n, pm))
    if d == tok_disc(TkBang)
        adv(ts, n, pm)
        let inner = parse_unary(ts, n, pm, em)?
        Ok(ExUnary("Not", inner))
    elif d == tok_disc(TkMinus)
        adv(ts, n, pm)
        let inner = parse_unary(ts, n, pm, em)?
        Ok(ExUnary("Neg", inner))
    else
        parse_question(ts, n, pm, em)
    end
end

# ? 后缀（宿主 parse_question：比 postfix 低、比 unary 高）
fn parse_question(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Result<Ex, String>
    let mut expr = parse_postfix(ts, n, pm, em)?
    let mut go = True
    while go
        if mt(ts, n, pm, TkQuestion)
            expr = ExTry(expr)
        else
            go = False
        end
    end
    Ok(expr)
end

# 后缀：调用 / 索引 / 字段（宿主 parse_postfix；跨行 ( 与 [ 不视为后缀）
fn parse_postfix(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Result<Ex, String>
    let mut expr = parse_primary(ts, n, pm, em)?
    let mut go = True
    while go
        let d = tok_disc(pk_tk(ts, n, pm))
        if d == tok_disc(TkLParen)
            if newline_before(ts, n, pm)
                go = False
            else
                adv(ts, n, pm)
                let args = parse_args(ts, n, pm, em)?
                expr = ExCall(expr, args)
            end
        elif d == tok_disc(TkLBracket)
            if newline_before(ts, n, pm)
                go = False
            else
                adv(ts, n, pm)
                let index = parse_expr(ts, n, pm, em)?
                expt(ts, n, pm, TkRBracket, "']'")?
                expr = ExIndex(expr, index)
            end
        elif d == tok_disc(TkDot)
            adv(ts, n, pm)
            match pk_tk(ts, n, pm)
                TkInt(idx) =>
                    adv(ts, n, pm)
                    if idx < 0
                        return Err(err_here(ts, n, pm, "元组索引不能为负"))
                    else
                        expr = ExField(expr, int_to_string(idx))
                    end
                end
                _ =>
                    let fname = parse_ident(ts, n, pm)?
                    expr = ExField(expr, fname)
                end
            end
        else
            go = False
        end
    end
    Ok(expr)
end

# 实参列表（宿主 parse_args）
fn parse_args(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Result<List<Ex>, String>
    let mut args = list_empty()
    if !chk(ts, n, pm, TkRParen)
        let mut go = True
        while go
            args = list_cons(parse_expr(ts, n, pm, em)?, args)
            if !mt(ts, n, pm, TkComma)
                go = False
            end
        end
    end
    expt(ts, n, pm, TkRParen, "')'")?
    Ok(rev_ex(args))
end

# 主表达式（宿主 parse_primary）
fn parse_primary(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Result<Ex, String>
    match pk_tk(ts, n, pm)
        TkInt(v) =>
            adv(ts, n, pm)
            Ok(ExInt(v))
        end
        TkFloat(s) =>
            adv(ts, n, pm)
            Ok(ExFloat(s))
        end
        TkTrue =>
            adv(ts, n, pm)
            Ok(ExBool(True))
        end
        TkFalse =>
            adv(ts, n, pm)
            Ok(ExBool(False))
        end
        TkStr(s) =>
            adv(ts, n, pm)
            Ok(ExStr(s))
        end
        TkIdent(s) =>
            let tpos = tok_at(ts, n, get_pos(pm))
            adv(ts, n, pm)
            Ok(ExIdent(s, tpos.ln, tpos.cl))
        end
        TkLParen =>
            let _ = adv(ts, n, pm)
            if mt(ts, n, pm, TkRParen)
                Ok(ExUnit)
            else
                let first = parse_expr(ts, n, pm, em)?
                if mt(ts, n, pm, TkComma)
                    let mut elems = list_cons(first, list_empty())
                    let mut go = True
                    while go
                        if chk(ts, n, pm, TkRParen)
                            go = False
                        else
                            elems = list_cons(parse_expr(ts, n, pm, em)?, elems)
                            if !mt(ts, n, pm, TkComma)
                                go = False
                            end
                        end
                    end
                    expt(ts, n, pm, TkRParen, "')' (闭合元组)")?
                    Ok(ExTuple(rev_ex(elems)))
                else
                    expt(ts, n, pm, TkRParen, "')'")?
                    Ok(ExGroup(first))
                end
            end
        end
        TkLBrace => parse_record(ts, n, pm, em)
        TkFn => parse_closure(ts, n, pm, em)
        TkIf =>
            let ifr = parse_if(ts, n, pm, em)?
            Ok(ExIf(ifr))
        end
        TkMatch => parse_match(ts, n, pm, em)
        _ => Err(err_here(ts, n, pm, "期望表达式，得到 " + tok_name(pk_tk(ts, n, pm))))
    end
end

# 闭包字面量（宿主 parse_closure）
fn parse_closure(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Result<Ex, String>
    adv(ts, n, pm)
    expt(ts, n, pm, TkLParen, "'('")?
    let params = parse_params(ts, n, pm)?
    let ret =
    if mt(ts, n, pm, TkArrow)
        Some(parse_type(ts, n, pm)?)
    else
        None
    end
    let body = parse_block(ts, n, pm, em)?
    Ok(ExClosure(params, ret, body))
end

# 记录字面量（宿主 parse_record；尾随逗号允许）
fn parse_record(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Result<Ex, String>
    adv(ts, n, pm)
    let mut fields = list_empty()
    if !chk(ts, n, pm, TkRBrace)
        let mut go = True
        while go
            if chk(ts, n, pm, TkRBrace)
                go = False
            else
                let fname = parse_ident(ts, n, pm)?
                expt(ts, n, pm, TkColon, "':' (记录字段分隔)")?
                let value = parse_expr(ts, n, pm, em)?
                fields = list_cons((fname, value), fields)
                if !mt(ts, n, pm, TkComma)
                    go = False
                end
            end
        end
    end
    expt(ts, n, pm, TkRBrace, "'}' (闭合记录)")?
    Ok(ExRecord(rev_sfld(fields)))
end

# match 表达式（宿主 parse_match：容错臂级恢复——丢弃坏臂余下臂，保证 match 自闭合）
fn parse_match(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Result<Ex, String>
    let _ = adv(ts, n, pm)
    let scrutinee = parse_expr(ts, n, pm, em)?
    let mut arms = list_empty()
    let mut go = True
    while go and !chk(ts, n, pm, TkEnd) and !chk(ts, n, pm, TkEof)
        let saved = get_pos(pm)
        match parse_match_arm(ts, n, pm, em)
            Ok(arm) =>
                arms = list_cons(arm, arms)
            end
            Err(e) =>
                let r = unpack_err(e)
                em_add(em, classify_parse_msg(r.msg), r.ln, r.cl, r.msg)
                # 保守同步：跳到 match 的 end（或 eof），放弃后续臂
                while !chk(ts, n, pm, TkEnd) and !chk(ts, n, pm, TkEof)
                    adv(ts, n, pm)
                end
                ensure_progress(ts, n, pm, saved)
                go = False
            end
        end
    end
    if chk(ts, n, pm, TkEnd)
        let end_rec = tok_at(ts, n, get_pos(pm))
        adv(ts, n, pm)
        Ok(ExMatch(scrutinee, rev_arm(arms), end_rec.ln))
    else
        Err(err_here(ts, n, pm, "期望 'end' 闭合 match"))
    end
end

# match 臂（宿主 parse_match_arm：Form A 同行单表达式 / Form B 跨行块）
fn parse_match_arm(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Result<ArmR, String>
    let pattern = parse_pattern(ts, n, pm, em)?
    let guard =
    if mt(ts, n, pm, TkIf)
        Some(parse_expr(ts, n, pm, em)?)
    else
        None
    end
    let _ = expt(ts, n, pm, TkFatArrow, "'=>'")?
    if newline_before(ts, n, pm)
        let b = parse_block(ts, n, pm, em)?
        Ok(ArmR(pattern, guard, ABBlock(b)))
    else
        let e = parse_expr(ts, n, pm, em)?
        Ok(ArmR(pattern, guard, ABExpr(e)))
    end
end

# 模式（宿主 parse_pattern：字面量 / _ / 绑定 / 变体（同行 ( 才是变体））
fn parse_pattern(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Result<Pat, String>
    match pk_tk(ts, n, pm)
        TkInt(v) =>
            adv(ts, n, pm)
            Ok(PatLit(ExInt(v)))
        end
        TkFloat(s) =>
            adv(ts, n, pm)
            Ok(PatLit(ExFloat(s)))
        end
        TkStr(s) =>
            adv(ts, n, pm)
            Ok(PatLit(ExStr(s)))
        end
        TkTrue =>
            adv(ts, n, pm)
            Ok(PatLit(ExBool(True)))
        end
        TkFalse =>
            adv(ts, n, pm)
            Ok(PatLit(ExBool(False)))
        end
        TkIdent(s) =>
            let _ = adv(ts, n, pm)
            if s == "_"
                Ok(PatWildcard)
            elif chk(ts, n, pm, TkLParen) and !newline_before(ts, n, pm)
                adv(ts, n, pm)
                let mut subs = list_empty()
                if !chk(ts, n, pm, TkRParen)
                    let mut go = True
                    while go
                        subs = list_cons(parse_pattern(ts, n, pm, em)?, subs)
                        if !mt(ts, n, pm, TkComma)
                            go = False
                        end
                    end
                end
                expt(ts, n, pm, TkRParen, "')' (闭合变体模式)")?
                Ok(PatVariant(s, rev_pat(subs)))
            else
                Ok(PatBinder(s))
            end
        end
        _ => Err(err_here(ts, n, pm, "期望模式，得到 " + tok_name(pk_tk(ts, n, pm))))
    end
end

# ============================================================================
# Part D：AST dump（对齐宿主 src/dump.rs 的确定性缩进树契约；逐行 println 增量输出，
#   绕开整树字符串拼接的 O(n^2)——RFC-0003 冻结声明的 join 不需要论证）
#   Float 用规范化文本直出；Str 用 Rust Debug 转义（\" \\ \n \r \t，其余可打印原样）；
#   Bool 输出小写 true/false（Rust Display 契约）
# ============================================================================

fn ind(d: Int) -> String
    let mut out = ""
    let mut i = 0
    while i < d
        out = out + "  "
        i += 1
    end
    out
end

fn pl(d: Int, text: String) -> Unit ! [IO]
    println(ind(d) + text)
end

# 列表 join（空列表 → ""，对齐 Rust Vec::join）
fn join_str(xs: List<String>, sep: String) -> String
    let mut out = ""
    let mut first = True
    for x in xs
        if first
            out = x
            first = False
        else
            out = out + sep + x
        end
    end
    out
end

# Str 的 Rust Debug 形态（含两侧引号）
fn debug_str(s: String) -> String
    let mut out = "\""
    for c in split(s, "")
        if c == "\""
            out = out + "\\\""
        elif c == "\\"
            out = out + "\\\\"
        elif c == "\n"
            out = out + "\\n"
        elif c == "\r"
            out = out + "\\r"
        elif c == "\t"
            out = out + "\\t"
        else
            out = out + c
        end
    end
    out + "\""
end

# 类型 → 字符串（dump.rs type_str 契约：记录 {x: Int} 无花括号内侧空格，join ", "）
fn ty_str(t: Ty) -> String
    match t
        TyInt => "Int"
        TyFloat => "Float"
        TyBool => "Bool"
        TyString => "String"
        TyUnit => "Unit"
        TyNamed(n) => n
        TyOption(inner) => "Option<" + ty_str(inner) + ">"
        TResult(a, b) => "Result<" + ty_str(a) + ", " + ty_str(b) + ">"
        TyGeneric(n, args) => n + "<" + join_str(ty_strs(args), ", ") + ">"
        TyRecord(fields) => "{" + join_str(sfty_strs(fields), ", ") + "}"
        TyTuple(elems) => "(" + join_str(ty_strs(elems), ", ") + ")"
    end
end

fn ty_strs(tys: List<Ty>) -> List<String>
    let mut acc = list_empty()
    for t in tys
        acc = list_cons(ty_str(t), acc)
    end
    rev_str(acc)
end

fn sfty_strs(fields: List<(String, Ty)>) -> List<String>
    let mut acc = list_empty()
    for f in fields
        acc = list_cons(f.0 + ": " + ty_str(f.1), acc)
    end
    rev_str(acc)
end

fn prm_strs(ps: List<Prm>) -> List<String>
    let mut acc = list_empty()
    for p in ps
        match p
            Prm(name, ty) =>
                acc = list_cons(name + ": " + ty_str(ty), acc)
            end
        end
    end
    rev_str(acc)
end

# Option<Ty> 的返回类型形态（无注解 → "_"）
fn ret_str(ret: Option<Ty>) -> String
    match ret
        Some(t) => ty_str(t)
        None => "_"
    end
end

fn dump_program(p: Prg) -> Unit ! [IO]
    println("Program")
    match p
        Prg(items) =>
            for it in items
                dump_item(it, 1)
            end
        end
    end
end

fn dump_item(it: Itm, d: Int) -> Unit ! [IO]
    match it
        ItFn(name, params, ret, effs, body, _, _) =>
            let eff_str =
            if list_length(effs) == 0
                ""
            else
                " ! [" + join_str(effs, ", ") + "]"
            end
            pl(d, "Fn " + name + "(" + join_str(prm_strs(params), ", ") + ") -> " + ret_str(ret) + eff_str)
            dump_blk(body, d + 1)
        end
        ItEnum(name, tparams, variants) =>
            let tp_str =
            if list_length(tparams) == 0
                ""
            else
                "<" + join_str(tparams, ", ") + ">"
            end
            let mut vstrs = list_empty()
            for v in variants
                match v
                    VarR(vname, fields) =>
                        if list_length(fields) == 0
                            vstrs = list_cons(vname, vstrs)
                        else
                            vstrs = list_cons(vname + "(" + join_str(ty_strs(fields), ", ") + ")", vstrs)
                        end
                    end
                end
            end
            pl(d, "Enum " + name + tp_str + " = " + join_str(rev_str(vstrs), " | "))
        end
        ItImport(module, items) =>
            let mut istrs = list_empty()
            for i in items
                match i
                    ImpI(iname, alias) =>
                        if iname == alias
                            istrs = list_cons(iname, istrs)
                        else
                            istrs = list_cons(iname + " as " + alias, istrs)
                        end
                    end
                end
            end
            pl(d, "Import " + module + " {" + join_str(rev_str(istrs), ", ") + "}")
        end
    end
end

# if 结构（语句与表达式共用；dump_if 契约：Branch/ElifBranch/ElseBranch）
fn dump_ifr(ifr: IfR, d: Int) -> Unit ! [IO]
    match ifr
        IfR(branches, els) =>
            pl(d, "If")
            let mut i = 0
            for br in branches
                if i == 0
                    pl(d + 1, "Branch")
                else
                    pl(d + 1, "ElifBranch")
                end
                dump_ex(br.0, d + 2)
                dump_blk(br.1, d + 2)
                i += 1
            end
            match els
                Some(b) =>
                    pl(d + 1, "ElseBranch")
                    dump_blk(b, d + 2)
                end
                None => ()
            end
        end
    end
end

fn dump_blk(b: Blk, d: Int) -> Unit ! [IO]
    match b
        BlkOf(stmts, tail) =>
            pl(d, "Block")
            for s in stmts
                dump_st(s, d + 1)
            end
            match tail
                Some(t) =>
                    pl(d + 1, "Tail")
                    dump_ex(t, d + 2)
                end
                None => ()
            end
        end
    end
end

fn dump_st(s: St, d: Int) -> Unit ! [IO]
    match s
        StLet(mutable, name, ty, value) =>
            let mut hdr = "Let "
            if mutable
                hdr = hdr + "mut "
            else
                ()
            end
            hdr = hdr + name
            match ty
                Some(t) =>
                    hdr = hdr + ": " + ty_str(t)
                end
                None => ()
            end
            pl(d, hdr)
            dump_ex(value, d + 1)
        end
        StDestruct(names, value) =>
            pl(d, "LetDestruct (" + join_str(names, ", ") + ")")
            dump_ex(value, d + 1)
        end
        StAssign(name, _, _, value) =>
            pl(d, "Assign " + name)
            dump_ex(value, d + 1)
        end
        StIf(ifr) => dump_ifr(ifr, d)
        StWhile(cond, body) =>
            pl(d, "While")
            dump_ex(cond, d + 1)
            dump_blk(body, d + 1)
        end
        StFor(var, iter, body) =>
            pl(d, "For " + var + " in")
            dump_ex(iter, d + 1)
            dump_blk(body, d + 1)
        end
        StReturn(opt) =>
            pl(d, "Return")
            match opt
                Some(e) => dump_ex(e, d + 1)
                None => ()
            end
        end
        StExpr(e) =>
            pl(d, "ExprStmt")
            dump_ex(e, d + 1)
        end
        StHole(l, c) =>
            pl(d, "Hole @" + int_to_string(l) + ":" + int_to_string(c))
        end
    end
end

fn dump_arm(arm: ArmR, d: Int) -> Unit ! [IO]
    match arm
        ArmR(pat, guard, body) =>
            pl(d, "Arm")
            dump_pat(pat, d + 1)
            match guard
                Some(g) =>
                    pl(d + 1, "Guard")
                    dump_ex(g, d + 2)
                end
                None => ()
            end
            match body
                ABExpr(e) => dump_ex(e, d + 1)
                ABBlock(b) => dump_blk(b, d + 1)
            end
        end
    end
end

fn dump_ex(e: Ex, d: Int) -> Unit ! [IO]
    match e
        ExInt(v) => pl(d, "Int " + int_to_string(v))
        ExFloat(s) => pl(d, "Float " + s)
        ExBool(b) =>
            if b
                pl(d, "Bool true")
            else
                pl(d, "Bool false")
            end
        end
        ExStr(s) => pl(d, "Str " + debug_str(s))
        ExUnit => pl(d, "Unit")
        ExIdent(x, _, _) => pl(d, "Ident " + x)
        ExBinary(op, l, r) =>
            pl(d, "Binary " + op)
            dump_ex(l, d + 1)
            dump_ex(r, d + 1)
        end
        ExUnary(op, inner) =>
            pl(d, "Unary " + op)
            dump_ex(inner, d + 1)
        end
        ExLogical(op, l, r) =>
            pl(d, "Logical " + op)
            dump_ex(l, d + 1)
            dump_ex(r, d + 1)
        end
        ExCall(callee, args) =>
            pl(d, "Call")
            dump_ex(callee, d + 1)
            for a in args
                dump_ex(a, d + 1)
            end
        end
        ExIndex(x, i) =>
            pl(d, "Index")
            dump_ex(x, d + 1)
            dump_ex(i, d + 1)
        end
        ExField(x, name) =>
            pl(d, "Field ." + name)
            dump_ex(x, d + 1)
        end
        ExGroup(inner) =>
            pl(d, "Group")
            dump_ex(inner, d + 1)
        end
        ExIf(ifr) => dump_ifr(ifr, d)
        ExClosure(params, ret, body) =>
            pl(d, "Closure (" + join_str(prm_strs(params), ", ") + ") -> " + ret_str(ret))
            dump_blk(body, d + 1)
        end
        ExMatch(scrut, arms, _) =>
            pl(d, "Match")
            dump_ex(scrut, d + 1)
            for arm in arms
                dump_arm(arm, d + 1)
            end
        end
        ExTry(inner) =>
            pl(d, "Try")
            dump_ex(inner, d + 1)
        end
        ExPipe(l, r) =>
            pl(d, "Pipe")
            dump_ex(l, d + 1)
            dump_ex(r, d + 1)
        end
        ExRange(s2, e2) =>
            pl(d, "Range")
            dump_ex(s2, d + 1)
            dump_ex(e2, d + 1)
        end
        ExRecord(fields) =>
            pl(d, "Record")
            for f in fields
                pl(d + 1, "Field " + f.0)
                dump_ex(f.1, d + 2)
            end
        end
        ExTuple(elems) =>
            pl(d, "Tuple")
            for x in elems
                dump_ex(x, d + 1)
            end
        end
    end
end

fn dump_pat(p: Pat, d: Int) -> Unit ! [IO]
    match p
        PatLit(e) =>
            pl(d, "Lit")
            dump_ex(e, d + 1)
        end
        PatBinder(x) => pl(d, "Binder " + x)
        PatWildcard => pl(d, "Wildcard")
        PatVariant(name, subs) =>
            pl(d, "Variant " + name)
            for s2 in subs
                dump_pat(s2, d + 1)
            end
        end
    end
end

# token 单行格式（对齐宿主 --dump-tokens 的 {:?} 形态：Name(payload) @ln:cl）
fn tok_line(t: {t: Tok, ln: Int, cl: Int}) -> String
    let name = match t.t
        TkInt(v) => "Int(" + int_to_string(v) + ")"
        # 宿主 --dump-tokens 的 Float 载荷是 Rust Debug 形态（整数值带 .0）；
        # dump 契约（dump.rs）才是 Display 形态（无 .0）——两者不同源
        TkFloat(x) =>
            if contains(x, ".")
                "Float(" + x + ")"
            else
                "Float(" + x + ".0)"
            end
        end
        TkStr(x) => "Str(" + debug_str(x) + ")"
        TkIdent(x) => "Ident(" + debug_str(x) + ")"
        _ => tk_dbg(t.t)
    end
    name + " @" + int_to_string(t.ln) + ":" + int_to_string(t.cl)
end

# token 流输出（数值序）
fn dump_tokens(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int) -> Unit ! [IO]
    let mut i = 0
    while i < n
        println(tok_line(tok_at(ts, n, i)))
        i += 1
    end
end

# 诊断输出（数值序遍历——map_keys 是字符串排序，"10" < "2" 会乱序）
fn dump_diags(em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Unit ! [IO]
    let total = map_size(em)
    let mut i = 0
    while i < total
        match map_get(em, int_to_string(i))
            Some(e) => println(e.code + "|" + int_to_string(e.ln) + "|" + int_to_string(e.cl) + "|" + e.msg)
            None => ()
        end
        i += 1
    end
end

# ============================================================================
# main：args()[0]=脚本名 args()[1]=待解析文件 args()[2] 可选 --diags
#   （宿主 lom CLI 剥掉裸 "--"，见 bench.lom 惯例）
# ============================================================================

fn main() -> Unit
    let argv = args()
    if list_length(argv) < 2
        println("usage: lom self_interp.lom -- <file> [--diags]")
    else
        let path = list_get(argv, 1)
        if file_exists(path) == False
            println("error: file not found: " + path)
        else
            let src = file_read(path)
            let r = lex(src)
            # 词法错误先入列（对齐宿主 parse_recover：lex_errors 在前，parse errors extend）
            let em = map_empty()
            for e in r.errs
                em_add(em, classify_lex_msg(e.msg), e.ln, e.cl, e.msg)
            end
            let pm = map_empty()
            map_set(pm, "pos", 0)
            let prg = parse_program(r.toks, r.n, pm, em)
            let mode =
            if list_length(argv) >= 3
                list_get(argv, 2)
            else
                ""
            end
            if mode == "--tokens"
                dump_tokens(r.toks, r.n)
            elif mode == "--diags"
                dump_diags(em)
            elif mode == "--run"
                match run_program(prg)
                    Ok(_) => ()
                    Err(e) =>
                        match e
                            EMsg(m) => println("[self-runtime] " + m)
                            ERet(_) => println("[self-runtime] main 提前返回")
                        end
                    end
                end
            elif mode == "--check"
                # 8.2：词法+语法诊断之上叠加静态检查（四类码）。
                # 对齐宿主 --json：parse 有错时跳过 typecheck（diags.ok 才检查）——
                # 带洞 AST 的静态检查会多报（容错恢复后的碎片被当正常代码查）
                if map_size(em) > 0
                    dump_diags(em)
                else
                    let fns = map_empty()
                    reg_builtins_fns(fns)
                    let enums = map_empty()
                    reg_builtins_enums(enums)
                    collect_items(prg, fns, enums)
                    check_program2(prg, fns, enums, em)
                    dump_diags(em)
                end
            else
                dump_program(prg)
            end
        end
    end
end

# ============================================================================
# Part E：8.2 静态检查（RFC-0003 §8.2 子集：NAM003 / TYPE003-arity / EFF001 / MAT001）
#   对齐宿主 src/typechecker.rs 的四类检查（类型检查全量移植维持挂账）：
#   - NAM003：未定义变量（Ident 位置）/ 调用未定义函数（callee 位置）/ 赋值未定义变量
#   - TYPE003：函数与变体构造器的参数个数（管道左值计入实参，2026-08-22 宿主同款）
#   - EFF001：被调函数声明的每个效应须在当前函数效应集中（main 豁免；闭包继承外层）
#   - MAT001：用户枚举变体 / Result(Ok,Err) / Option(Some,None) 穷尽性
#     （guard 臂不计入；Binder 模式命中无参变体名时计为已覆盖——宿主语义）
#   已知限制（与宿主的差异面，验收按四类码过滤比对）：
#   - Binary/Range/Tuple/Record 等复杂表达式的类型推断返回 Unknown（MAT001 依赖
#     scrutinee 可推：Ident（env 注解）/ Call（签名 ret）/ 字面量 / Group / 变体构造）
#   - 嵌套变体模式（Ok(Some(x))）的内层绑定类型 Unknown（宿主按字段类型传播）
#   - NAM004/TYPE001/002/010/020/MUT001 等类型层诊断不产出（8.2 范围外）
#   作用域语义（平移宿主 TypeEnv）：仅闭包与 match 臂开子作用域（child=拷贝），
#   if/while/for 块共享当前环境（绑定向外泄漏——宿主的简化作用域，不"修正"）
# ============================================================================

# 检查器状态（fns/enums 走 Map 引用共享；cur_effs/is_main 按函数重建）
# fns: Map<String, {ar: Int, effs: List<String>, ret: Option<Ty>}>
# enums: Map<String, {vs: List<(String, Int)>, blt: Bool}>

fn reg_builtins_fns(fns: Map<String, {ar: Int, effs: List<String>, ret: Option<Ty>}>) -> Unit
    let io = list_cons("IO", list_empty())
    let pure = list_empty()
    # prelude（IO 效应）
    map_set(fns, "println", {ar: 1, effs: io, ret: Some(TyUnit)})
    map_set(fns, "print", {ar: 1, effs: io, ret: Some(TyUnit)})
    # string（纯）
    map_set(fns, "len", {ar: 1, effs: pure, ret: Some(TyInt)})
    map_set(fns, "int_to_string", {ar: 1, effs: pure, ret: Some(TyString)})
    map_set(fns, "string_to_int", {ar: 1, effs: pure, ret: None})
    map_set(fns, "trim", {ar: 1, effs: pure, ret: Some(TyString)})
    map_set(fns, "upper", {ar: 1, effs: pure, ret: Some(TyString)})
    map_set(fns, "lower", {ar: 1, effs: pure, ret: Some(TyString)})
    map_set(fns, "split", {ar: 2, effs: pure, ret: None})
    map_set(fns, "contains", {ar: 2, effs: pure, ret: Some(TyBool)})
    map_set(fns, "replace", {ar: 3, effs: pure, ret: Some(TyString)})
    map_set(fns, "starts_with", {ar: 2, effs: pure, ret: Some(TyBool)})
    map_set(fns, "ends_with", {ar: 2, effs: pure, ret: Some(TyBool)})
    # math（纯）
    map_set(fns, "sqrt", {ar: 1, effs: pure, ret: Some(TyFloat)})
    map_set(fns, "abs", {ar: 1, effs: pure, ret: None})
    map_set(fns, "min", {ar: 2, effs: pure, ret: None})
    map_set(fns, "max", {ar: 2, effs: pure, ret: None})
    # list（纯）
    map_set(fns, "list_empty", {ar: 0, effs: pure, ret: None})
    map_set(fns, "list_length", {ar: 1, effs: pure, ret: Some(TyInt)})
    map_set(fns, "list_get", {ar: 2, effs: pure, ret: None})
    map_set(fns, "list_is_empty", {ar: 1, effs: pure, ret: Some(TyBool)})
    map_set(fns, "list_head", {ar: 1, effs: pure, ret: None})
    map_set(fns, "list_tail", {ar: 1, effs: pure, ret: None})
    map_set(fns, "list_cons", {ar: 2, effs: pure, ret: None})
    map_set(fns, "list_map", {ar: 2, effs: pure, ret: None})
    map_set(fns, "list_filter", {ar: 2, effs: pure, ret: None})
    map_set(fns, "list_fold", {ar: 3, effs: pure, ret: None})
    # json（纯）
    map_set(fns, "json_parse", {ar: 1, effs: pure, ret: None})
    map_set(fns, "json_stringify", {ar: 1, effs: pure, ret: Some(TyString)})
    # map（纯）
    map_set(fns, "map_empty", {ar: 0, effs: pure, ret: None})
    map_set(fns, "map_set", {ar: 3, effs: pure, ret: Some(TyUnit)})
    map_set(fns, "map_get", {ar: 2, effs: pure, ret: Some(TyOption(TyNamed("T")))})
    map_set(fns, "map_has", {ar: 2, effs: pure, ret: Some(TyBool)})
    map_set(fns, "map_remove", {ar: 2, effs: pure, ret: Some(TyBool)})
    map_set(fns, "map_keys", {ar: 1, effs: pure, ret: None})
    map_set(fns, "map_values", {ar: 1, effs: pure, ret: None})
    map_set(fns, "map_size", {ar: 1, effs: pure, ret: Some(TyInt)})
    # file（IO）
    map_set(fns, "file_read", {ar: 1, effs: io, ret: Some(TyString)})
    map_set(fns, "file_write", {ar: 2, effs: io, ret: Some(TyUnit)})
    map_set(fns, "file_append", {ar: 2, effs: io, ret: Some(TyUnit)})
    map_set(fns, "file_exists", {ar: 1, effs: io, ret: Some(TyBool)})
    # env（纯）
    map_set(fns, "args", {ar: 0, effs: pure, ret: None})
end

fn reg_builtins_enums(enums: Map<String, {vs: List<(String, Int)>, blt: Bool}>) -> Unit
    map_set(enums, "Result", {vs: list_cons(("Ok", 1), list_cons(("Err", 1), list_empty())), blt: True})
    map_set(enums, "Option", {vs: list_cons(("Some", 1), list_cons(("None", 0), list_empty())), blt: True})
end

# 作用域 child：宿主 TypeEnv::child 是整链值拷贝——这里等价拷贝当前 vars
fn env_child(env: Map<String, Option<Ty>>) -> Map<String, Option<Ty>>
    let child = map_empty()
    for k in map_keys(env)
        match map_get(env, k)
            Some(t) => map_set(child, k, t)
            None => ()
        end
    end
    child
end

# 变体名 → (所属枚举名, arity, 是否内建)；宿主遍历 enums 取首个命中（变体名全局唯一时无歧义）
fn enum_of_variant(enums: Map<String, {vs: List<(String, Int)>, blt: Bool}>, vname: String) -> Option<(String, Int, Bool)>
    let mut result = None
    for ename in map_keys(enums)
        match map_get(enums, ename)
            Some(info) =>
                for v in info.vs
                    if v.0 == vname and result == None
                        result = Some((ename, v.1, info.blt))
                    end
                end
            end
            None => ()
        end
    end
    result
end

# 变体构造器的返回类型（宿主 variant_return_type：内建 Result/Option 泛型形态，用户 Named）
fn variant_ret_ty(enums: Map<String, {vs: List<(String, Int)>, blt: Bool}>, vname: String) -> Option<Ty>
    match enum_of_variant(enums, vname)
        Some(t) =>
            let ename = t.0
            let blt = t.2
            if blt
                if ename == "Result"
                    Some(TResult(TyNamed("T"), TyNamed("E")))
                elif ename == "Option"
                    Some(TyOption(TyNamed("T")))
                else
                    None
                end
            else
                Some(TyNamed(ename))
            end
        end
        None => None
    end
end

# 效应是否已声明
fn eff_declared(effs: List<String>, e: String) -> Bool
    let mut cur = effs
    let mut found = False
    while !list_is_empty(cur) and found == False
        if list_head(cur) == e
            found = True
        else
            cur = list_tail(cur)
        end
    end
    found
end

# ---- 收集遍（宿主 check_program 第一遍；不产诊断——NAM002 范围外）----

fn rev_pair(xs: List<(String, Int)>) -> List<(String, Int)>
    let mut acc = list_empty()
    let mut cur = xs
    while !list_is_empty(cur)
        acc = list_cons(list_head(cur), acc)
        cur = list_tail(cur)
    end
    acc
end

fn collect_items(prg: Prg, fns: Map<String, {ar: Int, effs: List<String>, ret: Option<Ty>}>, enums: Map<String, {vs: List<(String, Int)>, blt: Bool}>) -> Unit
    match prg
        Prg(items) =>
            for it in items
                match it
                    ItFn(name, params, ret, effs, body, _, _) =>
                        map_set(fns, name, {ar: list_length(params), effs: effs, ret: ret})
                    end
                    ItEnum(name, _, variants) =>
                        let mut vs = list_empty()
                        for v in variants
                            match v
                                VarR(vname, fields) =>
                                    vs = list_cons((vname, list_length(fields)), vs)
                                end
                            end
                        end
                        map_set(enums, name, {vs: rev_pair(vs), blt: False})
                    end
                    ItImport(_, imp_items) =>
                        # 别名继承真名签名（仅真名已注册时——宿主语义）
                        for i in imp_items
                            match i
                                ImpI(iname, alias) =>
                                    match map_get(fns, iname)
                                        Some(sig) => map_set(fns, alias, sig)
                                        None => ()
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end

# ---- 检查遍（宿主第二遍）----
# st: Map 持 "effs"（当前函数效应 List）与 "is_main"（1/0）——Map 引用共享

fn check_program2(prg: Prg, fns: Map<String, {ar: Int, effs: List<String>, ret: Option<Ty>}>, enums: Map<String, {vs: List<(String, Int)>, blt: Bool}>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Unit
    match prg
        Prg(items) =>
            for it in items
                match it
                    ItFn(name, params, _, effs, body, fln, fcl) =>
                        let st = {effs: effs, is_main: name == "main", fln: fln, fcl: fcl}
                        let env = map_empty()
                        for p in params
                            match p
                                Prm(pname, pty) => map_set(env, pname, Some(pty))
                            end
                        end
                        chk_blk(body, env, st, fns, enums, em)
                    end
                    _ => ()
                end
            end
        end
    end
end

# 块检查（宿主 check_block：stmts 逐个 + tail；类型返回值 8.2 不消费，Unit）
fn chk_blk(b: Blk, env: Map<String, Option<Ty>>, st: {effs: List<String>, is_main: Bool, fln: Int, fcl: Int}, fns: Map<String, {ar: Int, effs: List<String>, ret: Option<Ty>}>, enums: Map<String, {vs: List<(String, Int)>, blt: Bool}>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Unit
    match b
        BlkOf(stmts, tail) =>
            for s in stmts
                chk_stmt(s, env, st, fns, enums, em)
            end
            match tail
                Some(t) => chk_expr(t, env, st, fns, enums, em)
                None => ()
            end
        end
    end
end

# 语句检查（四类诊断；类型层诊断 TYPE001/002/010/MUT001 不产——8.2 范围外）
fn chk_stmt(s: St, env: Map<String, Option<Ty>>, st: {effs: List<String>, is_main: Bool, fln: Int, fcl: Int}, fns: Map<String, {ar: Int, effs: List<String>, ret: Option<Ty>}>, enums: Map<String, {vs: List<(String, Int)>, blt: Bool}>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Unit
    match s
        StLet(_, name, ty, value) =>
            let vt = chk_expr(value, env, st, fns, enums, em)
            match ty
                Some(t) => map_set(env, name, Some(t))
                None => map_set(env, name, vt)
            end
        end
        StDestruct(names, value) =>
            chk_expr(value, env, st, fns, enums, em)
            for nm in names
                map_set(env, nm, None)
            end
        end
        StAssign(name, aln, acl, value) =>
            chk_expr(value, env, st, fns, enums, em)
            if map_has(env, name) == False
                em_add(em, "NAM003", aln, acl, "赋值给未定义变量 '" + name + "'")
            end
        end
        StIf(ifr) =>
            match ifr
                IfR(branches, els) =>
                    for br in branches
                        chk_expr(br.0, env, st, fns, enums, em)
                        chk_blk(br.1, env, st, fns, enums, em)
                    end
                    match els
                        Some(b) => chk_blk(b, env, st, fns, enums, em)
                        None => ()
                    end
                end
            end
        end
        StWhile(cond, body) =>
            chk_expr(cond, env, st, fns, enums, em)
            chk_blk(body, env, st, fns, enums, em)
        end
        StFor(var, iter, body) =>
            let it_ty = chk_expr(iter, env, st, fns, enums, em)
            # 宿主元素类型：String→String / Int→Int / Generic List 1 参→arg / 其他 Unknown
            let elem =
            match it_ty
                Some(TyString) => Some(TyString)
                Some(TyInt) => Some(TyInt)
                Some(TyGeneric(gname, gargs)) =>
                    if gname == "List" and list_length(gargs) == 1
                        list_get(gargs, 0)
                    else
                        None
                    end
                end
                _ => None
            end
            map_set(env, var, elem)
            chk_blk(body, env, st, fns, enums, em)
        end
        StReturn(opt) =>
            match opt
                Some(e) => chk_expr(e, env, st, fns, enums, em)
                None => ()
            end
        end
        StExpr(e) =>
            chk_expr(e, env, st, fns, enums, em)
        end
        StHole(_, _) => ()
    end
end

# 表达式检查：遍历产四类诊断 + 返回推断类型（MAT001 的 scrutinee 用）
fn chk_expr(e: Ex, env: Map<String, Option<Ty>>, st: {effs: List<String>, is_main: Bool, fln: Int, fcl: Int}, fns: Map<String, {ar: Int, effs: List<String>, ret: Option<Ty>}>, enums: Map<String, {vs: List<(String, Int)>, blt: Bool}>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Option<Ty>
    match e
        ExInt(_) => Some(TyInt)
        ExFloat(_) => Some(TyFloat)
        ExBool(_) => Some(TyBool)
        ExStr(_) => Some(TyString)
        ExUnit => Some(TyUnit)
        ExIdent(name, iln, icl) =>
            if map_has(env, name)
                # map_get 返回 Some(存储值) 包装：存储值本身是 Option<Ty>，解一层
                match map_get(env, name)
                    Some(stored) => stored
                    None => None
                end
            elif map_has(fns, name)
                # 顶层函数引用作为值（宿主：不深入检查）
                None
            else
                match enum_of_variant(enums, name)
                    Some(_) => variant_ret_ty(enums, name)
                    None =>
                        em_add(em, "NAM003", iln, icl, "未定义变量 '" + name + "'")
                        None
                    end
                end
            end
        end
        ExBinary(_, l, r) =>
            chk_expr(l, env, st, fns, enums, em)
            chk_expr(r, env, st, fns, enums, em)
            None
        end
        ExUnary(_, inner) =>
            chk_expr(inner, env, st, fns, enums, em)
            None
        end
        ExLogical(_, l, r) =>
            chk_expr(l, env, st, fns, enums, em)
            chk_expr(r, env, st, fns, enums, em)
            None
        end
        ExCall(callee, args) =>
            match callee
                ExIdent(cname, cln, ccl) =>
                    chk_call(cname, cln, ccl, args, env, st, fns, enums, em)
                end
                _ =>
                    # 复杂 callee（闭包字面量等）：宿主只 check_expr(callee)——args 也已查
                    chk_expr(callee, env, st, fns, enums, em)
                    for a in args
                        chk_expr(a, env, st, fns, enums, em)
                    end
                    None
                end
            end
        end
        ExIndex(x, i) =>
            chk_expr(x, env, st, fns, enums, em)
            chk_expr(i, env, st, fns, enums, em)
            None
        end
        ExField(x, _) =>
            chk_expr(x, env, st, fns, enums, em)
            None
        end
        ExGroup(inner) => chk_expr(inner, env, st, fns, enums, em)
        ExIf(ifr) =>
            match ifr
                IfR(branches, els) =>
                    for br in branches
                        chk_expr(br.0, env, st, fns, enums, em)
                        chk_blk(br.1, env, st, fns, enums, em)
                    end
                    match els
                        Some(b) => chk_blk(b, env, st, fns, enums, em)
                        None => ()
                    end
                end
            end
            None
        end
        ExClosure(params, _, body) =>
            # 宿主：闭包捕获外部环境（child 作用域）+ 参数注入
            let cenv = env_child(env)
            for p in params
                match p
                    Prm(pname, pty) => map_set(cenv, pname, Some(pty))
                end
            end
            chk_blk(body, cenv, st, fns, enums, em)
            None
        end
        ExMatch(scrut, arms, end_ln) => chk_match(scrut, arms, end_ln, env, st, fns, enums, em)
        ExTry(inner) =>
            chk_expr(inner, env, st, fns, enums, em)
            None
        end
        ExPipe(left, right) =>
            chk_expr(left, env, st, fns, enums, em)
            # 宿主：right 是 Call → check_call(callee, [left]+args)；right 是 Ident → check_call(right, [left])
            match right
                ExCall(ExIdent(cname, cln, ccl), args) =>
                    let mut full = list_cons(left, list_empty())
                    for a in args
                        full = list_cons(a, full)
                    end
                    chk_call(cname, cln, ccl, rev_ex(full), env, st, fns, enums, em)
                end
                ExIdent(cname, cln, ccl) =>
                    chk_call(cname, cln, ccl, list_cons(left, list_empty()), env, st, fns, enums, em)
                end
                _ =>
                    chk_expr(right, env, st, fns, enums, em)
                    None
                end
            end
        end
        ExRange(a, b) =>
            chk_expr(a, env, st, fns, enums, em)
            chk_expr(b, env, st, fns, enums, em)
            None
        end
        ExRecord(fields) =>
            for f in fields
                chk_expr(f.1, env, st, fns, enums, em)
            end
            None
        end
        ExTuple(elems) =>
            for x in elems
                chk_expr(x, env, st, fns, enums, em)
            end
            None
        end
    end
end

# 调用检查（宿主 check_call 的 Ident callee 路径；参数表达式先查——副作用顺序对齐）
fn chk_call(cname: String, cln: Int, ccl: Int, args: List<Ex>, env: Map<String, Option<Ty>>, st: {effs: List<String>, is_main: Bool, fln: Int, fcl: Int}, fns: Map<String, {ar: Int, effs: List<String>, ret: Option<Ty>}>, enums: Map<String, {vs: List<(String, Int)>, blt: Bool}>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Option<Ty>
    for a in args
        chk_expr(a, env, st, fns, enums, em)
    end
    if map_has(fns, cname)
        match map_get(fns, cname)
            Some(sig) =>
                # EFF001：被调效应须在当前函数效应集中（main 豁免）
                if st.is_main == False
                    for eff in sig.effs
                        if eff_declared(st.effs, eff) == False
                            em_add(em, "EFF001", st.fln, st.fcl, "纯函数或未声明效应 [" + join_str(st.effs, ", ") + "] 的函数调用了带效应 [" + eff + "] 的函数 '" + cname + "'")
                        end
                    end
                end
                # TYPE003 arity
                if sig.ar != list_length(args)
                    em_add(em, "TYPE003", cln, ccl, "函数 '" + cname + "' 期望 " + int_to_string(sig.ar) + " 个参数，得到 " + int_to_string(list_length(args)) + " 个")
                end
                sig.ret
            end
            None => None
        end
    else
        match enum_of_variant(enums, cname)
            Some(vt) =>
                let varity = vt.1
                if varity != list_length(args)
                    em_add(em, "TYPE003", cln, ccl, "变体 '" + cname + "' 期望 " + int_to_string(varity) + " 个参数，得到 " + int_to_string(list_length(args)) + " 个")
                end
                variant_ret_ty(enums, cname)
            end
            None =>
                if map_has(env, cname)
                    # 局部变量（可能是闭包）——宿主不深入检查
                    None
                else
                    em_add(em, "NAM003", cln, ccl, "调用未定义函数 '" + cname + "'")
                    None
                end
            end
        end
    end
end

# match 检查（宿主 check_match：臂 child 作用域 + guard 不计穷尽 + Binder 无参变体计覆盖）
fn chk_match(scrut: Ex, arms: List<ArmR>, end_ln: Int, env: Map<String, Option<Ty>>, st: {effs: List<String>, is_main: Bool, fln: Int, fcl: Int}, fns: Map<String, {ar: Int, effs: List<String>, ret: Option<Ty>}>, enums: Map<String, {vs: List<(String, Int)>, blt: Bool}>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Option<Ty>
    let scrut_ty = chk_expr(scrut, env, st, fns, enums, em)
    let mut has_wild = False
    let mut covered = list_empty()
    for arm in arms
        match arm
            ArmR(pat, guard, body) =>
                let aenv = env_child(env)
                let vn = chk_pattern(pat, scrut_ty, aenv, enums)
                match guard
                    Some(g) =>
                        # guard 臂不计入穷尽性（宿主 Rust 语义）
                        chk_expr(g, aenv, st, fns, enums, em)
                    end
                    None =>
                        match vn
                            Some(v) =>
                                covered = list_cons(v, covered)
                            end
                            None => ()
                        end
                        match pat
                            PatWildcard =>
                                has_wild = True
                            end
                            _ => ()
                        end
                    end
                end
                match body
                    ABExpr(e2) => chk_expr(e2, aenv, st, fns, enums, em)
                    ABBlock(b) => chk_blk(b, aenv, st, fns, enums, em)
                end
            end
        end
    end
    # 穷尽性（宿主：用户枚举逐变体 / Result→Ok,Err / Option→Some,None；位置 = end 行 col 1）
    if has_wild == False
        match scrut_ty
            Some(TyNamed(ename)) =>
                match map_get(enums, ename)
                    Some(info) =>
                        if info.blt == False
                            for v in info.vs
                                if list_contains(covered, v.0) == False
                                    em_add(em, "MAT001", end_ln, 1, "match 非穷尽：未覆盖变体 '" + v.0 + "'（枚举 " + ename + "）")
                                end
                            end
                        end
                    end
                    None => ()
                end
            end
            Some(TResult(_, _)) =>
                if list_contains(covered, "Ok") == False
                    em_add(em, "MAT001", end_ln, 1, "match 非穷尽：未覆盖 Ok")
                end
                if list_contains(covered, "Err") == False
                    em_add(em, "MAT001", end_ln, 1, "match 非穷尽：未覆盖 Err")
                end
            end
            Some(TyOption(_)) =>
                if list_contains(covered, "Some") == False
                    em_add(em, "MAT001", end_ln, 1, "match 非穷尽：未覆盖 Some")
                end
                if list_contains(covered, "None") == False
                    em_add(em, "MAT001", end_ln, 1, "match 非穷尽：未覆盖 None")
                end
            end
            _ => ()
        end
    end
    None
end

fn ty_str_or(t: Option<Ty>) -> String
    match t
        Some(x) => ty_str(x)
        None => "None"
    end
end

# 列表包含（covered 查重）
fn list_contains(xs: List<String>, x: String) -> Bool
    let mut cur = xs
    let mut found = False
    while !list_is_empty(cur) and found == False
        if list_head(cur) == x
            found = True
        else
            cur = list_tail(cur)
        end
    end
    found
end

# 模式检查：注入绑定到 aenv；返回命中的变体名（Binder 命中无参变体时——宿主语义）
fn chk_pattern(p: Pat, scrut_ty: Option<Ty>, aenv: Map<String, Option<Ty>>, enums: Map<String, {vs: List<(String, Int)>, blt: Bool}>) -> Option<String>
    match p
        PatLit(_) => None
        PatBinder(name) =>
            match enum_of_variant(enums, name)
                Some(_) => Some(name)
                None =>
                    map_set(aenv, name, scrut_ty)
                    None
                end
            end
        end
        PatWildcard => None
        PatVariant(vname, subs) =>
            # NAM004（变体不存在）与字段类型传播是 8.2 范围外；只递归注入绑定（类型 Unknown）
            for sp in subs
                chk_pattern(sp, None, aenv, enums)
            end
            Some(vname)
        end
    end
end

# ============================================================================
# Part F：8.3 求值器 in Lom（RFC-0003 §8.3）
#   语义基准 = 宿主树遍历解释器（RFC-0002 定其"参考实现"地位）
#
# 值系统（对齐宿主 Value 11 变体）：
#   VInt/VFloat/VBool/VStr/VUnit/VEnum/VRecord/VTuple/VList/VMap/VCl
#   VList 直接存宿主 List（宿主 cons 链即自举载体——透传决策，见 Part G 头注）
#   VMap 直接存宿主 Map（引用语义原样继承——map_set 就地改、别名共享）
#   VCl 闭包 {ps: 参数名, body: Blk, env: Env}
#
# 环境（对齐宿主 Scope 链）：
#   Env = EnvOf({vars: Map<String,Val>, par: Option<Env>})
#   Map 引用语义保证闭包捕获后仍可见后续突变（对齐宿主 Rc 共享作用域）
#   lookup 沿链查；define 只写当前层；set_existing 沿链找到并就地改（Assign 语义）
#   块/for 每轮/match 臂 = 新子作用域（宿主同款）
#
# 错误通道（镜像宿主 RuntimeError）：
#   Result<Val, E2>，E2 = EMsg(String) | ERet(Val)
#   ERet 由 ? 自动传播到函数调用边界解包（对齐宿主 Err(EarlyReturn) 传播路径）
#
# Form A/B 纪律（本部分开发中踩坑的沉淀）：
#   - Form A = 臂体首 token 与 => 同行；=> 行尾 + 次行表达式 = Form B（需要 end）
#   - Form B 臂块内嵌套 match 作尾表达式时的 end 错位：每层 Form B 臂块 + 尾 match
#     组合按"match end + 臂块 end"两个 end 计，fn 层用 --check 收敛兜底
# ============================================================================

enum Val
    | VInt(Int)
    | VFloat(Float)
    | VBool(Bool)
    | VStr(String)
    | VUnit
    | VEnum(String, List<Val>)
    | VRecord(List<(String, Val)>)
    | VTuple(List<Val>)
    | VList(List<Val>)
    | VMap(Map<String, Val>)
    | VCl(List<String>, Blk, Env)
end

enum Env
    | EnvOf({vars: Map<String, Val>, par: Option<Env>})
end

enum E2
    | EMsg(String)
    | ERet(Val)
end

# 具名函数表条目（collect 后不可变）
enum FnD
    | FnD(List<String>, Blk)
end

# ---- 环境操作 ----

fn mk_env(par: Option<Env>) -> Env
    EnvOf({vars: map_empty(), par: par})
end

fn env_lookup(env: Env, name: String) -> Option<Val>
    match env
        EnvOf(rec) =>
            match map_get(rec.vars, name)
                Some(v) => Some(v)
                None =>
                    match rec.par
                        Some(p) => env_lookup(p, name)
                        None => None
                    end
                end
            end
        end
    end
end

fn env_define(env: Env, name: String, v: Val) -> Unit
    match env
        EnvOf(rec) => map_set(rec.vars, name, v)
    end
end

# Assign 语义：沿链找到持有该名的层就地改（宿主 set_existing）
fn env_set_existing(env: Env, name: String, v: Val) -> Bool
    match env
        EnvOf(rec) =>
            if map_has(rec.vars, name)
                map_set(rec.vars, name, v)
                True
            else
                match rec.par
                    Some(p) => env_set_existing(p, name, v)
                    None => False
                end
            end
        end
    end
end

# ---- 显示（宿主 to_display 对齐）----

fn vdisplay(v: Val) -> String
    match v
        VInt(n) => int_to_string(n)
        VFloat(f) => "" + f
        VBool(b) =>
            if b
                "true"
            else
                "false"
            end
        end
        VStr(s) => s
        VUnit => "()"
        VEnum(vname, args) =>
            if list_length(args) == 0
                vname
            else
                vname + "(" + join_str(vdisplay_list(args), ", ") + ")"
            end
        end
        VRecord(fields) => "{" + join_str(vdisp_fields(fields), ", ") + "}"
        VTuple(elems) =>
            let parts = vdisplay_list(elems)
            if list_length(elems) == 1
                "(" + join_str(parts, ", ") + ",)"
            else
                "(" + join_str(parts, ", ") + ")"
            end
        end
        VList(l) => "[" + join_str(vdisplay_list(l), ", ") + "]"
        VMap(m) => "{" + join_str(vdisp_map(m, map_keys(m)), ", ") + "}"
        VCl(_, _, _) => "<闭包>"
    end
end

fn vdisplay_list(xs: List<Val>) -> List<String>
    let mut acc = list_empty()
    for x in xs
        acc = list_cons(vdisplay(x), acc)
    end
    rev_str(acc)
end

fn vdisp_fields(fields: List<(String, Val)>) -> List<String>
    let mut acc = list_empty()
    for f in fields
        acc = list_cons(f.0 + ": " + vdisplay(f.1), acc)
    end
    rev_str(acc)
end

# 宿主：keys 排序后逐键 "k: v"
fn vdisp_map(m: Map<String, Val>, keys: List<String>) -> List<String>
    let mut acc = list_empty()
    for k in keys
        match map_get(m, k)
            Some(v) =>
                acc = list_cons(k + ": " + vdisplay(v), acc)
            end
            None => ()
        end
    end
    rev_str(acc)
end

fn vtype_name(v: Val) -> String
    match v
        VInt(_) => "Int"
        VFloat(_) => "Float"
        VBool(_) => "Bool"
        VStr(_) => "String"
        VUnit => "Unit"
        VEnum(_, _) => "枚举变体"
        VRecord(_) => "记录"
        VTuple(_) => "元组"
        VList(_) => "List"
        VMap(_) => "Map"
        VCl(_, _, _) => "闭包"
    end
end

# 宿主 values_eq（结构递归；Record 字段集顺序不敏感；Map 键集+递归值）
fn veq(l: Val, r: Val) -> Bool
    match l
        VInt(a) =>
            match r
                VInt(b) => a == b
                _ => False
            end
        end
        VFloat(a) =>
            match r
                VFloat(b) => a == b
                _ => False
            end
        end
        VBool(a) =>
            match r
                VBool(b) => a == b
                _ => False
            end
        end
        VStr(a) =>
            match r
                VStr(b) => a == b
                _ => False
            end
        end
        VUnit =>
            match r
                VUnit => True
                _ => False
            end
        end
        VEnum(v1, a1) =>
            match r
                VEnum(v2, a2) =>
                    if v1 != v2 or list_length(a1) != list_length(a2)
                        False
                    else
                        veq_list(a1, a2)
                    end
                end
                _ => False
            end
        end
        VTuple(e1) =>
            match r
                VTuple(e2) =>
                    if list_length(e1) != list_length(e2)
                        False
                    else
                        veq_list(e1, e2)
                    end
                end
                _ => False
            end
        end
        VRecord(f1) =>
            match r
                VRecord(f2) =>
                    if list_length(f1) != list_length(f2)
                        False
                    else
                        veq_fields(f1, f2)
                    end
                end
                _ => False
            end
        end
        VList(a1) =>
            match r
                VList(a2) =>
                    if list_length(a1) != list_length(a2)
                        False
                    else
                        veq_list(a1, a2)
                    end
                end
                _ => False
            end
        end
        VMap(m1) =>
            match r
                VMap(m2) =>
                    if map_size(m1) != map_size(m2)
                        False
                    else
                        veq_map(m1, m2, map_keys(m1))
                    end
                end
                _ => False
            end
        end
        VCl(_, _, _) => False
    end
end

fn veq_list(a: List<Val>, b: List<Val>) -> Bool
    if list_is_empty(a)
        list_is_empty(b)
    else
        if list_is_empty(b)
            False
        else
            if veq(list_head(a), list_head(b))
                veq_list(list_tail(a), list_tail(b))
            else
                False
            end
        end
    end
end

fn veq_fields(f1: List<(String, Val)>, f2: List<(String, Val)>) -> Bool
    if list_is_empty(f1)
        True
    else
        let h = list_head(f1)
        let mut found = False
        for f in f2
            if f.0 == h.0 and veq(h.1, f.1)
                found = True
            end
        end
        if found
            veq_fields(list_tail(f1), f2)
        else
            False
        end
    end
end

fn veq_map(m1: Map<String, Val>, m2: Map<String, Val>, keys: List<String>) -> Bool
    if list_is_empty(keys)
        True
    else
        let k = list_head(keys)
        match map_get(m2, k)
            Some(v2) =>
                match map_get(m1, k)
                    Some(v1) =>
                        if veq(v1, v2)
                            veq_map(m1, m2, list_tail(keys))
                        else
                            False
                        end
                    end
                    None => False
                end
            end
            None => False
        end
    end
end

# ---- 具名函数收集（宿主 collect_functions：前向引用/互递归支持）----

fn collect_fns(prg: Prg, fns: Map<String, FnD>, variants: Map<String, Int>, nullaries: Map<String, Bool>, al: Map<String, String>) -> Unit
    match prg
        Prg(items) =>
            for it in items
                match it
                    ItFn(name, params, _, _, body, _, _) =>
                        let mut ps = list_empty()
                        for p in params
                            match p
                                Prm(pname, _) =>
                                    ps = list_cons(pname, ps)
                                end
                            end
                        end
                        map_set(fns, name, FnD(rev_str(ps), body))
                    end
                    ItEnum(_, _, vlist) =>
                        for v in vlist
                            match v
                                VarR(vname, fields) =>
                                    map_set(variants, vname, list_length(fields))
                                    if list_length(fields) == 0
                                        map_set(nullaries, vname, True)
                                    end
                                end
                            end
                        end
                    end
                    ItImport(_, imp_items) =>
                        for i in imp_items
                            match i
                                ImpI(iname, alias) =>
                                    map_set(al, alias, iname)
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end

# ---- 求值器主体（ev_ 前缀；对齐宿主 eval_expr / exec_stmt / exec_block）----
# 所有求值返回 Result<Val, E2>；ERet 由 ? 自动传播到调用边界（镜像宿主 EarlyReturn）

fn ev(e: Ex, env: Env, fns: Map<String, FnD>, variants: Map<String, Int>, nullaries: Map<String, Bool>, globals: Env, al: Map<String, String>) -> Result<Val, E2> ! [IO]
    match e
        ExInt(n) => Ok(VInt(n))
        ExFloat(s) => float_from_parts(s)
        ExBool(b) => Ok(VBool(b))
        ExStr(s) => Ok(VStr(s))
        ExUnit => Ok(VUnit)
        ExIdent(name, _, _) =>
            match env_lookup(env, name)
                Some(v) => Ok(v)
                None =>
                    if map_has(nullaries, name)
                        Ok(VEnum(name, list_empty()))
                    elif map_has(fns, name)
                        match map_get(fns, name)
                            Some(fd) =>
                                match fd
                                    FnD(ps, body) => Ok(VCl(ps, body, globals))
                                end
                            end
                            None => Err(EMsg("内部错误"))
                        end
                    else
                        Err(EMsg("未定义变量: '" + name + "'"))
                    end
                end
            end
        end
        ExBinary(op, l, r) =>
            let lv = ev(l, env, fns, variants, nullaries, globals, al)?
            let rv = ev(r, env, fns, variants, nullaries, globals, al)?
            ev_binary(op, lv, rv)
        end
        ExUnary(op, inner) =>
            let v = ev(inner, env, fns, variants, nullaries, globals, al)?
            if op == "Not"
                match v
                    VBool(b) => Ok(VBool(b == False))
                    _ => Err(EMsg("! 不支持 " + vtype_name(v)))
                end
            else
                match v
                    VInt(n) => Ok(VInt(0 - n))
                    VFloat(f) => Ok(VFloat(0.0 - f))
                    _ => Err(EMsg("负号不支持 " + vtype_name(v)))
                end
            end
        end
        ExLogical(op, l, r) =>
            let lv = ev(l, env, fns, variants, nullaries, globals, al)?
            let lt = truthy(lv)?
            if op == "And"
                if lt == False
                    Ok(VBool(False))
                else
                    let rv = ev(r, env, fns, variants, nullaries, globals, al)?
                    Ok(VBool(truthy(rv)?))
                end
            else
                if lt
                    Ok(VBool(True))
                else
                    let rv = ev(r, env, fns, variants, nullaries, globals, al)?
                    Ok(VBool(truthy(rv)?))
                end
            end
        end
        ExCall(callee, args) =>
            let mut avals = list_empty()
            for a in args
                avals = list_cons(ev(a, env, fns, variants, nullaries, globals, al)?, avals)
            end
            ev_call(callee, rev_val(avals), env, fns, variants, nullaries, globals, al)
        end
        ExIndex(_, _) => Err(EMsg("索引操作 Phase 2.1.4 未实现（元组用 .0 .1 访问）"))
        ExField(x, name) =>
            let v = ev(x, env, fns, variants, nullaries, globals, al)?
            match v
                VRecord(fields) =>
                    let mut found = None
                    for f in fields
                        if f.0 == name and found == None
                            found = Some(f.1)
                        end
                    end
                    match found
                        Some(fv) => Ok(fv)
                        None => Err(EMsg("记录没有字段 '" + name + "'"))
                    end
                end
                VTuple(elems) =>
                    match try_sti(name)
                        Some(idx) =>
                            if idx >= 0 and idx < list_length(elems)
                                Ok(list_get(elems, idx))
                            else
                                Err(EMsg("元组索引 " + int_to_string(idx) + " 越界（长度 " + int_to_string(list_length(elems)) + "）"))
                            end
                        end
                        None => Err(EMsg("元组索引必须是数字，得到 '" + name + "'"))
                    end
                end
                _ => Err(EMsg("不能对 " + vtype_name(v) + " 使用字段访问 '." + name + "'"))
            end
        end
        ExGroup(inner) => ev(inner, env, fns, variants, nullaries, globals, al)
        ExIf(ifr) =>
            match ifr
                IfR(branches, els) =>
                    let mut result = Ok(VUnit)
                    let mut go = True
                    for br in branches
                        if go
                            let c = ev(br.0, env, fns, variants, nullaries, globals, al)?
                            if truthy(c)?
                                let benv = mk_env(Some(env))
                                result = ex_blk(br.1, benv, fns, variants, nullaries, globals, al)
                                go = False
                            end
                        end
                    end
                    if go
                        match els
                            Some(b) =>
                                let benv = mk_env(Some(env))
                                result = ex_blk(b, benv, fns, variants, nullaries, globals, al)
                            end
                            None => ()
                        end
                    end
                    result
                end
            end
        end
        ExClosure(params, _, body) =>
            let mut ps = list_empty()
            for p in params
                match p
                    Prm(pname, _) =>
                        ps = list_cons(pname, ps)
                    end
                end
            end
            Ok(VCl(rev_str(ps), body, env))
        end
        ExMatch(scrut, arms, _) => ev_match2(scrut, arms, env, fns, variants, nullaries, globals, al)
        ExTry(inner) =>
            let v = ev(inner, env, fns, variants, nullaries, globals, al)?
            match v
                VEnum(vname, args) =>
                    if vname == "Ok" and list_length(args) == 1
                        Ok(list_get(args, 0))
                    elif vname == "Some" and list_length(args) == 1
                        Ok(list_get(args, 0))
                    elif (vname == "Err" and list_length(args) == 1) or (vname == "None" and list_length(args) == 0)
                        Err(ERet(v))
                    else
                        Err(EMsg("`?` 只能用于 Result/Option，得到 " + vdisplay(v)))
                    end
                end
                _ => Err(EMsg("`?` 只能用于 Result/Option，得到 " + vdisplay(v)))
            end
        end
        ExPipe(left, right) =>
            let lv = ev(left, env, fns, variants, nullaries, globals, al)?
            match right
                ExCall(rc, rargs) =>
                    let mut avals = list_cons(lv, list_empty())
                    for a in rargs
                        avals = list_cons(ev(a, env, fns, variants, nullaries, globals, al)?, avals)
                    end
                    ev_call(rc, rev_val(avals), env, fns, variants, nullaries, globals, al)
                end
                _ => ev_call(right, list_cons(lv, list_empty()), env, fns, variants, nullaries, globals, al)
            end
        end
        ExRange(a, b) =>
            let av = ev(a, env, fns, variants, nullaries, globals, al)?
            let bv = ev(b, env, fns, variants, nullaries, globals, al)?
            match av
                VInt(s2) =>
                    match bv
                        VInt(e2) =>
                            let mut acc = list_empty()
                            let mut i = e2 - 1
                            while i >= s2
                                acc = list_cons(VInt(i), acc)
                                i -= 1
                            end
                            Ok(VList(acc))
                        end
                        _ => Err(EMsg("range 端点必须是 Int，得到 " + vtype_name(bv)))
                    end
                end
                _ => Err(EMsg("range 端点必须是 Int，得到 " + vtype_name(av)))
            end
        end
        ExRecord(fields) =>
            let mut acc = list_empty()
            for f in fields
                let fv = ev(f.1, env, fns, variants, nullaries, globals, al)?
                acc = list_cons((f.0, fv), acc)
            end
            Ok(VRecord(rev_pair2(acc)))
        end
        ExTuple(elems) =>
            let mut acc = list_empty()
            for x in elems
                acc = list_cons(ev(x, env, fns, variants, nullaries, globals, al)?, acc)
            end
            Ok(VTuple(rev_val(acc)))
        end
    end
end

# truthy（宿主 is_truthy：非 Bool 即错）
fn truthy(v: Val) -> Result<Bool, E2>
    match v
        VBool(b) => Ok(b)
        _ => Err(EMsg("期望 Bool，得到 " + vtype_name(v)))
    end
end

fn rev_val(xs: List<Val>) -> List<Val>
    let mut acc = list_empty()
    let mut cur = xs
    while !list_is_empty(cur)
        acc = list_cons(list_head(cur), acc)
        cur = list_tail(cur)
    end
    acc
end

fn rev_pair2(xs: List<(String, Val)>) -> List<(String, Val)>
    let mut acc = list_empty()
    let mut cur = xs
    while !list_is_empty(cur)
        acc = list_cons(list_head(cur), acc)
        cur = list_tail(cur)
    end
    acc
end

# Float 字面量还原：ip + fp/10^len(fp)（验收集字面量位级一致，前提由钉子测试覆盖）
fn float_from_parts(lit: String) -> Result<Val, E2>
    let parts = split(lit, ".")
    let ip = list_get(parts, 0)
    # 无小数点形态（"2"——TkFloat 规范化去掉 .0 的整数浮点）
    if list_length(parts) == 1
        match try_sti(ip)
            Some(iv) => Ok(VFloat(iv * 1.0))
            None => Err(EMsg("无效浮点数: " + lit))
        end
    else
        let fp = list_get(parts, 1)
        match try_sti(ip)
            Some(iv) =>
                match try_sti(fp)
                    Some(fv) =>
                        # 位级精确：单次 IEEE 除法（正确舍入）== Rust parse 的正确舍入
                        let mut scale = 1
                        let fl = len(fp)
                        let mut i = 0
                        while i < fl
                            scale = scale * 10
                            i += 1
                        end
                        let numer = (iv * scale + fv) * 1.0
                        let denom = scale * 1.0
                        Ok(VFloat(numer / denom))
                    end
                    None => Err(EMsg("无效浮点数: " + lit))
                end
            end
            None => Err(EMsg("无效浮点数: " + lit))
        end
    end
end

# 二元运算（宿主 eval_binary 全语义）
fn ev_binary(op: String, l: Val, r: Val) -> Result<Val, E2>
    if op == "Add"
        match l
            VStr(a) =>
                match r
                    VStr(b) => Ok(VStr(a + b))
                    _ => Ok(VStr(a + vdisplay(r)))
                end
            end
            _ =>
                match r
                    VStr(b) => Ok(VStr(vdisplay(l) + b))
                    _ => ev_arith(op, l, r)
                end
            end
        end
    elif op == "Eq"
        Ok(VBool(veq(l, r)))
    elif op == "NotEq"
        Ok(VBool(veq(l, r) == False))
    elif op == "Lt" or op == "Gt" or op == "LtEq" or op == "GtEq"
        ev_compare(op, l, r)
    else
        ev_arith(op, l, r)
    end
end

fn ev_arith(op: String, l: Val, r: Val) -> Result<Val, E2>
    match l
        VInt(a) =>
            match r
                VInt(b) =>
                    if op == "Add"
                        Ok(VInt(a + b))
                    elif op == "Sub"
                        Ok(VInt(a - b))
                    elif op == "Mul"
                        Ok(VInt(a * b))
                    elif op == "Div"
                        if b == 0
                            Err(EMsg("整数除以零"))
                        else
                            Ok(VInt(a / b))
                        end
                    else
                        if b == 0
                            Err(EMsg("整数取模零"))
                        else
                            Ok(VInt(a % b))
                        end
                    end
                end
                VFloat(b) => ev_arith_f(op, a * 1.0, b)
                _ => Err(EMsg("运算 " + op + " 不支持 " + vtype_name(l) + " 和 " + vtype_name(r)))
            end
        end
        VFloat(a) =>
            match r
                VFloat(b) => ev_arith_f(op, a, b)
                VInt(b) => ev_arith_f(op, a, b * 1.0)
                _ => Err(EMsg("运算 " + op + " 不支持 " + vtype_name(l) + " 和 " + vtype_name(r)))
            end
        end
        _ => Err(EMsg("运算 " + op + " 不支持 " + vtype_name(l) + " 和 " + vtype_name(r)))
    end
end

fn ev_arith_f(op: String, a: Float, b: Float) -> Result<Val, E2>
    if op == "Add"
        Ok(VFloat(a + b))
    elif op == "Sub"
        Ok(VFloat(a - b))
    elif op == "Mul"
        Ok(VFloat(a * b))
    elif op == "Div"
        Ok(VFloat(a / b))
    else
        Ok(VFloat(a % b))
    end
end

fn ev_compare(op: String, l: Val, r: Val) -> Result<Val, E2>
    let cmp =
    match l
        VInt(a) =>
            match r
                VInt(b) =>
                    if a < b
                        0 - 1
                    elif a > b
                        1
                    else
                        0
                    end
                end
                _ => 0 - 2
            end
        end
        VStr(a) =>
            match r
                VStr(b) => str_cmp2(a, b)
                _ => 0 - 2
            end
        end
        VBool(a) =>
            match r
                VBool(b) =>
                    if a == b
                        0
                    elif a == False
                        0 - 1
                    else
                        1
                    end
                end
                _ => 0 - 2
            end
        end
        VFloat(a) =>
            match r
                VFloat(b) =>
                    if a < b
                        0 - 1
                    elif a > b
                        1
                    else
                        0
                    end
                end
                _ => 0 - 2
            end
        end
        _ => 0 - 2
    end
    if cmp == 0 - 2
        Err(EMsg("比较 " + op + " 不支持 " + vtype_name(l) + " 和 " + vtype_name(r)))
    else
        if op == "Lt"
            Ok(VBool(cmp < 0))
        elif op == "Gt"
            Ok(VBool(cmp > 0))
        elif op == "LtEq"
            Ok(VBool(cmp <= 0))
        else
            Ok(VBool(cmp >= 0))
        end
    end
end

fn str_cmp2(a: String, b: String) -> Int
    if a == b
        0
    elif a < b
        0 - 1
    else
        1
    end
end

# 调用分派（宿主 eval_call：变体构造 → 内建 → 用户函数 → 闭包变量 → 未定义）
fn ev_call(callee: Ex, avals: List<Val>, env: Env, fns: Map<String, FnD>, variants: Map<String, Int>, nullaries: Map<String, Bool>, globals: Env, al: Map<String, String>) -> Result<Val, E2> ! [IO]
    match callee
        ExIdent(name, _, _) =>
            let rname =
            if map_has(al, name)
                match map_get(al, name)
                    Some(r2) => r2
                    None => name
                end
            else
                name
            end
            if map_has(variants, name) and env_lookup(env, name) == None
                Ok(VEnum(name, avals))
            elif list_contains_str(bltins_list(), rname)
                bltin(rname, avals, fns, variants, nullaries, globals, al)
            elif map_has(fns, rname)
                match map_get(fns, name)
                    Some(fd) =>
                        match fd
                            FnD(ps, body) => call_cl(ps, body, globals, avals, name, fns, variants, nullaries, globals, al)
                        end
                    end
                    None => Err(EMsg("内部错误"))
                end
            elif env_lookup(env, name) != None
                match env_lookup(env, name)
                    Some(v) =>
                        match v
                            VCl(ps, body, cenv) => call_cl(ps, body, cenv, avals, "<闭包>", fns, variants, nullaries, globals, al)
                            _ => Err(EMsg("未定义函数: '" + name + "'"))
                        end
                    end
                    None => Err(EMsg("未定义函数: '" + name + "'"))
                end
            else
                Err(EMsg("未定义函数: '" + name + "'"))
            end
        end
        _ =>
            let c = ev(callee, env, fns, variants, nullaries, globals, al)?
            match c
                VCl(ps, body, cenv) => call_cl(ps, body, cenv, avals, "<闭包>", fns, variants, nullaries, globals, al)
                _ => Err(EMsg("未定义函数: '<expr>'"))
            end
        end
    end
end

# 闭包/函数调用（宿主 call_closure + call_function 的 ERet 解包）
fn call_cl(ps: List<String>, body: Blk, cenv: Env, avals: List<Val>, name: String, fns: Map<String, FnD>, variants: Map<String, Int>, nullaries: Map<String, Bool>, globals: Env, al: Map<String, String>) -> Result<Val, E2> ! [IO]
    if list_length(ps) != list_length(avals)
        Err(EMsg("函数 '" + name + "' 期望 " + int_to_string(list_length(ps)) + " 个参数，得到 " + int_to_string(list_length(avals)) + " 个"))
    else
        let env = mk_env(Some(cenv))
        let mut curp = ps
        let mut cura = avals
        while !list_is_empty(curp)
            env_define(env, list_head(curp), list_head(cura))
            curp = list_tail(curp)
            cura = list_tail(cura)
        end
        match ex_blk(body, env, fns, variants, nullaries, globals, al)
            Ok(v) => Ok(v)
            Err(ERet(v)) => Ok(v)
            Err(e) => Err(e)
        end
    end
end

# match 求值（宿主 ExprKind::Match：臂独立作用域 + guard 穿透 + 无匹配报错）
fn ev_match2(scrut: Ex, arms: List<ArmR>, env: Env, fns: Map<String, FnD>, variants: Map<String, Int>, nullaries: Map<String, Bool>, globals: Env, al: Map<String, String>) -> Result<Val, E2> ! [IO]
    let sv = ev(scrut, env, fns, variants, nullaries, globals, al)?
    let mut cur = arms
    let mut go = True
    let mut result = Err(EMsg("match 无匹配分支（值: " + vdisplay(sv) + "）"))
    while go and !list_is_empty(cur)
        let arm = list_head(cur)
        match arm
            ArmR(pat, guard, body) =>
                let aenv = mk_env(Some(env))
                match m_pattern(pat, sv, aenv, nullaries)
                    True =>
                        let mut arm_ok = True
                        match guard
                            Some(g) =>
                                let gv = ev(g, aenv, fns, variants, nullaries, globals, al)?
                                if truthy(gv)? == False
                                    arm_ok = False
                                end
                            end
                            None => ()
                        end
                        if arm_ok
                            result =
                            match body
                                ABExpr(e2) => ev(e2, aenv, fns, variants, nullaries, globals, al)
                                ABBlock(b) => ex_blk(b, aenv, fns, variants, nullaries, globals, al)
                            end
                            go = False
                        end
                    end
                    False => ()
                end
            end
        end
        cur = list_tail(cur)
    end
    result
end

# 模式匹配（宿主 match_pattern：Binder 对内建无参变体按变体匹配，用户无参变体按绑定）
fn m_pattern(p: Pat, v: Val, env: Env, nullaries: Map<String, Bool>) -> Bool
    match p
        PatWildcard => True
        PatBinder(name) =>
            if map_has(nullaries, name)
                match v
                    VEnum(vname, args) => vname == name and list_length(args) == 0
                    _ => False
                end
            else
                env_define(env, name, v)
                True
            end
        end
        PatLit(lit) =>
            match lit
                ExInt(n) => veq(VInt(n), v)
                ExFloat(s) =>
                    match float_from_parts(s)
                        Ok(fv) => veq(fv, v)
                        Err(_) => False
                    end
                end
                ExBool(b) => veq(VBool(b), v)
                ExStr(s) => veq(VStr(s), v)
                _ => False
            end
        end
        PatVariant(name, subs) =>
            match v
                VEnum(vname, args) =>
                    if vname != name
                        False
                    elif list_length(args) != list_length(subs)
                        False
                    else
                        m_pattern_subs(subs, args, env, nullaries)
                    end
                end
                _ => False
            end
        end
    end
end

fn m_pattern_subs(subs: List<Pat>, args: List<Val>, env: Env, nullaries: Map<String, Bool>) -> Bool
    if list_is_empty(subs)
        list_is_empty(args)
    else
        if list_is_empty(args)
            False
        else
            if m_pattern(list_head(subs), list_head(args), env, nullaries)
                m_pattern_subs(list_tail(subs), list_tail(args), env, nullaries)
            else
                False
            end
        end
    end
end

# ---- 语句与块 ----

fn ex_blk(b: Blk, env: Env, fns: Map<String, FnD>, variants: Map<String, Int>, nullaries: Map<String, Bool>, globals: Env, al: Map<String, String>) -> Result<Val, E2> ! [IO]
    match b
        BlkOf(stmts, tail) =>
            for s in stmts
                ex_stmt(s, env, fns, variants, nullaries, globals, al)?
            end
            match tail
                Some(t) => ev(t, env, fns, variants, nullaries, globals, al)
                None => Ok(VUnit)
            end
        end
    end
end

fn ex_stmt(s: St, env: Env, fns: Map<String, FnD>, variants: Map<String, Int>, nullaries: Map<String, Bool>, globals: Env, al: Map<String, String>) -> Result<Val, E2> ! [IO]
    match s
        StLet(_, name, _, value) =>
            let v = ev(value, env, fns, variants, nullaries, globals, al)?
            env_define(env, name, v)
            Ok(VUnit)
        end
        StDestruct(names, value) =>
            let v = ev(value, env, fns, variants, nullaries, globals, al)?
            match v
                VTuple(elems) =>
                    if list_length(elems) != list_length(names)
                        Err(EMsg("解构数量不匹配：模式含 " + int_to_string(list_length(names)) + " 个名字，值含 " + int_to_string(list_length(elems)) + " 个元素"))
                    else
                        let mut curn = names
                        let mut cure = elems
                        while !list_is_empty(curn)
                            env_define(env, list_head(curn), list_head(cure))
                            curn = list_tail(curn)
                            cure = list_tail(cure)
                        end
                        Ok(VUnit)
                    end
                end
                _ => Err(EMsg("解构期望元组，得到 " + vtype_name(v)))
            end
        end
        StAssign(name, _, _, value) =>
            let v = ev(value, env, fns, variants, nullaries, globals, al)?
            if env_set_existing(env, name, v)
                Ok(VUnit)
            else
                Err(EMsg("赋值给未定义变量: '" + name + "'"))
            end
        end
        StIf(ifr) =>
            match ifr
                IfR(branches, els) =>
                    let mut result = Ok(VUnit)
                    let mut go = True
                    for br in branches
                        if go
                            let c = ev(br.0, env, fns, variants, nullaries, globals, al)?
                            if truthy(c)?
                                let benv = mk_env(Some(env))
                                result = ex_blk(br.1, benv, fns, variants, nullaries, globals, al)
                                go = False
                            end
                        end
                    end
                    if go
                        match els
                            Some(b) =>
                                let benv = mk_env(Some(env))
                                result = ex_blk(b, benv, fns, variants, nullaries, globals, al)
                            end
                            None => ()
                        end
                    end
                    result
                end
            end
        end
        StWhile(cond, body) =>
            let mut go = True
            while go
                let c = ev(cond, env, fns, variants, nullaries, globals, al)?
                if truthy(c)?
                    let benv = mk_env(Some(env))
                    ex_blk(body, benv, fns, variants, nullaries, globals, al)?
                else
                    go = False
                end
            end
            Ok(VUnit)
        end
        StFor(var, iter, body) =>
            let iv = ev(iter, env, fns, variants, nullaries, globals, al)?
            match iv
                VStr(s2) =>
                    for ch in split(s2, "")
                        let benv = mk_env(Some(env))
                        env_define(benv, var, VStr(ch))
                        ex_blk(body, benv, fns, variants, nullaries, globals, al)?
                    end
                    Ok(VUnit)
                end
                VInt(n) =>
                    let mut i = 0
                    while i < n
                        let benv = mk_env(Some(env))
                        env_define(benv, var, VInt(i))
                        ex_blk(body, benv, fns, variants, nullaries, globals, al)?
                        i += 1
                    end
                    Ok(VUnit)
                end
                VList(l) =>
                    for elem in l
                        let benv = mk_env(Some(env))
                        env_define(benv, var, elem)
                        ex_blk(body, benv, fns, variants, nullaries, globals, al)?
                    end
                    Ok(VUnit)
                end
                _ => Err(EMsg("for 循环不支持迭代 " + vtype_name(iv)))
            end
        end
        StReturn(opt) =>
            match opt
                Some(e) =>
                    let v = ev(e, env, fns, variants, nullaries, globals, al)?
                    Err(ERet(v))
                end
                None => Err(ERet(VUnit))
            end
        end
        StExpr(e) => ev(e, env, fns, variants, nullaries, globals, al)
        StHole(l, c) =>
            Err(EMsg("代码洞 @" + int_to_string(l) + ":" + int_to_string(c) + "（源文件解析失败处，不可执行）"))
        end
    end
end

# ---- 内建分派（Part G）----
# bltins()：40 个透传/自实现 + json 双内建挂账（\uXXXX 需 char_from_code、透传需
# type_of——双冻结缺口，RFC-0003 修订记录挂账，8.3 验收集排除 json 程序）

fn bltins_list() -> List<String> ! [IO]
    let mut acc = list_empty()
    for n in split("println print len int_to_string string_to_int trim upper lower split contains replace starts_with ends_with sqrt abs min max list_empty list_length list_get list_is_empty list_head list_tail list_cons list_map list_filter list_fold map_empty map_set map_get map_has map_remove map_keys map_values map_size file_read file_write file_append file_exists args json_parse json_stringify", " ")
        acc = list_cons(n, acc)
    end
    rev_str(acc)
end

fn list_contains_str(xs: List<String>, x: String) -> Bool
    let mut cur = xs
    let mut found = False
    while !list_is_empty(cur) and found == False
        if list_head(cur) == x
            found = True
        else
            cur = list_tail(cur)
        end
    end
    found
end

# 参数解包辅助（类型错误消息对齐宿主内建实现）
fn vstr(v: Val, who: String) -> Result<String, E2>
    match v
        VStr(s) => Ok(s)
        _ => Err(EMsg(who + " 期望 String"))
    end
end

fn vint(v: Val, who: String) -> Result<Int, E2>
    match v
        VInt(n) => Ok(n)
        _ => Err(EMsg(who + " 期望 Int"))
    end
end

fn vlistv(v: Val, who: String) -> Result<List<Val>, E2>
    match v
        VList(l) => Ok(l)
        _ => Err(EMsg(who + " 期望 List"))
    end
end

fn vmapv(v: Val, who: String) -> Result<Map<String, Val>, E2>
    match v
        VMap(m) => Ok(m)
        _ => Err(EMsg(who + " 期望 Map"))
    end
end

fn want_arity(who: String, want: Int, args: List<Val>) -> Result<Unit, E2>
    if list_length(args) != want
        Err(EMsg(who + " 期望 " + int_to_string(want) + " 个参数，得到 " + int_to_string(list_length(args)) + " 个"))
    else
        Ok(())
    end
end

# 内建分派（宿主 call_builtin 语义）
fn bltin(name: String, args: List<Val>, fns: Map<String, FnD>, variants: Map<String, Int>, nullaries: Map<String, Bool>, globals: Env, al: Map<String, String>) -> Result<Val, E2> ! [IO]
    if name == "println"
        let _ = want_arity(name, 1, args)?
        println(vdisplay(list_get(args, 0)))
        Ok(VUnit)
    elif name == "print"
        let _ = want_arity(name, 1, args)?
        print(vdisplay(list_get(args, 0)))
        Ok(VUnit)
    elif name == "len"
        let _ = want_arity(name, 1, args)?
        match list_get(args, 0)
            VStr(s) => Ok(VInt(len(s)))
            _ => Err(EMsg("len 期望 String"))
        end
    elif name == "int_to_string"
        let _ = want_arity(name, 1, args)?
        match list_get(args, 0)
            VInt(n) => Ok(VStr("" + n))
            _ => Err(EMsg("int_to_string 期望 Int"))
        end
    elif name == "string_to_int"
        let _ = want_arity(name, 1, args)?
        match list_get(args, 0)
            VStr(s) =>
                match try_sti(s)
                    Some(n) => Ok(VInt(n))
                    None => Ok(VUnit)
                end
            end
            _ => Err(EMsg("string_to_int 期望 String"))
        end
    elif name == "trim"
        let _ = want_arity(name, 1, args)?
        Ok(VStr(trim(vstr(list_get(args, 0), name)?)))
    elif name == "upper"
        let _ = want_arity(name, 1, args)?
        Ok(VStr(upper(vstr(list_get(args, 0), name)?)))
    elif name == "lower"
        let _ = want_arity(name, 1, args)?
        Ok(VStr(lower(vstr(list_get(args, 0), name)?)))
    elif name == "split"
        let _ = want_arity(name, 2, args)?
        let s = vstr(list_get(args, 0), name)?
        let sep = vstr(list_get(args, 1), name)?
        let mut acc = list_empty()
        for piece in split(s, sep)
            acc = list_cons(VStr(piece), acc)
        end
        Ok(VList(rev_val(acc)))
    elif name == "contains"
        let _ = want_arity(name, 2, args)?
        Ok(VBool(contains(vstr(list_get(args, 0), name)?, vstr(list_get(args, 1), name)?)))
    elif name == "replace"
        let _ = want_arity(name, 3, args)?
        Ok(VStr(replace(vstr(list_get(args, 0), name)?, vstr(list_get(args, 1), name)?, vstr(list_get(args, 2), name)?)))
    elif name == "starts_with"
        let _ = want_arity(name, 2, args)?
        Ok(VBool(starts_with(vstr(list_get(args, 0), name)?, vstr(list_get(args, 1), name)?)))
    elif name == "ends_with"
        let _ = want_arity(name, 2, args)?
        Ok(VBool(ends_with(vstr(list_get(args, 0), name)?, vstr(list_get(args, 1), name)?)))
    elif name == "sqrt"
        let _ = want_arity(name, 1, args)?
        match list_get(args, 0)
            VFloat(f) => Ok(VFloat(sqrt(f)))
            VInt(n) => Ok(VFloat(sqrt(n * 1.0)))
            _ => Err(EMsg("sqrt 期望 Float"))
        end
    elif name == "abs"
        let _ = want_arity(name, 1, args)?
        match list_get(args, 0)
            VInt(n) =>
                if n < 0
                    Ok(VInt(0 - n))
                else
                    Ok(VInt(n))
                end
            end
            VFloat(f) =>
                if f < 0.0
                    Ok(VFloat(0.0 - f))
                else
                    Ok(VFloat(f))
                end
            end
            _ => Err(EMsg("abs 期望数值"))
        end
    elif name == "min" or name == "max"
        let _ = want_arity(name, 2, args)?
        let a = list_get(args, 0)
        let b = list_get(args, 1)
        let c = ev_compare_for_minmax(a, b)
        if name == "min"
            if c <= 0
                Ok(a)
            else
                Ok(b)
            end
        else
            if c >= 0
                Ok(a)
            else
                Ok(b)
            end
        end
    elif name == "list_empty"
        let _ = want_arity(name, 0, args)?
        Ok(VList(list_empty()))
    elif name == "list_length"
        let _ = want_arity(name, 1, args)?
        Ok(VInt(list_length(vlistv(list_get(args, 0), name)?)))
    elif name == "list_get"
        let _ = want_arity(name, 2, args)?
        let l = vlistv(list_get(args, 0), name)?
        let idx = vint(list_get(args, 1), name)?
        if idx < 0 or idx >= list_length(l)
            Err(EMsg("list_get 索引 " + int_to_string(idx) + " 越界（列表长度 " + int_to_string(list_length(l)) + "）"))
        else
            Ok(list_get(l, idx))
        end
    elif name == "list_is_empty"
        let _ = want_arity(name, 1, args)?
        Ok(VBool(list_is_empty(vlistv(list_get(args, 0), name)?)))
    elif name == "list_head"
        let _ = want_arity(name, 1, args)?
        match list_get(args, 0)
            VList(l) =>
                if list_is_empty(l)
                    Err(EMsg("list_head：空列表"))
                else
                    Ok(list_head(l))
                end
            end
            _ => Err(EMsg("list_head 期望 List"))
        end
    elif name == "list_tail"
        let _ = want_arity(name, 1, args)?
        match list_get(args, 0)
            VList(l) =>
                if list_is_empty(l)
                    Err(EMsg("list_tail：空列表"))
                else
                    Ok(VList(list_tail(l)))
                end
            end
            _ => Err(EMsg("list_tail 期望 List"))
        end
    elif name == "list_cons"
        let _ = want_arity(name, 2, args)?
        Ok(VList(list_cons(list_get(args, 0), vlistv(list_get(args, 1), name)?)))
    elif name == "list_map"
        let _ = want_arity(name, 2, args)?
        let f = list_get(args, 0)
        let l = vlistv(list_get(args, 1), name)?
        let mut acc = list_empty()
        for x in l
            acc = list_cons(call_val(f, list_cons(x, list_empty()), fns, variants, nullaries, globals, al)?, acc)
        end
        Ok(VList(rev_val(acc)))
    elif name == "list_filter"
        let _ = want_arity(name, 2, args)?
        let f = list_get(args, 0)
        let l = vlistv(list_get(args, 1), name)?
        let mut acc = list_empty()
        for x in l
            let keep = call_val(f, list_cons(x, list_empty()), fns, variants, nullaries, globals, al)?
            if truthy(keep)?
                acc = list_cons(x, acc)
            end
        end
        Ok(VList(rev_val(acc)))
    elif name == "list_fold"
        let _ = want_arity(name, 3, args)?
        let f = list_get(args, 0)
        let mut acc = list_get(args, 1)
        let l = vlistv(list_get(args, 2), name)?
        for x in l
            acc = call_val(f, list_cons(acc, list_cons(x, list_empty())), fns, variants, nullaries, globals, al)?
        end
        Ok(acc)
    elif name == "map_empty"
        let _ = want_arity(name, 0, args)?
        Ok(VMap(map_empty()))
    elif name == "map_set"
        let _ = want_arity(name, 3, args)?
        let m = vmapv(list_get(args, 0), name)?
        let k = vstr(list_get(args, 1), name)?
        map_set(m, k, list_get(args, 2))
        Ok(VUnit)
    elif name == "map_get"
        let _ = want_arity(name, 2, args)?
        let m = vmapv(list_get(args, 0), name)?
        let k = vstr(list_get(args, 1), name)?
        match map_get(m, k)
            Some(v) => Ok(VEnum("Some", list_cons(v, list_empty())))
            None => Ok(VEnum("None", list_empty()))
        end
    elif name == "map_has"
        let _ = want_arity(name, 2, args)?
        let m = vmapv(list_get(args, 0), name)?
        let k = vstr(list_get(args, 1), name)?
        Ok(VBool(map_has(m, k)))
    elif name == "map_remove"
        let _ = want_arity(name, 2, args)?
        let m = vmapv(list_get(args, 0), name)?
        let k = vstr(list_get(args, 1), name)?
        Ok(VBool(map_remove(m, k)))
    elif name == "map_keys"
        let _ = want_arity(name, 1, args)?
        let m = vmapv(list_get(args, 0), name)?
        let mut acc = list_empty()
        for k in map_keys(m)
            acc = list_cons(VStr(k), acc)
        end
        Ok(VList(rev_val(acc)))
    elif name == "map_values"
        let _ = want_arity(name, 1, args)?
        let m = vmapv(list_get(args, 0), name)?
        let mut acc = list_empty()
        for k in map_keys(m)
            match map_get(m, k)
                Some(v) =>
                    acc = list_cons(v, acc)
                end
                None => ()
            end
        end
        Ok(VList(rev_val(acc)))
    elif name == "map_size"
        let _ = want_arity(name, 1, args)?
        Ok(VInt(map_size(vmapv(list_get(args, 0), name)?)))
    elif name == "file_read"
        let _ = want_arity(name, 1, args)?
        Ok(VStr(file_read(vstr(list_get(args, 0), name)?)))
    elif name == "file_write"
        let _ = want_arity(name, 2, args)?
        file_write(vstr(list_get(args, 0), name)?, vstr(list_get(args, 1), name)?)
        Ok(VUnit)
    elif name == "file_append"
        let _ = want_arity(name, 2, args)?
        file_append(vstr(list_get(args, 0), name)?, vstr(list_get(args, 1), name)?)
        Ok(VUnit)
    elif name == "file_exists"
        let _ = want_arity(name, 1, args)?
        Ok(VBool(file_exists(vstr(list_get(args, 0), name)?)))
    elif name == "args"
        let _ = want_arity(name, 0, args)?
        let mut acc = list_empty()
        for a in args()
            acc = list_cons(VStr(a), acc)
        end
        Ok(VList(rev_val(acc)))
    elif name == "json_parse" or name == "json_stringify"
        Err(EMsg("内建 '" + name + "' 在自举解释器中挂账（RFC-0003 修订记录：\\uXXXX 转义需 char_from_code、透传需 type_of——双冻结缺口，待裁决）"))
    else
        Err(EMsg("未定义函数: '" + name + "'"))
    end
end

# 闭包值调用（list_map/filter/fold 的回调路径）
fn call_val(f: Val, avals: List<Val>, fns: Map<String, FnD>, variants: Map<String, Int>, nullaries: Map<String, Bool>, globals: Env, al: Map<String, String>) -> Result<Val, E2> ! [IO]
    match f
        VCl(ps, body, cenv) => call_cl(ps, body, cenv, avals, "<闭包>", fns, variants, nullaries, globals, al)
        _ => Err(EMsg("期望闭包，得到 " + vtype_name(f)))
    end
end

# min/max 的数值比较
fn ev_compare_for_minmax(a: Val, b: Val) -> Int
    match a
        VInt(x) =>
            match b
                VInt(y) =>
                    if x < y
                        0 - 1
                    elif x > y
                        1
                    else
                        0
                    end
                end
                VFloat(y) =>
                    let xf = x * 1.0
                    if xf < y
                        0 - 1
                    elif xf > y
                        1
                    else
                        0
                    end
                end
                _ => 0
            end
        end
        VFloat(x) =>
            match b
                VFloat(y) =>
                    if x < y
                        0 - 1
                    elif x > y
                        1
                    else
                        0
                    end
                end
                VInt(y) =>
                    let yf = y * 1.0
                    if x < yf
                        0 - 1
                    elif x > yf
                        1
                    else
                        0
                    end
                end
                _ => 0
            end
        end
        _ => 0
    end
end

# ---- run 入口（--run 模式）：收集 → 执行 main → 输出由 println 透传产生 ----

fn run_program(prg: Prg) -> Result<Val, E2> ! [IO]
    let fns = map_empty()
    let variants = map_empty()
    let nullaries = map_empty()
    let al = map_empty()
    collect_fns(prg, fns, variants, nullaries, al)
    # 内建变体（Ok/Err/Some/None）——宿主 BUILTIN_VARIANTS
    map_set(variants, "Ok", 1)
    map_set(variants, "Err", 1)
    map_set(variants, "Some", 1)
    map_set(variants, "None", 0)
    map_set(nullaries, "None", True)
    let globals = mk_env(None)
    match prg
        Prg(items) =>
            for it in items
                match it
                    ItFn(name, params, _, _, body, _, _) =>
                        if name == "main"
                            if list_length(params) == 0
                                return ex_blk(body, mk_env(Some(globals)), fns, variants, nullaries, globals, al)
                            else
                                return Err(EMsg("main 期望 0 个参数"))
                            end
                        end
                    end
                    _ => ()
                end
            end
        end
    end
    Ok(VUnit)
end
