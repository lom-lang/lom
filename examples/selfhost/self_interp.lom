# ============================================================================
# self_interp.lom — Lom 全量自举（RFC-0003，Phase 8）
#
# 当前阶段：8.1 完整前端 —— lexer + parser + AST dump（用 Lom 写的完整 Lom 前端）
# 后续阶段：8.2 静态检查 / 8.3 树遍历求值器 / 8.4 WASM 载体自证闭环
#
# 用法：
#   lom self_interp.lom -- <file>          # 解析 <file> 并打印 AST dump（对齐宿主 --dump-ast 格式）
#   lom self_interp.lom -- <file> --diags  # 只打印词法+语法诊断（行|列|消息，供与宿主 --json 对账）
#   lom self_interp.lom -- <file> --tokens # 打印 token 流（对齐宿主 --dump-tokens，lexer 对账）
#
# 契约（RFC-0003 §8.1，格式基准 = src/dump.rs 文件头注释）：
#   - dump 不含 span（宿主字节列 vs 本实现字符列在非 ASCII 行分叉，结构比对不需要位置；
#     验收集 = examples/*.lom + eval 113 参考解，除 todo.lom 字符串外全部纯 ASCII）
#   - Hole 节点照常输出（Hole @line:col）——本实现的 col 是 1-based 字符列
#   - Float dump = Rust Display 语义（整数值无 .0、最短形式）——本实现按"字面量规范化"
#     （去小数尾零 / .0 全零只留整数 / 整数部分去前导零）实现，前提由宿主侧测试钉住
#   - Str dump = Rust Debug 转义（\" \\ \n \r \t 转义，其余可打印字符原样）
#
# 实现说明（对照宿主 src/lexer.rs + src/parser.rs 的平移决策）：
#   - token 流存 Map<String 索引, {t, ln, cl}>（Map 引用语义 + O(1) 随机访问，
#     对齐宿主 Vec<SpannedToken> + pos 游标模型；list_get 是 O(n) 走查，不能用于 token 流）
#   - parser 的 pos / errors 也走 Map 引用语义跨函数共享（对齐宿主 &mut self）
#   - 主循环全部 while + 滑动窗口（list_head/list_tail O(1)），无逐字符递归——
#     45KB 级源文件在树遍历解释器 ~10^4 递归天花板下必须避免线性递归
#   - List 构建一律头插逆序 + 循环版 reverse（同因栈深）
#   - 位置：ln 从 1，cl 从 1（字符列；纯 ASCII 下与宿主字节列一致）
# ============================================================================

from string import { split, contains, len, string_to_int, int_to_string, starts_with }
from list import { list_empty, list_cons, list_head, list_tail, list_is_empty, list_length, list_get }
from map import { map_empty, map_set, map_get, map_has, map_size }
from file import { file_read, file_exists }
from env import { args }

# ============================================================================
# Part A：Token 定义（对齐宿主 src/lexer.rs Token 枚举，Tk 前缀避免变体名冲突）
# ============================================================================

enum Tok
    # 关键字（20 个，宿主保留字全表）
    | TkFn
    | TkLet
    | TkMut
    | TkIf
    | TkElif
    | TkElse
    | TkWhile
    | TkFor
    | TkIn
    | TkReturn
    | TkEnd
    | TkTrue
    | TkFalse
    | TkAnd
    | TkOr
    | TkFrom
    | TkImport
    | TkAs
    | TkMatch
    | TkEnum
    # 字面量（Float 存规范化文本——见文件头契约）
    | TkInt(Int)
    | TkFloat(String)
    | TkStr(String)
    | TkIdent(String)
    # 运算符
    | TkPlus
    | TkMinus
    | TkStar
    | TkSlash
    | TkPercent
    | TkPlusEq
    | TkMinusEq
    | TkStarEq
    | TkSlashEq
    | TkEq
    | TkNotEq
    | TkLt
    | TkGt
    | TkLtEq
    | TkGtEq
    | TkAssign
    | TkBang
    | TkQuestion
    | TkPipe
    | TkBar
    | TkArrow
    | TkFatArrow
    # 标点
    | TkLParen
    | TkRParen
    | TkLBrace
    | TkRBrace
    | TkLBracket
    | TkRBracket
    | TkComma
    | TkColon
    | TkDot
    | TkDotDot
    | TkSemi
    # 结束
    | TkEof
end

# ============================================================================
# Part B：字符串辅助 + 字面量规范化
# ============================================================================

# 前缀截取：s 的前 k 个字符（k 超长返回全串）
fn str_take(s: String, k: Int) -> String
    let mut out = ""
    let mut i = 0
    for c in split(s, "")
        if i < k
            out = out + c
        end
        i += 1
    end
    out
end

# 从右去 '0'（小数部分规范化用）
fn rstrip_zero(s: String) -> String
    let mut last_nz = -1
    let mut i = 0
    for c in split(s, "")
        if c != "0"
            last_nz = i
        end
        i += 1
    end
    if last_nz < 0
        ""
    else
        str_take(s, last_nz + 1)
    end
end

# 从左去 '0'（全零收敛为 "0"；整数部分规范化用）
fn lstrip_zero(s: String) -> String
    let mut out = ""
    let mut started = False
    for c in split(s, "")
        if started or c != "0"
            started = True
            out = out + c
        end
    end
    if len(out) == 0
        "0"
    else
        out
    end
end

# Float 字面量规范化（宿主 Rust Display 契约的验收集实现，见文件头）
#   "5.20" -> "5.2"；"2.0" -> "2"；"3.14" -> "3.14"；"0.50" -> "0.5"
fn norm_float(ip: String, fp: String) -> String
    let f2 = rstrip_zero(fp)
    let i2 = lstrip_zero(ip)
    if len(f2) == 0
        i2
    else
        i2 + "." + f2
    end
end

# 转义字符还原（宿主 lex_string 的 Some(c) => push(c as char) 泛化规则）
fn unesc(nc: String) -> String
    if nc == "n"
        "\n"
    elif nc == "t"
        "\t"
    elif nc == "r"
        "\r"
    elif nc == "\""
        "\""
    elif nc == "\\"
        "\\"
    else
        nc
    end
end

# 字符分类（纯 ASCII；宿主按字节判定，纯 ASCII 源下语义一致）
fn is_digit(c: String) -> Bool
    contains("0123456789", c)
end

fn is_alpha(c: String) -> Bool
    contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_", c)
end

fn is_alnum(c: String) -> Bool
    if is_alpha(c)
        True
    elif is_digit(c)
        True
    else
        False
    end
end

# 关键字识别（宿主 lex_ident 的 match 全表，20 个保留字）
fn keyword_or_ident(s: String) -> Tok
    if s == "fn"
        TkFn
    elif s == "let"
        TkLet
    elif s == "mut"
        TkMut
    elif s == "if"
        TkIf
    elif s == "elif"
        TkElif
    elif s == "else"
        TkElse
    elif s == "while"
        TkWhile
    elif s == "for"
        TkFor
    elif s == "in"
        TkIn
    elif s == "return"
        TkReturn
    elif s == "end"
        TkEnd
    elif s == "True"
        TkTrue
    elif s == "False"
        TkFalse
    elif s == "and"
        TkAnd
    elif s == "or"
        TkOr
    elif s == "from"
        TkFrom
    elif s == "import"
        TkImport
    elif s == "as"
        TkAs
    elif s == "match"
        TkMatch
    elif s == "enum"
        TkEnum
    else
        TkIdent(s)
    end
end

# ---- 循环版 reverse（各类型一份；线性递归版在万级 token 上会爆 ~10^4 栈深天花板）----

fn rev_tok(xs: List<{t: Tok, ln: Int, cl: Int}>) -> List<{t: Tok, ln: Int, cl: Int}>
    let mut acc = list_empty()
    let mut cur = xs
    while !list_is_empty(cur)
        acc = list_cons(list_head(cur), acc)
        cur = list_tail(cur)
    end
    acc
end

fn rev_err(xs: List<{code: String, msg: String, ln: Int, cl: Int}>) -> List<{code: String, msg: String, ln: Int, cl: Int}>
    let mut acc = list_empty()
    let mut cur = xs
    while !list_is_empty(cur)
        acc = list_cons(list_head(cur), acc)
        cur = list_tail(cur)
    end
    acc
end

fn rev_str(xs: List<String>) -> List<String>
    let mut acc = list_empty()
    let mut cur = xs
    while !list_is_empty(cur)
        acc = list_cons(list_head(cur), acc)
        cur = list_tail(cur)
    end
    acc
end

# ============================================================================
# Part B2：lexer 主循环（对齐宿主 Lexer::tokenize_recover 的容错语义）
#   产出 {toks: Map<索引, TokR>, n: Int, errs: List<ErrR>}；EOF 也入表（key = n-1）
#   错误对齐宿主：记录错误 + 回退跳 1 字节继续（意外字符 / 未闭合字符串 / 无效整数）
# ============================================================================

fn lex(src: String) -> {toks: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, errs: List<{code: String, msg: String, ln: Int, cl: Int}>}
    let chars = split(src, "")
    let mut rest = chars
    let mut ln = 1
    let mut cl = 1
    let mut acc = list_empty()
    let mut errs = list_empty()
    while !list_is_empty(rest)
        let c = list_head(rest)
        let ln0 = ln
        let cl0 = cl
        if c == " " or c == "\t" or c == "\r"
            rest = list_tail(rest)
            cl += 1
        elif c == "\n"
            rest = list_tail(rest)
            ln += 1
            cl = 1
        elif c == "#"
            # 注释：# 行注释 / #- 块注释 -#
            if !list_is_empty(list_tail(rest)) and list_head(list_tail(rest)) == "-"
                # 块注释：跳过 #- 后找 -#（未闭合静默结束，宿主语义）
                let mut r2 = list_tail(list_tail(rest))
                cl += 2
                let mut done = False
                while !list_is_empty(r2) and done == False
                    if !list_is_empty(list_tail(r2)) and list_head(r2) == "-" and list_head(list_tail(r2)) == "#"
                        r2 = list_tail(list_tail(r2))
                        cl += 2
                        done = True
                    else
                        if list_head(r2) == "\n"
                            ln += 1
                            cl = 1
                        else
                            cl += 1
                        end
                        r2 = list_tail(r2)
                    end
                end
                rest = r2
            else
                # 行注释：跳到换行前（换行留给主循环计数）
                let mut r2 = list_tail(rest)
                cl += 1
                let mut done = False
                while !list_is_empty(r2) and done == False
                    if list_head(r2) == "\n"
                        done = True
                    else
                        cl += 1
                        r2 = list_tail(r2)
                    end
                end
                rest = r2
            end
        elif is_digit(c)
            # 数字字面量（对齐宿主 lex_number：digit+ [ . digit+ ]）
            let mut ip = ""
            let mut r2 = rest
            while !list_is_empty(r2) and is_digit(list_head(r2))
                ip = ip + list_head(r2)
                r2 = list_tail(r2)
                cl += 1
            end
            # 浮点前瞻：'.' 后必须紧跟 digit（1..10 中 1 是 Int）
            if !list_is_empty(r2) and list_head(r2) == "."
                let r3 = list_tail(r2)
                if !list_is_empty(r3) and is_digit(list_head(r3))
                    let mut fp = ""
                    let mut r4 = r3
                    while !list_is_empty(r4) and is_digit(list_head(r4))
                        fp = fp + list_head(r4)
                        r4 = list_tail(r4)
                        cl += 1
                    end
                    cl += 1
                    acc = list_cons({t: TkFloat(norm_float(ip, fp)), ln: ln0, cl: cl0}, acc)
                    rest = r4
                else
                    match try_sti(ip)
                        Some(v) =>
                            acc = list_cons({t: TkInt(v), ln: ln0, cl: cl0}, acc)
                            rest = r2
                        end
                        None =>
                            errs = list_cons({msg: "无效整数: " + ip, ln: ln0, cl: cl0}, errs)
                            rest = list_tail(rest)
                            cl = cl0 + 1
                        end
                    end
                end
            else
                match try_sti(ip)
                    Some(v) =>
                        acc = list_cons({t: TkInt(v), ln: ln0, cl: cl0}, acc)
                        rest = r2
                    end
                    None =>
                        errs = list_cons({msg: "无效整数: " + ip, ln: ln0, cl: cl0}, errs)
                        rest = list_tail(rest)
                        cl = cl0 + 1
                    end
                end
            end
        elif c == "\""
            # 字符串字面量（对齐宿主 lex_string 的容错：未闭合 → 错误 + 回退跳 1 字节）
            let mut r2 = list_tail(rest)
            let mut s = ""
            let mut cl2 = cl + 1
            let mut ln2 = ln
            let mut closed = False
            let mut esc_eof = False
            while !list_is_empty(r2) and closed == False
                let ch = list_head(r2)
                if ch == "\""
                    r2 = list_tail(r2)
                    cl2 += 1
                    closed = True
                elif ch == "\\"
                    let r3 = list_tail(r2)
                    if list_is_empty(r3)
                        # \ 后 EOF：未闭合的字符串转义（宿主 LEX002）
                        esc_eof = True
                        r2 = list_empty()
                    else
                        s = s + unesc(list_head(r3))
                        r2 = list_tail(r3)
                        cl2 += 2
                    end
                else
                    s = s + ch
                    r2 = list_tail(r2)
                    if ch == "\n"
                        ln2 += 1
                        cl2 = 1
                    else
                        cl2 += 1
                    end
                end
            end
            if closed
                acc = list_cons({t: TkStr(s), ln: ln0, cl: cl0}, acc)
                rest = r2
                ln = ln2
                cl = cl2
            else
                # 未闭合：记录错误，回退跳过开头引号（宿主 saved_pos 回退 + advance 1）
                let unclosed_msg =
                if esc_eof
                    "未闭合的字符串转义"
                else
                    "未闭合的字符串"
                end
                errs = list_cons({msg: unclosed_msg, ln: ln0, cl: cl0}, errs)
                rest = list_tail(rest)
                cl += 1
            end
        elif is_alpha(c)
            # 标识符 / 关键字
            let mut word = ""
            let mut r2 = rest
            while !list_is_empty(r2) and is_alnum(list_head(r2))
                word = word + list_head(r2)
                r2 = list_tail(r2)
                cl += 1
            end
            acc = list_cons({t: keyword_or_ident(word), ln: ln0, cl: cl0}, acc)
            rest = r2
        elif c == "+"
            if !list_is_empty(list_tail(rest)) and list_head(list_tail(rest)) == "="
                acc = list_cons({t: TkPlusEq, ln: ln0, cl: cl0}, acc)
                rest = list_tail(list_tail(rest))
                cl += 2
            else
                acc = list_cons({t: TkPlus, ln: ln0, cl: cl0}, acc)
                rest = list_tail(rest)
                cl += 1
            end
        elif c == "-"
            if !list_is_empty(list_tail(rest)) and list_head(list_tail(rest)) == ">"
                acc = list_cons({t: TkArrow, ln: ln0, cl: cl0}, acc)
                rest = list_tail(list_tail(rest))
                cl += 2
            elif !list_is_empty(list_tail(rest)) and list_head(list_tail(rest)) == "="
                acc = list_cons({t: TkMinusEq, ln: ln0, cl: cl0}, acc)
                rest = list_tail(list_tail(rest))
                cl += 2
            else
                acc = list_cons({t: TkMinus, ln: ln0, cl: cl0}, acc)
                rest = list_tail(rest)
                cl += 1
            end
        elif c == "*"
            if !list_is_empty(list_tail(rest)) and list_head(list_tail(rest)) == "="
                acc = list_cons({t: TkStarEq, ln: ln0, cl: cl0}, acc)
                rest = list_tail(list_tail(rest))
                cl += 2
            else
                acc = list_cons({t: TkStar, ln: ln0, cl: cl0}, acc)
                rest = list_tail(rest)
                cl += 1
            end
        elif c == "/"
            if !list_is_empty(list_tail(rest)) and list_head(list_tail(rest)) == "="
                acc = list_cons({t: TkSlashEq, ln: ln0, cl: cl0}, acc)
                rest = list_tail(list_tail(rest))
                cl += 2
            else
                acc = list_cons({t: TkSlash, ln: ln0, cl: cl0}, acc)
                rest = list_tail(rest)
                cl += 1
            end
        elif c == "%"
            acc = list_cons({t: TkPercent, ln: ln0, cl: cl0}, acc)
            rest = list_tail(rest)
            cl += 1
        elif c == "!"
            if !list_is_empty(list_tail(rest)) and list_head(list_tail(rest)) == "="
                acc = list_cons({t: TkNotEq, ln: ln0, cl: cl0}, acc)
                rest = list_tail(list_tail(rest))
                cl += 2
            else
                acc = list_cons({t: TkBang, ln: ln0, cl: cl0}, acc)
                rest = list_tail(rest)
                cl += 1
            end
        elif c == "="
            if !list_is_empty(list_tail(rest)) and list_head(list_tail(rest)) == "="
                acc = list_cons({t: TkEq, ln: ln0, cl: cl0}, acc)
                rest = list_tail(list_tail(rest))
                cl += 2
            elif !list_is_empty(list_tail(rest)) and list_head(list_tail(rest)) == ">"
                acc = list_cons({t: TkFatArrow, ln: ln0, cl: cl0}, acc)
                rest = list_tail(list_tail(rest))
                cl += 2
            else
                acc = list_cons({t: TkAssign, ln: ln0, cl: cl0}, acc)
                rest = list_tail(rest)
                cl += 1
            end
        elif c == "<"
            if !list_is_empty(list_tail(rest)) and list_head(list_tail(rest)) == "="
                acc = list_cons({t: TkLtEq, ln: ln0, cl: cl0}, acc)
                rest = list_tail(list_tail(rest))
                cl += 2
            else
                acc = list_cons({t: TkLt, ln: ln0, cl: cl0}, acc)
                rest = list_tail(rest)
                cl += 1
            end
        elif c == ">"
            if !list_is_empty(list_tail(rest)) and list_head(list_tail(rest)) == "="
                acc = list_cons({t: TkGtEq, ln: ln0, cl: cl0}, acc)
                rest = list_tail(list_tail(rest))
                cl += 2
            else
                acc = list_cons({t: TkGt, ln: ln0, cl: cl0}, acc)
                rest = list_tail(rest)
                cl += 1
            end
        elif c == "|"
            if !list_is_empty(list_tail(rest)) and list_head(list_tail(rest)) == ">"
                acc = list_cons({t: TkPipe, ln: ln0, cl: cl0}, acc)
                rest = list_tail(list_tail(rest))
                cl += 2
            else
                acc = list_cons({t: TkBar, ln: ln0, cl: cl0}, acc)
                rest = list_tail(rest)
                cl += 1
            end
        elif c == "?"
            acc = list_cons({t: TkQuestion, ln: ln0, cl: cl0}, acc)
            rest = list_tail(rest)
            cl += 1
        elif c == "("
            acc = list_cons({t: TkLParen, ln: ln0, cl: cl0}, acc)
            rest = list_tail(rest)
            cl += 1
        elif c == "{"
            acc = list_cons({t: TkLBrace, ln: ln0, cl: cl0}, acc)
            rest = list_tail(rest)
            cl += 1
        elif c == ")"
            acc = list_cons({t: TkRParen, ln: ln0, cl: cl0}, acc)
            rest = list_tail(rest)
            cl += 1
        elif c == "}"
            acc = list_cons({t: TkRBrace, ln: ln0, cl: cl0}, acc)
            rest = list_tail(rest)
            cl += 1
        elif c == "["
            acc = list_cons({t: TkLBracket, ln: ln0, cl: cl0}, acc)
            rest = list_tail(rest)
            cl += 1
        elif c == "]"
            acc = list_cons({t: TkRBracket, ln: ln0, cl: cl0}, acc)
            rest = list_tail(rest)
            cl += 1
        elif c == ","
            acc = list_cons({t: TkComma, ln: ln0, cl: cl0}, acc)
            rest = list_tail(rest)
            cl += 1
        elif c == ":"
            acc = list_cons({t: TkColon, ln: ln0, cl: cl0}, acc)
            rest = list_tail(rest)
            cl += 1
        elif c == "."
            if !list_is_empty(list_tail(rest)) and list_head(list_tail(rest)) == "."
                acc = list_cons({t: TkDotDot, ln: ln0, cl: cl0}, acc)
                rest = list_tail(list_tail(rest))
                cl += 2
            else
                acc = list_cons({t: TkDot, ln: ln0, cl: cl0}, acc)
                rest = list_tail(rest)
                cl += 1
            end
        elif c == ";"
            acc = list_cons({t: TkSemi, ln: ln0, cl: cl0}, acc)
            rest = list_tail(rest)
            cl += 1
        else
            # 意外字符（宿主 LexError "意外字符 'x'"，tokenize_recover 跳过该字节）
            errs = list_cons({msg: "意外字符 '" + c + "'", ln: ln0, cl: cl0}, errs)
            rest = list_tail(rest)
            cl += 1
        end
    end
    # EOF token（宿主：is_at_end 时 push Eof，位置 = 结束时的 line/col）
    acc = list_cons({t: TkEof, ln: ln, cl: cl}, acc)
    # 逆序 → 正序 → Map 索引表
    let ordered = rev_tok(acc)
    let toks = map_empty()
    let mut i = 0
    for tk in ordered
        map_set(toks, int_to_string(i), tk)
        i += 1
    end
    {toks: toks, n: i, errs: rev_err(errs)}
end

# 整数字面量辅助：string_to_int 的返回约定是裸 Int（成功）或 Unit（失败）——
# 内建协议层 Ok(Some(Value)) 解包后用户拿到的不是 Option 枚举（与 map_get 不同）。
# 无 type_of 反射（RFC-0003 冻结），用拼接提升的 to_display 形态判定：Unit 显示为 "()"
fn try_sti(s: String) -> Option<Int>
    if "" + string_to_int(s) == "()"
        None
    else
        Some(string_to_int(s))
    end
end

# ============================================================================
# Part C：AST 定义（对齐宿主 src/ast.rs；span 不建模——dump 契约不含位置）
#   Blk/IfR/Prm/ArmR/ArmB/VarR/ImpI 用单变体 enum 包装（签名书写一个词，
#   且避开匿名记录类型在深层泛型参数里的书写负担）
# ============================================================================

enum Ty
    | TyInt
    | TyFloat
    | TyBool
    | TyString
    | TyUnit
    | TyNamed(String)
    | TyOption(Ty)
    | TResult(Ty, Ty)
    | TyGeneric(String, List<Ty>)
    | TyRecord(List<(String, Ty)>)
    | TyTuple(List<Ty>)
end

enum Blk
    | BlkOf(List<St>, Option<Ex>)
end

enum St
    | StLet(Bool, String, Option<Ty>, Ex)
    | StDestruct(List<String>, Ex)
    | StAssign(String, Ex)
    | StIf(IfR)
    | StWhile(Ex, Blk)
    | StFor(String, Ex, Blk)
    | StReturn(Option<Ex>)
    | StExpr(Ex)
    | StHole(Int, Int)
end

enum IfR
    | IfR(List<(Ex, Blk)>, Option<Blk>)
end

enum Ex
    | ExInt(Int)
    | ExFloat(String)
    | ExBool(Bool)
    | ExStr(String)
    | ExUnit
    | ExIdent(String)
    | ExBinary(String, Ex, Ex)
    | ExUnary(String, Ex)
    | ExLogical(String, Ex, Ex)
    | ExCall(Ex, List<Ex>)
    | ExIndex(Ex, Ex)
    | ExField(Ex, String)
    | ExGroup(Ex)
    | ExIf(IfR)
    | ExClosure(List<Prm>, Option<Ty>, Blk)
    | ExMatch(Ex, List<ArmR>)
    | ExTry(Ex)
    | ExPipe(Ex, Ex)
    | ExRange(Ex, Ex)
    | ExRecord(List<(String, Ex)>)
    | ExTuple(List<Ex>)
end

enum Prm
    | Prm(String, Ty)
end

enum ArmR
    | ArmR(Pat, Option<Ex>, ArmB)
end

enum ArmB
    | ABExpr(Ex)
    | ABBlock(Blk)
end

enum Pat
    | PatLit(Ex)
    | PatBinder(String)
    | PatWildcard
    | PatVariant(String, List<Pat>)
end

enum Itm
    | ItFn(String, List<Prm>, Option<Ty>, List<String>, Blk)
    | ItEnum(String, List<String>, List<VarR>)
    | ItImport(String, List<ImpI>)
end

enum VarR
    | VarR(String, List<Ty>)
end

enum ImpI
    | ImpI(String, String)
end

enum Prg
    | Prg(List<Itm>)
end

# 块元素（parse_block 循环体产出；对齐宿主 BlockEl）
enum Bel
    | BStmt(St)
    | BTail(Ex)
end

# ---- 各类型循环版 reverse（构建一律头插逆序）----

fn rev_itm(xs: List<Itm>) -> List<Itm>
    let mut acc = list_empty()
    let mut cur = xs
    while !list_is_empty(cur)
        acc = list_cons(list_head(cur), acc)
        cur = list_tail(cur)
    end
    acc
end

fn rev_st(xs: List<St>) -> List<St>
    let mut acc = list_empty()
    let mut cur = xs
    while !list_is_empty(cur)
        acc = list_cons(list_head(cur), acc)
        cur = list_tail(cur)
    end
    acc
end

fn rev_ex(xs: List<Ex>) -> List<Ex>
    let mut acc = list_empty()
    let mut cur = xs
    while !list_is_empty(cur)
        acc = list_cons(list_head(cur), acc)
        cur = list_tail(cur)
    end
    acc
end

fn rev_pat(xs: List<Pat>) -> List<Pat>
    let mut acc = list_empty()
    let mut cur = xs
    while !list_is_empty(cur)
        acc = list_cons(list_head(cur), acc)
        cur = list_tail(cur)
    end
    acc
end

