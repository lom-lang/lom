# ============================================================================
# self_comp.lom — L2 自举编译器（RFC-0004 方案 A，L2.3-c2 子集）
#
# 用途：把 Lom 子集程序编译为 .wasm（经纯 ASCII hex 文本落盘，宿主桩
#       tools/hex2wasm.py 转二进制——方案 A 通道，RFC-0004）。
# 用法：
#   lom self_comp.lom -- <input.lom> <output.hex>
#   成功打印 "COMPILED <n> bytes -> <path>"；失败打印诊断 + "COMPILE-ERROR"
#
# 当前子集：L2.2 算术/调用/println + L2.3-a 控制流/Bool + L2.3-b 闭包
# + L2.3-c1 非泛型用户枚举与 match + c2 内建 Result/Option、泛型
# 用户枚举类型实例（构造、match、递归/嵌套载荷）。子集外编译期拒绝：
# String/List/Map/json/包、? 与 return 语句、枚举结构相等/显示、
# 闭包值 match 等留 L2.3 后续批次。
#
# 值表示（编译器实现自由度，RFC-0004：不做字节级一致，行为级对拍）：
#   Int=i64、Float=f64、Bool=i32；闭包/枚举=i64 裸指针（untagged，
#   编译期 vt 区分）。宿主导入（env 模块）：
#   print_i64(i64) / print_f64(f64)——换行由 harness 隐式处理（每调用一行）。
#   专用 harness：tools/selfcomp/run_selfcomp.mjs（与宿主 run_wasm.mjs 的
#   fmtFloat 口径一致：整数值补 .0、inf/-inf/NaN 字面）。
#
# 前端（Part A-C4）自 self_interp.lom 物理复用（L2.1 决策：token/lexer/
# AST/parser 全家平移）；Float 字面量经 parse_float_str 从右往左除法解析
# （Lom 无 string_to_float）——已知精度边界：测试程序集的字面量限定
# 二进制可精确表示的十进制值（.5/.25/.125 等），任意字面量的正确舍入
# 留 L2.3 精度专项（挂账）。
# ============================================================================

from string import { split, contains, len, string_to_int, int_to_string, starts_with, ends_with, trim, upper, lower, replace, char_from_code }
from list import { list_empty, list_cons, list_head, list_tail, list_is_empty, list_length, list_get }
from map import { map_empty, map_set, map_get, map_has, map_size, map_keys, map_remove }
from file import { file_read, file_exists, file_write, file_append }
from math import { sqrt }
from env import { args }
from io import { println }

# ============================================================================
# Part A：Token 定义（对齐宿主 src/lexer.rs Token 枚举，Tk 前缀避免变体名冲突）
# ============================================================================

enum Tok
    # 关键字（20 个，宿主保留字全表）
    | TkFn
    | TkLet
    | TkMut
    | TkIf
    | TkElif
    | TkElse
    | TkWhile
    | TkFor
    | TkIn
    | TkReturn
    | TkEnd
    | TkTrue
    | TkFalse
    | TkAnd
    | TkOr
    | TkFrom
    | TkImport
    | TkAs
    | TkMatch
    | TkEnum
    # 字面量（Float 存规范化文本——见文件头契约）
    | TkInt(Int)
    | TkFloat(String)
    | TkStr(String)
    | TkIdent(String)
    # 运算符
    | TkPlus
    | TkMinus
    | TkStar
    | TkSlash
    | TkPercent
    | TkPlusEq
    | TkMinusEq
    | TkStarEq
    | TkSlashEq
    | TkEq
    | TkNotEq
    | TkLt
    | TkGt
    | TkLtEq
    | TkGtEq
    | TkAssign
    | TkBang
    | TkQuestion
    | TkPipe
    | TkBar
    | TkArrow
    | TkFatArrow
    # 标点
    | TkLParen
    | TkRParen
    | TkLBrace
    | TkRBrace
    | TkLBracket
    | TkRBracket
    | TkComma
    | TkColon
    | TkDot
    | TkDotDot
    | TkSemi
    # 结束
    | TkEof
end

# ============================================================================
# Part B：字符串辅助 + 字面量规范化
# ============================================================================

# 前缀截取：s 的前 k 个字符（k 超长返回全串）
fn str_take(s: String, k: Int) -> String
    let mut out = ""
    let mut i = 0
    for c in split(s, "")
        if i < k
            out = out + c
        end
        i += 1
    end
    out
end

# 从右去 '0'（小数部分规范化用）
fn rstrip_zero(s: String) -> String
    let mut last_nz = -1
    let mut i = 0
    for c in split(s, "")
        if c != "0"
            last_nz = i
        end
        i += 1
    end
    if last_nz < 0
        ""
    else
        str_take(s, last_nz + 1)
    end
end

# 从左去 '0'（全零收敛为 "0"；整数部分规范化用）
fn lstrip_zero(s: String) -> String
    let mut out = ""
    let mut started = False
    for c in split(s, "")
        if started or c != "0"
            started = True
            out = out + c
        end
    end
    if len(out) == 0
        "0"
    else
        out
    end
end

# Float 字面量规范化（宿主 Rust Display 契约的验收集实现，见文件头）
#   "5.20" -> "5.2"；"2.0" -> "2"；"3.14" -> "3.14"；"0.50" -> "0.5"
fn norm_float(ip: String, fp: String) -> String
    let f2 = rstrip_zero(fp)
    let i2 = lstrip_zero(ip)
    if len(f2) == 0
        i2
    else
        i2 + "." + f2
    end
end

# 转义字符还原（宿主 lex_string 的 Some(c) => push(c as char) 泛化规则）
fn unesc(nc: String) -> String
    if nc == "n"
        "\n"
    elif nc == "t"
        "\t"
    elif nc == "r"
        "\r"
    elif nc == "\""
        "\""
    elif nc == "\\"
        "\\"
    else
        nc
    end
end

# 字符分类（纯 ASCII；宿主按字节判定，纯 ASCII 源下语义一致）
fn is_digit(c: String) -> Bool
    contains("0123456789", c)
end

fn is_alpha(c: String) -> Bool
    contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_", c)
end

fn is_alnum(c: String) -> Bool
    if is_alpha(c)
        True
    elif is_digit(c)
        True
    else
        False
    end
end

# 关键字识别（宿主 lex_ident 的 match 全表，20 个保留字）
fn keyword_or_ident(s: String) -> Tok
    if s == "fn"
        TkFn
    elif s == "let"
        TkLet
    elif s == "mut"
        TkMut
    elif s == "if"
        TkIf
    elif s == "elif"
        TkElif
    elif s == "else"
        TkElse
    elif s == "while"
        TkWhile
    elif s == "for"
        TkFor
    elif s == "in"
        TkIn
    elif s == "return"
        TkReturn
    elif s == "end"
        TkEnd
    elif s == "True"
        TkTrue
    elif s == "False"
        TkFalse
    elif s == "and"
        TkAnd
    elif s == "or"
        TkOr
    elif s == "from"
        TkFrom
    elif s == "import"
        TkImport
    elif s == "as"
        TkAs
    elif s == "match"
        TkMatch
    elif s == "enum"
        TkEnum
    else
        TkIdent(s)
    end
end

# ---- 循环版 reverse（各类型一份；线性递归版在万级 token 上会爆 ~10^4 栈深天花板）----

fn rev_tok(xs: List<{t: Tok, ln: Int, cl: Int}>) -> List<{t: Tok, ln: Int, cl: Int}>
    let mut acc = list_empty()
    let mut cur = xs
    while !list_is_empty(cur)
        acc = list_cons(list_head(cur), acc)
        cur = list_tail(cur)
    end
    acc
end

fn rev_err(xs: List<{code: String, msg: String, ln: Int, cl: Int}>) -> List<{code: String, msg: String, ln: Int, cl: Int}>
    let mut acc = list_empty()
    let mut cur = xs
    while !list_is_empty(cur)
        acc = list_cons(list_head(cur), acc)
        cur = list_tail(cur)
    end
    acc
end

fn rev_str(xs: List<String>) -> List<String>
    let mut acc = list_empty()
    let mut cur = xs
    while !list_is_empty(cur)
        acc = list_cons(list_head(cur), acc)
        cur = list_tail(cur)
    end
    acc
end

# ============================================================================
# Part B2：lexer 主循环（对齐宿主 Lexer::tokenize_recover 的容错语义）
#   产出 {toks: Map<索引, TokR>, n: Int, errs: List<ErrR>}；EOF 也入表（key = n-1）
#   错误对齐宿主：记录错误 + 回退跳 1 字节继续（意外字符 / 未闭合字符串 / 无效整数）
# ============================================================================

fn lex(src: String) -> {toks: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, errs: List<{code: String, msg: String, ln: Int, cl: Int}>}
    let chars = split(src, "")
    let mut rest = chars
    let mut ln = 1
    let mut cl = 1
    let mut acc = list_empty()
    let mut errs = list_empty()
    while !list_is_empty(rest)
        let c = list_head(rest)
        let ln0 = ln
        let cl0 = cl
        if c == " " or c == "\t" or c == "\r"
            rest = list_tail(rest)
            cl += 1
        elif c == "\n"
            rest = list_tail(rest)
            ln += 1
            cl = 1
        elif c == "#"
            # 注释：# 行注释 / #- 块注释 -#
            if !list_is_empty(list_tail(rest)) and list_head(list_tail(rest)) == "-"
                # 块注释：跳过 #- 后找 -#（未闭合静默结束，宿主语义）
                let mut r2 = list_tail(list_tail(rest))
                cl += 2
                let mut done = False
                while !list_is_empty(r2) and done == False
                    if !list_is_empty(list_tail(r2)) and list_head(r2) == "-" and list_head(list_tail(r2)) == "#"
                        r2 = list_tail(list_tail(r2))
                        cl += 2
                        done = True
                    else
                        if list_head(r2) == "\n"
                            ln += 1
                            cl = 1
                        else
                            cl += 1
                        end
                        r2 = list_tail(r2)
                    end
                end
                rest = r2
            else
                # 行注释：跳到换行前（换行留给主循环计数）
                let mut r2 = list_tail(rest)
                cl += 1
                let mut done = False
                while !list_is_empty(r2) and done == False
                    if list_head(r2) == "\n"
                        done = True
                    else
                        cl += 1
                        r2 = list_tail(r2)
                    end
                end
                rest = r2
            end
        elif is_digit(c)
            # 数字字面量（对齐宿主 lex_number：digit+ [ . digit+ ]）
            let mut ip = ""
            let mut r2 = rest
            while !list_is_empty(r2) and is_digit(list_head(r2))
                ip = ip + list_head(r2)
                r2 = list_tail(r2)
                cl += 1
            end
            # 浮点前瞻：'.' 后必须紧跟 digit（1..10 中 1 是 Int）
            if !list_is_empty(r2) and list_head(r2) == "."
                let r3 = list_tail(r2)
                if !list_is_empty(r3) and is_digit(list_head(r3))
                    let mut fp = ""
                    let mut r4 = r3
                    while !list_is_empty(r4) and is_digit(list_head(r4))
                        fp = fp + list_head(r4)
                        r4 = list_tail(r4)
                        cl += 1
                    end
                    cl += 1
                    acc = list_cons({t: TkFloat(norm_float(ip, fp)), ln: ln0, cl: cl0}, acc)
                    rest = r4
                else
                    match try_sti(ip)
                        Some(v) =>
                            acc = list_cons({t: TkInt(v), ln: ln0, cl: cl0}, acc)
                            rest = r2
                        end
                        None =>
                            errs = list_cons({msg: "无效整数: " + ip, ln: ln0, cl: cl0}, errs)
                            rest = list_tail(rest)
                            cl = cl0 + 1
                        end
                    end
                end
            else
                match try_sti(ip)
                    Some(v) =>
                        acc = list_cons({t: TkInt(v), ln: ln0, cl: cl0}, acc)
                        rest = r2
                    end
                    None =>
                        errs = list_cons({msg: "无效整数: " + ip, ln: ln0, cl: cl0}, errs)
                        rest = list_tail(rest)
                        cl = cl0 + 1
                    end
                end
            end
        elif c == "\""
            # 字符串字面量（对齐宿主 lex_string 的容错：未闭合 → 错误 + 回退跳 1 字节）
            let mut r2 = list_tail(rest)
            let mut s = ""
            let mut cl2 = cl + 1
            let mut ln2 = ln
            let mut closed = False
            let mut esc_eof = False
            while !list_is_empty(r2) and closed == False
                let ch = list_head(r2)
                if ch == "\""
                    r2 = list_tail(r2)
                    cl2 += 1
                    closed = True
                elif ch == "\\"
                    let r3 = list_tail(r2)
                    if list_is_empty(r3)
                        # \ 后 EOF：未闭合的字符串转义（宿主 LEX002）
                        esc_eof = True
                        r2 = list_empty()
                    else
                        s = s + unesc(list_head(r3))
                        r2 = list_tail(r3)
                        cl2 += 2
                    end
                else
                    s = s + ch
                    r2 = list_tail(r2)
                    if ch == "\n"
                        ln2 += 1
                        cl2 = 1
                    else
                        cl2 += 1
                    end
                end
            end
            if closed
                acc = list_cons({t: TkStr(s), ln: ln0, cl: cl0}, acc)
                rest = r2
                ln = ln2
                cl = cl2
            else
                # 未闭合：记录错误，回退跳过开头引号（宿主 saved_pos 回退 + advance 1）
                let unclosed_msg =
                if esc_eof
                    "未闭合的字符串转义"
                else
                    "未闭合的字符串"
                end
                errs = list_cons({msg: unclosed_msg, ln: ln0, cl: cl0}, errs)
                rest = list_tail(rest)
                cl += 1
            end
        elif is_alpha(c)
            # 标识符 / 关键字
            let mut word = ""
            let mut r2 = rest
            while !list_is_empty(r2) and is_alnum(list_head(r2))
                word = word + list_head(r2)
                r2 = list_tail(r2)
                cl += 1
            end
            acc = list_cons({t: keyword_or_ident(word), ln: ln0, cl: cl0}, acc)
            rest = r2
        elif c == "+"
            if !list_is_empty(list_tail(rest)) and list_head(list_tail(rest)) == "="
                acc = list_cons({t: TkPlusEq, ln: ln0, cl: cl0}, acc)
                rest = list_tail(list_tail(rest))
                cl += 2
            else
                acc = list_cons({t: TkPlus, ln: ln0, cl: cl0}, acc)
                rest = list_tail(rest)
                cl += 1
            end
        elif c == "-"
            if !list_is_empty(list_tail(rest)) and list_head(list_tail(rest)) == ">"
                acc = list_cons({t: TkArrow, ln: ln0, cl: cl0}, acc)
                rest = list_tail(list_tail(rest))
                cl += 2
            elif !list_is_empty(list_tail(rest)) and list_head(list_tail(rest)) == "="
                acc = list_cons({t: TkMinusEq, ln: ln0, cl: cl0}, acc)
                rest = list_tail(list_tail(rest))
                cl += 2
            else
                acc = list_cons({t: TkMinus, ln: ln0, cl: cl0}, acc)
                rest = list_tail(rest)
                cl += 1
            end
        elif c == "*"
            if !list_is_empty(list_tail(rest)) and list_head(list_tail(rest)) == "="
                acc = list_cons({t: TkStarEq, ln: ln0, cl: cl0}, acc)
                rest = list_tail(list_tail(rest))
                cl += 2
            else
                acc = list_cons({t: TkStar, ln: ln0, cl: cl0}, acc)
                rest = list_tail(rest)
                cl += 1
            end
        elif c == "/"
            if !list_is_empty(list_tail(rest)) and list_head(list_tail(rest)) == "="
                acc = list_cons({t: TkSlashEq, ln: ln0, cl: cl0}, acc)
                rest = list_tail(list_tail(rest))
                cl += 2
            else
                acc = list_cons({t: TkSlash, ln: ln0, cl: cl0}, acc)
                rest = list_tail(rest)
                cl += 1
            end
        elif c == "%"
            acc = list_cons({t: TkPercent, ln: ln0, cl: cl0}, acc)
            rest = list_tail(rest)
            cl += 1
        elif c == "!"
            if !list_is_empty(list_tail(rest)) and list_head(list_tail(rest)) == "="
                acc = list_cons({t: TkNotEq, ln: ln0, cl: cl0}, acc)
                rest = list_tail(list_tail(rest))
                cl += 2
            else
                acc = list_cons({t: TkBang, ln: ln0, cl: cl0}, acc)
                rest = list_tail(rest)
                cl += 1
            end
        elif c == "="
            if !list_is_empty(list_tail(rest)) and list_head(list_tail(rest)) == "="
                acc = list_cons({t: TkEq, ln: ln0, cl: cl0}, acc)
                rest = list_tail(list_tail(rest))
                cl += 2
            elif !list_is_empty(list_tail(rest)) and list_head(list_tail(rest)) == ">"
                acc = list_cons({t: TkFatArrow, ln: ln0, cl: cl0}, acc)
                rest = list_tail(list_tail(rest))
                cl += 2
            else
                acc = list_cons({t: TkAssign, ln: ln0, cl: cl0}, acc)
                rest = list_tail(rest)
                cl += 1
            end
        elif c == "<"
            if !list_is_empty(list_tail(rest)) and list_head(list_tail(rest)) == "="
                acc = list_cons({t: TkLtEq, ln: ln0, cl: cl0}, acc)
                rest = list_tail(list_tail(rest))
                cl += 2
            else
                acc = list_cons({t: TkLt, ln: ln0, cl: cl0}, acc)
                rest = list_tail(rest)
                cl += 1
            end
        elif c == ">"
            if !list_is_empty(list_tail(rest)) and list_head(list_tail(rest)) == "="
                acc = list_cons({t: TkGtEq, ln: ln0, cl: cl0}, acc)
                rest = list_tail(list_tail(rest))
                cl += 2
            else
                acc = list_cons({t: TkGt, ln: ln0, cl: cl0}, acc)
                rest = list_tail(rest)
                cl += 1
            end
        elif c == "|"
            if !list_is_empty(list_tail(rest)) and list_head(list_tail(rest)) == ">"
                acc = list_cons({t: TkPipe, ln: ln0, cl: cl0}, acc)
                rest = list_tail(list_tail(rest))
                cl += 2
            else
                acc = list_cons({t: TkBar, ln: ln0, cl: cl0}, acc)
                rest = list_tail(rest)
                cl += 1
            end
        elif c == "?"
            acc = list_cons({t: TkQuestion, ln: ln0, cl: cl0}, acc)
            rest = list_tail(rest)
            cl += 1
        elif c == "("
            acc = list_cons({t: TkLParen, ln: ln0, cl: cl0}, acc)
            rest = list_tail(rest)
            cl += 1
        elif c == "{"
            acc = list_cons({t: TkLBrace, ln: ln0, cl: cl0}, acc)
            rest = list_tail(rest)
            cl += 1
        elif c == ")"
            acc = list_cons({t: TkRParen, ln: ln0, cl: cl0}, acc)
            rest = list_tail(rest)
            cl += 1
        elif c == "}"
            acc = list_cons({t: TkRBrace, ln: ln0, cl: cl0}, acc)
            rest = list_tail(rest)
            cl += 1
        elif c == "["
            acc = list_cons({t: TkLBracket, ln: ln0, cl: cl0}, acc)
            rest = list_tail(rest)
            cl += 1
        elif c == "]"
            acc = list_cons({t: TkRBracket, ln: ln0, cl: cl0}, acc)
            rest = list_tail(rest)
            cl += 1
        elif c == ","
            acc = list_cons({t: TkComma, ln: ln0, cl: cl0}, acc)
            rest = list_tail(rest)
            cl += 1
        elif c == ":"
            acc = list_cons({t: TkColon, ln: ln0, cl: cl0}, acc)
            rest = list_tail(rest)
            cl += 1
        elif c == "."
            if !list_is_empty(list_tail(rest)) and list_head(list_tail(rest)) == "."
                acc = list_cons({t: TkDotDot, ln: ln0, cl: cl0}, acc)
                rest = list_tail(list_tail(rest))
                cl += 2
            else
                acc = list_cons({t: TkDot, ln: ln0, cl: cl0}, acc)
                rest = list_tail(rest)
                cl += 1
            end
        elif c == ";"
            acc = list_cons({t: TkSemi, ln: ln0, cl: cl0}, acc)
            rest = list_tail(rest)
            cl += 1
        else
            # 意外字符（宿主 LexError "意外字符 'x'"，tokenize_recover 跳过该字节）
            errs = list_cons({msg: "意外字符 '" + c + "'", ln: ln0, cl: cl0}, errs)
            rest = list_tail(rest)
            cl += 1
        end
    end
    # EOF token（宿主：is_at_end 时 push Eof，位置 = 结束时的 line/col）
    acc = list_cons({t: TkEof, ln: ln, cl: cl}, acc)
    # 逆序 → 正序 → Map 索引表
    let ordered = rev_tok(acc)
    let toks = map_empty()
    let mut i = 0
    for tk in ordered
        map_set(toks, int_to_string(i), tk)
        i += 1
    end
    {toks: toks, n: i, errs: rev_err(errs)}
end

# 整数字面量辅助：string_to_int 的返回约定是裸 Int（成功）或 Unit（失败）——
# 内建协议层 Ok(Some(Value)) 解包后用户拿到的不是 Option 枚举（与 map_get 不同）。
# 无 type_of 反射（RFC-0003 冻结），用拼接提升的 to_display 形态判定：Unit 显示为 "()"
fn try_sti(s: String) -> Option<Int>
    if "" + string_to_int(s) == "()"
        None
    else
        Some(string_to_int(s))
    end
end

# ============================================================================
# Part C：AST 定义（对齐宿主 src/ast.rs；span 不建模——dump 契约不含位置）
#   Blk/IfR/Prm/ArmR/ArmB/VarR/ImpI 用单变体 enum 包装（签名书写一个词，
#   且避开匿名记录类型在深层泛型参数里的书写负担）
# ============================================================================

enum Ty
    | TyInt
    | TyFloat
    | TyBool
    | TyString
    | TyUnit
    | TyNamed(String)
    | TyOption(Ty)
    | TResult(Ty, Ty)
    | TyGeneric(String, List<Ty>)
    | TyRecord(List<(String, Ty)>)
    | TyTuple(List<Ty>)
end

enum Blk
    | BlkOf(List<St>, Option<Ex>)
end

enum St
    | StLet(Bool, String, Option<Ty>, Ex)
    | StDestruct(List<String>, Ex)
    | StAssign(String, Int, Int, Ex)
    | StIf(IfR)
    | StWhile(Ex, Blk)
    | StFor(String, Ex, Blk)
    | StReturn(Option<Ex>)
    | StExpr(Ex)
    | StHole(Int, Int)
end

enum IfR
    | IfR(List<(Ex, Blk)>, Option<Blk>)
end

enum Ex
    | ExInt(Int)
    | ExFloat(String)
    | ExBool(Bool)
    | ExStr(String)
    | ExUnit
    | ExIdent(String, Int, Int)
    | ExBinary(String, Ex, Ex)
    | ExUnary(String, Ex)
    | ExLogical(String, Ex, Ex)
    | ExCall(Ex, List<Ex>)
    | ExIndex(Ex, Ex)
    | ExField(Ex, String)
    | ExGroup(Ex)
    | ExIf(IfR)
    | ExClosure(List<Prm>, Option<Ty>, Blk)
    | ExMatch(Ex, List<ArmR>, Int)
    | ExTry(Ex)
    | ExPipe(Ex, Ex)
    | ExRange(Ex, Ex)
    | ExRecord(List<(String, Ex)>)
    | ExTuple(List<Ex>)
end

enum Prm
    | Prm(String, Ty)
end

enum ArmR
    | ArmR(Pat, Option<Ex>, ArmB)
end

enum ArmB
    | ABExpr(Ex)
    | ABBlock(Blk)
end

enum Pat
    | PatLit(Ex)
    | PatBinder(String)
    | PatWildcard
    | PatVariant(String, List<Pat>)
end

enum Itm
    | ItFn(String, List<Prm>, Option<Ty>, List<String>, Blk, Int, Int)
    | ItEnum(String, List<String>, List<VarR>)
    | ItImport(String, List<ImpI>)
end

enum VarR
    | VarR(String, List<Ty>)
end

enum ImpI
    | ImpI(String, String)
end

enum Prg
    | Prg(List<Itm>)
end

# 块元素（parse_block 循环体产出；对齐宿主 BlockEl）
enum Bel
    | BStmt(St)
    | BTail(Ex)
end

# ---- 各类型循环版 reverse（构建一律头插逆序）----

fn rev_itm(xs: List<Itm>) -> List<Itm>
    let mut acc = list_empty()
    let mut cur = xs
    while !list_is_empty(cur)
        acc = list_cons(list_head(cur), acc)
        cur = list_tail(cur)
    end
    acc
end

fn rev_st(xs: List<St>) -> List<St>
    let mut acc = list_empty()
    let mut cur = xs
    while !list_is_empty(cur)
        acc = list_cons(list_head(cur), acc)
        cur = list_tail(cur)
    end
    acc
end

fn rev_ex(xs: List<Ex>) -> List<Ex>
    let mut acc = list_empty()
    let mut cur = xs
    while !list_is_empty(cur)
        acc = list_cons(list_head(cur), acc)
        cur = list_tail(cur)
    end
    acc
end

fn rev_pat(xs: List<Pat>) -> List<Pat>
    let mut acc = list_empty()
    let mut cur = xs
    while !list_is_empty(cur)
        acc = list_cons(list_head(cur), acc)
        cur = list_tail(cur)
    end
    acc
end

fn rev_prm(xs: List<Prm>) -> List<Prm>
    let mut acc = list_empty()
    let mut cur = xs
    while !list_is_empty(cur)
        acc = list_cons(list_head(cur), acc)
        cur = list_tail(cur)
    end
    acc
end

fn rev_branch(xs: List<(Ex, Blk)>) -> List<(Ex, Blk)>
    let mut acc = list_empty()
    let mut cur = xs
    while !list_is_empty(cur)
        acc = list_cons(list_head(cur), acc)
        cur = list_tail(cur)
    end
    acc
end

fn rev_arm(xs: List<ArmR>) -> List<ArmR>
    let mut acc = list_empty()
    let mut cur = xs
    while !list_is_empty(cur)
        acc = list_cons(list_head(cur), acc)
        cur = list_tail(cur)
    end
    acc
end

fn rev_var(xs: List<VarR>) -> List<VarR>
    let mut acc = list_empty()
    let mut cur = xs
    while !list_is_empty(cur)
        acc = list_cons(list_head(cur), acc)
        cur = list_tail(cur)
    end
    acc
end

fn rev_impi(xs: List<ImpI>) -> List<ImpI>
    let mut acc = list_empty()
    let mut cur = xs
    while !list_is_empty(cur)
        acc = list_cons(list_head(cur), acc)
        cur = list_tail(cur)
    end
    acc
end

fn rev_sfld(xs: List<(String, Ex)>) -> List<(String, Ex)>
    let mut acc = list_empty()
    let mut cur = xs
    while !list_is_empty(cur)
        acc = list_cons(list_head(cur), acc)
        cur = list_tail(cur)
    end
    acc
end

fn rev_sfty(xs: List<(String, Ty)>) -> List<(String, Ty)>
    let mut acc = list_empty()
    let mut cur = xs
    while !list_is_empty(cur)
        acc = list_cons(list_head(cur), acc)
        cur = list_tail(cur)
    end
    acc
end

fn rev_ty(xs: List<Ty>) -> List<Ty>
    let mut acc = list_empty()
    let mut cur = xs
    while !list_is_empty(cur)
        acc = list_cons(list_head(cur), acc)
        cur = list_tail(cur)
    end
    acc
end

# ============================================================================
# Part C2：parser 基础设施（对齐宿主 Parser 的游标模型）
#   ts = token 索引表（lex 产出）；pm = Map 持 "pos"（引用语义跨函数共享，对齐 &mut self）
#   错误走 Result<_, String>（打包 "ln|cl|msg"，? 传播；Hole 插入点解包）
# ============================================================================

# token 判别编号（对齐宿主 std::mem::discriminant 的判等用途；只对无载荷变体比较判别）
fn tok_disc(t: Tok) -> Int
    match t
        TkFn => 1
        TkLet => 2
        TkMut => 3
        TkIf => 4
        TkElif => 5
        TkElse => 6
        TkWhile => 7
        TkFor => 8
        TkIn => 9
        TkReturn => 10
        TkEnd => 11
        TkTrue => 12
        TkFalse => 13
        TkAnd => 14
        TkOr => 15
        TkFrom => 16
        TkImport => 17
        TkAs => 18
        TkMatch => 19
        TkEnum => 20
        TkInt(_) => 21
        TkFloat(_) => 22
        TkStr(_) => 23
        TkIdent(_) => 24
        TkPlus => 25
        TkMinus => 26
        TkStar => 27
        TkSlash => 28
        TkPercent => 29
        TkPlusEq => 30
        TkMinusEq => 31
        TkStarEq => 32
        TkSlashEq => 33
        TkEq => 34
        TkNotEq => 35
        TkLt => 36
        TkGt => 37
        TkLtEq => 38
        TkGtEq => 39
        TkAssign => 40
        TkBang => 41
        TkQuestion => 42
        TkPipe => 43
        TkBar => 44
        TkArrow => 45
        TkFatArrow => 46
        TkLParen => 47
        TkRParen => 48
        TkLBrace => 49
        TkRBrace => 50
        TkLBracket => 51
        TkRBracket => 52
        TkComma => 53
        TkColon => 54
        TkDot => 55
        TkDotDot => 56
        TkSemi => 57
        TkEof => 58
    end
end

# 无载荷 token 的 Rust Debug 名（宿主 token_name 的 `{:?}` 分支，去 Tk 前缀即宿主变体名）
fn tk_dbg(t: Tok) -> String
    match t
        TkFn => "Fn"
        TkLet => "Let"
        TkMut => "Mut"
        TkIf => "If"
        TkElif => "Elif"
        TkElse => "Else"
        TkWhile => "While"
        TkFor => "For"
        TkIn => "In"
        TkReturn => "Return"
        TkEnd => "End"
        TkTrue => "True"
        TkFalse => "False"
        TkAnd => "And"
        TkOr => "Or"
        TkFrom => "From"
        TkImport => "Import"
        TkAs => "As"
        TkMatch => "Match"
        TkEnum => "Enum"
        TkInt(_) => "Int"
        TkFloat(_) => "Float"
        TkStr(_) => "Str"
        TkIdent(_) => "Ident"
        TkPlus => "Plus"
        TkMinus => "Minus"
        TkStar => "Star"
        TkSlash => "Slash"
        TkPercent => "Percent"
        TkPlusEq => "PlusEq"
        TkMinusEq => "MinusEq"
        TkStarEq => "StarEq"
        TkSlashEq => "SlashEq"
        TkEq => "Eq"
        TkNotEq => "NotEq"
        TkLt => "Lt"
        TkGt => "Gt"
        TkLtEq => "LtEq"
        TkGtEq => "GtEq"
        TkAssign => "Assign"
        TkBang => "Bang"
        TkQuestion => "Question"
        TkPipe => "Pipe"
        TkBar => "Bar"
        TkArrow => "Arrow"
        TkFatArrow => "FatArrow"
        TkLParen => "LParen"
        TkRParen => "RParen"
        TkLBrace => "LBrace"
        TkRBrace => "RBrace"
        TkLBracket => "LBracket"
        TkRBracket => "RBracket"
        TkComma => "Comma"
        TkColon => "Colon"
        TkDot => "Dot"
        TkDotDot => "DotDot"
        TkSemi => "Semi"
        TkEof => "Eof"
    end
end

# token 的诊断名（对齐宿主 token_name：字面量有值形态，其余 Rust Debug 名）
fn tok_name(t: Tok) -> String
    match t
        TkEof => "文件结束"
        TkInt(v) => "整数 " + int_to_string(v)
        TkFloat(s) => "浮点数 " + s
        TkStr(s) => "字符串 \"" + s + "\""
        TkIdent(s) => "标识符 '" + s + "'"
        _ => tk_dbg(t)
    end
end

# ---- 游标操作 ----

fn get_pos(pm: Map<String, Int>) -> Int
    match map_get(pm, "pos")
        Some(v) => v
        None => 0
    end
end

# 按索引取 token（越界回落到 EOF——对齐宿主 tokens 向量以 Eof 收尾且 advance 不越过）
fn tok_at(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, i: Int) -> {t: Tok, ln: Int, cl: Int}
    let k = if i < n - 1
        i
    else
        n - 1
    end
    match map_get(ts, int_to_string(k))
        Some(r) => r
        None => {t: TkEof, ln: 0, cl: 0}
    end
end

# 当前 token 的 Tok 部分（宿主 peek）
fn pk_tk(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>) -> Tok
    tok_at(ts, n, get_pos(pm)).t
end

# advance：Eof 不前进（对齐宿主）
fn adv(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>) -> Unit
    match pk_tk(ts, n, pm)
        TkEof => ()
        _ => map_set(pm, "pos", get_pos(pm) + 1)
    end
end

# check：判别相等（只对无载荷 token 使用，对齐宿主 discriminant 比较）
fn chk(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, t: Tok) -> Bool
    tok_disc(pk_tk(ts, n, pm)) == tok_disc(t)
end

# matches：check + advance
fn mt(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, t: Tok) -> Bool
    if chk(ts, n, pm, t)
        adv(ts, n, pm)
        True
    else
        False
    end
end

# 错误打包（"ln|cl|msg"）与解包
fn perr(ln: Int, cl: Int, msg: String) -> String
    int_to_string(ln) + "|" + int_to_string(cl) + "|" + msg
end

fn unpack_err(e: String) -> {ln: Int, cl: Int, msg: String}
    let parts = split(e, "|")
    if list_length(parts) >= 3
        {ln: or_zero(list_get(parts, 0)), cl: or_zero(list_get(parts, 1)), msg: list_get(parts, 2)}
    else
        {ln: 0, cl: 0, msg: e}
    end
end

fn or_zero(s: String) -> Int
    match try_sti(s)
        Some(v) => v
        None => 0
    end
end

# 当前位置错误（宿主 self.err：位置 = 当前 token）
fn err_here(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, msg: String) -> String
    let cur = tok_at(ts, n, get_pos(pm))
    perr(cur.ln, cur.cl, msg)
end

# expect（宿主：期望 X，得到 Y；位置 = 当前 token）
fn expt(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, want: Tok, what: String) -> Result<Unit, String>
    if chk(ts, n, pm, want)
        adv(ts, n, pm)
        Ok(())
    else
        Err(err_here(ts, n, pm, "期望 " + what + "，得到 " + tok_name(pk_tk(ts, n, pm))))
    end
end

# is_newline_before：当前 token 与前一个 token 不同行（宿主换行守卫的判定）
fn newline_before(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>) -> Bool
    let p = get_pos(pm)
    if p == 0
        False
    else
        tok_at(ts, n, p).ln != tok_at(ts, n, p - 1).ln
    end
end

# 错误累积（em 的 value 记录；map_size 计数键）
fn em_add(em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>, code: String, ln: Int, cl: Int, msg: String) -> Unit
    map_set(em, int_to_string(map_size(em)), {code: code, msg: msg, ln: ln, cl: cl})
end

# 错误码分类（对齐宿主 diagnostics.rs 的关键字匹配；lex 与 parse 分表——宿主按阶段分，这里按记录点分）
fn classify_lex_msg(msg: String) -> String
    if contains(msg, "未闭合的字符串转义")
        "LEX002"
    elif contains(msg, "未闭合的字符串")
        "LEX001"
    elif contains(msg, "无效浮点数")
        "LEX003"
    elif contains(msg, "无效整数")
        "LEX004"
    elif contains(msg, "意外字符")
        "LEX005"
    else
        "LEX000"
    end
end

fn classify_parse_msg(msg: String) -> String
    if contains(msg, "Result") and contains(msg, "类型参数")
        "PARSE002"
    elif contains(msg, "Option") and contains(msg, "类型参数")
        "PARSE003"
    elif starts_with(msg, "期望")
        "PARSE001"
    else
        "PARSE000"
    end
end

# ---- 容错同步点（宿主 Phase 2.2）----

# 同步到顶层 item 起点：跳到 fn/enum/from/EOF
fn sync_to_top(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>) -> Unit
    let mut d = tok_disc(pk_tk(ts, n, pm))
    while d != tok_disc(TkEof) and d != tok_disc(TkFn) and d != tok_disc(TkEnum) and d != tok_disc(TkFrom)
        adv(ts, n, pm)
        d = tok_disc(pk_tk(ts, n, pm))
    end
end

# 语句起始 token 判定（宿主 is_block_stmt_start；不含 fn/enum/from——顶层声明留给 sync_to_top）
# 带载荷变体的判别值用哨兵构造（_ 只能出现在模式位置，表达式位置不合法）
fn d_int_lit() -> Int
    tok_disc(TkInt(0))
end

fn d_float_lit() -> Int
    tok_disc(TkFloat("0"))
end

fn d_str_lit() -> Int
    tok_disc(TkStr(""))
end

fn d_ident() -> Int
    tok_disc(TkIdent(""))
end

fn is_block_stmt_start(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>) -> Bool
    let d = tok_disc(pk_tk(ts, n, pm))
    if d == tok_disc(TkLet) or d == tok_disc(TkIf) or d == tok_disc(TkWhile) or d == tok_disc(TkFor) or d == tok_disc(TkReturn) or d == tok_disc(TkMatch) or d == d_ident() or d == d_int_lit() or d == d_float_lit() or d == d_str_lit() or d == tok_disc(TkTrue) or d == tok_disc(TkFalse) or d == tok_disc(TkLParen) or d == tok_disc(TkLBrace)
        True
    else
        False
    end
end

# 同步到语句边界：跳到块终止符或新行上的语句起始 token（Lom 无 break，用 flag 退出）
fn sync_to_stmt_boundary(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>) -> Unit
    let mut go = True
    while go and !chk(ts, n, pm, TkEof) and !chk(ts, n, pm, TkEnd) and !chk(ts, n, pm, TkElif) and !chk(ts, n, pm, TkElse)
        if newline_before(ts, n, pm) and is_block_stmt_start(ts, n, pm)
            go = False
        else
            adv(ts, n, pm)
        end
    end
end

# 保证解析进度（宿主 ensure_progress）
fn ensure_progress(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, saved: Int) -> Unit
    if get_pos(pm) <= saved
        adv(ts, n, pm)
    end
end

# ============================================================================
# Part C3：顶层与声明解析（对齐宿主 parse_program / parse_item / 声明族）
# ============================================================================

fn parse_program(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Prg
    let mut items = list_empty()
    while !chk(ts, n, pm, TkEof)
        let saved = get_pos(pm)
        match parse_item(ts, n, pm, em)
            Ok(it) =>
                items = list_cons(it, items)
            end
            Err(e) =>
                let r = unpack_err(e)
                em_add(em, classify_parse_msg(r.msg), r.ln, r.cl, r.msg)
                sync_to_top(ts, n, pm)
                ensure_progress(ts, n, pm, saved)
            end
        end
    end
    Prg(rev_itm(items))
end

fn parse_item(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Result<Itm, String>
    let d = tok_disc(pk_tk(ts, n, pm))
    if d == tok_disc(TkFn)
        parse_fn_decl(ts, n, pm, em)
    elif d == tok_disc(TkEnum)
        parse_enum_decl(ts, n, pm)
    elif d == tok_disc(TkFrom)
        parse_import_decl(ts, n, pm)
    else
        Err(err_here(ts, n, pm, "期望函数声明 'fn'、枚举声明 'enum' 或导入声明 'from'，得到 " + tok_name(pk_tk(ts, n, pm))))
    end
end

# 解析标识符（宿主 parse_ident）
fn parse_ident(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>) -> Result<String, String>
    let tk = pk_tk(ts, n, pm)
    adv(ts, n, pm)
    match tk
        TkIdent(s) => Ok(s)
        _ => Err(err_here(ts, n, pm, "期望标识符，得到 " + tok_name(tk)))
    end
end

# 点分模块路径（宿主 parse_module_path）
fn parse_module_path(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>) -> Result<String, String>
    let first = parse_ident(ts, n, pm)?
    let mut path = first
    let mut go = True
    while go
        if mt(ts, n, pm, TkDot)
            path = path + "." + parse_ident(ts, n, pm)?
        else
            go = False
        end
    end
    Ok(path)
end

# 导入声明（宿主 parse_import_decl：from mod import { a, b as c }，允许尾随逗号与空列表）
fn parse_import_decl(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>) -> Result<Itm, String>
    adv(ts, n, pm)
    let module = parse_module_path(ts, n, pm)?
    expt(ts, n, pm, TkImport, "'import'")?
    expt(ts, n, pm, TkLBrace, "'{' (导入列表开始)")?
    let mut items = list_empty()
    if !chk(ts, n, pm, TkRBrace)
        let mut go = True
        while go
            if chk(ts, n, pm, TkRBrace)
                go = False
            else
                let iname = parse_ident(ts, n, pm)?
                let alias =
                if mt(ts, n, pm, TkAs)
                    parse_ident(ts, n, pm)?
                else
                    iname
                end
                items = list_cons(ImpI(iname, alias), items)
                if !mt(ts, n, pm, TkComma)
                    go = False
                end
            end
        end
    end
    expt(ts, n, pm, TkRBrace, "'}' (导入列表结束)")?
    Ok(ItImport(module, rev_impi(items)))
end

# 参数列表（宿主 parse_params：name: type 逗号分隔）
fn parse_params(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>) -> Result<List<Prm>, String>
    let mut params = list_empty()
    if !chk(ts, n, pm, TkRParen)
        let mut go = True
        while go
            let pname = parse_ident(ts, n, pm)?
            expt(ts, n, pm, TkColon, "':'")?
            let pty = parse_type(ts, n, pm)?
            params = list_cons(Prm(pname, pty), params)
            if !mt(ts, n, pm, TkComma)
                go = False
            end
        end
    end
    expt(ts, n, pm, TkRParen, "')'")?
    Ok(rev_prm(params))
end

# 效应注解（宿主 parse_effects：可选 ! [E1, E2]，空列表允许）
fn parse_effects(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>) -> Result<List<String>, String>
    if !mt(ts, n, pm, TkBang)
        Ok(list_empty())
    else
        expt(ts, n, pm, TkLBracket, "'[' (效应列表开始)")?
        let mut effs = list_empty()
        if !chk(ts, n, pm, TkRBracket)
            let mut go = True
            while go
                let e = parse_ident(ts, n, pm)?
                effs = list_cons(e, effs)
                if !mt(ts, n, pm, TkComma)
                    go = False
                end
            end
        end
        expt(ts, n, pm, TkRBracket, "']' (效应列表结束)")?
        Ok(rev_str(effs))
    end
end

# 函数声明（宿主 parse_fn_decl；span 省略）
fn parse_fn_decl(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Result<Itm, String>
    let fn_rec = tok_at(ts, n, get_pos(pm))
    adv(ts, n, pm)
    let name = parse_ident(ts, n, pm)?
    expt(ts, n, pm, TkLParen, "'('")?
    let params = parse_params(ts, n, pm)?
    let ret =
    if mt(ts, n, pm, TkArrow)
        Some(parse_type(ts, n, pm)?)
    else
        None
    end
    let effs = parse_effects(ts, n, pm)?
    let body = parse_block(ts, n, pm, em)?
    Ok(ItFn(name, params, ret, effs, body, fn_rec.ln, fn_rec.cl))
end

# 标识符 → 基础类型（宿主 Type::from_name）
fn ty_from_name(s: String) -> Ty
    if s == "Int"
        TyInt
    elif s == "Float"
        TyFloat
    elif s == "Bool"
        TyBool
    elif s == "String"
        TyString
    elif s == "Unit"
        TyUnit
    else
        TyNamed(s)
    end
end

# 类型的 Debug 名（宿主 "类型 {:?} 不支持泛型参数" 消息用；仅覆盖所需形态）
fn ty_dbg(t: Ty) -> String
    match t
        TyInt => "Int"
        TyFloat => "Float"
        TyBool => "Bool"
        TyString => "String"
        TyUnit => "Unit"
        TyNamed(s) => "Named(\"" + s + "\")"
        TyOption(_) => "Option"
        TResult(_, _) => "Result"
        TyGeneric(_, _) => "Generic"
        TyRecord(_) => "Record"
        TyTuple(_) => "Tuple"
    end
end

# 类型解析（宿主 parse_type：记录/元组/命名+泛型，Result/Option 特判）
fn parse_type(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>) -> Result<Ty, String>
    if chk(ts, n, pm, TkLBrace)
        adv(ts, n, pm)
        let mut fields = list_empty()
        if !chk(ts, n, pm, TkRBrace)
            let mut go = True
            while go
                let fname = parse_ident(ts, n, pm)?
                expt(ts, n, pm, TkColon, "':' (记录字段类型分隔)")?
                let fty = parse_type(ts, n, pm)?
                fields = list_cons((fname, fty), fields)
                if !mt(ts, n, pm, TkComma)
                    go = False
                end
            end
        end
        expt(ts, n, pm, TkRBrace, "'}' (闭合记录类型)")?
        Ok(TyRecord(rev_sfty(fields)))
    elif chk(ts, n, pm, TkLParen)
        let _ = adv(ts, n, pm)
        if mt(ts, n, pm, TkRParen)
            Ok(TyUnit)
        else
            let first = parse_type(ts, n, pm)?
            if mt(ts, n, pm, TkComma)
                let mut elems = list_cons(first, list_empty())
                let mut go = True
                while go
                    elems = list_cons(parse_type(ts, n, pm)?, elems)
                    if !mt(ts, n, pm, TkComma)
                        go = False
                    end
                end
                expt(ts, n, pm, TkRParen, "')' (闭合元组类型)")?
                Ok(TyTuple(rev_ty(elems)))
            else
                expt(ts, n, pm, TkRParen, "')'")?
                Ok(first)
            end
        end
    else
        let name = parse_ident(ts, n, pm)?
        let base = ty_from_name(name)
        if chk(ts, n, pm, TkLt)
            adv(ts, n, pm)
            let mut args = list_cons(parse_type(ts, n, pm)?, list_empty())
            let mut go = True
            while go
                if mt(ts, n, pm, TkComma)
                    args = list_cons(parse_type(ts, n, pm)?, args)
                else
                    go = False
                end
            end
            expt(ts, n, pm, TkGt, "'>' (闭合泛型参数)")?
            let args2 = rev_ty(args)
            match base
                TyNamed(bn) =>
                    if bn == "Result"
                        if list_length(args2) != 2
                            Err(err_here(ts, n, pm, "Result 期望 2 个类型参数，得到 " + int_to_string(list_length(args2)) + " 个"))
                        else
                            Ok(TResult(list_get(args2, 0), list_get(args2, 1)))
                        end
                    elif bn == "Option"
                        if list_length(args2) != 1
                            Err(err_here(ts, n, pm, "Option 期望 1 个类型参数，得到 " + int_to_string(list_length(args2)) + " 个"))
                        else
                            Ok(TyOption(list_get(args2, 0)))
                        end
                    else
                        Ok(TyGeneric(bn, args2))
                    end
                end
                _ => Err(err_here(ts, n, pm, "类型 " + ty_dbg(base) + " 不支持泛型参数"))
            end
        else
            Ok(base)
        end
    end
end

# 枚举声明（宿主 parse_enum_decl：单行 = 形式 / 多行 end 形式）
fn parse_enum_decl(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>) -> Result<Itm, String>
    adv(ts, n, pm)
    let name = parse_ident(ts, n, pm)?
    let mut tparams = list_empty()
    if chk(ts, n, pm, TkLt)
        adv(ts, n, pm)
        let mut go = True
        while go
            tparams = list_cons(parse_ident(ts, n, pm)?, tparams)
            if !mt(ts, n, pm, TkComma)
                go = False
            end
        end
        expt(ts, n, pm, TkGt, "'>' (闭合类型参数)")?
    end
    let mut variants = list_empty()
    if mt(ts, n, pm, TkAssign)
        # 单行形式：V1 | V2 | V3（无 end）
        let mut go = True
        while go
            variants = list_cons(parse_enum_variant(ts, n, pm)?, variants)
            if mt(ts, n, pm, TkBar)
                ()
            else
                go = False
            end
        end
    else
        # 多行形式：每行一个变体（可选 | 前缀），以 end 闭合
        while !chk(ts, n, pm, TkEnd) and !chk(ts, n, pm, TkEof)
            mt(ts, n, pm, TkBar)
            variants = list_cons(parse_enum_variant(ts, n, pm)?, variants)
        end
        expt(ts, n, pm, TkEnd, "'end' (闭合 enum)")?
    end
    Ok(ItEnum(name, rev_str(tparams), rev_var(variants)))
end

# 枚举变体（宿主 parse_enum_variant：Name 或 Name(Types)；跨行 ( 不视为参数）
fn parse_enum_variant(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>) -> Result<VarR, String>
    let vname = parse_ident(ts, n, pm)?
    if chk(ts, n, pm, TkLParen) and !newline_before(ts, n, pm)
        adv(ts, n, pm)
        let mut fs = list_empty()
        if !chk(ts, n, pm, TkRParen)
            let mut go = True
            while go
                fs = list_cons(parse_type(ts, n, pm)?, fs)
                if !mt(ts, n, pm, TkComma)
                    go = False
                end
            end
        end
        expt(ts, n, pm, TkRParen, "')' (闭合变体参数)")?
        Ok(VarR(vname, rev_ty(fs)))
    else
        Ok(VarR(vname, list_empty()))
    end
end

# ============================================================================
# Part C4：块 / 语句 / 表达式 / 模式解析（对齐宿主 parse_block 族 + Pratt 链）
#   注意：Lom 无 break/continue，循环提前退出一律用 flag；无 TCO，链式左结合
#   在宿主是循环、这里也保持循环（不递归）
# ============================================================================

# stmts 中是否存在裸表达式语句（parse_block 的 if_can_be_tail 判定用）
fn has_expr_stmt(stmts: List<St>) -> Bool
    let mut cur = stmts
    let mut found = False
    while !list_is_empty(cur) and found == False
        match list_head(cur)
            StExpr(_) =>
                found = True
            end
            _ =>
                cur = list_tail(cur)
            end
        end
    end
    found
end

# 复合赋值（宿主 match_compound_assign：换行守卫 + op 映射；返回 dump 形态 op 名）
fn match_compound_assign(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>) -> Option<String>
    if newline_before(ts, n, pm)
        None
    else
        match pk_tk(ts, n, pm)
            TkPlusEq =>
                adv(ts, n, pm)
                Some("Add")
            end
            TkMinusEq =>
                adv(ts, n, pm)
                Some("Sub")
            end
            TkStarEq =>
                adv(ts, n, pm)
                Some("Mul")
            end
            TkSlashEq =>
                adv(ts, n, pm)
                Some("Div")
            end
            _ => None
        end
    end
end

# 块元素解析（宿主 parse_block_el；ict = if_can_be_tail）
fn parse_block_el(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>, ict: Bool) -> Result<Bel, String>
    let d = tok_disc(pk_tk(ts, n, pm))
    if d == tok_disc(TkLet) or d == tok_disc(TkWhile) or d == tok_disc(TkFor) or d == tok_disc(TkReturn)
        match parse_stmt(ts, n, pm, em)
            Ok(s) => Ok(BStmt(s))
            Err(e) => Err(e)
        end
    elif d == tok_disc(TkIf)
        let ifr = parse_if(ts, n, pm, em)?
        let d2 = tok_disc(pk_tk(ts, n, pm))
        if ict and (d2 == tok_disc(TkEnd) or d2 == tok_disc(TkElif) or d2 == tok_disc(TkElse) or d2 == tok_disc(TkEof))
            Ok(BTail(ExIf(ifr)))
        else
            Ok(BStmt(StIf(ifr)))
        end
    else
        let e = parse_expr(ts, n, pm, em)?
        if chk(ts, n, pm, TkAssign)
            adv(ts, n, pm)
            let value = parse_expr(ts, n, pm, em)?
            match e
                ExIdent(name, tln, tcl) => Ok(BStmt(StAssign(name, tln, tcl, value)))
                _ => Err(err_here(ts, n, pm, "赋值目标必须是变量"))
            end
        else
            match match_compound_assign(ts, n, pm)
                Some(op) =>
                    let rhs = parse_expr(ts, n, pm, em)?
                    match e
                        ExIdent(name, tln, tcl) => Ok(BStmt(StAssign(name, tln, tcl, ExBinary(op, ExIdent(name, tln, tcl), rhs))))
                        _ => Err(err_here(ts, n, pm, "复合赋值目标必须是变量"))
                    end
                end
                None =>
                    let d3 = tok_disc(pk_tk(ts, n, pm))
                    if d3 == tok_disc(TkEnd) or d3 == tok_disc(TkElif) or d3 == tok_disc(TkElse) or d3 == tok_disc(TkEof)
                        Ok(BTail(e))
                    else
                        Ok(BStmt(StExpr(e)))
                    end
                end
            end
        end
    end
end

# 块解析（宿主 parse_block：终止于 end/elif/else/eof，只消费 end；容错插 Hole）
fn parse_block(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Result<Blk, String>
    let mut stmts = list_empty()
    let mut tail = None
    let mut has_tail = False
    let mut go = True
    while go and !chk(ts, n, pm, TkEnd) and !chk(ts, n, pm, TkElif) and !chk(ts, n, pm, TkElse) and !chk(ts, n, pm, TkEof)
        let ict = has_tail == False and has_expr_stmt(stmts) == False
        let saved = get_pos(pm)
        match parse_block_el(ts, n, pm, em, ict)
            Ok(BStmt(s)) =>
                stmts = list_cons(s, stmts)
            end
            Ok(BTail(e)) =>
                tail = Some(e)
                has_tail = True
                go = False
            end
            Err(e) =>
                let r = unpack_err(e)
                em_add(em, classify_parse_msg(r.msg), r.ln, r.cl, r.msg)
                stmts = list_cons(StHole(r.ln, r.cl), stmts)
                sync_to_stmt_boundary(ts, n, pm)
                ensure_progress(ts, n, pm, saved)
            end
        end
    end
    if chk(ts, n, pm, TkEnd)
        adv(ts, n, pm)
    elif chk(ts, n, pm, TkEof)
        # R57（九审）：EOF 不得静默闭合块（与宿主 parse_block 对齐：
        # 记录诊断但保留已解析块——带洞语义，fn 项不丢）
        let t = tok_at(ts, n, get_pos(pm))
        em_add(em, classify_parse_msg("期望 'end' (块闭合)，得到 文件结束"), t.ln, t.cl, "期望 'end' (块闭合)，得到 文件结束")
    end
    Ok(BlkOf(rev_st(stmts), tail))
end

# 语句解析（宿主 parse_stmt）
fn parse_stmt(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Result<St, String>
    let d = tok_disc(pk_tk(ts, n, pm))
    if d == tok_disc(TkLet)
        parse_let(ts, n, pm, em)
    elif d == tok_disc(TkIf)
        Ok(StIf(parse_if(ts, n, pm, em)?))
    elif d == tok_disc(TkWhile)
        parse_while(ts, n, pm, em)
    elif d == tok_disc(TkFor)
        parse_for(ts, n, pm, em)
    elif d == tok_disc(TkReturn)
        parse_return(ts, n, pm, em)
    else
        Ok(StExpr(parse_expr(ts, n, pm, em)?))
    end
end

# let [mut] name [: type] = expr / let (a, b) = expr（宿主 parse_let + parse_let_destruct）
fn parse_let(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Result<St, String>
    let _ = adv(ts, n, pm)
    let mutable = mt(ts, n, pm, TkMut)
    if chk(ts, n, pm, TkLParen)
        if mutable
            Err(err_here(ts, n, pm, "元组解构不支持 mut（解构绑定不可变）"))
        else
            adv(ts, n, pm)
            let mut names = list_empty()
            let mut go = True
            while go
                names = list_cons(parse_ident(ts, n, pm)?, names)
                if !mt(ts, n, pm, TkComma)
                    go = False
                elif chk(ts, n, pm, TkRParen)
                    go = False
                else
                    ()
                end
            end
            expt(ts, n, pm, TkRParen, "')'")?
            expt(ts, n, pm, TkAssign, "'='")?
            let value = parse_expr(ts, n, pm, em)?
            Ok(StDestruct(rev_str(names), value))
        end
    else
        let name = parse_ident(ts, n, pm)?
        let ty =
        if mt(ts, n, pm, TkColon)
            Some(parse_type(ts, n, pm)?)
        else
            None
        end
        expt(ts, n, pm, TkAssign, "'='")?
        let value = parse_expr(ts, n, pm, em)?
        Ok(StLet(mutable, name, ty, value))
    end
end

# if/elif/else（宿主 parse_if：分支与 else 块都由 parse_block 闭合）
fn parse_if(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Result<IfR, String>
    adv(ts, n, pm)
    let cond = parse_expr(ts, n, pm, em)?
    let body = parse_block(ts, n, pm, em)?
    let mut branches = list_cons((cond, body), list_empty())
    let mut els = None
    let mut has_else = False
    let mut go = True
    while go
        if mt(ts, n, pm, TkElif)
            let c = parse_expr(ts, n, pm, em)?
            let b = parse_block(ts, n, pm, em)?
            branches = list_cons((c, b), branches)
        else
            go = False
        end
    end
    if mt(ts, n, pm, TkElse)
        els = Some(parse_block(ts, n, pm, em)?)
        has_else = True
    else
        ()
    end
    Ok(IfR(rev_branch(branches), els))
end

fn parse_while(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Result<St, String>
    adv(ts, n, pm)
    let cond = parse_expr(ts, n, pm, em)?
    let body = parse_block(ts, n, pm, em)?
    Ok(StWhile(cond, body))
end

fn parse_for(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Result<St, String>
    adv(ts, n, pm)
    let var = parse_ident(ts, n, pm)?
    expt(ts, n, pm, TkIn, "'in'")?
    let iter = parse_expr(ts, n, pm, em)?
    let body = parse_block(ts, n, pm, em)?
    Ok(StFor(var, iter, body))
end

fn parse_return(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Result<St, String>
    let _ = adv(ts, n, pm)
    if chk(ts, n, pm, TkEnd) or chk(ts, n, pm, TkEof)
        Ok(StReturn(None))
    else
        Ok(StReturn(Some(parse_expr(ts, n, pm, em)?)))
    end
end

# ============================================================================
# Pratt 优先级链（宿主 parse_expr 族；span 逻辑全部省略——dump 契约无位置）
#   range(最低，非结合) < or < and < comparison < pipeline < add < mul < unary < ? < postfix
# ============================================================================

fn parse_expr(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Result<Ex, String>
    parse_range(ts, n, pm, em)
end

# range：a..b 非结合，换行守卫（宿主 parse_range）
fn parse_range(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Result<Ex, String>
    let start = parse_or(ts, n, pm, em)?
    if newline_before(ts, n, pm) == False and mt(ts, n, pm, TkDotDot)
        let end_e = parse_or(ts, n, pm, em)?
        Ok(ExRange(start, end_e))
    else
        Ok(start)
    end
end

fn parse_or(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Result<Ex, String>
    let mut left = parse_and(ts, n, pm, em)?
    let mut go = True
    while go
        if mt(ts, n, pm, TkOr)
            let right = parse_and(ts, n, pm, em)?
            left = ExLogical("Or", left, right)
        else
            go = False
        end
    end
    Ok(left)
end

fn parse_and(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Result<Ex, String>
    let mut left = parse_comparison(ts, n, pm, em)?
    let mut go = True
    while go
        if mt(ts, n, pm, TkAnd)
            let right = parse_comparison(ts, n, pm, em)?
            left = ExLogical("And", left, right)
        else
            go = False
        end
    end
    Ok(left)
end

fn parse_comparison(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Result<Ex, String>
    let mut left = parse_pipeline(ts, n, pm, em)?
    let mut go = True
    while go
        let d = tok_disc(pk_tk(ts, n, pm))
        if d == tok_disc(TkEq)
            adv(ts, n, pm)
            left = ExBinary("Eq", left, parse_pipeline(ts, n, pm, em)?)
        elif d == tok_disc(TkNotEq)
            adv(ts, n, pm)
            left = ExBinary("NotEq", left, parse_pipeline(ts, n, pm, em)?)
        elif d == tok_disc(TkLt)
            adv(ts, n, pm)
            left = ExBinary("Lt", left, parse_pipeline(ts, n, pm, em)?)
        elif d == tok_disc(TkGt)
            adv(ts, n, pm)
            left = ExBinary("Gt", left, parse_pipeline(ts, n, pm, em)?)
        elif d == tok_disc(TkLtEq)
            adv(ts, n, pm)
            left = ExBinary("LtEq", left, parse_pipeline(ts, n, pm, em)?)
        elif d == tok_disc(TkGtEq)
            adv(ts, n, pm)
            left = ExBinary("GtEq", left, parse_pipeline(ts, n, pm, em)?)
        else
            go = False
        end
    end
    Ok(left)
end

# pipeline：|> 左结合（宿主 parse_pipeline）
fn parse_pipeline(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Result<Ex, String>
    let mut left = parse_addition(ts, n, pm, em)?
    let mut go = True
    while go
        if mt(ts, n, pm, TkPipe)
            let right = parse_addition(ts, n, pm, em)?
            left = ExPipe(left, right)
        else
            go = False
        end
    end
    Ok(left)
end

fn parse_addition(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Result<Ex, String>
    let mut left = parse_multiplication(ts, n, pm, em)?
    let mut go = True
    while go
        let d = tok_disc(pk_tk(ts, n, pm))
        if d == tok_disc(TkPlus)
            adv(ts, n, pm)
            left = ExBinary("Add", left, parse_multiplication(ts, n, pm, em)?)
        elif d == tok_disc(TkMinus)
            # 跨行的 - 视为一元取负（宿主：避免 "0\n-1" 解析为 "0 - 1"）
            if newline_before(ts, n, pm)
                go = False
            else
                adv(ts, n, pm)
                left = ExBinary("Sub", left, parse_multiplication(ts, n, pm, em)?)
            end
        else
            go = False
        end
    end
    Ok(left)
end

fn parse_multiplication(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Result<Ex, String>
    let mut left = parse_unary(ts, n, pm, em)?
    let mut go = True
    while go
        let d = tok_disc(pk_tk(ts, n, pm))
        if d == tok_disc(TkStar)
            adv(ts, n, pm)
            left = ExBinary("Mul", left, parse_unary(ts, n, pm, em)?)
        elif d == tok_disc(TkSlash)
            adv(ts, n, pm)
            left = ExBinary("Div", left, parse_unary(ts, n, pm, em)?)
        elif d == tok_disc(TkPercent)
            adv(ts, n, pm)
            left = ExBinary("Mod", left, parse_unary(ts, n, pm, em)?)
        else
            go = False
        end
    end
    Ok(left)
end

fn parse_unary(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Result<Ex, String>
    let d = tok_disc(pk_tk(ts, n, pm))
    if d == tok_disc(TkBang)
        adv(ts, n, pm)
        let inner = parse_unary(ts, n, pm, em)?
        Ok(ExUnary("Not", inner))
    elif d == tok_disc(TkMinus)
        adv(ts, n, pm)
        let inner = parse_unary(ts, n, pm, em)?
        Ok(ExUnary("Neg", inner))
    else
        parse_question(ts, n, pm, em)
    end
end

# ? 后缀（宿主 parse_question：比 postfix 低、比 unary 高）
fn parse_question(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Result<Ex, String>
    let mut expr = parse_postfix(ts, n, pm, em)?
    let mut go = True
    while go
        if mt(ts, n, pm, TkQuestion)
            expr = ExTry(expr)
        else
            go = False
        end
    end
    Ok(expr)
end

# 后缀：调用 / 索引 / 字段（宿主 parse_postfix；跨行 ( 与 [ 不视为后缀）
fn parse_postfix(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Result<Ex, String>
    let mut expr = parse_primary(ts, n, pm, em)?
    let mut go = True
    while go
        let d = tok_disc(pk_tk(ts, n, pm))
        if d == tok_disc(TkLParen)
            if newline_before(ts, n, pm)
                go = False
            else
                adv(ts, n, pm)
                let args = parse_args(ts, n, pm, em)?
                expr = ExCall(expr, args)
            end
        elif d == tok_disc(TkLBracket)
            if newline_before(ts, n, pm)
                go = False
            else
                adv(ts, n, pm)
                let index = parse_expr(ts, n, pm, em)?
                expt(ts, n, pm, TkRBracket, "']'")?
                expr = ExIndex(expr, index)
            end
        elif d == tok_disc(TkDot)
            adv(ts, n, pm)
            match pk_tk(ts, n, pm)
                TkInt(idx) =>
                    adv(ts, n, pm)
                    if idx < 0
                        return Err(err_here(ts, n, pm, "元组索引不能为负"))
                    else
                        expr = ExField(expr, int_to_string(idx))
                    end
                end
                _ =>
                    let fname = parse_ident(ts, n, pm)?
                    expr = ExField(expr, fname)
                end
            end
        else
            go = False
        end
    end
    Ok(expr)
end

# 实参列表（宿主 parse_args）
fn parse_args(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Result<List<Ex>, String>
    let mut args = list_empty()
    if !chk(ts, n, pm, TkRParen)
        let mut go = True
        while go
            args = list_cons(parse_expr(ts, n, pm, em)?, args)
            if !mt(ts, n, pm, TkComma)
                go = False
            end
        end
    end
    expt(ts, n, pm, TkRParen, "')'")?
    Ok(rev_ex(args))
end

# 主表达式（宿主 parse_primary）
fn parse_primary(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Result<Ex, String>
    match pk_tk(ts, n, pm)
        TkInt(v) =>
            adv(ts, n, pm)
            Ok(ExInt(v))
        end
        TkFloat(s) =>
            adv(ts, n, pm)
            Ok(ExFloat(s))
        end
        TkTrue =>
            adv(ts, n, pm)
            Ok(ExBool(True))
        end
        TkFalse =>
            adv(ts, n, pm)
            Ok(ExBool(False))
        end
        TkStr(s) =>
            adv(ts, n, pm)
            Ok(ExStr(s))
        end
        TkIdent(s) =>
            let tpos = tok_at(ts, n, get_pos(pm))
            adv(ts, n, pm)
            Ok(ExIdent(s, tpos.ln, tpos.cl))
        end
        TkLParen =>
            let _ = adv(ts, n, pm)
            if mt(ts, n, pm, TkRParen)
                Ok(ExUnit)
            else
                let first = parse_expr(ts, n, pm, em)?
                if mt(ts, n, pm, TkComma)
                    let mut elems = list_cons(first, list_empty())
                    let mut go = True
                    while go
                        if chk(ts, n, pm, TkRParen)
                            go = False
                        else
                            elems = list_cons(parse_expr(ts, n, pm, em)?, elems)
                            if !mt(ts, n, pm, TkComma)
                                go = False
                            end
                        end
                    end
                    expt(ts, n, pm, TkRParen, "')' (闭合元组)")?
                    Ok(ExTuple(rev_ex(elems)))
                else
                    expt(ts, n, pm, TkRParen, "')'")?
                    Ok(ExGroup(first))
                end
            end
        end
        TkLBrace => parse_record(ts, n, pm, em)
        TkFn => parse_closure(ts, n, pm, em)
        TkIf =>
            let ifr = parse_if(ts, n, pm, em)?
            Ok(ExIf(ifr))
        end
        TkMatch => parse_match(ts, n, pm, em)
        _ => Err(err_here(ts, n, pm, "期望表达式，得到 " + tok_name(pk_tk(ts, n, pm))))
    end
end

# 闭包字面量（宿主 parse_closure）
fn parse_closure(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Result<Ex, String>
    adv(ts, n, pm)
    expt(ts, n, pm, TkLParen, "'('")?
    let params = parse_params(ts, n, pm)?
    let ret =
    if mt(ts, n, pm, TkArrow)
        Some(parse_type(ts, n, pm)?)
    else
        None
    end
    let body = parse_block(ts, n, pm, em)?
    Ok(ExClosure(params, ret, body))
end

# 记录字面量（宿主 parse_record；尾随逗号允许）
fn parse_record(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Result<Ex, String>
    adv(ts, n, pm)
    let mut fields = list_empty()
    if !chk(ts, n, pm, TkRBrace)
        let mut go = True
        while go
            if chk(ts, n, pm, TkRBrace)
                go = False
            else
                let fname = parse_ident(ts, n, pm)?
                expt(ts, n, pm, TkColon, "':' (记录字段分隔)")?
                let value = parse_expr(ts, n, pm, em)?
                fields = list_cons((fname, value), fields)
                if !mt(ts, n, pm, TkComma)
                    go = False
                end
            end
        end
    end
    expt(ts, n, pm, TkRBrace, "'}' (闭合记录)")?
    Ok(ExRecord(rev_sfld(fields)))
end

# match 表达式（宿主 parse_match：容错臂级恢复——丢弃坏臂余下臂，保证 match 自闭合）
fn parse_match(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Result<Ex, String>
    let _ = adv(ts, n, pm)
    let scrutinee = parse_expr(ts, n, pm, em)?
    let mut arms = list_empty()
    let mut go = True
    while go and !chk(ts, n, pm, TkEnd) and !chk(ts, n, pm, TkEof)
        let saved = get_pos(pm)
        match parse_match_arm(ts, n, pm, em)
            Ok(arm) =>
                arms = list_cons(arm, arms)
            end
            Err(e) =>
                let r = unpack_err(e)
                em_add(em, classify_parse_msg(r.msg), r.ln, r.cl, r.msg)
                # 保守同步：跳到 match 的 end（或 eof），放弃后续臂
                while !chk(ts, n, pm, TkEnd) and !chk(ts, n, pm, TkEof)
                    adv(ts, n, pm)
                end
                ensure_progress(ts, n, pm, saved)
                go = False
            end
        end
    end
    if chk(ts, n, pm, TkEnd)
        let end_rec = tok_at(ts, n, get_pos(pm))
        adv(ts, n, pm)
        Ok(ExMatch(scrutinee, rev_arm(arms), end_rec.ln))
    else
        Err(err_here(ts, n, pm, "期望 'end' 闭合 match"))
    end
end

# match 臂（宿主 parse_match_arm：Form A 同行单表达式 / Form B 跨行块）
fn parse_match_arm(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Result<ArmR, String>
    let pattern = parse_pattern(ts, n, pm, em)?
    let guard =
    if mt(ts, n, pm, TkIf)
        Some(parse_expr(ts, n, pm, em)?)
    else
        None
    end
    let _ = expt(ts, n, pm, TkFatArrow, "'=>'")?
    if newline_before(ts, n, pm)
        let b = parse_block(ts, n, pm, em)?
        Ok(ArmR(pattern, guard, ABBlock(b)))
    else
        let e = parse_expr(ts, n, pm, em)?
        Ok(ArmR(pattern, guard, ABExpr(e)))
    end
end

# 模式（宿主 parse_pattern：字面量 / _ / 绑定 / 变体（同行 ( 才是变体））
fn parse_pattern(ts: Map<String, {t: Tok, ln: Int, cl: Int}>, n: Int, pm: Map<String, Int>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Result<Pat, String>
    match pk_tk(ts, n, pm)
        TkInt(v) =>
            adv(ts, n, pm)
            Ok(PatLit(ExInt(v)))
        end
        TkFloat(s) =>
            adv(ts, n, pm)
            Ok(PatLit(ExFloat(s)))
        end
        TkStr(s) =>
            adv(ts, n, pm)
            Ok(PatLit(ExStr(s)))
        end
        TkTrue =>
            adv(ts, n, pm)
            Ok(PatLit(ExBool(True)))
        end
        TkFalse =>
            adv(ts, n, pm)
            Ok(PatLit(ExBool(False)))
        end
        TkIdent(s) =>
            let _ = adv(ts, n, pm)
            if s == "_"
                Ok(PatWildcard)
            elif chk(ts, n, pm, TkLParen) and !newline_before(ts, n, pm)
                adv(ts, n, pm)
                let mut subs = list_empty()
                if !chk(ts, n, pm, TkRParen)
                    let mut go = True
                    while go
                        subs = list_cons(parse_pattern(ts, n, pm, em)?, subs)
                        if !mt(ts, n, pm, TkComma)
                            go = False
                        end
                    end
                end
                expt(ts, n, pm, TkRParen, "')' (闭合变体模式)")?
                Ok(PatVariant(s, rev_pat(subs)))
            else
                Ok(PatBinder(s))
            end
        end
        _ => Err(err_here(ts, n, pm, "期望模式，得到 " + tok_name(pk_tk(ts, n, pm))))
    end
end

# ============================================================================

# ============================================================================
# Part X：L2.2 子集 codegen（本文件新增——前端 A-C4 之上）
# ============================================================================

# ---- X0：字节/编码基元（自 L2.1 spike 移植） ----

fn hex_digit(n: Int) -> String
    if n < 10
        return char_from_code(48 + n)
    end
    char_from_code(97 + n - 10)
end

fn byte_hex(b: Int) -> String
    hex_digit(b / 16) + hex_digit(b % 16)
end

# LEB128 unsigned（section size / 索引 / 计数）
fn leb128_hex(n: Int) -> String
    let mut out = ""
    let mut v = n
    let mut go = True
    while go
        let mut b = v % 128
        v = v / 128
        if v > 0
            b = b + 128
        else
            go = False
        end
        out = out + byte_hex(b)
    end
    out
end

# LEB128 signed（i64.const 操作数）——无位运算实现：
#   byte = n 的非负模 128（% 截断语义下 n%128 ∈ (-128,128)，负数 +128）；
#   n' = (n - byte) / 128（精确 = 算术右移 7）；
#   停止：n'==0 且 byte<64，或 n'==-1 且 byte>=64
fn sleb128_hex(n: Int) -> String
    let mut out = ""
    let mut v = n
    let mut go = True
    while go
        let mut b = v % 128
        if b < 0
            b = b + 128
        end
        v = (v - b) / 128
        if (v == 0 and b < 64) or (v == -1 and b >= 64)
            go = False
        else
            b = b + 128
        end
        out = out + byte_hex(b)
    end
    out
end

# 整数字符串 → Float（逐位 val*10+d，< 2^53 精确）
fn int_str_to_float(s: String) -> Float
    let digits = split(s, "")
    let mut v = 0.0
    let mut i = 0
    while i < list_length(digits)
        v = v * 10.0 + string_to_int(list_get(digits, i))
        i = i + 1
    end
    v
end

# Float 字面量字符串 → Float（无 string_to_float 内建的替代实现）：
# 整数部分逐位累加；小数部分从右往左 (val+d)/10（值域 [0,1)，精度最优）。
# 已知边界：非二进制精确字面量与 Rust 正确舍入可能差——L2.2 测试集限定
# 精确可表示值，任意字面量的正确舍入留 L2.3 挂账。
fn parse_float_str(s: String) -> Float
    let parts = split(s, ".")
    let ip = int_str_to_float(list_get(parts, 0))
    if list_length(parts) == 1
        return ip
    end
    let mut frac = 0.0
    let digits = split(list_get(parts, 1), "")
    let mut i = list_length(digits) - 1
    while i >= 0
        frac = (frac + string_to_int(list_get(digits, i))) / 10.0
        i = i - 1
    end
    ip + frac
end

# 整数值 Float（< 2^53）→ Int（to_display + split + string_to_int）
fn float_int_part(fx: Float) -> Int
    let s = "" + fx
    let parts = split(s, ".")
    string_to_int(list_get(parts, 0))
end

# f64 → 8 字节小端 hex（L2.1 spike 的纯算术拆解，16 向量已验证）
fn f64_bits_le(x: Float) -> String
    if x != x
        return "000000000000f87f"
    end
    let mut sign = 0
    let mut ax = x
    if x < 0.0 or (x == 0.0 and 1.0 / x < 0.0)
        sign = 1
        ax = -x
    end
    if ax * 0.0 != 0.0
        if sign == 1
            return "000000000000f0ff"
        end
        return "000000000000f07f"
    end
    if ax == 0.0
        if sign == 1
            return "0000000000000080"
        end
        return "0000000000000000"
    end
    let mut m = ax
    let mut e = 0
    while m >= 2.0
        m = m / 2.0
        e = e + 1
    end
    while m < 1.0
        m = m * 2.0
        e = e - 1
    end
    if e < -1022
        let mut f = ax
        let mut i = 0
        while i < 1074
            f = f * 2.0
            i = i + 1
        end
        return bits_from_parts(sign, 0, float_int_part(f))
    end
    let mant = float_int_part((m - 1.0) * 4503599627370496.0)
    bits_from_parts(sign, e + 1023, mant)
end

fn bits_from_parts(sign: Int, ef: Int, mant: Int) -> String
    let mut out = ""
    let pows = list_cons(1, list_cons(256, list_cons(65536, list_cons(16777216, list_cons(4294967296, list_cons(1099511627776, list_empty()))))))
    let mut i = 0
    while i < 6
        out = out + byte_hex(mant / list_get(pows, i) % 256)
        i = i + 1
    end
    out + byte_hex((ef % 16) * 16 + mant / 281474976710656) + byte_hex(sign * 128 + ef / 16)
end

# ---- X1：子集类型系统 ----

fn subset_err(msg: String) -> String
    "L2.2 子集不支持: " + msg
end

# Ty → 值类型（"i64"|"f64"|"i32"|"cl"|"en:<name>"|"void"）。
# 泛型实例延伸为 en:Name{arg1;arg2}，其中类型参数模板为 tv:T，
# 构造时未知参数为 ?；实例编码不含逗号/@，可嵌入现有 prms/sig 字符串。
fn enum_vt(vt: String) -> Bool
    starts_with(vt, "en:")
end

# 从内部枚举 vt 拆出基名与最外层类型参数；嵌套花括号按深度配对。
fn enum_vt_parts(vt: String) -> Result<{name: String, args: List<String>}, String>
    if !enum_vt(vt)
        return Err("内部错误：非枚举 vt 进入 enum_vt_parts（" + vt + "）")
    end
    let chars = split(vt, "")
    let n = list_length(chars)
    let mut i = 3
    let mut name = ""
    while i < n and list_get(chars, i) != "{"
        name = name + list_get(chars, i)
        i = i + 1
    end
    if name == ""
        return Err("内部错误：枚举 vt 缺类型名")
    end
    if i == n
        return Ok({name: name, args: list_empty()})
    end
    i = i + 1
    let mut depth = 1
    let mut arg = ""
    let mut args = list_empty()
    while i < n
        let c = list_get(chars, i)
        if c == "{"
            depth = depth + 1
            arg = arg + c
        elif c == "}"
            depth = depth - 1
            if depth == 0
                if arg == "" or i != n - 1
                    return Err("内部错误：枚举 vt 参数编码损坏（" + vt + "）")
                end
                args = list_cons(arg, args)
            else
                arg = arg + c
            end
        elif c == ";" and depth == 1
            if arg == ""
                return Err("内部错误：枚举 vt 含空参数（" + vt + "）")
            end
            args = list_cons(arg, args)
            arg = ""
        else
            arg = arg + c
        end
        i = i + 1
    end
    if depth != 0
        return Err("内部错误：枚举 vt 花括号未闭合（" + vt + "）")
    end
    Ok({name: name, args: rev_str(args)})
end

fn enum_vt_make(name: String, args: List<String>) -> String
    if list_is_empty(args)
        return "en:" + name
    end
    let mut out = "en:" + name + "{"
    let mut first = True
    for arg in args
        if !first
            out = out + ";"
        end
        out = out + arg
        first = False
    end
    out + "}"
end

# ? 仅代表构造器未提供的信息，不代表任意动态值；已知参数必须逐层相等。
fn vt_merge(a: String, b: String) -> Result<String, String>
    if a == b
        return Ok(a)
    end
    if a == "?"
        return Ok(b)
    end
    if b == "?"
        return Ok(a)
    end
    if enum_vt(a) and enum_vt(b)
        let aa = enum_vt_parts(a)?
        let bb = enum_vt_parts(b)?
        if aa.name != bb.name or list_length(aa.args) != list_length(bb.args)
            return Err(subset_err("泛型实例类型不符（'" + a + "' vs '" + b + "'）"))
        end
        let mut merged = list_empty()
        let mut i = 0
        while i < list_length(aa.args)
            merged = list_cons(vt_merge(list_get(aa.args, i), list_get(bb.args, i))?, merged)
            i = i + 1
        end
        return Ok(enum_vt_make(aa.name, rev_str(merged)))
    end
    Err(subset_err("类型不符（'" + a + "' vs '" + b + "'）"))
end

fn vt_compatible(a: String, b: String) -> Bool
    match vt_merge(a, b)
        Ok(_) => True
        Err(_) => False
    end
end

fn type_var_name(vt: String) -> String
    let chars = split(vt, "")
    let mut out = ""
    let mut i = 3
    while i < list_length(chars)
        out = out + list_get(chars, i)
        i = i + 1
    end
    out
end

# 枚举实例参数 → 模板参数环境；非泛型 enum 的环境为空。
fn enum_inst_env(inst_vt: String, fns: Map<String, {idx: Int, ret: String, nprm: Int, prms: String}>) -> Result<Map<String, String>, String>
    let parts = enum_vt_parts(inst_vt)?
    let meta = match map_get(fns, "@enum:" + parts.name)
        Some(m) => m
        None => {idx: -1, ret: "", nprm: -1, prms: ""}
    end
    if meta.nprm < 0 or list_length(parts.args) != meta.nprm
        return Err(subset_err("枚举实例类型参数数不符（'" + inst_vt + "'）"))
    end
    let out = map_empty()
    if meta.nprm > 0
        let names = split(meta.prms, ",")
        let mut i = 0
        while i < meta.nprm
            map_set(out, list_get(names, i), list_get(parts.args, i))
            i = i + 1
        end
    end
    Ok(out)
end

# 模板载荷类型按具体实例替换；嵌套 enum/Result/Option 递归处理。
fn template_resolve(tpl: String, subs: Map<String, String>) -> Result<String, String>
    if starts_with(tpl, "tv:")
        let key = type_var_name(tpl)
        match map_get(subs, key)
            Some(v) => Ok(v)
            None => Err(subset_err("未声明的枚举类型参数 '" + key + "'"))
        end
    elif enum_vt(tpl)
        let parts = enum_vt_parts(tpl)?
        let mut args = list_empty()
        for arg in parts.args
            args = list_cons(template_resolve(arg, subs)?, args)
        end
        Ok(enum_vt_make(parts.name, rev_str(args)))
    else
        Ok(tpl)
    end
end

# 构造器载荷对模板做结构统一；重复出现的同一参数必须一致。
fn template_unify(tpl: String, got: String, subs: Map<String, String>) -> Result<Unit, String>
    if starts_with(tpl, "tv:")
        let key = type_var_name(tpl)
        match map_get(subs, key)
            Some(old) =>
                map_set(subs, key, vt_merge(old, got)?)
                Ok(())
            end
            None => Err(subset_err("未声明的枚举类型参数 '" + key + "'"))
        end
    elif enum_vt(tpl)
        if !enum_vt(got)
            return Err(subset_err("枚举载荷类型不符（期望 '" + tpl + "' 得 '" + got + "'）"))
        end
        let a = enum_vt_parts(tpl)?
        let b = enum_vt_parts(got)?
        if a.name != b.name or list_length(a.args) != list_length(b.args)
            return Err(subset_err("枚举载荷类型不符（期望 '" + tpl + "' 得 '" + got + "'）"))
        end
        let mut i = 0
        while i < list_length(a.args)
            template_unify(list_get(a.args, i), list_get(b.args, i), subs)?
            i = i + 1
        end
        Ok(())
    else
        if vt_compatible(tpl, got)
            Ok(())
        else
            Err(subset_err("载荷类型不符（期望 '" + tpl + "' 得 '" + got + "'）"))
        end
    end
end

fn ty_vt_with_params(t: Ty, fns: Map<String, {idx: Int, ret: String, nprm: Int, prms: String}>, tparams: List<String>) -> Result<String, String>
    match t
        TyInt => Ok("i64")
        TyFloat => Ok("f64")
        TyBool => Ok("i32")
        TyUnit => Ok("void")
        TyString => Ok("st")
        TyNamed(s) =>
            if name_in(tparams, s)
                Ok("tv:" + s)
            elif s == "Fn"
                Err(subset_err("Fn 类型注解留后续批次（untagged call_indirect 需精确签名）"))
            else
                match map_get(fns, "@enum:" + s)
                    Some(meta) =>
                        if meta.nprm != 0
                            Err(subset_err("泛型枚举类型 '" + s + "' 期望 " + meta.nprm + " 个类型参数"))
                        else
                            Ok("en:" + s)
                        end
                    end
                    None => Err(subset_err("未知或子集外枚举类型 '" + s + "'"))
                end
            end
        end
        TyGeneric(name, args) =>
            let meta = match map_get(fns, "@enum:" + name)
                Some(m) => m
                None => {idx: -1, ret: "", nprm: -1, prms: ""}
            end
            if meta.nprm < 0
                return Err(subset_err("未知泛型枚举类型 '" + name + "'"))
            end
            if list_length(args) != meta.nprm or meta.nprm == 0
                return Err(subset_err("泛型枚举类型 '" + name + "' 类型参数数不符（期望 " + meta.nprm + " 得 " + list_length(args) + "）"))
            end
            let mut out = list_empty()
            for arg in args
                let vt = ty_vt_with_params(arg, fns, tparams)?
                if vt == "void" or vt == "cl"
                    return Err(subset_err("泛型类型参数暂不支持 Unit/Fn（'" + name + "'）"))
                end
                out = list_cons(vt, out)
            end
            Ok(enum_vt_make(name, rev_str(out)))
        end
        TyOption(inner) =>
            let vt = ty_vt_with_params(inner, fns, tparams)?
            if vt == "void" or vt == "cl"
                return Err(subset_err("Option 类型参数暂不支持 Unit/Fn"))
            end
            Ok(enum_vt_make("Option", list_cons(vt, list_empty())))
        end
        TResult(ok_ty, err_ty) =>
            let ok_vt = ty_vt_with_params(ok_ty, fns, tparams)?
            let err_vt = ty_vt_with_params(err_ty, fns, tparams)?
            if ok_vt == "void" or err_vt == "void" or ok_vt == "cl" or err_vt == "cl"
                return Err(subset_err("Result 类型参数暂不支持 Unit/Fn"))
            end
            Ok(enum_vt_make("Result", list_cons(ok_vt, list_cons(err_vt, list_empty()))))
        end
        _ => Err(subset_err("该参数/返回类型（String/List/Map/记录/元组留后续批次）"))
    end
end

fn ty_vt(t: Ty, fns: Map<String, {idx: Int, ret: String, nprm: Int, prms: String}>) -> Result<String, String>
    ty_vt_with_params(t, fns, list_empty())
end

# Option<Ty> → 值类型（None = 无返回 = void）
fn tyopt_vt(t: Option<Ty>, fns: Map<String, {idx: Int, ret: String, nprm: Int, prms: String}>) -> Result<String, String>
    match t
        None => Ok("void")
        Some(tt) => ty_vt(tt, fns)
    end
end

fn vt_hex(vt: String) -> String
    if vt == "i64" or enum_vt(vt) or vt == "st"
        "7e"
    else
        if vt == "i32"
            "7f"
        else
            # f64 = 7c；cl/enum = i64 裸指针（编译期 vt 跟踪）= 7e
            if vt == "cl"
                "7e"
            else
                "7c"
            end
        end
    end
end

# ============================================================================
# L2.3-b：闭包签名编码与综合（designs/0001 §7.1）
#
# sig 编码（避免 split 歧义——prms/ret 用 "@" 分隔，嵌套闭包用 "cl" 前缀
# 递归编码，解析手写扫描不用 split）：
#   sig   ::= prms "@" ret_seg          prms = vt 逗号串（"i64,f64"，可空）
#   ret_seg ::= "i64"|"f64"|"i32"|"void"|"cl" sig   （返回闭包 → "cl"+内层 sig）
# 例：Int->Int 闭包 = "i64@i64"；返回 Int->Int 闭包的函数 = "i64@cli64@i64"
# ============================================================================

# 第一个 "@" 的位置（无 "@" 返回串长——调用方保证存在）
fn sig_at(s: String) -> Int
    let n = len(s)
    let mut i = 0
    let mut found = n
    while i < n
        if list_get(split(s, ""), i) == "@"
            found = i
            i = n
        else
            i = i + 1
        end
    end
    found
end

fn mk_sig(ps: String, rv: String) -> String
    ps + "@" + rv
end

fn sig_ps(sig: String) -> String
    str_take(sig, sig_at(sig))
end

# "@" 之后全部（含嵌套 "cl"+sig）
fn sig_rv(sig: String) -> String
    let at = sig_at(sig)
    let n = len(sig)
    let chars = split(sig, "")
    let mut out = ""
    let mut i = at + 1
    while i < n
        out = out + list_get(chars, i)
        i = i + 1
    end
    out
end

fn sig_nprm(sig: String) -> Int
    let ps = sig_ps(sig)
    if ps == ""
        0
    else
        let cs = split(ps, ",")
        list_length(cs)
    end
end

fn sig_prm_at(sig: String, i: Int) -> String
    let cs = split(sig_ps(sig), ",")
    list_get(cs, i)
end

# 返回段是否闭包（"cl" 前缀——base vt 无 "cl" 开头者，前缀判定安全）
fn rv_is_cl(rv: String) -> Bool
    starts_with(rv, "cl")
end

# 返回段 → vt（"cl…" → "cl"）
fn rv_vt(rv: String) -> String
    if rv_is_cl(rv)
        "cl"
    else
        rv
    end
end

# sig → 闭包函数 type 条目 hex：60 (nprm+1) [7e env] [prms...] [00|01 rvhex]
# （env 参数 i64；prms 各按 vt；ret void → 00，否则 01 + vt_hex）
fn sig_type_hex(sig: String) -> String
    let ps = sig_ps(sig)
    let n = sig_nprm(sig)
    let mut ent = "60" + leb128_hex(n + 1) + "7e"
    if n > 0
        let cs = split(ps, ",")
        let mut i = 0
        while i < n
            ent = ent + vt_hex(list_get(cs, i))
            i = i + 1
        end
    end
    let rv = sig_rv(sig)
    if rv_vt(rv) == "void"
        ent + "00"
    else
        ent + "01" + vt_hex(rv_vt(rv))
    end
end

# 闭包返回段综合：reto Some → ty_vt（Fn 拒）；None → 体尾 ex_rv（嵌套闭包
# 递归编码）。env' = 闭包参数 + 捕获绑定（由调用方构造——compile_closure
# 的 caps 或外层上下文）。
fn closure_rv(reto: Option<Ty>, body: Blk, env2: Map<String, {slot: Int, vt: String, sig: String, cap: Bool}>, fns: Map<String, {idx: Int, ret: String, nprm: Int, prms: String}>) -> Result<String, String>
    match reto
        Some(t) => ty_vt(t, fns)
        None => blk_rv(body, env2, fns)
    end
end

# 闭包完整签名：ps（参数 vt 逗号串）+ "@" + rv
fn closure_sig(params: List<Prm>, reto: Option<Ty>, body: Blk, env2: Map<String, {slot: Int, vt: String, sig: String, cap: Bool}>, fns: Map<String, {idx: Int, ret: String, nprm: Int, prms: String}>) -> Result<String, String>
    let mut ps = ""
    let mut k = 0
    for p in params
        match p
            Prm(_, pt) =>
                if k > 0
                    ps = ps + ","
                end
                ps = ps + ty_vt(pt, fns)?
            end
        end
        k = k + 1
    end
    let rv = closure_rv(reto, body, env2, fns)?
    Ok(mk_sig(ps, rv))
end

# 构造器签名校验；与调用点 R74 同为编译期拒绝，不把坏类型留到 wasm 实例化。
fn variant_call_type(name: String, args: List<Ex>, env: Map<String, {slot: Int, vt: String, sig: String, cap: Bool}>, fns: Map<String, {idx: Int, ret: String, nprm: Int, prms: String}>) -> Result<String, String>
    match map_get(fns, "@variant:" + name)
        None => Err(subset_err("未知枚举变体 '" + name + "'"))
        Some(v) =>
            if list_length(args) != v.nprm
                return Err(subset_err("变体 '" + name + "' 实参数不符（期望 " + v.nprm + " 得 " + list_length(args) + "）"))
            end
            let owner_parts = enum_vt_parts(v.ret)?
            let owner = owner_parts.name
            let enum_meta = match map_get(fns, "@enum:" + owner)
                Some(m) => m
                None => {idx: -1, ret: "", nprm: -1, prms: ""}
            end
            if enum_meta.nprm < 0
                return Err("内部错误：变体 '" + name + "' 缺所属枚举")
            end
            let subs = map_empty()
            if enum_meta.nprm > 0
                for tp in split(enum_meta.prms, ",")
                    map_set(subs, tp, "?")
                end
            end
            if v.nprm > 0
                let wants = split(v.prms, ",")
                let mut i = 0
                while i < v.nprm
                    let got = infer_ex(list_get(args, i), env, fns)?
                    let want = list_get(wants, i)
                    if got == "void" or got == "cl"
                        return Err(subset_err("变体 '" + name + "' 第 " + (i + 1) + " 参类型不支持（" + got + "）"))
                    end
                    let unified = template_unify(want, got, subs)
                    let valid = match unified
                        Ok(_) => True
                        Err(_) => False
                    end
                    if !valid
                        return Err(subset_err("变体 '" + name + "' 第 " + (i + 1) + " 参类型不符（期望 " + want + " 得 " + got + "）"))
                    end
                    i = i + 1
                end
            end
            let mut inst_args = list_empty()
            if enum_meta.nprm > 0
                for tp in split(enum_meta.prms, ",")
                    let bound = match map_get(subs, tp)
                        Some(vt) => vt
                        None => "?"
                    end
                    inst_args = list_cons(bound, inst_args)
                end
            end
            Ok(enum_vt_make(owner, rev_str(inst_args)))
        end
    end
end

# 表达式的"返回段"综合（作为函数返回值时）：闭包值 → "cl"+sig（嵌套递归）；
# 闭包调用的结果 = 被调 rv 段原样；其余 = infer_ex 的 base vt
fn ex_rv(e: Ex, env: Map<String, {slot: Int, vt: String, sig: String, cap: Bool}>, fns: Map<String, {idx: Int, ret: String, nprm: Int, prms: String}>) -> Result<String, String>
    match e
        ExClosure(params, reto, body) =>
            let s = closure_sig(params, reto, body, env, fns)?
            Ok("cl" + s)
        end
        ExIdent(x, _, _) =>
            match map_get(env, x)
                Some(b) =>
                    if b.vt == "cl"
                        Ok("cl" + b.sig)
                    else
                        Ok(b.vt)
                    end
                end
                None =>
                    if map_has(fns, "@variant:" + x)
                        variant_call_type(x, list_empty(), env, fns)
                    else
                        match map_get(fns, x)
                            Some(fi) => Ok("cl" + mk_sig(fi.prms, fi.ret))
                            None => Err("未定义变量 '" + x + "'")
                        end
                    end
                end
            end
        end
        ExCall(callee, args) =>
            # 直调（println/fns）→ ret；闭包调用 → 被调 rv 段原样
            match callee
                ExIdent(name, _, _) =>
                    if map_has(env, name) == False and map_has(fns, "@variant:" + name)
                        variant_call_type(name, args, env, fns)
                    elif name == "println"
                        Ok("void")
                    else
                        match map_get(fns, name)
                            Some(fi) => Ok(fi.ret)
                            None =>
                                let s = ex_sig(callee, env, fns)?
                                Ok(sig_rv(s))
                            end
                        end
                    end
                end
                _ =>
                    let s = ex_sig(callee, env, fns)?
                    Ok(sig_rv(s))
                end
            end
        end
        ExGroup(inner) => ex_rv(inner, env, fns)
        ExIf(ifr) =>
            # 对齐 infer_if_expr 口径：无 else 仅 void 语境（各分支 rv 须
            # void）；有 else 各分支 rv 与 else 一致
            match ifr
                IfR(branches, else_b) =>
                    match else_b
                        None =>
                            for pair in branches
                                let br = blk_rv(pair.1, env, fns)?
                                if br != "void"
                                    return Err(subset_err("非 void 语境的 if 必须带 else（分支返回 '" + br + "'）"))
                                end
                            end
                            Ok("void")
                        end
                        Some(eb) =>
                            let mut out = blk_rv(eb, env, fns)?
                            for pair in branches
                                let br = blk_rv(pair.1, env, fns)?
                                let merged = match vt_merge(out, br)
                                    Ok(vt) => vt
                                    Err(_) => ""
                                end
                                if merged == ""
                                    return Err(subset_err("if 表达式分支返回类型不一致（'" + out + "' vs '" + br + "'）"))
                                end
                                out = merged
                            end
                            Ok(out)
                        end
                    end
                end
            end
        end
        _ => infer_ex(e, env, fns)
    end
end

# 块的返回段（尾表达式 ex_rv；无尾 = void）
fn blk_rv(b: Blk, env: Map<String, {slot: Int, vt: String, sig: String, cap: Bool}>, fns: Map<String, {idx: Int, ret: String, nprm: Int, prms: String}>) -> Result<String, String>
    match b
        BlkOf(stmts, tail) =>
            let block_env = copy_bindings(env)
            scan_block_lets(stmts, block_env, fns, "")?
            match tail
                None => Ok("void")
                Some(te) => ex_rv(te, block_env, fns)
            end
        end
    end
end

# 表达式为闭包值时的完整签名（调用点/绑定处取 sig 用）
fn ex_sig(e: Ex, env: Map<String, {slot: Int, vt: String, sig: String, cap: Bool}>, fns: Map<String, {idx: Int, ret: String, nprm: Int, prms: String}>) -> Result<String, String>
    match e
        ExClosure(params, reto, body) => closure_sig(params, reto, body, env, fns)
        ExIdent(x, _, _) =>
            match map_get(env, x)
                Some(b) => Ok(b.sig)
                None =>
                    match map_get(fns, x)
                        Some(fi) => Ok(mk_sig(fi.prms, fi.ret))
                        None => Err("未定义变量 '" + x + "'")
                    end
                end
            end
        end
        ExCall(callee, _) =>
            let s = ex_sig(callee, env, fns)?
            let rv = sig_rv(s)
            if rv_is_cl(rv)
                # 去掉 "cl" 前缀 → 内层闭包的完整 sig
                let chars = split(rv, "")
                let n = list_length(chars)
                let mut out = ""
                let mut i = 2
                while i < n
                    out = out + list_get(chars, i)
                    i = i + 1
                end
                Ok(out)
            else
                Err(subset_err("调用结果的返回值不是闭包"))
            end
        end
        ExGroup(inner) => ex_sig(inner, env, fns)
        ExIf(ifr) =>
            match ifr
                IfR(branches, else_b) =>
                    match else_b
                        None => Err(subset_err("闭包值语境的 if 必须带 else"))
                        Some(eb) =>
                            let first = blk_rv(eb, env, fns)?
                            for pair in branches
                                let br = blk_rv(pair.1, env, fns)?
                                if br != first
                                    return Err(subset_err("if 表达式分支闭包签名不一致"))
                                end
                            end
                            if rv_is_cl(first)
                                let chars = split(first, "")
                                let n = list_length(chars)
                                let mut out = ""
                                let mut i = 2
                                while i < n
                                    out = out + list_get(chars, i)
                                    i = i + 1
                                end
                                Ok(out)
                            else
                                Err(subset_err("if 表达式分支不是闭包值"))
                            end
                        end
                    end
                end
            end
        end
        _ => Err(subset_err("该表达式不是闭包值"))
    end
end

# ExCall 的类型辅助：println → void；用户函数 → 签名 ret
fn infer_call(name: String, fns: Map<String, {idx: Int, ret: String, nprm: Int, prms: String}>) -> Result<String, String>
    if name == "println"
        Ok("void")
    else
        match map_get(fns, name)
            Some(fi) => Ok(fi.ret)
            None => Err("调用未知函数 '" + name + "'（内建只支持 println）")
        end
    end
end

# 表达式类型综合；env: Map<name, {slot, vt}>；fns: Map<name, {idx, ret, nprm}>
fn infer_ex(e: Ex, env: Map<String, {slot: Int, vt: String, sig: String, cap: Bool}>, fns: Map<String, {idx: Int, ret: String, nprm: Int, prms: String}>) -> Result<String, String>
    match e
        ExInt(_) => Ok("i64")
        ExFloat(_) => Ok("f64")
        ExBool(_) => Ok("i32")
        ExStr(_) => Ok("st")
        ExUnit => Ok("void")
        ExGroup(inner) => infer_ex(inner, env, fns)
        ExClosure(_, _, _) =>
            # L2.3-b：闭包字面量 → 闭包值（参数/返回子集外类型在闭包编译层拒）
            Ok("cl")
        end
        ExIdent(x, _, _) =>
            match map_get(env, x)
                Some(b) => Ok(b.vt)
                None =>
                    if map_has(fns, "@variant:" + x)
                        variant_call_type(x, list_empty(), env, fns)
                    else
                        # L2.3-b：具名函数当值（v0.4.2 宿主语义）
                        match map_get(fns, x)
                            Some(_) => Ok("cl")
                            None => Err("未定义变量 '" + x + "'")
                        end
                    end
                end
            end
        end
        ExUnary(op, inner) =>
            if op == "Not"
                # L2.3-a：! 综合 Bool（操作数须 Bool）
                let it = infer_ex(inner, env, fns)?
                if it != "i32"
                    return Err(subset_err("逻辑非操作数须为 Bool"))
                end
                return Ok("i32")
            end
            if op != "Neg"
                return Err(subset_err("一元运算 '" + op + "'"))
            end
            # 闭包与枚举裸指针不参与一元负。
            let itn = infer_ex(inner, env, fns)?
            if itn == "cl" or enum_vt(itn) or itn == "st"
                return Err(subset_err("闭包/枚举/String 值参与一元负"))
            end
            if itn == "i32"
                return Err(subset_err("Bool 参与一元负"))
            end
            Ok(itn)
        end
        ExBinary(op, l, r) =>
            if is_cmp_op(op)
                # L2.3-a：比较运算产 Bool（i32）——操作数 void/cl 拒绝，
                # Int/Float 混合按宿主提升语义比较
                let lt = infer_ex(l, env, fns)?
                let rt = infer_ex(r, env, fns)?
                if lt == "void" or rt == "void"
                    return Err(subset_err("void 参与比较"))
                end
                if lt == "st" or rt == "st"
                    if lt == "st" and rt == "st"
                        return Ok("i32")
                    end
                    return Err(subset_err("String 与非 String 比较（L2 子集外；宿主跨类型比较是运行时行为）"))
                end
                if lt == "cl" or rt == "cl" or enum_vt(lt) or enum_vt(rt)
                    return Err(subset_err("闭包/枚举值参与比较（结构相等留后续批次）"))
                end
                if (lt == "i32" and rt != "i32") or (rt == "i32" and lt != "i32")
                    return Err(subset_err("Bool 与非 Bool 比较（L2 子集外）"))
                end
                return Ok("i32")
            end
            if op != "Add" and op != "Sub" and op != "Mul" and op != "Div" and op != "Mod"
                return Err(subset_err("二元运算 '" + op + "'"))
            end
            let lt = infer_ex(l, env, fns)?
            let rt = infer_ex(r, env, fns)?
            if op == "Add" and (lt == "st" or rt == "st")
                # 拼接提升（v0.4.1 宿主语义）：任一侧 String → 两侧 to_display 后拼接。
                # Bool/Unit 侧经显示串；枚举/闭包显示留后续。
                if lt == "cl" or rt == "cl" or enum_vt(lt) or enum_vt(rt)
                    return Err(subset_err("闭包/枚举值的显示留后续批次（拼接提升）"))
                end
                return Ok("st")
            end
            if lt == "void" or rt == "void"
                return Err(subset_err("void 参与算术"))
            end
            if lt == "cl" or rt == "cl" or enum_vt(lt) or enum_vt(rt)
                return Err(subset_err("闭包/枚举值参与算术"))
            end
            if lt == "st" or rt == "st"
                return Err(subset_err("String 只参与 + 拼接"))
            end
            if lt == "i32" or rt == "i32"
                return Err(subset_err("Bool 参与算术"))
            end
            if lt == "i64" and rt == "i64"
                Ok("i64")
            else
                Ok("f64")
            end
        end
        ExLogical(_, l, r) =>
            # L2.3-a：and/or 短路——操作数须 Bool（宿主静态口径对齐）
            let lt = infer_ex(l, env, fns)?
            let rt = infer_ex(r, env, fns)?
            if lt != "i32" or rt != "i32"
                return Err(subset_err("逻辑运算操作数须为 Bool"))
            end
            Ok("i32")
        end
        ExIf(ifr) => infer_if_expr(ifr, env, fns)
        ExMatch(scrut, arms, _) => infer_match_expr(scrut, arms, env, fns)
        ExTry(_) => Err(subset_err("? 提前返回留 return 批（块深度跟踪）"))
        ExCall(callee, _) =>
            # L2.3-b：统一走 ex_rv（直调 println/fns → ret；闭包调用 → 被调
            # rv 段；任意 callee 同口径）——返回段 → vt
            let rv = ex_rv(e, env, fns)?
            Ok(rv_vt(rv))
        end
        _ => Err(subset_err("该表达式形态"))
    end
end

# L2.3-a：块尾 if 表达式的类型综合——带 else 时各分支值类型须一致；
# 无 else 时仅 void 语境合法（各分支值类型须 void——宿主运行时"条件假
# 得 Unit"的渐进式语义收紧为编译期一致，非 void 值语境必须写全 else）。
fn infer_if_expr(ifr: IfR, env: Map<String, {slot: Int, vt: String, sig: String, cap: Bool}>, fns: Map<String, {idx: Int, ret: String, nprm: Int, prms: String}>) -> Result<String, String>
    match ifr
        IfR(branches, else_b) =>
            match else_b
                None =>
                    for pair in branches
                        let bt = blk_val_ty(pair.1, env, fns)?
                        if bt != "void"
                            return Err(subset_err("非 void 语境的 if 必须带 else（分支值类型 '" + bt + "'）"))
                        end
                    end
                    Ok("void")
                end
                Some(eb) =>
                    let mut t = blk_val_ty(eb, env, fns)?
                    for pair in branches
                        let bt = blk_val_ty(pair.1, env, fns)?
                        let merged = match vt_merge(t, bt)
                            Ok(vt) => vt
                            Err(_) => ""
                        end
                        if merged == ""
                            return Err(subset_err("if 表达式各分支值类型不一致（'" + t + "' vs '" + bt + "'）"))
                        end
                        t = merged
                    end
                    Ok(t)
                end
            end
        end
    end
end

# R82/c2：类型预扫只在独立绑定表里按序登记 let，并在赋值时细化
# 尚未知的泛型参数。编译期槽位由真实发射路径分配；临时 let 的
# slot=0 只供 infer_ex/ex_sig 使用。
fn scan_block_lets(stmts: List<St>, block_env: Map<String, {slot: Int, vt: String, sig: String, cap: Bool}>, fns: Map<String, {idx: Int, ret: String, nprm: Int, prms: String}>, prefix: String) -> Result<Unit, String>
    for s in stmts
        match s
            StLet(_, name, tyo, ex) =>
                let vt = let_vt(tyo, ex, block_env, fns)?
                if vt == "void"
                    return Err(subset_err(prefix + "let 绑定 void 值"))
                end
                let sig = if vt == "cl" ex_sig(ex, block_env, fns)? else "" end
                map_set(block_env, name, {slot: 0, vt: vt, sig: sig, cap: False})
            end
            StAssign(name, _, _, ex) =>
                let bnd = match map_get(block_env, name)
                    Some(b) => b
                    None => {slot: -1, vt: "", sig: "", cap: False}
                end
                if bnd.slot < 0
                    return Err("赋值给未定义变量 '" + name + "'")
                end
                if bnd.cap
                    return Err("赋值给未定义变量 '" + name + "'（闭包捕获为值拷贝，不能赋值）")
                end
                let got = infer_ex(ex, block_env, fns)?
                if !vt_compatible(bnd.vt, got)
                    return Err(subset_err("赋值 '" + name + "' 类型不符（期望 " + bnd.vt + " 得 " + got + "）"))
                end
                if bnd.vt == "cl"
                    let assigned_sig = ex_sig(ex, block_env, fns)?
                    if assigned_sig != bnd.sig
                        return Err(subset_err("赋值 '" + name + "' 闭包签名不符"))
                    end
                end
                let merged = vt_merge(bnd.vt, got)?
                map_set(block_env, name, {slot: bnd.slot, vt: merged, sig: bnd.sig, cap: False})
            end
            _ => ()
        end
    end
    Ok(())
end

# 块的值类型：临时块作用域先综合本块 let，再综合尾表达式；无尾 → void。
fn blk_val_ty(b: Blk, env: Map<String, {slot: Int, vt: String, sig: String, cap: Bool}>, fns: Map<String, {idx: Int, ret: String, nprm: Int, prms: String}>) -> Result<String, String>
    match b
        BlkOf(stmts, tail) =>
            let block_env = copy_bindings(env)
            scan_block_lets(stmts, block_env, fns, "")?
            match tail
                None => Ok("void")
                Some(te) => infer_ex(te, block_env, fns)
            end
        end
    end
end

# match 臂和控制流子块的独立作用域：Map 是引用语义，故逐项复制绑定。
# 只复制名字到槽的映射；同一函数内的 locals/localvt 仍共享并持续分配新槽。
fn copy_bindings(env: Map<String, {slot: Int, vt: String, sig: String, cap: Bool}>) -> Map<String, {slot: Int, vt: String, sig: String, cap: Bool}>
    let out = map_empty()
    for key in map_keys(env)
        match map_get(env, key)
            Some(b) => map_set(out, key, b)
            None => ()
        end
    end
    out
end

# 根据被测枚举实例替换变体载荷模板；模式与真实发射共用这一结果。
fn variant_field_vts(v: {idx: Int, ret: String, nprm: Int, prms: String}, scrut_vt: String, fns: Map<String, {idx: Int, ret: String, nprm: Int, prms: String}>) -> Result<List<String>, String>
    if !enum_vt(scrut_vt)
        return Err(subset_err("变体模式与非枚举被测类型 '" + scrut_vt + "' 不符"))
    end
    let owner = enum_vt_parts(v.ret)?
    let actual = enum_vt_parts(scrut_vt)?
    if owner.name != actual.name
        return Err(subset_err("变体模式所属枚举 '" + owner.name + "' 与被测类型 '" + scrut_vt + "' 不符"))
    end
    let subs = enum_inst_env(scrut_vt, fns)?
    let mut out = list_empty()
    if v.nprm > 0
        for tpl in split(v.prms, ",")
            let field_vt = template_resolve(tpl, subs)?
            # en:Tree{?} 自身仍是 i64 指针；只有载荷 vt 本身未知时
            # 才无法选择 load/local 宽度。更深层模式会再次独立校验。
            if field_vt == "?" or starts_with(field_vt, "tv:")
                return Err(subset_err("模式载荷类型不可推断（需枚举实例类型注解）"))
            end
            out = list_cons(field_vt, out)
        end
    end
    Ok(rev_str(out))
end

fn pattern_types(p: Pat, scrut_vt: String, arm_env: Map<String, {slot: Int, vt: String, sig: String, cap: Bool}>, fns: Map<String, {idx: Int, ret: String, nprm: Int, prms: String}>) -> Result<Unit, String>
    match p
        PatWildcard => Ok(())
        PatBinder(name) =>
            match map_get(fns, "@variant:" + name)
                Some(v) =>
                    if v.nprm == 0
                        let checked = variant_field_vts(v, scrut_vt, fns)
                        let valid = match checked
                            Ok(_) => True
                            Err(_) => False
                        end
                        if !valid
                            return Err(subset_err("无参变体模式 '" + name + "' 与被测类型 '" + scrut_vt + "' 不符"))
                        end
                        return Ok(())
                    end
                end
                None => ()
            end
            map_set(arm_env, name, {slot: 0, vt: scrut_vt, sig: "", cap: False})
            Ok(())
        end
        PatLit(lit) =>
            # L2.3 String 批：ExStr 综合 "st"，走通用类型校验（scrut 类型不符即拒）
            let lt = infer_ex(lit, arm_env, fns)?
            if scrut_vt == lt or (scrut_vt == "i64" and lt == "f64") or (scrut_vt == "f64" and lt == "i64")
                Ok(())
            else
                Err(subset_err("字面量模式类型不符（被测 " + scrut_vt + " 模式 " + lt + "）"))
            end
        end
        PatVariant(name, subs) =>
            let v = match map_get(fns, "@variant:" + name)
                Some(meta) => meta
                None => {idx: -1, ret: "", nprm: -1, prms: ""}
            end
            if v.idx < 0
                return Err(subset_err("未知变体模式 '" + name + "'"))
            end
            if list_length(subs) != v.nprm
                return Err(subset_err("变体模式 '" + name + "' 子模式数不符（期望 " + v.nprm + " 得 " + list_length(subs) + "）"))
            end
            let fields = variant_field_vts(v, scrut_vt, fns)?
            if v.nprm > 0
                let mut i = 0
                while i < v.nprm
                    pattern_types(list_get(subs, i), list_get(fields, i), arm_env, fns)?
                    i = i + 1
                end
            end
            Ok(())
        end
    end
end

# Form B 臂的尾表达式可读取臂内 let；先在拷贝作用域上做类型走查，
# 再由 comp_val_blk 真正发射语句，不让类型预扫改变外层 env。
fn match_block_type(b: Blk, arm_env: Map<String, {slot: Int, vt: String, sig: String, cap: Bool}>, fns: Map<String, {idx: Int, ret: String, nprm: Int, prms: String}>) -> Result<String, String>
    match b
        BlkOf(stmts, tail) =>
            let block_env = copy_bindings(arm_env)
            scan_block_lets(stmts, block_env, fns, "match 臂内 ")?
            match tail
                None => Ok("void")
                Some(te) => infer_ex(te, block_env, fns)
            end
        end
    end
end

fn match_arm_type(body: ArmB, arm_env: Map<String, {slot: Int, vt: String, sig: String, cap: Bool}>, fns: Map<String, {idx: Int, ret: String, nprm: Int, prms: String}>) -> Result<String, String>
    match body
        ABExpr(e) => infer_ex(e, arm_env, fns)
        ABBlock(b) => match_block_type(b, arm_env, fns)
    end
end

fn infer_match_expr(scrut: Ex, arms: List<ArmR>, env: Map<String, {slot: Int, vt: String, sig: String, cap: Bool}>, fns: Map<String, {idx: Int, ret: String, nprm: Int, prms: String}>) -> Result<String, String>
    let svt = infer_ex(scrut, env, fns)?
    if svt == "void" or svt == "cl"
        return Err(subset_err("match 被测值类型不支持（'" + svt + "'）"))
    end
    let mut out = ""
    let mut first = True
    for arm in arms
        match arm
            ArmR(pat, guard, body) =>
                let arm_env = copy_bindings(env)
                pattern_types(pat, svt, arm_env, fns)?
                match guard
                    None => ()
                    Some(g) =>
                        let gt = infer_ex(g, arm_env, fns)?
                        if gt != "i32"
                            return Err(subset_err("match guard 须为 Bool（得到 '" + gt + "'）"))
                        end
                    end
                end
                let bt = match_arm_type(body, arm_env, fns)?
                if first
                    out = bt
                    first = False
                else
                    let merged = match vt_merge(out, bt)
                        Ok(vt) => vt
                        Err(_) => ""
                    end
                    if merged == ""
                        return Err(subset_err("match 臂值类型不一致（'" + out + "' vs '" + bt + "'）"))
                    end
                    out = merged
                end
            end
        end
    end
    if first
        return Err(subset_err("match 至少需要一个臂"))
    end
    if out == "cl"
        return Err(subset_err("返回闭包值的 match 留后续批次（缺精确签名）"))
    end
    Ok(out)
end

# ---- X2：表达式编译（产物 hex；值留栈上；void 不产值） ----

fn comp_ex(e: Ex, env: Map<String, {slot: Int, vt: String, sig: String, cap: Bool}>, fns: Map<String, {idx: Int, ret: String, nprm: Int, prms: String}>, cg: {cgs: Map<String, Int>, cgh: Map<String, String>, shims: Map<String, Int>, sigty: Map<String, Int>}, locals: Map<String, Int>, localvt: Map<String, String>) -> Result<String, String>
    match e
        ExInt(n) => Ok("42" + sleb128_hex(n))
        ExFloat(s) => Ok("44" + f64_bits_le(parse_float_str(s)))
        ExUnit => Ok("")
        ExGroup(inner) => comp_ex(inner, env, fns, cg, locals, localvt)
        ExClosure(params, reto, body) =>
            # L2.3-b：闭包字面量 → 创建序列（栈上留闭包值）
            let r = compile_closure(params, reto, body, env, fns, cg, locals, localvt)?
            Ok(r.0)
        end
        ExIdent(x, _, _) =>
            match map_get(env, x)
                Some(b) =>
                    if b.cap
                        # L2.3-b：捕获读取——local.get 0（env i64）→ wrap → 按宽 load
                        Ok("2000" + "a7" + cap_load_hex(b.vt, 4 + 8 * b.slot))
                    else
                        Ok("20" + leb128_hex(b.slot))
                    end
                end
                None =>
                    if map_has(fns, "@variant:" + x)
                        emit_variant_construct(x, list_empty(), env, fns, cg, locals, localvt)
                    else
                        # L2.3-b：具名函数当值（零捕获 shim）
                        match map_get(fns, x)
                            Some(fi) => emit_fn_value(x, fi, fns, cg, locals, localvt)
                            None => Err("未定义变量 '" + x + "'")
                        end
                    end
                end
            end
        end
        ExBool(b) =>
            # L2.3-a：Bool 字面量 = i32 0/1（untagged 值表示的 Bool 约定）
            if b
                Ok("4101")
            else
                Ok("4100")
            end
        end
        ExStr(s) =>
            # L2.3 String 批：字面量 intern 进 data 段 → i64 裸指针（偏移零扩展）
            let off = intern_str_lit(s, cg)
            Ok("41" + sleb128_hex(off) + "ad")
        end
        ExUnary(op, inner) =>
            if op == "Not"
                # L2.3-a：! = i32.eqz（操作数须 Bool）
                let it = infer_ex(inner, env, fns)?
                if it != "i32"
                    return Err(subset_err("逻辑非操作数须为 Bool"))
                end
                return Ok(comp_ex(inner, env, fns, cg, locals, localvt)? + "45")
            end
            if op != "Neg"
                return Err(subset_err("一元运算 '" + op + "'"))
            end
            let it = infer_ex(inner, env, fns)?
            if it == "i32"
                return Err(subset_err("Bool 参与一元负"))
            end
            let code = comp_ex(inner, env, fns, cg, locals, localvt)?
            if it == "i64"
                Ok("4200" + code + "7d")
            else
                Ok(code + "9a")
            end
        end
        ExLogical(op, l, r) => comp_logical(op, l, r, env, fns, cg, locals, localvt)
        ExBinary(op, l, r) => comp_binary(op, l, r, env, fns, cg, locals, localvt)
        ExIf(ifr) =>
            # L2.3-b 顺带修复（L2.3-a 存量缺口）：comp_ex 缺 ExIf 分支——块尾
            # if 表达式此前只在函数体最外层尾（comp_tail 特判）被支持，分支
            # 块尾/值位嵌套 if（else 内嵌 if、let y = if ... end）落兜底被拒
            comp_if_expr(ifr, env, fns, cg, locals, localvt)
        end
        ExMatch(scrut, arms, _) => comp_match_expr(scrut, arms, env, fns, cg, locals, localvt)
        ExTry(_) => Err(subset_err("? 提前返回留 return 批（块深度跟踪）"))
        ExCall(callee, args) => comp_call(callee, args, env, fns, cg, locals, localvt)
        _ => Err(subset_err("该表达式形态"))
    end
end

# L2.3-a：and/or 短路编译——if (result i32) 结构保证右侧仅在必要时求值
# （宿主 WASM 后端同为短路；and：左假产 0 不看右；or：左真产 1 不看右）
fn comp_logical(op: String, l: Ex, r: Ex, env: Map<String, {slot: Int, vt: String, sig: String, cap: Bool}>, fns: Map<String, {idx: Int, ret: String, nprm: Int, prms: String}>, cg: {cgs: Map<String, Int>, cgh: Map<String, String>, shims: Map<String, Int>, sigty: Map<String, Int>}, locals: Map<String, Int>, localvt: Map<String, String>) -> Result<String, String>
    let lc = comp_ex(l, env, fns, cg, locals, localvt)?
    let rc = comp_ex(r, env, fns, cg, locals, localvt)?
    if op == "And"
        Ok(lc + "047f" + rc + "05" + "4100" + "0b")
    else
        Ok(lc + "047f" + "4101" + "05" + rc + "0b")
    end
end

# L2.3-a：比较运算判别（token 判别名）
fn is_cmp_op(op: String) -> Bool
    op == "Eq" or op == "NotEq" or op == "Lt" or op == "Gt" or op == "LtEq" or op == "GtEq"
end

# L2.3-a：i64 比较操作码（eq 51 / ne 52 / lt_s 53 / gt_s 55 / le_s 57 / ge_s 59）
fn i64_cmp_op(op: String) -> Result<String, String>
    if op == "Eq"
        Ok("51")
    else
        if op == "NotEq"
            Ok("52")
        else
            if op == "Lt"
                Ok("53")
            else
                if op == "Gt"
                    Ok("55")
                else
                    if op == "LtEq"
                        Ok("57")
                    else
                        if op == "GtEq"
                            Ok("59")
                        else
                            Err(subset_err("比较运算 '" + op + "'"))
                        end
                    end
                end
            end
        end
    end
end

# R81：Bool 为 i32 0/1，六种同类型比较均使用 i32 操作码。
fn i32_cmp_op(op: String) -> Result<String, String>
    if op == "Eq"
        Ok("46")
    elif op == "NotEq"
        Ok("47")
    elif op == "Lt"
        Ok("48")
    elif op == "Gt"
        Ok("4a")
    elif op == "LtEq"
        Ok("4c")
    elif op == "GtEq"
        Ok("4e")
    else
        Err(subset_err("比较运算 '" + op + "'"))
    end
end

# i32 有符号比较操作码（st_cmp 的 -1/0/1 与 0 比较：lt_s=48 gt_s=4a le_s=4c ge_s=4e）
fn i32_ord_op(op: String) -> Result<String, String>
    if op == "Lt"
        Ok("48")
    elif op == "Gt"
        Ok("4a")
    elif op == "LtEq"
        Ok("4c")
    else
        Ok("4e")
    end
end

# 拼接提升的显示化：code（栈上值）→ String 值（宿主 to_display 子集——
# Int/Float 走 helper，Bool/Unit 编译期静态串；st 原样；cl/en 已在上游拒）
fn disp_code(code: String, vt: String, cg: {cgs: Map<String, Int>, cgh: Map<String, String>, shims: Map<String, Int>, sigty: Map<String, Int>}) -> Result<String, String>
    if vt == "st"
        Ok(code)
    elif vt == "i64"
        let idx = ensure_str_helper("st_itoa", cg)?
        Ok(code + "10" + leb128_hex(idx))
    elif vt == "f64"
        let idx = ensure_str_helper("st_ftoa", cg)?
        Ok(code + "10" + leb128_hex(idx))
    elif vt == "i32"
        let t_off = intern_str_lit("true", cg)
        let f_off = intern_str_lit("false", cg)
        Ok(code + "047e" + "41" + sleb128_hex(t_off) + "ad" + "05" + "41" + sleb128_hex(f_off) + "ad" + "0b")
    else
        let u_off = intern_str_lit("()", cg)
        Ok(code + "41" + sleb128_hex(u_off) + "ad")
    end
end

# L2.3-a：f64 比较操作码（eq 61 / ne 62 / lt 63 / gt 64 / le 65 / ge 66）
fn f64_cmp_op(op: String) -> Result<String, String>
    if op == "Eq"
        Ok("61")
    else
        if op == "NotEq"
            Ok("62")
        else
            if op == "Lt"
                Ok("63")
            else
                if op == "Gt"
                    Ok("64")
                else
                    if op == "LtEq"
                        Ok("65")
                    else
                        if op == "GtEq"
                            Ok("66")
                        else
                            Err(subset_err("比较运算 '" + op + "'"))
                        end
                    end
                end
            end
        end
    end
end

fn comp_binary(op: String, l: Ex, r: Ex, env: Map<String, {slot: Int, vt: String, sig: String, cap: Bool}>, fns: Map<String, {idx: Int, ret: String, nprm: Int, prms: String}>, cg: {cgs: Map<String, Int>, cgh: Map<String, String>, shims: Map<String, Int>, sigty: Map<String, Int>}, locals: Map<String, Int>, localvt: Map<String, String>) -> Result<String, String>
    # 发射前先走完整类型校验；非法 Bool 组合不得流入 f64 opcode。
    let _ = infer_ex(ExBinary(op, l, r), env, fns)?
    let left_vt = infer_ex(l, env, fns)?
    let right_vt = infer_ex(r, env, fns)?
    if enum_vt(left_vt) or enum_vt(right_vt)
        return Err(subset_err("枚举值参与算术/比较（结构相等留后续批次）"))
    end
    if is_cmp_op(op)
        # L2.3-a：比较——i64 直接比 / f64 直接比 / 混合提升 f64 后比（对齐宿主）
        let lc = comp_ex(l, env, fns, cg, locals, localvt)?
        let rc = comp_ex(r, env, fns, cg, locals, localvt)?
        if left_vt == "st" and right_vt == "st"
            # L2.3 String 批：Eq/NotEq 走 st_eq；序比较走 st_cmp(-1/0/1) 与 0 比
            if op == "Eq"
                let idx = ensure_str_helper("st_eq", cg)?
                return Ok(lc + rc + "10" + leb128_hex(idx))
            end
            if op == "NotEq"
                let idx = ensure_str_helper("st_eq", cg)?
                return Ok(lc + rc + "10" + leb128_hex(idx) + "45")
            end
            let idx = ensure_str_helper("st_cmp", cg)?
            return Ok(lc + rc + "10" + leb128_hex(idx) + "4100" + i32_ord_op(op)?)
        end
        if left_vt == "i32" and right_vt == "i32"
            return Ok(lc + rc + i32_cmp_op(op)?)
        end
        if left_vt == "i64" and right_vt == "i64"
            return Ok(lc + rc + i64_cmp_op(op)?)
        end
        if left_vt == "i64" and right_vt == "f64"
            return Ok(lc + "b9" + rc + f64_cmp_op(op)?)
        end
        if left_vt == "f64" and right_vt == "i64"
            return Ok(lc + rc + "b9" + f64_cmp_op(op)?)
        end
        return Ok(lc + rc + f64_cmp_op(op)?)
    end
    if op != "Add" and op != "Sub" and op != "Mul" and op != "Div" and op != "Mod"
        return Err(subset_err("二元运算 '" + op + "'"))
    end
    let lc = comp_ex(l, env, fns, cg, locals, localvt)?
    let rc = comp_ex(r, env, fns, cg, locals, localvt)?
    if op == "Add" and (left_vt == "st" or right_vt == "st")
        # L2.3 String 批：拼接提升（v0.4.1 宿主语义）——非 String 侧
        # to_display 后拼接（Bool/Unit 静态串、Int/Float 走 helper）
        let ld = disp_code(lc, left_vt, cg)?
        let rd = disp_code(rc, right_vt, cg)?
        let idx = ensure_str_helper("st_concat", cg)?
        return Ok(ld + rd + "10" + leb128_hex(idx))
    end
    if left_vt == "i64" and right_vt == "i64"
        Ok(lc + rc + i64_op(op))
    else
        if left_vt == "i64" and right_vt == "f64"
            return Ok(lc + "b9" + rc + f64_op(op)?)
        end
        if left_vt == "f64" and right_vt == "i64"
            return Ok(lc + rc + "b9" + f64_op(op)?)
        end
        Ok(lc + rc + f64_op(op)?)
    end
end

# L2.3-c 用户枚举构造：参数先按源序求值到 scratch local，再分配
# [variant_idx:i32][arity:i32][payload:i64×n]。Float 用位重解释、Bool
# 扩为 i64，枚举指针直接存 i64；编译期 vt 与声明逐位校验。
fn emit_variant_construct(name: String, args: List<Ex>, env: Map<String, {slot: Int, vt: String, sig: String, cap: Bool}>, fns: Map<String, {idx: Int, ret: String, nprm: Int, prms: String}>, cg: {cgs: Map<String, Int>, cgh: Map<String, String>, shims: Map<String, Int>, sigty: Map<String, Int>}, locals: Map<String, Int>, localvt: Map<String, String>) -> Result<String, String>
    let _ = need_heap(cg)?
    let rv = variant_call_type(name, args, env, fns)?
    let meta = match map_get(fns, "@variant:" + name)
        Some(v) => v
        None => {idx: -1, ret: "", nprm: -1, prms: ""}
    end
    if meta.idx < 0
        return Err(subset_err("未知枚举变体 '" + name + "'"))
    end
    let mut out = ""
    let mut slots = list_empty()
    let mut i = 0
    while i < meta.nprm
        let arg = list_get(args, i)
        let vt = infer_ex(arg, env, fns)?
        out = out + comp_ex(arg, env, fns, cg, locals, localvt)?
        let slot = new_slot(locals, localvt, vt)
        out = out + "21" + leb128_hex(slot)
        slots = list_cons((slot, vt), slots)
        i = i + 1
    end
    let p = new_slot(locals, localvt, rv)
    let alloc_idx = cg_int(cg.cgs, "alloc_idx")
    out = out + "41" + sleb128_hex(8 + 8 * meta.nprm) + "10" + leb128_hex(alloc_idx) + "ac" + "21" + leb128_hex(p)
    out = out + "20" + leb128_hex(p) + "a7" + "41" + sleb128_hex(meta.idx) + "3600" + "00"
    out = out + "20" + leb128_hex(p) + "a7" + "41" + sleb128_hex(meta.nprm) + "3600" + "04"
    let mut j = 0
    for pr in rev_slots_vt(slots)
        let mut payload = "20" + leb128_hex(pr.0)
        if pr.1 == "f64"
            payload = payload + "bd"
        elif pr.1 == "i32"
            payload = payload + "ac"
        end
        out = out + "20" + leb128_hex(p) + "a7" + payload + "3700" + leb128_hex(8 + 8 * j)
        j = j + 1
    end
    Ok(out + "20" + leb128_hex(p))
end

# 模式测试在栈上留下 i32 条件；载荷只在 idx 命中后的 if(result i32)
# 内读取，防止 0 参对象贴页尾时盲读越界（RFC-0003 修订 25）。
fn comp_pattern_test(p: Pat, s: Int, svt: String, arm_env: Map<String, {slot: Int, vt: String, sig: String, cap: Bool}>, fns: Map<String, {idx: Int, ret: String, nprm: Int, prms: String}>, cg: {cgs: Map<String, Int>, cgh: Map<String, String>, shims: Map<String, Int>, sigty: Map<String, Int>}, locals: Map<String, Int>, localvt: Map<String, String>) -> Result<String, String>
    match p
        PatWildcard => Ok("4101")
        PatBinder(name) =>
            match map_get(fns, "@variant:" + name)
                Some(v) =>
                    if v.nprm == 0
                        let _ = variant_field_vts(v, svt, fns)?
                        return Ok("20" + leb128_hex(s) + "a7" + "2800" + "00" + "41" + sleb128_hex(v.idx) + "46")
                    end
                end
                None => ()
            end
            let slot = new_slot(locals, localvt, svt)
            map_set(arm_env, name, {slot: slot, vt: svt, sig: "", cap: False})
            Ok("20" + leb128_hex(s) + "21" + leb128_hex(slot) + "4101")
        end
        PatLit(lit) =>
            let lv = infer_ex(lit, arm_env, fns)?
            let lc = comp_ex(lit, arm_env, fns, cg, locals, localvt)?
            let sc = "20" + leb128_hex(s)
            if svt == "i64" and lv == "i64"
                Ok(sc + lc + "51")
            elif svt == "f64" and lv == "f64"
                Ok(sc + lc + "61")
            elif svt == "i32" and lv == "i32"
                Ok(sc + lc + "46")
            elif svt == "st" and lv == "st"
                # L2.3 String 批：String 字面量模式走 st_eq（字节相等，对齐宿主 rt_eq）
                let idx = ensure_str_helper("st_eq", cg)?
                Ok(sc + lc + "10" + leb128_hex(idx))
            elif svt == "i64" and lv == "f64"
                # 宿主 match 字面量走 tagged rt_eq：Int 2 与 Float 2.0
                # 不相等（普通二元比较的数值提升不适用于模式）。
                Ok("4100")
            elif svt == "f64" and lv == "i64"
                Ok("4100")
            else
                Err(subset_err("字面量模式类型不符（被测 " + svt + " 模式 " + lv + "）"))
            end
        end
        PatVariant(name, subs) =>
            let v = match map_get(fns, "@variant:" + name)
                Some(meta) => meta
                None => {idx: -1, ret: "", nprm: -1, prms: ""}
            end
            if v.idx < 0
                return Err(subset_err("未知变体模式 '" + name + "'"))
            end
            if list_length(subs) != v.nprm
                return Err(subset_err("变体模式 '" + name + "' 的子模式数不符"))
            end
            let fields = variant_field_vts(v, svt, fns)?
            let mut out = "20" + leb128_hex(s) + "a7" + "2800" + "00" + "41" + sleb128_hex(v.idx) + "46"
            if v.nprm > 0
                out = out + "047f"
                let mut i = 0
                while i < v.nprm
                    let vt = list_get(fields, i)
                    let arg_slot = new_slot(locals, localvt, vt)
                    out = out + "20" + leb128_hex(s) + "a7" + "2900" + leb128_hex(8 + 8 * i)
                    if vt == "f64"
                        out = out + "bf"
                    elif vt == "i32"
                        out = out + "a7"
                    end
                    out = out + "21" + leb128_hex(arg_slot)
                    out = out + comp_pattern_test(list_get(subs, i), arg_slot, vt, arm_env, fns, cg, locals, localvt)?
                    if i > 0
                        out = out + "71"
                    end
                    i = i + 1
                end
                out = out + "05" + "4100" + "0b"
            end
            Ok(out)
        end
    end
end

fn comp_match_arm_body(body: ArmB, arm_env: Map<String, {slot: Int, vt: String, sig: String, cap: Bool}>, fns: Map<String, {idx: Int, ret: String, nprm: Int, prms: String}>, cg: {cgs: Map<String, Int>, cgh: Map<String, String>, shims: Map<String, Int>, sigty: Map<String, Int>}, locals: Map<String, Int>, localvt: Map<String, String>) -> Result<String, String>
    match body
        ABExpr(e) => comp_ex(e, arm_env, fns, cg, locals, localvt)
        ABBlock(b) => comp_val_blk(b, arm_env, fns, cg, locals, localvt)
    end
end

fn comp_match_expr(scrut: Ex, arms: List<ArmR>, env: Map<String, {slot: Int, vt: String, sig: String, cap: Bool}>, fns: Map<String, {idx: Int, ret: String, nprm: Int, prms: String}>, cg: {cgs: Map<String, Int>, cgh: Map<String, String>, shims: Map<String, Int>, sigty: Map<String, Int>}, locals: Map<String, Int>, localvt: Map<String, String>) -> Result<String, String>
    let result_vt = infer_match_expr(scrut, arms, env, fns)?
    let svt = infer_ex(scrut, env, fns)?
    let scrut_code = comp_ex(scrut, env, fns, cg, locals, localvt)?
    let s = new_slot(locals, localvt, svt)
    let mut out = scrut_code + "21" + leb128_hex(s) + "02" + vt_bt(result_vt)
    for arm in arms
        match arm
            ArmR(pat, guard, body) =>
                let arm_env = copy_bindings(env)
                let pc = comp_pattern_test(pat, s, svt, arm_env, fns, cg, locals, localvt)?
                out = out + pc + "0440"
                match guard
                    None =>
                        out = out + comp_match_arm_body(body, arm_env, fns, cg, locals, localvt)? + "0c01"
                    end
                    Some(g) =>
                        let gt = infer_ex(g, arm_env, fns)?
                        if gt != "i32"
                            return Err(subset_err("match guard 须为 Bool"))
                        end
                        out = out + comp_ex(g, arm_env, fns, cg, locals, localvt)? + "0440"
                        out = out + comp_match_arm_body(body, arm_env, fns, cg, locals, localvt)? + "0c02" + "0b"
                    end
                end
                out = out + "0b"
            end
        end
    end
    # 宿主无匹配臂时运行时错误；L2 对齐为 trap，不默默造默认值。
    Ok(out + "00" + "0b")
end

fn comp_call(callee: Ex, args: List<Ex>, env: Map<String, {slot: Int, vt: String, sig: String, cap: Bool}>, fns: Map<String, {idx: Int, ret: String, nprm: Int, prms: String}>, cg: {cgs: Map<String, Int>, cgh: Map<String, String>, shims: Map<String, Int>, sigty: Map<String, Int>}, locals: Map<String, Int>, localvt: Map<String, String>) -> Result<String, String>
    match callee
        ExIdent(name, _, _) =>
            if map_has(env, name) == False and map_has(fns, "@variant:" + name)
                return emit_variant_construct(name, args, env, fns, cg, locals, localvt)
            end
            if name == "println"
                return comp_println(args, env, fns, cg, locals, localvt)
            end
            match map_get(fns, name)
                None =>
                    # L2.3-b：闭包变量调用（分派次序对齐宿主/解释器：
                    # println/内建 → 具名函数直调 → 闭包变量）
                    match map_get(env, name)
                        Some(b) =>
                            if b.vt == "cl"
                                emit_closure_call(callee, args, env, fns, cg, locals, localvt)
                            else
                                Err(subset_err("调用非闭包值（得到 vt '" + b.vt + "'）"))
                            end
                        end
                        None => Err("调用未知函数 '" + name + "'")
                    end
                end
                Some(fi) =>
                    # L2.3 String 批：内建摘要哨兵（idx=-2）→ helper 分派
                    if fi.idx == -2
                        return comp_builtin_call(name, fi, args, env, fns, cg, locals, localvt)
                    end
                    # R74（十二审）：调用点校验 arity 与逐实参类型——不符即
                    # 拒绝，不产坏 wasm（此前 f(1) 传 Float 形参/多传参均
                    # COMPILED，失败面推迟到实例化）。与 R68 同为编译期
                    # 严格校验：宿主侧 TYPE003 warning + 运行提升的渐进式
                    # 语义是子集外的信任边界（RFC-0004 修订 5 登记）。
                    if list_length(args) != fi.nprm
                        return Err(subset_err("调用 '" + name + "' 实数量不符（期望 " + fi.nprm + " 得 " + list_length(args) + "）"))
                    end
                    let want = split(fi.prms, ",")
                    let mut out = ""
                    let mut i = 0
                    while i < list_length(args)
                        let a = list_get(args, i)
                        let at = infer_ex(a, env, fns)?
                        if fi.nprm > 0
                            let w = list_get(want, i)
                            if !vt_compatible(at, w)
                                return Err(subset_err("调用 '" + name + "' 第 " + (i + 1) + " 参类型不符（期望 " + w + " 得 " + at + "）"))
                            end
                        end
                        out = out + comp_ex(a, env, fns, cg, locals, localvt)?
                        i = i + 1
                    end
                    Ok(out + "10" + leb128_hex(fi.idx))
                end
            end
        end
        _ =>
            # L2.3-b（B2）：任意表达式 callee——闭包调用（make_adder(5)(10) 形态）
            let ct = infer_ex(callee, env, fns)?
            if ct != "cl"
                return Err(subset_err("非闭包 callee 的调用（得到 vt '" + ct + "'）"))
            end
            emit_closure_call(callee, args, env, fns, cg, locals, localvt)
        end
    end
end

# L2.3 String 批：string 内建调用编译（R74 模式——arity/逐参校验后 call helper）
fn comp_builtin_call(name: String, fi: {idx: Int, ret: String, nprm: Int, prms: String}, args: List<Ex>, env: Map<String, {slot: Int, vt: String, sig: String, cap: Bool}>, fns: Map<String, {idx: Int, ret: String, nprm: Int, prms: String}>, cg: {cgs: Map<String, Int>, cgh: Map<String, String>, shims: Map<String, Int>, sigty: Map<String, Int>}, locals: Map<String, Int>, localvt: Map<String, String>) -> Result<String, String>
    let ent = st_builtin_entry(name)?
    if list_length(args) != fi.nprm
        return Err(subset_err("调用 '" + name + "' 实数量不符（期望 " + fi.nprm + " 得 " + list_length(args) + "）"))
    end
    let want = split(fi.prms, ",")
    let mut out = ""
    let mut i = 0
    while i < list_length(args)
        let a = list_get(args, i)
        let at = infer_ex(a, env, fns)?
        if fi.nprm > 0
            let w = list_get(want, i)
            if !vt_compatible(at, w)
                return Err(subset_err("调用 '" + name + "' 第 " + (i + 1) + " 参类型不符（期望 " + w + " 得 " + at + "）"))
            end
        end
        out = out + comp_ex(a, env, fns, cg, locals, localvt)?
        i = i + 1
    end
    let hidx = ensure_str_helper(ent.helper, cg)?
    Ok(out + "10" + leb128_hex(hidx))
end

# println(String) 的打印序列：ptr_code（栈上 i64）→ 存 local →
# print_str(p+4, len) + print_str(0,1)（'\n' 在 data offset 0）
fn print_st_hex(ptr_code: String, locals: Map<String, Int>, localvt: Map<String, String>) -> String
    let t = new_slot(locals, localvt, "st")
    ptr_code + "21" + leb128_hex(t)
    + "20" + leb128_hex(t) + "a7" + "4104" + "6a"
    + "20" + leb128_hex(t) + "a7" + "2800" + "00"
    + "10" + "02"
    + "4100" + "4101" + "10" + "02"
end

fn comp_println(args: List<Ex>, env: Map<String, {slot: Int, vt: String, sig: String, cap: Bool}>, fns: Map<String, {idx: Int, ret: String, nprm: Int, prms: String}>, cg: {cgs: Map<String, Int>, cgh: Map<String, String>, shims: Map<String, Int>, sigty: Map<String, Int>}, locals: Map<String, Int>, localvt: Map<String, String>) -> Result<String, String>
    if list_length(args) != 1
        return Err("println 期望 1 个参数")
    end
    let at = infer_ex(list_get(args, 0), env, fns)?
    let ac = comp_ex(list_get(args, 0), env, fns, cg, locals, localvt)?
    if at == "i64"
        Ok(ac + "1000")
    else
        if at == "f64"
            Ok(ac + "1001")
        else
            if at == "st"
                Ok(print_st_hex(ac, locals, localvt))
            else
                if at == "i32"
                    # L2.3 String 批顺带解禁（裁决 2）：Bool → "true"/"false" 静态串
                    let pc = disp_code(ac, "i32", cg)?
                    Ok(print_st_hex(pc, locals, localvt))
                else
                    Err(subset_err("println 只接受 Int/Float/String/Bool（枚举显示留后续批次）"))
                end
            end
        end
    end
end

# i64 算术操作码（WASM 数值指令：add 7c / sub 7d / mul 7e / div_s 7f / rem_s 81；
# node 验证器为最终权威）
fn i64_op(op: String) -> String
    if op == "Add"
        "7c"
    elif op == "Sub"
        "7d"
    elif op == "Mul"
        "7e"
    elif op == "Div"
        "7f"
    else
        "81"
    end
end

# f64 算术操作码（add a0 / sub a1 / mul a2 / div a3）；% 无指令——L2.3 合成
fn f64_op(op: String) -> Result<String, String>
    if op == "Mod"
        Err(subset_err("Float %（f64 rem 合成留 L2.3）"))
    elif op == "Add"
        Ok("a0")
    elif op == "Sub"
        Ok("a1")
    elif op == "Mul"
        Ok("a2")
    else
        Ok("a3")
    end
end

# ============================================================================
# L2.3-b：闭包编译主体（designs/0001 §7.5-§7.8；宿主 compile_closure /
# emit_fn_value / emit_closure_call / build_alloc 平移）
#
# 值表示（裁决 A甲）：闭包值 = i64 裸指针（vt "cl"，编译期跟踪；运行时
# call_indirect 签名检查兜底）。堆对象布局（裁决 D，8 字节统一槽）：
#   env 对象 [n: i32][v0..vn 各 8 字节]（偏移 4+8i，与宿主一致）
#   闭包对象 [tslot: i32][env_ptr: i32]（8 字节；shim 的 env=0）
# 捕获语义：创建时值拷贝（对齐宿主 WASM；mut 捕获放行——裁决 C）。
# ============================================================================

# 捕获槽读取（local.get 0 = env i64 → i32.wrap → 按宽 load，偏移 4+8*pos）
fn cap_load_hex(vt: String, off: Int) -> String
    if vt == "f64"
        "2b00" + leb128_hex(off)
    else
        if vt == "i32"
            "2800" + leb128_hex(off)
        else
            "2900" + leb128_hex(off)
        end
    end
end

# 捕获槽写入（按宽 store，偏移 4+8*i）
fn cap_store_hex(vt: String, off: Int) -> String
    if vt == "f64"
        "3900" + leb128_hex(off)
    else
        if vt == "i32"
            "3600" + leb128_hex(off)
        else
            "3700" + leb128_hex(off)
        end
    end
end

# List<String> 含名判定（Lom 无 list_contains——手写循环）
fn name_in(xs: List<String>, x: String) -> Bool
    let n = list_length(xs)
    let mut i = 0
    while i < n
        if list_get(xs, i) == x
            return True
        end
        i = i + 1
    end
    False
end

# 名在 caps 中的序号（未找到 -1）
fn name_pos(xs: List<String>, x: String) -> Int
    let n = list_length(xs)
    let mut i = 0
    while i < n
        if list_get(xs, i) == x
            return i
        end
        i = i + 1
    end
    -1
end

# cgs 计数读取（缺省 0）
fn cg_int(cgs: Map<String, Int>, key: String) -> Int
    match map_get(cgs, key)
        Some(v) => v
        None => 0
    end
end

# cgh 串读取（缺省空）
fn cg_str(cgh: Map<String, String>, key: String) -> String
    match map_get(cgh, key)
        Some(v) => v
        None => ""
    end
end

# 签名 → typeidx（去重复用：sigty 命中返回；否则注册 extra type）
fn sig_typeidx(sig: String, cg: {cgs: Map<String, Int>, cgh: Map<String, String>, shims: Map<String, Int>, sigty: Map<String, Int>}) -> Int
    match map_get(cg.sigty, sig)
        Some(t) => t
        None =>
            let idx = cg_int(cg.cgs, "tbase") + cg_int(cg.cgs, "nfun") + cg_int(cg.cgs, "n_extra_types")
            map_set(cg.cgh, "extra_types", cg_str(cg.cgh, "extra_types") + sig_type_hex(sig))
            map_set(cg.cgs, "n_extra_types", cg_int(cg.cgs, "n_extra_types") + 1)
            map_set(cg.sigty, sig, idx)
            idx
        end
    end
end

# 注册 extra 函数（追加 typeidx 索引 + code 条目），返回 funcidx
# （String 批起 import 面按需扩展：ibase=2（无 String）/4（有 String），从 cgs 读）
fn reg_extra_fn(tidx: Int, bodyhex: String, cg: {cgs: Map<String, Int>, cgh: Map<String, String>, shims: Map<String, Int>, sigty: Map<String, Int>}) -> Int
    let fidx = cg_int(cg.cgs, "ibase") + cg_int(cg.cgs, "nfun") + cg_int(cg.cgs, "n_extra_fns")
    map_set(cg.cgh, "extra_fidxs", cg_str(cg.cgh, "extra_fidxs") + leb128_hex(tidx))
    map_set(cg.cgh, "extra_bodies", cg_str(cg.cgh, "extra_bodies") + leb128_hex(len(bodyhex) / 2) + bodyhex)
    map_set(cg.cgs, "n_extra_fns", cg_int(cg.cgs, "n_extra_fns") + 1)
    fidx
end

# funcref 表注册（返回 tslot）
fn reg_table_slot(funcidx: Int, cg: {cgs: Map<String, Int>, cgh: Map<String, String>, shims: Map<String, Int>, sigty: Map<String, Int>}) -> Int
    let tslot = cg_int(cg.cgs, "n_table")
    map_set(cg.cgh, "table", cg_str(cg.cgh, "table") + leb128_hex(funcidx))
    map_set(cg.cgs, "n_table", tslot + 1)
    tslot
end

# bump allocator 函数体（宿主 build_alloc 平移；opcode 对照 wasm.rs 常量表）：
# (i32 size)->i32；local 1=result、local 2=new_hp；溢界自动 memory.grow（失败 trap）
fn alloc_body_hex() -> String
    "02017f017f"
    + "2300" + "2101"
    + "2300" + "2000" + "6a" + "2102"
    + "2002" + "3f00" + "4110" + "74" + "4a"
    + "0440"
    + "2002" + "3f00" + "4110" + "74" + "6b"
    + "41" + "ffff03"
    + "6a"
    + "4110" + "76"
    + "4000"
    + "4100" + "48" + "0440" + "00" + "0b"
    + "0b"
    + "2002" + "2400"
    + "2001"
    + "0b"
end

# heap_on 防御（预扫漏判时 fail-safe：宁可编译错误不可产引用缺失 alloc 的 wasm）
fn need_heap(cg: {cgs: Map<String, Int>, cgh: Map<String, String>, shims: Map<String, Int>, sigty: Map<String, Int>}) -> Result<Unit, String>
    if cg_int(cg.cgs, "heap_on") == 0
        Err("内部错误：堆预扫漏判（heap 未启用）——请报维护者")
    else
        Ok(())
    end
end

# ============================================================================
# L2.3 String 批：编译期编码器 + data 段 intern（designs/0004 §7.1-§7.2）
#
# 值表示：vt "st"，WASM 值 = i64 裸指针（静态字面量 = data 段偏移零扩展，
# 动态串 = 堆地址）；对象布局对齐宿主 [len: i32][utf8 bytes]（len 为字节数）。
# data 段 offset 0 = '\n'（println 换行，对齐宿主惯例）；末尾 64 字节 scratch
# （itoa/ftoa 共用，global 1 指向）。
#
# 字面量 → UTF-8 字节 hex：Lom 无 char_to_code 内建，码点用两段二分求取
# （UTF-8 字节序 = 码点序；代理区 D800-DFFF 的 char_from_code 会 trap，
# 故以 U+E000 为界分 [0,0xD7FF] / [0xE000,0x10FFFF] 两段，段内 mid 安全）。
# ============================================================================

# 二分求单字符码点（c 必为合法单字符；lo/hi 界内不含代理区）
fn bin_search_cp(c: String, lo: Int, hi: Int) -> Int
    let mut l = lo
    let mut h = hi
    while l <= h
        let mid = (l + h) / 2
        let mc = char_from_code(mid)
        if c == mc
            return mid
        elif c < mc
            h = mid - 1
        else
            l = mid + 1
        end
    end
    lo
end

# 单字符 → 码点（两段二分；每字符 ≤ ~21 次 char_from_code）
fn cp_of_char(c: String) -> Int
    if char_from_code(57344) <= c
        bin_search_cp(c, 57344, 1114111)
    else
        bin_search_cp(c, 0, 55295)
    end
end

# 码点 → UTF-8 字节 hex（1-4 字节；编码逻辑 = 宿主 char_from_code 蓝本）
fn utf8_hex(cp: Int) -> String
    if cp < 128
        byte_hex(cp)
    elif cp < 2048
        byte_hex((cp / 64) + 192) + byte_hex((cp % 64) + 128)
    elif cp < 65536
        byte_hex((cp / 4096) + 224) + byte_hex(((cp / 64) % 64) + 128) + byte_hex((cp % 64) + 128)
    else
        byte_hex((cp / 262144) + 240) + byte_hex(((cp / 4096) % 64) + 128) + byte_hex(((cp / 64) % 64) + 128) + byte_hex((cp % 64) + 128)
    end
end

# 4 字节小端 hex（data 段串长度头）
fn le32_hex(n: Int) -> String
    byte_hex(n % 256) + byte_hex((n / 256) % 256) + byte_hex((n / 65536) % 256) + byte_hex((n / 16777216) % 256)
end

# 字面量 intern 进 data 段（去重）；返回字节偏移。
# data 布局（has_str 时）：offset 0 = '\n'；随后 intern 字面量；
# 编译完成后追加 64 字节 scratch（global 1 指向；hp 从 scratch 之后起）。
fn intern_str_lit(s: String, cg: {cgs: Map<String, Int>, cgh: Map<String, String>, shims: Map<String, Int>, sigty: Map<String, Int>}) -> Int
    match map_get(cg.cgh, "stroff:" + s)
        Some(off_s) =>
            match string_to_int(off_s)
                n => n
            end
        end
        None =>
            let off = cg_int(cg.cgs, "data_len")
            let mut bytes_hex = ""
            for ch in split(s, "")
                bytes_hex = bytes_hex + utf8_hex(cp_of_char(ch))
            end
            # n 是字节数（多字节字符按 UTF-8 实际宽度——len 头语义与宿主一致）
            let n = len(bytes_hex) / 2
            map_set(cg.cgh, "data_hex", cg_str(cg.cgh, "data_hex") + le32_hex(n) + bytes_hex)
            map_set(cg.cgs, "data_len", off + 4 + n)
            map_set(cg.cgh, "stroff:" + s, int_to_string(off))
            off
        end
    end
end

