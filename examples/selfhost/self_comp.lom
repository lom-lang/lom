# st_upper/st_lower: (i64 s) -> i64；ASCII-only（宿主 build_case 平移）
# locals: 1=ptr,2=len,3=i,4=pout,5=b（5×i32）
fn st_case_body(upper: Bool, alloc_idx: Int) -> String
    let lo =
    if upper
        97
    else
        65
    end
    let hi =
    if upper
        122
    else
        90
    end
    let delta =
    if upper
        -32
    else
        32
    end
    "01057f"
    + "2000" + "a7" + "2101"
    + "2001" + "280000" + "2102"
    + "2002" + "4104" + "6a" + "10" + leb128_hex(alloc_idx) + "2104"
    + "2004" + "2002" + "360000"
    + "4100" + "2103"
    + "0240" + "0340"
    + "2003" + "2002" + "4f" + "0d01"
    + "2001" + "4104" + "6a" + "2003" + "6a" + "2d0000" + "2105"
    + "2004" + "4104" + "6a" + "2003" + "6a"
    + "2005" + "41" + sleb128_hex(lo) + "4e" + "2005" + "41" + sleb128_hex(hi) + "4c" + "71"
    + "047f"
    + "2005" + "41" + sleb128_hex(delta) + "6a"
    + "05"
    + "2005"
    + "0b"
    + "3a0000"
    + "2003" + "4101" + "6a" + "2103"
    + "0c00"
    + "0b" + "0b"
    + "2004" + "ac"
    + "0b"
end

# match_at(i)：local 3=ps 从偏移 i 起 与 local 5=pf 逐字节比（lf=local 6），
# 结果(1/0)写 local 15（宿主 emit_match_at 平移；local 号对齐 replace 布局）
fn match_at_hex() -> String
    "4101" + "210f"
    + "4100" + "210a"
    + "0240" + "0340"
    + "200a" + "2006" + "4f" + "0d01"
    + "2003" + "4104" + "6a" + "2009" + "6a" + "200a" + "6a" + "2d0000"
    + "2005" + "4104" + "6a" + "200a" + "6a" + "2d0000"
    + "47" + "0440" + "4100" + "210f" + "0c02" + "0b"
    + "200a" + "4101" + "6a" + "210a"
    + "0c00"
    + "0b" + "0b"
end

# st_replace: (i64 s, i64 from, i64 to) -> i64；两遍扫描全量替换
# （宿主 build_replace 平移；from 空 = 每间隙插入含两端，Rust 语义）
# locals: 3=ps,4=ls,5=pf,6=lf,7=pt,8=lt,9=i,10=j,11=cnt,12=olen,13=pout,14=o,15=mf（13×i32）
fn st_replace_body(alloc_idx: Int) -> String
    let head =
    "010d7f"
    + "2000" + "a7" + "2103"
    + "2001" + "a7" + "2105"
    + "2002" + "a7" + "2107"
    + "2003" + "280000" + "2104"
    + "2005" + "280000" + "2106"
    + "2007" + "280000" + "2108"
    # from 为空特例：olen = ls + lt*(ls+1)；i in 0..=ls 每步先写 to 再写 s[i]
    let empty_case =
    "2006" + "45" + "0440"
    + "2004" + "2008" + "2004" + "4101" + "6a" + "6c" + "6a" + "210c"
    + "200c" + "4104" + "6a" + "10" + leb128_hex(alloc_idx) + "210d"
    + "200d" + "200c" + "360000"
    + "4100" + "2109" + "4100" + "210e"
    + "0240" + "0340"
    + "2009" + "2004" + "4a" + "0d01"
    + "4100" + "210a"
    + "0240" + "0340"
    + "200a" + "2008" + "4f" + "0d01"
    + "200d" + "4104" + "6a" + "200e" + "6a" + "2007" + "4104" + "6a" + "200a" + "6a" + "2d0000" + "3a0000"
    + "200e" + "4101" + "6a" + "210e"
    + "200a" + "4101" + "6a" + "210a"
    + "0c00"
    + "0b" + "0b"
    + "2009" + "2004" + "48" + "0440"
    + "200d" + "4104" + "6a" + "200e" + "6a" + "2003" + "4104" + "6a" + "2009" + "6a" + "2d0000" + "3a0000"
    + "200e" + "4101" + "6a" + "210e"
    + "0b"
    + "2009" + "4101" + "6a" + "2109"
    + "0c00"
    + "0b" + "0b"
    + "200d" + "ac" + "0f"
    + "0b"
    # pass 1：数非重叠匹配
    let pass1 =
    "4100" + "2109" + "4100" + "210b"
    + "0240" + "0340"
    + "2009" + "2006" + "6a" + "2004" + "4a" + "0d01"
    + match_at_hex()
    + "200f" + "0440"
    + "200b" + "4101" + "6a" + "210b"
    + "2009" + "2006" + "6a" + "2109"
    + "05"
    + "2009" + "4101" + "6a" + "2109"
    + "0b"
    + "0c00"
    + "0b" + "0b"
    # olen = ls - cnt*lf + cnt*lt；pout 分配
    + "2004" + "200b" + "2006" + "6c" + "6b" + "200b" + "2008" + "6c" + "6a" + "210c"
    + "200c" + "4104" + "6a" + "10" + leb128_hex(alloc_idx) + "210d"
    + "200d" + "200c" + "360000"
    # pass 2：填充
    + "4100" + "2109" + "4100" + "210e"
    + "0240" + "0340"
    + "2009" + "2004" + "4f" + "0d01"
    + "2009" + "2006" + "6a" + "2004" + "4c" + "0440"
    + match_at_hex()
    + "05"
    + "4100" + "210f"
    + "0b"
    + "200f" + "0440"
    + "4100" + "210a"
    + "0240" + "0340"
    + "200a" + "2008" + "4f" + "0d01"
    + "200d" + "4104" + "6a" + "200e" + "6a" + "2007" + "4104" + "6a" + "200a" + "6a" + "2d0000" + "3a0000"
    + "200e" + "4101" + "6a" + "210e"
    + "200a" + "4101" + "6a" + "210a"
    + "0c00"
    + "0b" + "0b"
    + "2009" + "2006" + "6a" + "2109"
    + "05"
    + "200d" + "4104" + "6a" + "200e" + "6a" + "2003" + "4104" + "6a" + "2009" + "6a" + "2d0000" + "3a0000"
    + "200e" + "4101" + "6a" + "210e"
    + "2009" + "4101" + "6a" + "2109"
    + "0b"
    + "0c00"
    + "0b" + "0b"
    + "200d" + "ac"
    + "0b"
    head + empty_case + pass1
end

# st_cfc: (i64 cp) -> i64；码点→UTF-8 单字符 Str（宿主 build_char_from_code
# 平移；无效码点/代理区 trap 对齐宿主）
# locals: 1=cp(i64), 2=cp32, 3=n, 4=p（1×i64 + 3×i32）
fn st_cfc_body(alloc_idx: Int) -> String
    "02017e037f"
    + "2000" + "2101"
    + "2001" + "4200" + "53" + "0440" + "00" + "0b"
    + "2001" + "42" + sleb128_hex(1114111) + "55" + "0440" + "00" + "0b"
    + "2001" + "42" + sleb128_hex(55296) + "59" + "2001" + "42" + sleb128_hex(57343) + "57" + "71" + "0440" + "00" + "0b"
    + "2001" + "a7" + "2102"
    + "4101" + "2103"
    + "2002" + "41" + sleb128_hex(128) + "4f" + "0440"
    + "4102" + "2103"
    + "2002" + "41" + sleb128_hex(2048) + "4f" + "0440"
    + "4103" + "2103"
    + "2002" + "41" + sleb128_hex(65536) + "4f" + "0440"
    + "4104" + "2103"
    + "0b"
    + "0b"
    + "0b"
    + "2003" + "4104" + "6a" + "10" + leb128_hex(alloc_idx) + "2104"
    + "2004" + "2003" + "360000"
    # 写字节：if n==1 {1B} else { if n==2 {2B} else { if n==3 {3B} else {4B} } }
    + "2003" + "4101" + "46" + "0440"
    + "2004" + "4104" + "6a" + "2002" + "3a0000"
    + "05"
    + "2003" + "4102" + "46" + "0440"
    + "2004" + "4104" + "6a" + "2002" + "4106" + "76" + "41" + sleb128_hex(192) + "72" + "3a0000"
    + "2004" + "4105" + "6a" + "2002" + "413f" + "71" + "41" + sleb128_hex(128) + "72" + "3a0000"
    + "05"
    + "2003" + "4103" + "46" + "0440"
    + "2004" + "4104" + "6a" + "2002" + "410c" + "76" + "41" + sleb128_hex(224) + "72" + "3a0000"
    + "2004" + "4105" + "6a" + "2002" + "4106" + "76" + "413f" + "71" + "41" + sleb128_hex(128) + "72" + "3a0000"
    + "2004" + "4106" + "6a" + "2002" + "413f" + "71" + "41" + sleb128_hex(128) + "72" + "3a0000"
    + "05"
    + "2004" + "4104" + "6a" + "2002" + "41" + sleb128_hex(18) + "76" + "41" + sleb128_hex(240) + "72" + "3a0000"
    + "2004" + "4105" + "6a" + "2002" + "410c" + "76" + "413f" + "71" + "41" + sleb128_hex(128) + "72" + "3a0000"
    + "2004" + "4106" + "6a" + "2002" + "4106" + "76" + "413f" + "71" + "41" + sleb128_hex(128) + "72" + "3a0000"
    + "2004" + "4107" + "6a" + "2002" + "413f" + "71" + "41" + sleb128_hex(128) + "72" + "3a0000"
    + "0b"
    + "0b"
    + "0b"
    + "2004" + "ac"
    + "0b"
end

# String helper 注册（cgh "hidx:<name>" 去重；type/body 追加 extra 区）。
# heap 依赖 helper 在注册前调用 need_heap 防御（预扫漏判 fail-safe）。
# ftoa 导入 idx 恒为 3（has_str 布局：0/1=print_i64/f64、2=print_str、3=ftoa）。
fn ensure_str_helper(name: String, cg: {cgs: Map<String, Int>, cgh: Map<String, String>, shims: Map<String, Int>, sigty: Map<String, Int>}) -> Result<Int, String>
    match map_get(cg.cgh, "hidx:" + name)
        Some(idx_s) =>
            match string_to_int(idx_s)
                n => Ok(n)
            end
        end
        None =>
            let alloc_idx = cg_int(cg.cgs, "alloc_idx")
            let tyhex =
            if name == "st_eq" or name == "st_cmp" or name == "st_starts" or name == "st_ends" or name == "st_contains"
                "60027e7e017f"
            else
                if name == "st_concat"
                    "60027e7e017e"
                else
                    if name == "st_ftoa"
                        "60017c017e"
                    else
                        if name == "st_replace"
                            "60037e7e7e017e"
                        else
                            "60017e017e"
                        end
                    end
                end
            end
            let body =
            if name == "st_eq"
                st_eq_body()
            elif name == "st_cmp"
                st_cmp_body()
            elif name == "st_concat"
                st_concat_body(alloc_idx)
            elif name == "st_len"
                st_len_body()
            elif name == "st_itoa"
                st_itoa_body(alloc_idx)
            elif name == "st_ftoa"
                st_ftoa_body(alloc_idx)
            elif name == "st_starts"
                st_starts_ends_body(True)
            elif name == "st_ends"
                st_starts_ends_body(False)
            elif name == "st_contains"
                st_contains_body()
            elif name == "st_trim"
                st_trim_body(alloc_idx)
            elif name == "st_upper"
                st_case_body(True, alloc_idx)
            elif name == "st_lower"
                st_case_body(False, alloc_idx)
            elif name == "st_replace"
                st_replace_body(alloc_idx)
            else
                st_cfc_body(alloc_idx)
            end
            if name != "st_eq" and name != "st_cmp" and name != "st_len" and name != "st_starts" and name != "st_ends" and name != "st_contains"
                let _ = need_heap(cg)?
            end
            let tidx = cg_int(cg.cgs, "tbase") + cg_int(cg.cgs, "nfun") + cg_int(cg.cgs, "n_extra_types")
            map_set(cg.cgh, "extra_types", cg_str(cg.cgh, "extra_types") + tyhex)
            map_set(cg.cgs, "n_extra_types", cg_int(cg.cgs, "n_extra_types") + 1)
            let fidx = reg_extra_fn(tidx, body, cg)
            map_set(cg.cgh, "hidx:" + name, int_to_string(fidx))
            Ok(fidx)
        end
    end
end


# 闭包创建点编译（宿主 compile_closure 平移）。返回 (code, e 槽, caps 名单)：
# code 在父函数里执行——分配 env 对象 + 闭包对象，栈上留闭包值。
# 递归闭包（预绑定 + 补丁）由 comp_one_stmt 特判调用本函数后追加补丁。
fn compile_closure(params: List<Prm>, reto: Option<Ty>, body: Blk, env: Map<String, {slot: Int, vt: String, sig: String, cap: Bool}>, fns: Map<String, {idx: Int, ret: String, nprm: Int, prms: String}>, cg: {cgs: Map<String, Int>, cgh: Map<String, String>, shims: Map<String, Int>, sigty: Map<String, Int>}, locals: Map<String, Int>, localvt: Map<String, String>) -> Result<(String, Int, List<String>), String>
    let _ = need_heap(cg)?
    # 1. 自由变量 → 捕获名单。词法局部先于同名全局函数/变体解析；
    #    只有父环境没有绑定时才按全局符号放行。
    let frees = free_vars_block(body, params)
    let nf = list_length(frees)
    let mut capnames = list_empty()
    let mut fi2 = 0
    while fi2 < nf
        let nm = list_get(frees, fi2)
        match map_get(env, nm)
            Some(_) =>
                capnames = list_cons(nm, capnames)
            end
            None =>
                if map_has(fns, nm) == False and map_has(fns, "@variant:" + nm) == False
                    return Err("闭包捕获了未定义变量 '" + nm + "'")
                end
            end
        end
        fi2 = fi2 + 1
    end
    let caps = rev_str(capnames)
    let ncaps = list_length(caps)
    # 2. 闭包体 env'：参数（slot 1..n；local 0 = env）+ 捕获（slot=捕获位、cap=True）
    let np = list_length(params)
    let env2 = map_empty()
    let localvt2 = map_empty()
    let mut k = 0
    while k < np
        match list_get(params, k)
            Prm(pn, pt) =>
                let vt = ty_vt(pt, fns)?
                map_set(env2, pn, {slot: k + 1, vt: vt, sig: "", cap: False})
                map_set(localvt2, int_to_string(k + 1), vt)
            end
        end
        k = k + 1
    end
    let mut ci = 0
    while ci < ncaps
        let cnm = list_get(caps, ci)
        match map_get(env, cnm)
            Some(pb) =>
                map_set(env2, cnm, {slot: ci, vt: pb.vt, sig: pb.sig, cap: True})
            end
            None =>
                return Err("内部错误：捕获名不在父环境（" + cnm + "）")
            end
        end
        ci = ci + 1
    end
    # 3. 签名与返回段
    let sig = closure_sig(params, reto, body, env2, fns)?
    let rvt = rv_vt(sig_rv(sig))
    # 4. 闭包体编译（独立 locals：槽从 np+1 起）
    let locals2 = map_empty()
    map_set(locals2, "n", np + 1)
    let code2 = comp_blk(body, env2, fns, cg, locals2, localvt2, rvt)?
    let total2 = cg_int(locals2, "n")
    let mut ldecl2 = leb128_hex(total2 - (np + 1))
    let mut li = np + 1
    while li < total2
        ldecl2 = ldecl2 + "01" + vt_hex(slot_vt(localvt2, li))
        li = li + 1
    end
    # 5. 注册函数与表槽
    let tidx = sig_typeidx(sig, cg)
    let fidx = reg_extra_fn(tidx, ldecl2 + code2 + "0b", cg)
    let tslot = reg_table_slot(fidx, cg)
    # 6. 创建点序列（父函数槽）：env 对象 → 闭包对象 → 栈上留值
    let alloc_idx = cg_int(cg.cgs, "alloc_idx")
    let e = new_slot(locals, localvt, "i64")
    let p = new_slot(locals, localvt, "cl")
    let mut out = "41" + sleb128_hex(4 + 8 * ncaps) + "10" + leb128_hex(alloc_idx) + "ac" + "21" + leb128_hex(e)
    out = out + "20" + leb128_hex(e) + "a7" + "41" + sleb128_hex(ncaps) + "3600" + "00"
    let mut i2 = 0
    while i2 < ncaps
        let nm2 = list_get(caps, i2)
        let pb2 = match map_get(env, nm2)
            Some(b) => b
            None => {slot: 0, vt: "i64", sig: "", cap: False}
        end
        let src =
        if pb2.cap
            # 父自己也是闭包：捕获值在父 env 对象里（local 0 中转读取）
            "2000" + "a7" + cap_load_hex(pb2.vt, 4 + 8 * pb2.slot)
        else
            "20" + leb128_hex(pb2.slot)
        end
        out = out + "20" + leb128_hex(e) + "a7" + src + cap_store_hex(pb2.vt, 4 + 8 * i2)
        i2 = i2 + 1
    end
    out = out + "41" + "08" + "10" + leb128_hex(alloc_idx) + "ac" + "21" + leb128_hex(p)
    out = out + "20" + leb128_hex(p) + "a7" + "41" + sleb128_hex(tslot) + "3600" + "00"
    out = out + "20" + leb128_hex(p) + "a7" + "20" + leb128_hex(e) + "a7" + "3600" + "04"
    out = out + "20" + leb128_hex(p)
    Ok((out, e, caps))
end

# 具名函数当值（宿主 emit_fn_value 平移）：零捕获 shim（忽略 env 直调真函数）
# + 零捕获闭包对象 [tslot][env=0]；shim 按名去重复用。
fn emit_fn_value(name: String, fi: {idx: Int, ret: String, nprm: Int, prms: String}, fns: Map<String, {idx: Int, ret: String, nprm: Int, prms: String}>, cg: {cgs: Map<String, Int>, cgh: Map<String, String>, shims: Map<String, Int>, sigty: Map<String, Int>}, locals: Map<String, Int>, localvt: Map<String, String>) -> Result<String, String>
    let _ = need_heap(cg)?
    let tslot = match map_get(cg.shims, name)
        Some(t) => t
        None =>
            let sig = mk_sig(fi.prms, fi.ret)
            let tidx = sig_typeidx(sig, cg)
            # shim 体：参数（local 1..n）直通 + call 真函数
            let mut b = ""
            let mut i = 0
            while i < fi.nprm
                b = b + "20" + leb128_hex(i + 1)
                i = i + 1
            end
            b = b + "10" + leb128_hex(fi.idx)
            let fidx = reg_extra_fn(tidx, "00" + b + "0b", cg)
            let ts = reg_table_slot(fidx, cg)
            map_set(cg.shims, name, ts)
            ts
        end
    end
    let alloc_idx = cg_int(cg.cgs, "alloc_idx")
    let p = new_slot(locals, localvt, "cl")
    Ok("41" + "08" + "10" + leb128_hex(alloc_idx) + "ac" + "21" + leb128_hex(p)
    + "20" + leb128_hex(p) + "a7" + "41" + sleb128_hex(tslot) + "3600" + "00"
    + "20" + leb128_hex(p) + "a7" + "41" + "00" + "3600" + "04"
    + "20" + leb128_hex(p))
end

# 闭包调用（宿主 emit_closure_call 平移 + R74 式编译期签名校验）：
# 先 args 暂存、后 callee 暂存（求值顺序对齐解释器）→ 压 env → 参数 →
# 表索引 → call_indirect（运行时签名检查兜底）。
fn emit_closure_call(callee: Ex, args: List<Ex>, env: Map<String, {slot: Int, vt: String, sig: String, cap: Bool}>, fns: Map<String, {idx: Int, ret: String, nprm: Int, prms: String}>, cg: {cgs: Map<String, Int>, cgh: Map<String, String>, shims: Map<String, Int>, sigty: Map<String, Int>}, locals: Map<String, Int>, localvt: Map<String, String>) -> Result<String, String>
    let sig = ex_sig(callee, env, fns)?
    let np = sig_nprm(sig)
    # 编译期校验（R74 模式）：arity + 逐参 vt
    if list_length(args) != np
        return Err(subset_err("调用闭包实数量不符（期望 " + np + " 得 " + list_length(args) + "）"))
    end
    let mut out = ""
    let mut slots = list_empty()
    let mut i = 0
    while i < list_length(args)
        let a = list_get(args, i)
        let at = infer_ex(a, env, fns)?
        let w = sig_prm_at(sig, i)
        if !vt_compatible(at, w)
            return Err(subset_err("调用闭包第 " + (i + 1) + " 参类型不符（期望 " + w + " 得 " + at + "）"))
        end
        out = out + comp_ex(a, env, fns, cg, locals, localvt)?
        let s = new_slot(locals, localvt, w)
        out = out + "21" + leb128_hex(s)
        slots = list_cons((s, w), slots)
        i = i + 1
    end
    out = out + comp_ex(callee, env, fns, cg, locals, localvt)?
    let cslot = new_slot(locals, localvt, "cl")
    out = out + "21" + leb128_hex(cslot)
    # env（闭包对象 +4 → i32 → i64.extend）
    out = out + "20" + leb128_hex(cslot) + "a7" + "2800" + "04" + "ad"
    # 参数（正序压栈——slots 是头插的，先反转）
    let slots2 = rev_slots_vt(slots)
    for pr in slots2
        out = out + "20" + leb128_hex(pr.0)
    end
    # 表索引（闭包对象 +0 → i32 留栈）
    out = out + "20" + leb128_hex(cslot) + "a7" + "2800" + "00"
    # call_indirect（typeidx 按签名去重）
    let tidx = sig_typeidx(sig, cg)
    out = out + "11" + leb128_hex(tidx) + "00"
    Ok(out)
end

# List<(Int, String)> 反转（emit_closure_call 的参数槽正序恢复）
fn rev_slots_vt(xs: List<(Int, String)>) -> List<(Int, String)>
    let mut out = list_empty()
    let ys = xs
    let mut cur = ys
    while list_is_empty(cur) == False
        out = list_cons(list_head(cur), out)
        cur = list_tail(cur)
    end
    out
end


# ============================================================================
# L2.3-b：自由变量分析（宿主 free_vars_block/fv_* 家族平移；designs/0001 §7.3）
#
# 按首次使用序确定性收集（out 头插 + 逆序恢复）。块级作用域：宿主用
# bound.clone()，Lom Map 引用语义无复制——用 add/remove 配对（added 只记
# 本层新增名，退出逐个移除；同名遮蔽时外层绑定保留）。
# bound/seen: Map<name, Bool>（集合语义）；out: List<String>（头插）
# ============================================================================

# 绑定名进 bound（返回 updated added——只记本层新增，同名遮蔽不重复记）
fn fv_push(bound: Map<String, Bool>, added: List<String>, name: String) -> List<String>
    if map_has(bound, name)
        added
    else
        map_set(bound, name, True)
        list_cons(name, added)
    end
end

# 本层新增名逐个移除（恢复外层作用域）
fn fv_pop(bound: Map<String, Bool>, added: List<String>) -> Unit
    for nm in added
        map_remove(bound, nm)
    end
end

fn fv_note(name: String, bound: Map<String, Bool>, seen: Map<String, Bool>, out: List<String>) -> List<String>
    if map_has(bound, name) == False and map_has(seen, name) == False
        map_set(seen, name, True)
        list_cons(name, out)
    else
        out
    end
end

fn fv_block(b: Blk, bound: Map<String, Bool>, seen: Map<String, Bool>, out: List<String>) -> List<String>
    match b
        BlkOf(stmts, tail) =>
            # added 必须线程化：Lom List 不可变持久化，fv_push 产生新名单——
            # 语句间累积，退出时统一 fv_pop（恢复外层作用域）
            let mut added = list_empty()
            let mut o = out
            let ns = list_length(stmts)
            let mut si = 0
            while si < ns
                let r = fv_stmt(list_get(stmts, si), bound, seen, o, added)
                o = r.0
                added = r.1
                si = si + 1
            end
            match tail
                None =>
                    fv_pop(bound, added)
                    o
                end
                Some(te) =>
                    let o2 = fv_expr(te, bound, seen, o, added)
                    fv_pop(bound, added)
                    o2
                end
            end
        end
    end
end

# 返回 (out, added)——StLet/StDestruct 会追加本层绑定名
fn fv_stmt(s: St, bound: Map<String, Bool>, seen: Map<String, Bool>, out: List<String>, added: List<String>) -> (List<String>, List<String>)
    match s
        StLet(_, name, _, ex) =>
            let o = fv_expr(ex, bound, seen, out, added)
            let a2 = fv_push(bound, added, name)
            (o, a2)
        end
        StDestruct(names, ex) =>
            let o = fv_expr(ex, bound, seen, out, added)
            let mut a = added
            let nn = list_length(names)
            let mut i = 0
            while i < nn
                a = fv_push(bound, a, list_get(names, i))
                i = i + 1
            end
            (o, a)
        end
        StAssign(_, _, _, ex) => (fv_expr(ex, bound, seen, out, added), added)
        StIf(ifr) => fv_if(ifr, bound, seen, out, added)
        StWhile(cond, body) =>
            let o = fv_expr(cond, bound, seen, out, added)
            (fv_block(body, bound, seen, o), added)
        end
        StFor(var, iter, body) =>
            # for 变量作用域限于 body（宿主 b2 = bound.clone 语义 → add/remove 配对）
            let o = fv_expr(iter, bound, seen, out, added)
            let a2 = fv_push(bound, list_empty(), var)
            let o2 = fv_block(body, bound, seen, o)
            fv_pop(bound, a2)
            (o2, added)
        end
        StReturn(opt) =>
            match opt
                None => (out, added)
                Some(e) => (fv_expr(e, bound, seen, out, added), added)
            end
        end
        StExpr(e) => (fv_expr(e, bound, seen, out, added), added)
        StHole(_, _) => (out, added)
    end
end

fn fv_if(ifr: IfR, bound: Map<String, Bool>, seen: Map<String, Bool>, out: List<String>, added: List<String>) -> (List<String>, List<String>)
    match ifr
        IfR(branches, else_b) =>
            let mut o = out
            for pair in branches
                o = fv_expr(pair.0, bound, seen, o, added)
                o = fv_block(pair.1, bound, seen, o)
            end
            match else_b
                None => (o, added)
                Some(eb) => (fv_block(eb, bound, seen, o), added)
            end
        end
    end
end

# match 臂模式绑定（Pattern::Binder/Variant 子模式）——fv 照宿主语义完整
# 实现（match 编译留后续批次，正确遍历无害）
fn fv_pattern_bound(p: Pat, bound: Map<String, Bool>, added: List<String>) -> List<String>
    match p
        PatBinder(n) => fv_push(bound, added, n)
        PatVariant(_, subs) =>
            let mut a = added
            for sp in subs
                a = fv_pattern_bound(sp, bound, a)
            end
            a
        end
        _ => added
    end
end

fn fv_expr(e: Ex, bound: Map<String, Bool>, seen: Map<String, Bool>, out: List<String>, added: List<String>) -> List<String>
    match e
        ExIdent(x, _, _) => fv_note(x, bound, seen, out)
        ExBinary(_, l, r) =>
            let o = fv_expr(l, bound, seen, out, added)
            fv_expr(r, bound, seen, o, added)
        end
        ExLogical(_, l, r) =>
            let o = fv_expr(l, bound, seen, out, added)
            fv_expr(r, bound, seen, o, added)
        end
        ExUnary(_, inner) => fv_expr(inner, bound, seen, out, added)
        ExCall(callee, args) =>
            let mut o = fv_expr(callee, bound, seen, out, added)
            for a in args
                o = fv_expr(a, bound, seen, o, added)
            end
            o
        end
        ExIndex(e1, e2) =>
            let o = fv_expr(e1, bound, seen, out, added)
            fv_expr(e2, bound, seen, o, added)
        end
        ExField(inner, _) => fv_expr(inner, bound, seen, out, added)
        ExGroup(inner) => fv_expr(inner, bound, seen, out, added)
        ExIf(ifr) =>
            # fv_if 返回 (out, added) 元组——fv_expr 只取 out（元组直传会让
            # 上游 rev_str 在运行时炸 list_is_empty，--check 查不出动态类型错）
            let r = fv_if(ifr, bound, seen, out, added)
            r.0
        end
        ExClosure(params, _, body) =>
            # 闭包参数遮蔽（作用域限闭包体）；体自由变量外溢到外层收集
            let mut a = list_empty()
            let np = list_length(params)
            let mut i = 0
            while i < np
                match list_get(params, i)
                    Prm(pn, _) =>
                        a = fv_push(bound, a, pn)
                    end
                end
                i = i + 1
            end
            let o = fv_block(body, bound, seen, out)
            fv_pop(bound, a)
            o
        end
        ExMatch(scrut, arms, _) =>
            let mut o = fv_expr(scrut, bound, seen, out, added)
            for arm in arms
                match arm
                    ArmR(pat, guard, ab) =>
                        let a2 = list_empty()
                        let mut a3 = a2
                        match pat
                            PatBinder(_) =>
                                a3 = fv_pattern_bound(pat, bound, a2)
                            end
                            PatVariant(_, _) =>
                                a3 = fv_pattern_bound(pat, bound, a2)
                            end
                            _ => ()
                        end
                        match guard
                            None => ()
                            Some(g) =>
                                o = fv_expr(g, bound, seen, o, a3)
                            end
                        end
                        match ab
                            ABExpr(be) =>
                                o = fv_expr(be, bound, seen, o, a3)
                            end
                            ABBlock(bb) =>
                                o = fv_block(bb, bound, seen, o)
                            end
                        end
                        fv_pop(bound, a3)
                    end
                end
            end
            o
        end
        ExTry(inner) => fv_expr(inner, bound, seen, out, added)
        ExRange(a, b) =>
            let o = fv_expr(a, bound, seen, out, added)
            fv_expr(b, bound, seen, o, added)
        end
        ExRecord(fields) =>
            let mut o = out
            for pair in fields
                o = fv_expr(pair.1, bound, seen, o, added)
            end
            o
        end
        ExTuple(elems) =>
            let mut o = out
            for el in elems
                o = fv_expr(el, bound, seen, o, added)
            end
            o
        end
        _ => out
    end
end

# 闭包体自由变量（按首次使用序）：参数视为已绑定
fn free_vars_block(body: Blk, params: List<Prm>) -> List<String>
    let bound = map_empty()
    let seen = map_empty()
    let out = list_empty()
    for p in params
        match p
            Prm(pn, _) =>
                map_set(bound, pn, True)
            end
        end
    end
    let o = fv_block(body, bound, seen, out)
    rev_str(o)
end

# ============================================================================
# L2.3-c1：堆设施预扫——闭包/具名函数值/用户 enum/match 命中即真；
# 宁可多发 memory/global，不可漏发 alloc。table/elem 仍只在闭包存在时发。
# 防线：comp 层遇 heap_on=false 却要创建闭包 → 内部一致性 Err（理论不可达）。
# ============================================================================

fn scan_ex(e: Ex, fns: Map<String, {idx: Int, ret: String, nprm: Int, prms: String}>) -> Bool
    match e
        ExClosure(_, _, _) => True
        ExCall(callee, args) =>
            let callee_is_direct =
            match callee
                ExIdent(name, _, _) => map_has(fns, name)
                _ => False
            end
            if callee_is_direct
                scan_args(args, fns)
            else
                if scan_ex(callee, fns)
                    True
                else
                    scan_args(args, fns)
                end
            end
        end
        ExIdent(name, _, _) => map_has(fns, name) or map_has(fns, "@variant:" + name)
        ExBinary(_, l, r) =>
            if scan_ex(l, fns)
                True
            else
                scan_ex(r, fns)
            end
        end
        ExLogical(_, l, r) =>
            if scan_ex(l, fns)
                True
            else
                scan_ex(r, fns)
            end
        end
        ExUnary(_, inner) => scan_ex(inner, fns)
        ExIndex(e1, e2) =>
            if scan_ex(e1, fns)
                True
            else
                scan_ex(e2, fns)
            end
        end
        ExField(inner, _) => scan_ex(inner, fns)
        ExGroup(inner) => scan_ex(inner, fns)
        ExIf(ifr) => scan_if(ifr, fns)
        # L2.3-c：match 预扫保守启用堆（标量 match 多发堆设施无害）；
        # 臂内闭包同样有堆，因此命中即真无需继续递归扫描。
        ExMatch(_, _, _) => True
        ExTry(inner) => scan_ex(inner, fns)
        ExRange(a, b) =>
            if scan_ex(a, fns)
                True
            else
                scan_ex(b, fns)
            end
        end
        ExRecord(fields) =>
            let mut hit = False
            for pair in fields
                if scan_ex(pair.1, fns)
                    hit = True
                end
            end
            hit
        end
        ExTuple(elems) =>
            let mut hit = False
            for el in elems
                if scan_ex(el, fns)
                    hit = True
                end
            end
            hit
        end
        _ => False
    end
end

fn scan_args(args: List<Ex>, fns: Map<String, {idx: Int, ret: String, nprm: Int, prms: String}>) -> Bool
    let mut hit = False
    for a in args
        if scan_ex(a, fns)
            hit = True
        end
    end
    hit
end

fn scan_if(ifr: IfR, fns: Map<String, {idx: Int, ret: String, nprm: Int, prms: String}>) -> Bool
    match ifr
        IfR(branches, else_b) =>
            let mut hit = False
            for pair in branches
                if scan_ex(pair.0, fns)
                    hit = True
                end
                if scan_block(pair.1, fns)
                    hit = True
                end
            end
            match else_b
                None => ()
                Some(eb) =>
                    if scan_block(eb, fns)
                        hit = True
                    end
                end
            end
            hit
        end
    end
end

fn scan_stmt(s: St, fns: Map<String, {idx: Int, ret: String, nprm: Int, prms: String}>) -> Bool
    match s
        StLet(_, _, _, ex) => scan_ex(ex, fns)
        StDestruct(_, ex) => scan_ex(ex, fns)
        StAssign(_, _, _, ex) => scan_ex(ex, fns)
        StIf(ifr) => scan_if(ifr, fns)
        StWhile(cond, body) =>
            if scan_ex(cond, fns)
                True
            else
                scan_block(body, fns)
            end
        end
        StFor(_, iter, body) =>
            if scan_ex(iter, fns)
                True
            else
                scan_block(body, fns)
            end
        end
        StReturn(opt) =>
            match opt
                None => False
                Some(e) => scan_ex(e, fns)
            end
        end
        StExpr(e) => scan_ex(e, fns)
        StHole(_, _) => False
    end
end

fn scan_block(b: Blk, fns: Map<String, {idx: Int, ret: String, nprm: Int, prms: String}>) -> Bool
    match b
        BlkOf(stmts, tail) =>
            let mut hit = False
            for s in stmts
                if scan_stmt(s, fns)
                    hit = True
                end
            end
            match tail
                None => hit
                Some(te) =>
                    if scan_ex(te, fns)
                        True
                    else
                        hit
                    end
                end
            end
        end
    end
end

fn needs_heap(prg: Prg, fns: Map<String, {idx: Int, ret: String, nprm: Int, prms: String}>) -> Bool
    match prg
        Prg(items) =>
            let mut hit = False
            for it in items
                match it
                    ItFn(_, _, _, _, body, _, _) =>
                        if scan_block(body, fns)
                            hit = True
                        end
                    end
                    ItEnum(_, _, _) =>
                        hit = True
                    end
                    _ => ()
                end
            end
            hit
        end
    end
end

# ---- X3：块/函数编译 ----


# 分配 let 槽（locals: Map<"n",Int> 计数；localvt: Map<绝对槽, vt>）
fn new_slot(locals: Map<String, Int>, localvt: Map<String, String>, vt: String) -> Int
    let s = match map_get(locals, "n")
        Some(v) => v
        None => 0
    end
    map_set(locals, "n", s + 1)
    map_set(localvt, int_to_string(s), vt)
    s
end

# StLet 的类型：显式注解优先，否则综合
# R68（十一审）：注解与综合值类型做编译期一致性校验——不一致即拒绝
# （此前直接采信注解定槽位，`let x: Int = 1.5` 产 i64 槽存 f64 值的
# 非法 wasm，失败面推迟到实例化）。与宿主"注解不匹配仅 TYPE001 warning、
# 运行时值胜出"的渐进式语义是已登记的信任边界差异（RFC-0004 修订 4）。
fn let_vt(tyo: Option<Ty>, ex: Ex, env: Map<String, {slot: Int, vt: String, sig: String, cap: Bool}>, fns: Map<String, {idx: Int, ret: String, nprm: Int, prms: String}>) -> Result<String, String>
    match tyo
        None => infer_ex(ex, env, fns)
        Some(tt) =>
            let av = ty_vt(tt, fns)?
            let iv = infer_ex(ex, env, fns)?
            if !vt_compatible(iv, av)
                return Err(subset_err("let 注解类型 '" + av + "' 与值类型 '" + iv + "' 不符（编译期拒绝；宿主侧仅 warning）"))
            end
            Ok(av)
        end
    end
end

# 单条语句编译（comp_blk/comp_stmt_blk 共用；L2.3-a 起含控制流语句）
# R66/R67（十一审）：语句分派的 match 值必须线程化（? 传播）——此前
# match 位于语句位置，拒绝臂的 Err 是被丢弃的死值，子集外语句静默蒸发
# 后照常 COMPILED，产出行为错误的 wasm。
fn comp_one_stmt(s: St, env: Map<String, {slot: Int, vt: String, sig: String, cap: Bool}>, fns: Map<String, {idx: Int, ret: String, nprm: Int, prms: String}>, cg: {cgs: Map<String, Int>, cgh: Map<String, String>, shims: Map<String, Int>, sigty: Map<String, Int>}, locals: Map<String, Int>, localvt: Map<String, String>, ret_vt: String) -> Result<String, String>
    match s
        StLet(_, name, tyo, ex) =>
            match ex
                ExClosure(params, reto, body) =>
                    # L2.3-b 递归闭包特判（宿主 compile_stmt StLet 同款）：
                    # fv 含绑定名 → 预绑定 local → 编译闭包（捕获自身占位值）
                    # → 真值入槽 → 把真值补丁进 env 自身槽位
                    let frees = free_vars_block(body, params)
                    if name_in(frees, name)
                        let _ = let_vt(tyo, ex, env, fns)?
                        # 预绑定先占位（sig "?"——尾引用自身时综合不报未定义），
                        # 综合出真 sig 后回填，再编译闭包（捕获解析拿真值）
                        let slot = new_slot(locals, localvt, "cl")
                        map_set(env, name, {slot: slot, vt: "cl", sig: "?", cap: False})
                        let sig = ex_sig(ex, env, fns)?
                        map_set(env, name, {slot: slot, vt: "cl", sig: sig, cap: False})
                        let r = compile_closure(params, reto, body, env, fns, cg, locals, localvt)?
                        let mut out = r.0 + "21" + leb128_hex(slot)
                        let pos = name_pos(r.2, name)
                        if pos >= 0
                            out = out + "20" + leb128_hex(r.1) + "a7" + "20" + leb128_hex(slot) + "3700" + leb128_hex(4 + 8 * pos)
                        end
                        return Ok(out)
                    end
                end
                _ => ()
            end
            let vt = let_vt(tyo, ex, env, fns)?
            if vt == "void"
                return Err(subset_err("let 绑定 void 值"))
            end
            let code = comp_ex(ex, env, fns, cg, locals, localvt)?
            let slot = new_slot(locals, localvt, vt)
            # L2.3-b：闭包值绑定的 sig 从值表达式综合（调用点校验的事实源）
            let sig2 =
            if vt == "cl"
                ex_sig(ex, env, fns)?
            else
                ""
            end
            map_set(env, name, {slot: slot, vt: vt, sig: sig2, cap: False})
            Ok(code + "21" + leb128_hex(slot))
        end
        StAssign(name, _, _, ex) =>
            match map_get(env, name)
                None => Err("赋值给未定义变量 '" + name + "'")
                Some(bnd) =>
                    # L2.3-b：闭包捕获是值拷贝——赋值捕获变量编译期拒绝
                    # （对齐宿主 WASM："赋值给未定义变量"；宿主 Assign 只查
                    # local 不查 capture）
                    if bnd.cap
                        Err("赋值给未定义变量 '" + name + "'（闭包捕获为值拷贝，不能赋值）")
                    else
                        let assigned_vt = infer_ex(ex, env, fns)?
                        if !vt_compatible(assigned_vt, bnd.vt)
                            return Err(subset_err("赋值 '" + name + "' 类型不符（期望 " + bnd.vt + " 得 " + assigned_vt + "）"))
                        end
                        if bnd.vt == "cl"
                            let assigned_sig = ex_sig(ex, env, fns)?
                            if assigned_sig != bnd.sig
                                return Err(subset_err("赋值 '" + name + "' 闭包签名不符（call_indirect 需精确签名）"))
                            end
                        end
                        let code = comp_ex(ex, env, fns, cg, locals, localvt)?
                        let merged = vt_merge(bnd.vt, assigned_vt)?
                        if merged != bnd.vt
                            map_set(env, name, {slot: bnd.slot, vt: merged, sig: bnd.sig, cap: False})
                        end
                        Ok(code + "21" + leb128_hex(bnd.slot))
                    end
                end
            end
        end
        StExpr(ex) =>
            let t = infer_ex(ex, env, fns)?
            let code = comp_ex(ex, env, fns, cg, locals, localvt)?
            if t == "void"
                Ok(code)
            else
                Ok(code + "1a")
            end
        end
        StIf(ifr) => comp_if_stmt(ifr, env, fns, cg, locals, localvt, ret_vt)
        StWhile(cond, body) => comp_while(cond, body, env, fns, cg, locals, localvt, ret_vt)
        StFor(var, iter, body) => comp_for(var, iter, body, env, fns, cg, locals, localvt, ret_vt)
        StReturn(_) => Err(subset_err("return 语句（块深度跟踪留后续批次）"))
        _ => Err(subset_err("该语句形态（match/解构留后续批次）"))
    end
end

# 编译块：语句（值丢弃：非 void 的裸表达式 drop）+ 尾表达式（= 返回值）
fn comp_blk(b: Blk, env: Map<String, {slot: Int, vt: String, sig: String, cap: Bool}>, fns: Map<String, {idx: Int, ret: String, nprm: Int, prms: String}>, cg: {cgs: Map<String, Int>, cgh: Map<String, String>, shims: Map<String, Int>, sigty: Map<String, Int>}, locals: Map<String, Int>, localvt: Map<String, String>, ret_vt: String) -> Result<String, String>
    match b
        BlkOf(stmts, tail) =>
            let mut out = ""
            let mut si = 0
            while si < list_length(stmts)
                out = out + comp_one_stmt(list_get(stmts, si), env, fns, cg, locals, localvt, ret_vt)?
                si = si + 1
            end
            comp_tail(tail, env, fns, cg, out, ret_vt, locals, localvt)
        end
    end
end

# 语句体块编译（if/while/for 的 body）：块值丢弃——尾表达式 void 时编译
# 执行（副作用，R66 教训），非 void 时补 drop
fn comp_stmt_blk(b: Blk, env: Map<String, {slot: Int, vt: String, sig: String, cap: Bool}>, fns: Map<String, {idx: Int, ret: String, nprm: Int, prms: String}>, cg: {cgs: Map<String, Int>, cgh: Map<String, String>, shims: Map<String, Int>, sigty: Map<String, Int>}, locals: Map<String, Int>, localvt: Map<String, String>, ret_vt: String) -> Result<String, String>
    match b
        BlkOf(stmts, tail) =>
            # R79：绑定表为引用语义；每个词法子块独立复制，local 槽表继续共享。
            let block_env = copy_bindings(env)
            let mut out = ""
            let mut si = 0
            while si < list_length(stmts)
                out = out + comp_one_stmt(list_get(stmts, si), block_env, fns, cg, locals, localvt, ret_vt)?
                si = si + 1
            end
            match tail
                None => Ok(out)
                Some(te) =>
                    match te
                        ExIf(ifr) =>
                            # L2.3-a：语句体块尾的 if——按语句执行（分支值
                            # 丢弃），走 comp_if_stmt 的 void 形态
                            Ok(out + comp_if_stmt(ifr, block_env, fns, cg, locals, localvt, ret_vt)?)
                        end
                        _ =>
                            let tt = infer_ex(te, block_env, fns)?
                            let code = comp_ex(te, block_env, fns, cg, locals, localvt)?
                            if tt == "void"
                                Ok(out + code)
                            else
                                Ok(out + code + "1a")
                            end
                        end
                    end
                end
            end
        end
    end
end

# L2.3-a：if 语句（含 elif 链）——分支链按嵌套 else 展开；条件须 Bool。
# 语句位 if 的块值丢弃（comp_stmt_blk）。
fn comp_if_stmt(ifr: IfR, env: Map<String, {slot: Int, vt: String, sig: String, cap: Bool}>, fns: Map<String, {idx: Int, ret: String, nprm: Int, prms: String}>, cg: {cgs: Map<String, Int>, cgh: Map<String, String>, shims: Map<String, Int>, sigty: Map<String, Int>}, locals: Map<String, Int>, localvt: Map<String, String>, ret_vt: String) -> Result<String, String>
    match ifr
        IfR(branches, else_b) =>
            comp_if_from(branches, else_b, 0, env, fns, cg, locals, localvt, ret_vt)
        end
    end
end

fn comp_if_from(branches: List<(Ex, Blk)>, else_b: Option<Blk>, bi: Int, env: Map<String, {slot: Int, vt: String, sig: String, cap: Bool}>, fns: Map<String, {idx: Int, ret: String, nprm: Int, prms: String}>, cg: {cgs: Map<String, Int>, cgh: Map<String, String>, shims: Map<String, Int>, sigty: Map<String, Int>}, locals: Map<String, Int>, localvt: Map<String, String>, ret_vt: String) -> Result<String, String>
    if bi >= list_length(branches)
        match else_b
            None => Ok("")
            Some(eb) => comp_stmt_blk(eb, env, fns, cg, locals, localvt, ret_vt)
        end
    else
        let pair = list_get(branches, bi)
        let ct = infer_ex(pair.0, env, fns)?
        if ct != "i32"
            return Err(subset_err("if 条件须为 Bool（得到 '" + ct + "'）"))
        end
        let cc = comp_ex(pair.0, env, fns, cg, locals, localvt)?
        let bc = comp_stmt_blk(pair.1, env, fns, cg, locals, localvt, ret_vt)?
        let rest = comp_if_from(branches, else_b, bi + 1, env, fns, cg, locals, localvt, ret_vt)?
        Ok(cc + "0440" + bc + "05" + rest + "0b")
    end
end

# L2.3-a：块尾 if 表达式编译——(result bt) 形态产值；bt 由综合类型定。
# 分支体产值（comp_val_blk：语句照常 + 尾值留栈；void 分支不产值）。
fn comp_if_expr(ifr: IfR, env: Map<String, {slot: Int, vt: String, sig: String, cap: Bool}>, fns: Map<String, {idx: Int, ret: String, nprm: Int, prms: String}>, cg: {cgs: Map<String, Int>, cgh: Map<String, String>, shims: Map<String, Int>, sigty: Map<String, Int>}, locals: Map<String, Int>, localvt: Map<String, String>) -> Result<String, String>
    match ifr
        IfR(branches, else_b) =>
            let t = infer_if_expr(ifr, env, fns)?
            let bt = vt_bt(t)
            comp_if_expr_from(branches, else_b, bt, 0, env, fns, cg, locals, localvt)
        end
    end
end

fn comp_if_expr_from(branches: List<(Ex, Blk)>, else_b: Option<Blk>, bt: String, bi: Int, env: Map<String, {slot: Int, vt: String, sig: String, cap: Bool}>, fns: Map<String, {idx: Int, ret: String, nprm: Int, prms: String}>, cg: {cgs: Map<String, Int>, cgh: Map<String, String>, shims: Map<String, Int>, sigty: Map<String, Int>}, locals: Map<String, Int>, localvt: Map<String, String>) -> Result<String, String>
    if bi >= list_length(branches)
        match else_b
            None => Ok("")
            Some(eb) => comp_val_blk(eb, env, fns, cg, locals, localvt)
        end
    else
        let pair = list_get(branches, bi)
        let ct = infer_ex(pair.0, env, fns)?
        if ct != "i32"
            return Err(subset_err("if 条件须为 Bool（得到 '" + ct + "'）"))
        end
        let cc = comp_ex(pair.0, env, fns, cg, locals, localvt)?
        let bc = comp_val_blk(pair.1, env, fns, cg, locals, localvt)?
        let rest = comp_if_expr_from(branches, else_b, bt, bi + 1, env, fns, cg, locals, localvt)?
        Ok(cc + "04" + bt + bc + "05" + rest + "0b")
    end
end

# 值位块编译：语句照常（let 开槽走同一 locals/localvt）+ 尾表达式值留栈
# （无尾 = void 不产值）
fn comp_val_blk(b: Blk, env: Map<String, {slot: Int, vt: String, sig: String, cap: Bool}>, fns: Map<String, {idx: Int, ret: String, nprm: Int, prms: String}>, cg: {cgs: Map<String, Int>, cgh: Map<String, String>, shims: Map<String, Int>, sigty: Map<String, Int>}, locals: Map<String, Int>, localvt: Map<String, String>) -> Result<String, String>
    match b
        BlkOf(stmts, tail) =>
            let block_env = copy_bindings(env)
            let mut out = ""
            let mut si = 0
            while si < list_length(stmts)
                out = out + comp_one_stmt(list_get(stmts, si), block_env, fns, cg, locals, localvt, "void")?
                si = si + 1
            end
            match tail
                None => Ok(out)
                Some(te) => Ok(out + comp_ex(te, block_env, fns, cg, locals, localvt)?)
            end
        end
    end
end

# L2.3-a：值类型 → if 的 blocktype hex（void 40 / i64 7e / f64 7c / i32 7f；
# L2.3-b：cl（闭包值 = i64）→ 7e）
fn vt_bt(vt: String) -> String
    if vt == "i64" or enum_vt(vt) or vt == "st"
        "7e"
    else
        if vt == "i32"
            "7f"
        else
            if vt == "f64"
                "7c"
            else
                if vt == "cl"
                    "7e"
                else
                    "40"
                end
            end
        end
    end
end

# L2.3-a：while——block/loop + 条件取反 br_if 退出 + br 0 回环
fn comp_while(cond: Ex, body: Blk, env: Map<String, {slot: Int, vt: String, sig: String, cap: Bool}>, fns: Map<String, {idx: Int, ret: String, nprm: Int, prms: String}>, cg: {cgs: Map<String, Int>, cgh: Map<String, String>, shims: Map<String, Int>, sigty: Map<String, Int>}, locals: Map<String, Int>, localvt: Map<String, String>, ret_vt: String) -> Result<String, String>
    let ct = infer_ex(cond, env, fns)?
    if ct != "i32"
        return Err(subset_err("while 条件须为 Bool（得到 '" + ct + "'）"))
    end
    let cc = comp_ex(cond, env, fns, cg, locals, localvt)?
    let bc = comp_stmt_blk(body, env, fns, cg, locals, localvt, ret_vt)?
    Ok("0240" + "0340" + cc + "45" + "0d01" + bc + "0c00" + "0b" + "0b")
end

# L2.3-a：for x in <Int>（0..n 左闭右开，对齐宿主 Int 迭代）。循环变量
# 遮蔽 = 新槽（对齐宿主：循环后外层同名绑定不变）；String/List 迭代
# 留后续批次。iter 表达式循环前求值一次存槽。
fn comp_for(var: String, iter: Ex, body: Blk, env: Map<String, {slot: Int, vt: String, sig: String, cap: Bool}>, fns: Map<String, {idx: Int, ret: String, nprm: Int, prms: String}>, cg: {cgs: Map<String, Int>, cgh: Map<String, String>, shims: Map<String, Int>, sigty: Map<String, Int>}, locals: Map<String, Int>, localvt: Map<String, String>, ret_vt: String) -> Result<String, String>
    let it = infer_ex(iter, env, fns)?
    if it != "i64"
        return Err(subset_err("for 迭代仅支持 Int（String/List 留后续批次，得到 '" + it + "'）"))
    end
    let ic = comp_ex(iter, env, fns, cg, locals, localvt)?
    let n_slot = new_slot(locals, localvt, "i64")
    let x_slot = new_slot(locals, localvt, "i64")
    # 迭代变量只进入循环的临时绑定表；循环体自己再开一层子块。
    let loop_env = copy_bindings(env)
    map_set(loop_env, var, {slot: x_slot, vt: "i64", sig: "", cap: False})
    let bc = comp_stmt_blk(body, loop_env, fns, cg, locals, localvt, ret_vt)?
    let xl = leb128_hex(x_slot)
    Ok(ic + "21" + leb128_hex(n_slot)
        + "4200" + "21" + xl
        + "0240" + "0340"
        + "20" + xl + "20" + leb128_hex(n_slot) + "53"
        + "45" + "0d01"
        + bc
        + "20" + xl + "4201" + "7c" + "21" + xl
        + "0c00" + "0b" + "0b")
end

fn comp_tail(tail: Option<Ex>, env: Map<String, {slot: Int, vt: String, sig: String, cap: Bool}>, fns: Map<String, {idx: Int, ret: String, nprm: Int, prms: String}>, cg: {cgs: Map<String, Int>, cgh: Map<String, String>, shims: Map<String, Int>, sigty: Map<String, Int>}, out: String, ret_vt: String, locals: Map<String, Int>, localvt: Map<String, String>) -> Result<String, String>
    match tail
        None => Ok(out)
        Some(te) =>
            match te
                ExIf(ifr) =>
                    # L2.3-a：块尾 if 表达式——(result bt) 产值（类型校验走
                    # infer_if_expr 综合口径）。注：then 块首元素不得是嵌套
                    # if（宿主 dangling-else 贪婪归内会吞外层 else），
                    # 校验写为提前 return 链。
                    let t = infer_if_expr(ifr, env, fns)?
                    if ret_vt == "void" and t != "void"
                        return Err(subset_err("void 函数的尾表达式产值"))
                    end
                    if ret_vt != "void" and !vt_compatible(t, ret_vt)
                        return Err("尾表达式类型与返回类型不符")
                    end
                    Ok(out + comp_if_expr(ifr, env, fns, cg, locals, localvt)?)
                end
                _ =>
                    let tt = infer_ex(te, env, fns)?
                    if ret_vt == "void"
                        if tt == "void"
                            # void 函数的 void 尾（如 println 调用）有副作用——
                            # 必须编译执行（块尾裸表达式归 Tail 不归 stmts）
                            return Ok(out + comp_ex(te, env, fns, cg, locals, localvt)?)
                        end
                        return Err(subset_err("void 函数的尾表达式产值"))
                    end
                    if !vt_compatible(tt, ret_vt)
                        return Err("尾表达式类型与返回类型不符")
                    end
                    Ok(out + comp_ex(te, env, fns, cg, locals, localvt)?)
                end
            end
        end
    end
end

# 编译单个函数体 → code section 条目（bodysize + locals 声明 + 指令 + end）
fn comp_one_fn(params: List<Prm>, ret: Option<Ty>, body: Blk, fns: Map<String, {idx: Int, ret: String, nprm: Int, prms: String}>, cg: {cgs: Map<String, Int>, cgh: Map<String, String>, shims: Map<String, Int>, sigty: Map<String, Int>}) -> Result<String, String>
    let env = map_empty()
    let locals = map_empty()
    let localvt = map_empty()
    let k = bind_params(params, env, fns)?
    map_set(locals, "n", k)
    let rv = tyopt_vt(ret, fns)?
    let code = comp_blk(body, env, fns, cg, locals, localvt, rv)?
    # local 声明段：只声明 let 槽（绝对槽 k..n），每组 count=1
    let total = match map_get(locals, "n")
        Some(v) => v
        None => 0
    end
    let mut ldecl = leb128_hex(total - k)
    let mut i = k
    while i < total
        ldecl = ldecl + "01" + vt_hex(slot_vt(localvt, i))
        i = i + 1
    end
    let bodyhex = ldecl + code + "0b"
    Ok(leb128_hex(len(bodyhex) / 2) + bodyhex)
end

# 参数绑定到槽 0..k-1；返回参数数（子集外类型由 fn_type_entry 报错）
# 槽 vt（None 不可达——new_slot 先 set；兜底 "i64"）
fn slot_vt(localvt: Map<String, String>, i: Int) -> String
    match map_get(localvt, int_to_string(i))
        Some(v) => v
        None => "i64"
    end
end

fn bind_params(params: List<Prm>, env: Map<String, {slot: Int, vt: String, sig: String, cap: Bool}>, fns: Map<String, {idx: Int, ret: String, nprm: Int, prms: String}>) -> Result<Int, String>
    let mut k = 0
    for p in params
        match p
            Prm(pn, pt) =>
                let vt = ty_vt(pt, fns)?
                if vt == "void"
                    return Err(subset_err("void/子集外参数类型"))
                end
                map_set(env, pn, {slot: k, vt: vt, sig: "", cap: False})
                k = k + 1
            end
        end
    end
    Ok(k)
end

# ---- X4：模块组装 ----

fn sect(id: String, content: String) -> String
    id + leb128_hex(len(content) / 2) + content
end

# 枚举两遍登记：先登记类型名/参数（支持递归载荷），再登记变体模板。
# 内建 Result/Option 沿用宿主预留的变体索引 0..3；用户变体从 4 起。
# @ 前缀不是 Lom 标识符字符，故与用户函数名不碰撞。
fn register_enums(prg: Prg, fns: Map<String, {idx: Int, ret: String, nprm: Int, prms: String}>) -> Result<String, String>
    map_set(fns, "@enum:Result", {idx: 0, ret: "en:Result", nprm: 2, prms: "T,E"})
    map_set(fns, "@enum:Option", {idx: 0, ret: "en:Option", nprm: 1, prms: "T"})
    map_set(fns, "@variant:Ok", {idx: 0, ret: "en:Result", nprm: 1, prms: "tv:T"})
    map_set(fns, "@variant:Err", {idx: 1, ret: "en:Result", nprm: 1, prms: "tv:E"})
    map_set(fns, "@variant:Some", {idx: 2, ret: "en:Option", nprm: 1, prms: "tv:T"})
    map_set(fns, "@variant:None", {idx: 3, ret: "en:Option", nprm: 0, prms: ""})
    match prg
        Prg(items) =>
            for it in items
                match it
                    ItEnum(name, tparams, _) =>
                        if name == "Int" or name == "Float" or name == "Bool" or name == "String" or name == "Unit" or name == "Fn" or name == "Result" or name == "Option"
                            return Err(subset_err("枚举名与内建类型冲突（'" + name + "'）"))
                        end
                        if map_has(fns, "@enum:" + name)
                            return Err(subset_err("重复枚举声明 '" + name + "'"))
                        end
                        let mut ps = ""
                        let mut seen = map_empty()
                        for tp in tparams
                            if tp == "Int" or tp == "Float" or tp == "Bool" or tp == "String" or tp == "Unit" or tp == "Fn" or tp == "Result" or tp == "Option"
                                return Err(subset_err("类型参数名与内建类型冲突（'" + tp + "'）"))
                            end
                            if map_has(seen, tp)
                                return Err(subset_err("枚举 '" + name + "' 重复类型参数 '" + tp + "'"))
                            end
                            map_set(seen, tp, True)
                            if ps != ""
                                ps = ps + ","
                            end
                            ps = ps + tp
                        end
                        map_set(fns, "@enum:" + name, {idx: 0, ret: "en:" + name, nprm: list_length(tparams), prms: ps})
                    end
                    _ => ()
                end
            end
            let mut vidx = 4
            for it in items
                match it
                    ItEnum(name, tparams, variants) =>
                        for vr in variants
                            match vr
                                VarR(vname, fields) =>
                                    if vname == "Ok" or vname == "Err" or vname == "Some" or vname == "None"
                                        return Err(subset_err("用户变体名与内建变体冲突（'" + vname + "'）"))
                                    end
                                    if map_has(fns, "@variant:" + vname)
                                        return Err(subset_err("重复变体名 '" + vname + "'"))
                                    end
                                    let mut ps = ""
                                    let mut n = 0
                                    for ft in fields
                                        let vt = ty_vt_with_params(ft, fns, tparams)?
                                        if vt == "void"
                                            return Err(subset_err("变体载荷不能为 Unit（'" + vname + "'）"))
                                        end
                                        if n > 0
                                            ps = ps + ","
                                        end
                                        ps = ps + vt
                                        n = n + 1
                                    end
                                    map_set(fns, "@variant:" + vname, {idx: vidx, ret: "en:" + name, nprm: n, prms: ps})
                                    vidx = vidx + 1
                                end
                            end
                        end
                    end
                    _ => ()
                end
            end
            Ok("")
        end
    end
end

# 收集签名：fns: Map<name, {idx, ret, nprm, prms}>（idx = 2+序，前两个是 print 导入；prms = 形参 vt 逗号串——R74 调用点校验用）
# Ty 是否含 String（递归；String 批 has_str 预扫的签名路）
fn ty_has_string(t: Ty) -> Bool
    match t
        TyString => True
        TyOption(i) => ty_has_string(i)
        TResult(a, b) => ty_has_string(a) or ty_has_string(b)
        TyGeneric(_, args) =>
            let mut hit = False
            for a in args
                if ty_has_string(a)
                    hit = True
                end
            end
            hit
        end
        TyRecord(flds) =>
            let mut hit = False
            for f in flds
                if ty_has_string(f.1)
                    hit = True
                end
            end
            hit
        end
        TyTuple(args) =>
            let mut hit = False
            for a in args
                if ty_has_string(a)
                    hit = True
                end
            end
            hit
        end
        _ => False
    end
end

# Option<Ty> 是否含 String（None = 无返回注解 = 不含）
fn tyopt_has_string(t: Option<Ty>) -> Bool
    match t
        Some(tt) => ty_has_string(tt)
        None => False
    end
end

# string 模块内建表（B3 子集；string_to_int 返回 Int|Unit 联合在 untagged 下
# 不可表达、split 返回 List——两者明确拒绝并锁负例）
fn st_builtin_entry(name: String) -> Result<{helper: String, nprm: Int, prms: String, ret: String}, String>
    if name == "len"
        return Ok({helper: "st_len", nprm: 1, prms: "st", ret: "i64"})
    end
    if name == "int_to_string"
        return Ok({helper: "st_itoa", nprm: 1, prms: "i64", ret: "st"})
    end
    if name == "starts_with"
        return Ok({helper: "st_starts", nprm: 2, prms: "st,st", ret: "i32"})
    end
    if name == "ends_with"
        return Ok({helper: "st_ends", nprm: 2, prms: "st,st", ret: "i32"})
    end
    if name == "contains"
        return Ok({helper: "st_contains", nprm: 2, prms: "st,st", ret: "i32"})
    end
    if name == "trim"
        return Ok({helper: "st_trim", nprm: 1, prms: "st", ret: "st"})
    end
    if name == "upper"
        return Ok({helper: "st_upper", nprm: 1, prms: "st", ret: "st"})
    end
    if name == "lower"
        return Ok({helper: "st_lower", nprm: 1, prms: "st", ret: "st"})
    end
    if name == "replace"
        return Ok({helper: "st_replace", nprm: 3, prms: "st,st,st", ret: "st"})
    end
    if name == "char_from_code"
        return Ok({helper: "st_cfc", nprm: 1, prms: "i64", ret: "st"})
    end
    if name == "string_to_int"
        return Err(subset_err("string_to_int 返回 Int|Unit 联合（成功 Int 失败 Unit），untagged 表示下运行时不可区分——留后续批次"))
    end
    if name == "split"
        return Err(subset_err("split 返回 List——随 List 批交付"))
    end
    Err(subset_err("string 模块内建 '" + name + "' 超出 L2 String 批子集"))
end

# n 字节零的 hex（scratch 区填充）
fn zeros_hex(n: Int) -> String
    let mut out = ""
    let mut i = 0
    while i < n
        out = out + "00"
        i = i + 1
    end
    out
end

# ---- String 预扫（表达式路：AST 含 ExStr 即真——独立于 heap 预扫，语义不混）----

fn str_pattern(p: Pat) -> Bool
    match p
        PatLit(lit) => str_ex(lit)
        PatVariant(_, subs) =>
            let mut hit = False
            for s in subs
                if str_pattern(s)
                    hit = True
                end
            end
            hit
        end
        _ => False
    end
end

fn str_ex(e: Ex) -> Bool
    match e
        ExStr(_) => True
        ExBinary(_, l, r) => str_ex(l) or str_ex(r)
        ExLogical(_, l, r) => str_ex(l) or str_ex(r)
        ExUnary(_, i) => str_ex(i)
        ExGroup(i) => str_ex(i)
        ExCall(c, args) =>
            let mut hit = str_ex(c)
            for a in args
                if str_ex(a)
                    hit = True
                end
            end
            hit
        end
        ExIndex(a, b) => str_ex(a) or str_ex(b)
        ExField(i, _) => str_ex(i)
        ExIf(ifr) => str_if(ifr)
        ExMatch(scrut, arms, _) =>
            let mut hit = str_ex(scrut)
            for arm in arms
                match arm
                    ArmR(pat, guard, ab) =>
                        if str_pattern(pat)
                            hit = True
                        end
                        match guard
                            Some(g) =>
                                if str_ex(g)
                                    hit = True
                                end
                            end
                            None => ()
                        end
                        match ab
                            ABExpr(ae) =>
                                if str_ex(ae)
                                    hit = True
                                end
                            end
                            ABBlock(bb) =>
                                if str_block(bb)
                                    hit = True
                                end
                            end
                        end
                    end
                end
            end
            hit
        end
        ExClosure(_, _, body) => str_block(body)
        ExTry(i) => str_ex(i)
        ExPipe(a, b) => str_ex(a) or str_ex(b)
        ExRange(a, b) => str_ex(a) or str_ex(b)
        ExRecord(flds) =>
            let mut hit = False
            for f in flds
                if str_ex(f.1)
                    hit = True
                end
            end
            hit
        end
        ExTuple(args) =>
            let mut hit = False
            for a in args
                if str_ex(a)
                    hit = True
                end
            end
            hit
        end
        _ => False
    end
end

fn str_if(ifr: IfR) -> Bool
    match ifr
        IfR(branches, else_b) =>
            let mut hit = False
            for pair in branches
                if str_ex(pair.0) or str_block(pair.1)
                    hit = True
                end
            end
            match else_b
                Some(eb) =>
                    if str_block(eb)
                        hit = True
                    end
                end
                None => ()
            end
            hit
        end
    end
end

fn str_block(b: Blk) -> Bool
    match b
        BlkOf(stmts, tail) =>
            let mut hit = False
            for s in stmts
                if str_stmt(s)
                    hit = True
                end
            end
            match tail
                Some(t) =>
                    if str_ex(t)
                        hit = True
                    end
                end
                None => ()
            end
            hit
        end
    end
end

fn str_stmt(s: St) -> Bool
    match s
        StLet(_, _, _, e) => str_ex(e)
        StDestruct(_, e) => str_ex(e)
        StAssign(_, _, _, e) => str_ex(e)
        StIf(ifr) => str_if(ifr)
        StWhile(c, b) => str_ex(c) or str_block(b)
        StFor(_, i, b) => str_ex(i) or str_block(b)
        StReturn(oe) =>
            match oe
                Some(e) => str_ex(e)
                None => False
            end
        end
        StExpr(e) => str_ex(e)
        StHole(_, _) => False
    end
end

fn scan_has_string(prg: Prg) -> Bool
    match prg
        Prg(items) =>
            let mut hit = False
            for it in items
                match it
                    ItFn(_, _, _, _, body, _, _) =>
                        if str_block(body)
                            hit = True
                        end
                    end
                    _ => ()
                end
            end
            hit
        end
    end
end

# 签名/import 路的 String 预探测（不注册 fns——ibase 判定先行）
fn probe_str_sigs(prg: Prg) -> Bool
    match prg
        Prg(items) =>
            let mut hit = False
            for it in items
                match it
                    ItFn(_, params, ret, _, _, _, _) =>
                        if tyopt_has_string(ret)
                            hit = True
                        end
                        for p in params
                            match p
                                Prm(_, pt) =>
                                    if ty_has_string(pt)
                                        hit = True
                                    end
                                end
                            end
                        end
                    end
                    ItImport(module, _) =>
                        if module == "string"
                            hit = True
                        end
                    end
                    _ => ()
                end
            end
            hit
        end
    end
end

fn collect_sigs(prg: Prg, fns: Map<String, {idx: Int, ret: String, nprm: Int, prms: String}>, ibase: Int) -> Result<String, String>
    register_enums(prg, fns)?
    match prg
        Prg(items) =>
            let mut idx = ibase
            for it in items
                match it
                    ItFn(name, params, ret, _, _, _, _) =>
                        if name == "println"
                            return Err("用户函数不得命名 'println'")
                        end
                        let rv = tyopt_vt(ret, fns)?
                        # R74（十二审）：摘要携带形参 vt 逗号串——调用点
                        # 类型/arity 校验的事实源（Int/Float/Bool/String/用户 enum；
                        # 其余在签名层即拒，与 fn_type_entry 同文案）
                        let mut pv = ""
                        let mut k = 0
                        for p in params
                            match p
                                Prm(_, pt) =>
                                    let vt = ty_vt(pt, fns)?
                                    if vt == "void"
                                        return Err(subset_err("void/子集外参数类型"))
                                    end
                                    if k > 0
                                        pv = pv + ","
                                    end
                                    pv = pv + vt
                                end
                            end
                            k = k + 1
                        end
                        map_set(fns, name, {idx: idx, ret: rv, nprm: list_length(params), prms: pv})
                        idx = idx + 1
                    end
                    ItImport(module, im_items) =>
                        # L2.3 String 批：from string import {...} 逐名注册
                        # 内建摘要（idx=-2 哨兵 → comp_call 走 helper 分派）
                        if module == "string"
                            for imp in im_items
                                match imp
                                    ImpI(iname, alias) =>
                                        let ent = st_builtin_entry(iname)?
                                        if map_has(fns, alias)
                                            return Err(subset_err("内建导入 '" + alias + "' 与用户函数/重复导入同名"))
                                        end
                                        map_set(fns, alias, {idx: -2, ret: ent.ret, nprm: ent.nprm, prms: ent.prms})
                                    end
                                end
                            end
                        end
                    end
                    _ => ()
                end
            end
            Ok("")
        end
    end
end

# 函数类型条目：60 <nprm> <vt...> <0|1> <ret>
fn fn_type_entry(params: List<Prm>, ret_vt: String, fns: Map<String, {idx: Int, ret: String, nprm: Int, prms: String}>) -> Result<String, String>
    let mut ps = leb128_hex(list_length(params))
    for p in params
        match p
            Prm(_, pt) =>
                let vt = ty_vt(pt, fns)?
                if vt == "void"
                    return Err(subset_err("void/子集外参数类型"))
                end
                ps = ps + vt_hex(vt)
            end
        end
    end
    if ret_vt == "void"
        Ok("60" + ps + "00")
    else
        Ok("60" + ps + "01" + vt_hex(ret_vt))
    end
end

# 从 Itm 提取该函数的返回值类型
fn sig_ret(it: Itm, fns: Map<String, {idx: Int, ret: String, nprm: Int, prms: String}>) -> Result<String, String>
    match it
        ItFn(_, _, ret, _, _, _, _) => tyopt_vt(ret, fns)
        _ => Err("内部错误：sig_ret 只接受 ItFn")
    end
end

# Prg → 模块 hex
fn build_module(prg: Prg) -> Result<String, String>
    let fns = map_empty()
    # L2.3 String 批：has_str 预扫先于签名收集（ibase 依赖它）。
    # 口径（宁滥勿缺）：import string 模块 / 签名 Ty 含 String / 表达式
    # 含 ExStr——st 值的三个来源全覆盖；模式内 ExStr 必伴随其一。
    let has_str = probe_str_sigs(prg) or scan_has_string(prg)
    let ibase =
    if has_str
        4
    else
        2
    end
    collect_sigs(prg, fns, ibase)?
    if map_has(fns, "main") == False
        return Err("程序缺少 main 函数")
    end
    match prg
        Prg(items) =>
            # L2.3-b：nfun 预计数（闭包 funcidx = base+nfun+extra 序依赖它——
            # 两遍式天然免疫宿主 §7.3"闭包挤占索引空间"坑）
            let mut nfun = 0
            for it in items
                match it
                    ItFn(_, _, _, _, _, _, _) =>
                        nfun = nfun + 1
                    end
                    _ => ()
                end
            end
            # L2.3 String 批：has_str → import 扩 4（+print_str/ftoa），全部
            # funcidx/typeidx 基址随抬（ibase/tbase）；data 段 offset 0 起
            # '\n'。无 String 程序布局与旧版逐字节一致（存量 hex 不变）。
            let ibase =
            if has_str
                4
            else
                2
            end
            # L2.3-c：闭包、枚举或 match 预扫（保守）→ 按需启用堆设施。
            # String 批保守化：任一 String 形态也开堆（静态/动态判定易漏，
            # 宁可多发；行为对拍不受 section 多寡影响）。
            let heap_on = needs_heap(prg, fns) or has_str
            # 模块级编译状态（Map 引用语义跨函数共享）
            let cgs = map_empty()
            let cgh = map_empty()
            map_set(cgs, "nfun", nfun)
            map_set(cgs, "ibase", ibase)
            map_set(cgs, "tbase", ibase)
            map_set(cgs, "has_str",
            if has_str
                1
            else
                0
            end)
            map_set(cgs, "n_extra_types", 0)
            map_set(cgs, "n_extra_fns", 0)
            map_set(cgs, "n_table", 0)
            map_set(cgs, "alloc_idx", 0)
            if has_str
                # data 段初始化：offset 0 = '\n'（println 换行 + 静态串基址）
                map_set(cgh, "data_hex", "0a")
                map_set(cgs, "data_len", 1)
            end
            if heap_on
                map_set(cgs, "heap_on", 1)
                # alloc 注册为 extra 区第一个（type (i32)->(i32) + bump 体）
                let abody = alloc_body_hex()
                map_set(cgh, "extra_types", "60017f017f")
                map_set(cgs, "n_extra_types", 1)
                map_set(cgh, "extra_fidxs", leb128_hex(ibase + nfun))
                map_set(cgh, "extra_bodies", leb128_hex(len(abody) / 2) + abody)
                map_set(cgs, "n_extra_fns", 1)
                map_set(cgs, "alloc_idx", ibase + nfun)
            else
                map_set(cgs, "heap_on", 0)
            end
            let shims = map_empty()
            let sigty = map_empty()
            let cg = {cgs: cgs, cgh: cgh, shims: shims, sigty: sigty}
            # pass 2（items 正序）：type 条目 + function typeidx + 函数体
            let mut tentries = ""
            let mut fidxs = ""
            let mut bodies = ""
            let mut nfun2 = 0
            for it in items
                match it
                    ItFn(_, params, ret, _, body, _, _) =>
                        let rv = sig_ret(it, fns)?
                        tentries = tentries + fn_type_entry(params, rv, fns)?
                        fidxs = fidxs + leb128_hex(ibase + nfun2)
                        bodies = bodies + comp_one_fn(params, ret, body, fns, cg)?
                        nfun2 = nfun2 + 1
                    end
                    _ => ()
                end
            end
            # type section：t0=(i64)->()、t1=(f64)->() 供 print 导入；用户
            # base+；has_str 再加 t2=(i32,i32)->()（print_str）与
            # t3=(f64,i32)->i32（ftoa）；L2.3-b 起按需追加 extra types
            let mut types_head = "60" + "01" + "7e" + "00" + "60" + "01" + "7c" + "00"
            let mut ntypes = 2 + nfun2
            if has_str
                types_head = types_head + "60" + "02" + "7f" + "7f" + "00" + "60" + "02" + "7c" + "7f" + "01" + "7f"
                ntypes = ntypes + 2
            end
            let types_c = leb128_hex(ntypes + cg_int(cgs, "n_extra_types")) + types_head + tentries + cg_str(cgh, "extra_types")
            # import section：env.print_i64(t0) / env.print_f64(t1)；
            # has_str 加 env.print_str(t2) / env.ftoa(t3)（count=4）
            let mut imp_c = leb128_hex(2)
            + "03" + "656e76" + "09" + "7072696e745f693634" + "00" + "00"
            + "03" + "656e76" + "09" + "7072696e745f663634" + "00" + "01"
            if has_str
                imp_c = leb128_hex(4)
                + "03" + "656e76" + "09" + "7072696e745f693634" + "00" + "00"
                + "03" + "656e76" + "09" + "7072696e745f663634" + "00" + "01"
                + "03" + "656e76" + "09" + "7072696e745f737472" + "00" + "02"
                + "03" + "656e76" + "04" + "66746f61" + "00" + "03"
            end
            # function section（用户 + extra：alloc/闭包体/shim/helper）
            let nfn_total = nfun2 + cg_int(cgs, "n_extra_fns")
            let func_c = leb128_hex(nfn_total) + fidxs + cg_str(cgh, "extra_fidxs")
            # L2.3-b 按需 section（table/memory/global 在 export 前、elem 在
            # export 后——WASM section id 升序：4/5/6 < 7 < 9 < 10 < 11）
            let ntab = cg_int(cgs, "n_table")
            let mut mid = ""
            let mut elem_c = ""
            if ntab > 0
                # table（funcref，min=max=n）仅闭包路径需要。
                mid = sect("04", "01" + "70" + "01" + leb128_hex(ntab) + leb128_hex(ntab))
                elem_c = sect("09", "01" + "00" + "41000b" + leb128_hex(ntab) + cg_str(cgh, "table"))
            end
            if heap_on
                mid = mid + sect("05", "01" + "00" + "01")
                if has_str
                    # data 尾追加 64 字节 scratch（itoa/ftoa 共用，global 1 指向）；
                    # hp 从 scratch 之后起（无 data 冲突）
                    let lit_end = cg_int(cgs, "data_len")
                    let data_hex = cg_str(cgh, "data_hex") + zeros_hex(64)
                    mid = mid + sect("06", "02"
                    + "7f" + "01" + "41" + sleb128_hex(lit_end + 64) + "0b"
                    + "7f" + "01" + "41" + sleb128_hex(lit_end) + "0b")
                    map_set(cgh, "data_bytes", data_hex)
                else
                    # hp init 8：地址 0 留哨兵，bump 自动 memory.grow。
                    mid = mid + sect("06", "01" + "7f" + "01" + "4108" + "0b")
                end
            end
            # export section：main（has_str 加导出 memory——harness 打印需要）
            let mi = match map_get(fns, "main")
                Some(f) => f
                None => {idx: 2, ret: "void", nprm: 0, prms: ""}
            end
            let exp_c =
            if has_str
                "02" + "06" + "6d656d6f7279" + "02" + "00" + "04" + "6d61696e" + "00" + leb128_hex(mi.idx)
            else
                "01" + "04" + "6d61696e" + "00" + leb128_hex(mi.idx)
            end
            # code section
            let code_c = leb128_hex(nfn_total) + bodies + cg_str(cgh, "extra_bodies")
            # data section(11)：排 code(10) 之后（section id 升序）；active 全量装载
            let mut data_c = ""
            if has_str
                data_c = sect("0b", "01" + "00" + "4100" + "0b" + leb128_hex(len(cg_str(cgh, "data_bytes")) / 2) + cg_str(cgh, "data_bytes"))
            end
            Ok("0061736d01000000"
                + sect("01", types_c)
                + sect("02", imp_c)
                + sect("03", func_c)
                + mid
                + sect("07", exp_c)
                + elem_c
                + sect("0a", code_c)
                + data_c)
        end
    end
end

# ---- X5：驱动 ----

# 打印词法/语法错误；有错返回 True
fn report_errors(errs: List<{code: String, msg: String, ln: Int, cl: Int}>, em: Map<String, {code: String, msg: String, ln: Int, cl: Int}>) -> Bool ! [IO]
    let mut bad = False
    for e in errs
        println("lex error " + e.ln + ":" + e.cl + " [" + e.code + "] " + e.msg)
        bad = True
    end
    let en = map_size(em)
    let mut i = 0
    while i < en
        let e = match map_get(em, int_to_string(i))
            Some(ev) => ev
            None => {code: "?", msg: "", ln: 0, cl: 0}
        end
        println("parse error " + e.ln + ":" + e.cl + " [" + e.code + "] " + e.msg)
        bad = True
        i = i + 1
    end
    bad
end

fn main() -> Unit ! [IO]
    let argv = args()
    if list_length(argv) < 3
        println("usage: lom self_comp.lom -- <input.lom> <output.hex>")
    else
        let input = list_get(argv, 1)
        let outpath = list_get(argv, 2)
        if file_exists(input) == False
            println("error: file not found: " + input)
            println("COMPILE-ERROR")
        else
            let src = file_read(input)
            let r = lex(src)
            let pm = map_empty()
            map_set(pm, "pos", 0)
            let em = map_empty()
            let prg = parse_program(r.toks, r.n, pm, em)
            let bad = report_errors(r.errs, em)
            if bad
                println("COMPILE-ERROR")
            else
                match build_module(prg)
                    Ok(hex) =>
                        file_write(outpath, hex)
                        println("COMPILED " + len(hex) / 2 + " bytes -> " + outpath)
                    end
                    Err(msg) =>
                        println("codegen error: " + msg)
                        println("COMPILE-ERROR")
                    end
                end
            end
        end
    end
end
