# 自举验证 4：变量引用 + 环境查找（用 Phase 5.1 新特性 let 元组解构重写）
# parser 返回 (Expr, List<Token>) 元组，let (a, b) = ... 直接解构
# 无需 record workaround

from string import { split, string_to_int, contains, len }
from list import { list_empty, list_cons, list_head, list_tail, list_is_empty }

# ===== Token =====
enum Token
    | TInt(Int)
    | TIdent(String)
    | TPlus
    | TMinus
    | TStar
    | TSlash
    | TLParen
    | TRParen
end

# ===== AST =====
enum Expr
    | Num(Int)
    | Var(String)
    | Add(Expr, Expr)
    | Sub(Expr, Expr)
    | Mul(Expr, Expr)
    | Div(Expr, Expr)
end

# ===== Lexer =====

fn is_digit(c: String) -> Bool
    contains("0123456789", c)
end

fn is_alpha(c: String) -> Bool
    contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_", c)
end

fn is_alnum(c: String) -> Bool
    if is_alpha(c)
        True
    elif is_digit(c)
        True
    else
        False
    end
end

fn flush_num(acc: String, rest: List<Token>) -> List<Token>
    if len(acc) == 0
        rest
    else
        list_cons(TInt(string_to_int(acc)), rest)
    end
end

fn lex_char(c: String, rest_chars: List<String>) -> List<Token>
    if c == " "
        lex_rec(rest_chars, "")
    elif c == "+"
        list_cons(TPlus, lex_rec(rest_chars, ""))
    elif c == "-"
        list_cons(TMinus, lex_rec(rest_chars, ""))
    elif c == "*"
        list_cons(TStar, lex_rec(rest_chars, ""))
    elif c == "/"
        list_cons(TSlash, lex_rec(rest_chars, ""))
    elif c == "("
        list_cons(TLParen, lex_rec(rest_chars, ""))
    elif c == ")"
        list_cons(TRParen, lex_rec(rest_chars, ""))
    else
        lex_rec(rest_chars, "")
    end
end

fn lex_ident(chars: List<String>, acc: String) -> List<Token>
    if list_is_empty(chars)
        list_cons(TIdent(acc), list_empty())
    else
        let c = list_head(chars)
        if is_alnum(c)
            lex_ident(list_tail(chars), acc + c)
        else
            list_cons(TIdent(acc), lex_char(c, list_tail(chars)))
        end
    end
end

fn lex_rec(chars: List<String>, num_acc: String) -> List<Token>
    if list_is_empty(chars)
        flush_num(num_acc, list_empty())
    else
        let c = list_head(chars)
        if is_digit(c)
            lex_rec(list_tail(chars), num_acc + c)
        elif is_alpha(c)
            flush_num(num_acc, lex_ident(list_tail(chars), c))
        else
            flush_num(num_acc, lex_char(c, list_tail(chars)))
        end
    end
end

fn lex(src: String) -> List<Token>
    let chars = split(src, "")
    lex_rec(chars, "")
end

# ===== Parser =====
# 文法: Expr = Term (("+"|"-") Term)*   Term = Factor (("*"|"/") Factor)*
#        Factor = Int | Ident | "(" Expr ")"
# Phase 5.1: 用 let 元组解构直接拆 (expr, rest)

fn parse_factor(tokens: List<Token>) -> (Expr, List<Token>)
    match list_head(tokens)
        TInt(n) => (Num(n), list_tail(tokens))
        TIdent(name) => (Var(name), list_tail(tokens))
        TLParen =>
            let (e, rest) = parse_expr(list_tail(tokens))
            (e, list_tail(rest))
        end
    end
end

fn parse_term_rest(left: Expr, tokens: List<Token>) -> (Expr, List<Token>)
    if list_is_empty(tokens)
        (left, tokens)
    else
        match list_head(tokens)
            TStar =>
                let (r, rest) = parse_factor(list_tail(tokens))
                parse_term_rest(Mul(left, r), rest)
            end
            TSlash =>
                let (r, rest) = parse_factor(list_tail(tokens))
                parse_term_rest(Div(left, r), rest)
            end
            _ => (left, tokens)
        end
    end
end

fn parse_term(tokens: List<Token>) -> (Expr, List<Token>)
    let (left, rest) = parse_factor(tokens)
    parse_term_rest(left, rest)
end

fn parse_expr_rest(left: Expr, tokens: List<Token>) -> (Expr, List<Token>)
    if list_is_empty(tokens)
        (left, tokens)
    else
        match list_head(tokens)
            TPlus =>
                let (r, rest) = parse_term(list_tail(tokens))
                parse_expr_rest(Add(left, r), rest)
            end
            TMinus =>
                let (r, rest) = parse_term(list_tail(tokens))
                parse_expr_rest(Sub(left, r), rest)
            end
            _ => (left, tokens)
        end
    end
end

fn parse_expr(tokens: List<Token>) -> (Expr, List<Token>)
    let (left, rest) = parse_term(tokens)
    parse_expr_rest(left, rest)
end

# ===== 环境查找 =====
# env: List<(String, Int)>，线性查找（Lom 无 HashMap）

fn env_lookup(env: List<(String, Int)>, name: String) -> Int
    if list_is_empty(env)
        0
    else
        let pair = list_head(env)
        if pair.0 == name
            pair.1
        else
            env_lookup(list_tail(env), name)
        end
    end
end

# ===== Evaluator =====
fn eval(e: Expr, env: List<(String, Int)>) -> Int
    match e
        Num(n) => n
        Var(name) => env_lookup(env, name)
        Add(a, b) => eval(a, env) + eval(b, env)
        Sub(a, b) => eval(a, env) - eval(b, env)
        Mul(a, b) => eval(a, env) * eval(b, env)
        Div(a, b) => eval(a, env) / eval(b, env)
    end
end

# ===== 主入口 =====
fn run(src: String, env: List<(String, Int)>) -> Int
    let tokens = lex(src)
    let (ast, _) = parse_expr(tokens)
    eval(ast, env)
end

fn main() -> Unit
    let env = list_cons(("x", 10), list_cons(("y", 3), list_empty()))
    println(run("x + y", env))        # 13
    println(run("x * y + 2", env))    # 32
    println(run("x - y", env))        # 7
    println(run("(x + y) * 2", env))  # 26
    println(run("x", env))            # 10
end
