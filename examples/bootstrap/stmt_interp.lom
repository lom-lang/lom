# 自举验证 5：带语句层、函数、多类型值、诊断、容错解析与位置信息的解释器（Phase 5.2 → 5.17）
# 源语言支持：let 绑定、if/else、while、块、比较/四则运算、变量、函数定义与调用、
#             Int/String/Bool/List 值、字符串字面量、列表字面量、索引、== 比较、
#             显式错误诊断（5.13）、容错解析（5.15）、内建函数（5.16）、诊断带行号（5.17）
#   SLet / SExpr / SIf / SWhile / SError(msg)     语句（SError = 解析失败占位）
#   DFn(name, params, body) / DStmt(stmt)         顶层声明
#   Num/StrLit/Var/Add/Sub/Mul/Div/Gt/Eq/Call/ListLit/Index/EError(msg)   表达式
#   Val = VInt | VStr | VBool | VList(List<Val>)
# 设计要点：
#   - 环境用宿主 Map（5.21 起，此前是函数式关联表）；词法作用域（函数调用用全新环境）
#   - 语句值语义：SIf 的值=被执行分支块的值（if 即表达式）；块的值=尾语句的值
#   - in_fn 标志区分语境：顶层 SExpr 打印，函数体内 SExpr 只产出值
#   - collect_fns 先收集全部函数再执行 → 前向引用/互递归天然支持
#   - Phase 5.13 诊断层：全链路 Result<_, String> + ? 传播
#   - Phase 5.15 容错解析：错误成为 AST 节点（EError/SError）；TUnknown；parser 全函数
#   - Phase 5.16 内建：try_intrinsic 分派（len/split/contains/trim/to_string/push）
#   - Phase 5.17 位置信息：token 包成记录 {t: Token, ln: Int}（宿主结构记录），
#     peek_kind/peek_line 隔离变化，解析错误消息带 "at line N"（对齐主语言诊断形态）
#   - Add 混合规则镜像 Lom v0.4.1：任一侧是 String 时另一侧 show() 提升拼接
#   - Phase 5.21 环境换 Map：变量环境从 List<(String, Val)> 关联表改为宿主的 Map
#     （引用语义，map_set 就地修改），env_lookup 从 O(n) 线性扫描降为 O(1)；
#     函数调用仍词法作用域——callee 用全新 map_empty() 环境，参数 map_set 进去；
#     exec_stmt/exec_stmts 不再返回环境（就地突变，无需 threading），只返回语句值

from string import { split, string_to_int, int_to_string, contains, len, trim }
from list import { list_empty, list_cons, list_head, list_tail, list_is_empty, list_length, list_fold, list_map }
from map import { map_empty, map_set, map_get }

# ===== Token =====
# 词法单元本身（不带位置）；位置由外层记录 Tok 承载
enum Token
    | TInt(Int)
    | TStr(String)
    | TIdent(String)
    | TPlus
    | TMinus
    | TStar
    | TSlash
    | TLParen
    | TRParen
    | TLBracket
    | TRBracket
    | TComma
    | TAssign
    | TEq
    | TLet
    | TIf
    | TElse
    | TEnd
    | TWhile
    | TFn
    | TGt
    | TUnknown(String)
end

# ===== AST =====
enum Expr
    | Num(Int)
    | StrLit(String)
    | Var(String)
    | Add(Expr, Expr)
    | Sub(Expr, Expr)
    | Mul(Expr, Expr)
    | Div(Expr, Expr)
    | Gt(Expr, Expr)
    | Eq(Expr, Expr)
    | Call(String, List<Expr>)
    | ListLit(List<Expr>)
    | Index(Expr, Expr)
    | EError(String)
end

enum Stmt
    | SLet(String, Expr)
    | SExpr(Expr)
    | SIf(Expr, List<Stmt>, List<Stmt>)
    | SWhile(Expr, List<Stmt>)
    | SError(String)
end

# 顶层声明：函数定义 or 语句
enum Decl
    | DFn(String, List<String>, List<Stmt>)
    | DStmt(Stmt)
end

# ===== 值系统 =====
enum Val
    | VInt(Int)
    | VStr(String)
    | VBool(Bool)
    | VList(List<Val>)
end

# ===== Lexer =====
# 产出 List<{t: Token, ln: Int}>——每个 token 烙上行号（对齐主语言 SpannedToken 的设计）

fn mk_tok(t: Token, ln: Int) -> {t: Token, ln: Int}
    {t: t, ln: ln}
end

fn is_digit(c: String) -> Bool
    contains("0123456789", c)
end

fn is_alpha(c: String) -> Bool
    contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_", c)
end

fn is_alnum(c: String) -> Bool
    if is_alpha(c)
        True
    elif is_digit(c)
        True
    else
        False
    end
end

# 关键字识别：let/if/else/end/while/fn 是保留字，其余为标识符
fn keyword_or_ident(s: String) -> Token
    if s == "let"
        TLet
    elif s == "if"
        TIf
    elif s == "else"
        TElse
    elif s == "end"
        TEnd
    elif s == "while"
        TWhile
    elif s == "fn"
        TFn
    else
        TIdent(s)
    end
end

fn flush_num(acc: String, rest: List<{t: Token, ln: Int}>, ln: Int) -> List<{t: Token, ln: Int}>
    if len(acc) == 0
        rest
    else
        list_cons(mk_tok(TInt(string_to_int(acc)), ln), rest)
    end
end

# 字符串字面量："..." —— 未闭合时宽容产出已有内容（已知限制，无诊断）
fn lex_str(chars: List<String>, acc: String, ln: Int) -> List<{t: Token, ln: Int}>
    if list_is_empty(chars)
        list_cons(mk_tok(TStr(acc), ln), list_empty())
    else
        let c = list_head(chars)
        if c == "\""
            list_cons(mk_tok(TStr(acc), ln), lex_rec(list_tail(chars), "", ln))
        else
            lex_str(list_tail(chars), acc + c, ln)
        end
    end
end

fn lex_char(c: String, rest_chars: List<String>, ln: Int) -> List<{t: Token, ln: Int}>
    if c == " "
        lex_rec(rest_chars, "", ln)
    elif c == "\n"
        lex_rec(rest_chars, "", ln + 1)
    elif c == "\r"
        lex_rec(rest_chars, "", ln)
    elif c == "\t"
        lex_rec(rest_chars, "", ln)
    elif c == "+"
        list_cons(mk_tok(TPlus, ln), lex_rec(rest_chars, "", ln))
    elif c == "-"
        list_cons(mk_tok(TMinus, ln), lex_rec(rest_chars, "", ln))
    elif c == "*"
        list_cons(mk_tok(TStar, ln), lex_rec(rest_chars, "", ln))
    elif c == "/"
        list_cons(mk_tok(TSlash, ln), lex_rec(rest_chars, "", ln))
    elif c == ">"
        list_cons(mk_tok(TGt, ln), lex_rec(rest_chars, "", ln))
    elif c == "("
        list_cons(mk_tok(TLParen, ln), lex_rec(rest_chars, "", ln))
    elif c == ")"
        list_cons(mk_tok(TRParen, ln), lex_rec(rest_chars, "", ln))
    elif c == "["
        list_cons(mk_tok(TLBracket, ln), lex_rec(rest_chars, "", ln))
    elif c == "]"
        list_cons(mk_tok(TRBracket, ln), lex_rec(rest_chars, "", ln))
    elif c == ","
        list_cons(mk_tok(TComma, ln), lex_rec(rest_chars, "", ln))
    elif c == "\""
        lex_str(rest_chars, "", ln)
    elif c == "="
        # = 与 == 是显式 token（Phase 5.12 根治"静默丢弃"陷阱）
        if list_is_empty(rest_chars)
            list_cons(mk_tok(TAssign, ln), lex_rec(rest_chars, "", ln))
        else
            if list_head(rest_chars) == "="
                list_cons(mk_tok(TEq, ln), lex_rec(list_tail(rest_chars), "", ln))
            else
                list_cons(mk_tok(TAssign, ln), lex_rec(rest_chars, "", ln))
            end
        end
    else
        # Phase 5.15：未知字符产出 TUnknown（由 parser 报错），不再静默丢弃
        list_cons(mk_tok(TUnknown(c), ln), lex_rec(rest_chars, "", ln))
    end
end

fn lex_ident(chars: List<String>, acc: String, ln: Int) -> List<{t: Token, ln: Int}>
    if list_is_empty(chars)
        list_cons(mk_tok(keyword_or_ident(acc), ln), list_empty())
    else
        let c = list_head(chars)
        if is_alnum(c)
            lex_ident(list_tail(chars), acc + c, ln)
        else
            list_cons(mk_tok(keyword_or_ident(acc), ln), lex_char(c, list_tail(chars), ln))
        end
    end
end

fn lex_rec(chars: List<String>, num_acc: String, ln: Int) -> List<{t: Token, ln: Int}>
    if list_is_empty(chars)
        flush_num(num_acc, list_empty(), ln)
    else
        let c = list_head(chars)
        if is_digit(c)
            lex_rec(list_tail(chars), num_acc + c, ln)
        elif is_alpha(c)
            flush_num(num_acc, lex_ident(list_tail(chars), c, ln), ln)
        else
            flush_num(num_acc, lex_char(c, list_tail(chars), ln), ln)
        end
    end
end

fn lex(src: String) -> List<{t: Token, ln: Int}>
    let chars = split(src, "")
    lex_rec(chars, "", 1)
end

# ===== Parser 辅助 =====

# 安全取头：空表返回 None（所有解析函数不裸调 list_head）
fn peek_tok(tokens: List<{t: Token, ln: Int}>) -> Option<{t: Token, ln: Int}>
    if list_is_empty(tokens)
        None
    else
        Some(list_head(tokens))
    end
end

# 取 token 种类（剥掉位置记录；pattern match 用）
fn peek_kind(tokens: List<{t: Token, ln: Int}>) -> Option<Token>
    match peek_tok(tokens)
        Some(tw) => Some(tw.t)
        None => None
    end
end

# 取当前 token 行号（空表返回 0）
fn peek_line(tokens: List<{t: Token, ln: Int}>) -> Int
    match peek_tok(tokens)
        Some(tw) => tw.ln
        None => 0
    end
end

# token 名字（诊断消息用）
fn token_name(t: Token) -> String
    match t
        TInt(n) => "number(" + n + ")"
        TStr(s) => "string"
        TIdent(s) => "identifier '" + s + "'"
        TPlus => "'+'"
        TMinus => "'-'"
        TStar => "'*'"
        TSlash => "'/'"
        TLParen => "'('"
        TRParen => "')'"
        TLBracket => "'['"
        TRBracket => "']'"
        TComma => "','"
        TAssign => "'='"
        TEq => "'=='"
        TLet => "'let'"
        TIf => "'if'"
        TElse => "'else'"
        TEnd => "'end'"
        TWhile => "'while'"
        TFn => "'fn'"
        TGt => "'>'"
        TUnknown(c) => "unknown character '" + c + "'"
    end
end

# ===== Expr Parser =====
# 文法: Expr = Term (("+"|"-"|">"|"==") Term)*   Term = Factor (("*"|"/") Factor)*
#        Factor = Int | Str | Ident | Ident "(" Args ")" | "[" Elems "]" | "(" Expr ")"
# 容错：任何意外输入产出 EError 节点而不是崩溃；错误消息带行号（Phase 5.17）

# 调用参数：expr, expr, ... 直到 TRParen（消耗之）
fn parse_call_args(tokens: List<{t: Token, ln: Int}>) -> (List<Expr>, List<{t: Token, ln: Int}>)
    match peek_kind(tokens)
        Some(TRParen) => (list_empty(), list_tail(tokens))
        Some(_) =>
            let (e, rest) = parse_expr(tokens)
            match peek_kind(rest)
                Some(TComma) =>
                    let (more, rest2) = parse_call_args(list_tail(rest))
                    (list_cons(e, more), rest2)
                end
                Some(TRParen) => (list_cons(e, list_empty()), list_tail(rest))
                _ =>
                    # 缺失 ) —— 宽容收尾,已有参数保留;末尾追加错误节点(执行时经诊断通道报告)
                    (list_cons(e, list_cons(EError("expected ',' or ')' in argument list at line " + peek_line(rest)), list_empty())), rest)
                end
            end
        end
        None => (list_cons(EError("unexpected end of input in argument list"), list_empty()), tokens)
    end
end

# 列表字面量元素：[e1, e2, ...] —— tokens 从 TLBracket 之后开始
fn parse_list_elems(tokens: List<{t: Token, ln: Int}>) -> (List<Expr>, List<{t: Token, ln: Int}>)
    match peek_kind(tokens)
        Some(TRBracket) => (list_empty(), list_tail(tokens))
        Some(_) =>
            let (e, rest) = parse_expr(tokens)
            match peek_kind(rest)
                Some(TComma) =>
                    let (more, rest2) = parse_list_elems(list_tail(rest))
                    (list_cons(e, more), rest2)
                end
                Some(TRBracket) => (list_cons(e, list_empty()), list_tail(rest))
                _ => (list_cons(e, list_cons(EError("expected ',' or ']' in list literal at line " + peek_line(rest)), list_empty())), rest)
            end
        end
        None => (list_cons(EError("unexpected end of input in list literal"), list_empty()), tokens)
    end
end

# 原子表达式：字面量 / 变量 / 调用 / 列表字面量 / 括号 / 错误节点
fn parse_atom(tokens: List<{t: Token, ln: Int}>) -> (Expr, List<{t: Token, ln: Int}>)
    match peek_tok(tokens)
        None => (EError("unexpected end of input"), tokens)
        Some(tw) =>
            let ln = tw.ln
            match tw.t
                TInt(n) => (Num(n), list_tail(tokens))
                TStr(s) => (StrLit(s), list_tail(tokens))
                TUnknown(c) => (EError("unexpected " + token_name(TUnknown(c)) + " at line " + ln), list_tail(tokens))
                TLBracket =>
                    let (elems, rest) = parse_list_elems(list_tail(tokens))
                    (ListLit(elems), rest)
                end
                TIdent(name) =>
                    # 前瞻：Ident 后跟 TLParen 是函数调用，否则是变量引用
                    match peek_kind(list_tail(tokens))
                        Some(TLParen) =>
                            let (args, rest) = parse_call_args(list_tail(list_tail(tokens)))
                            (Call(name, args), rest)
                        end
                        _ => (Var(name), list_tail(tokens))
                    end
                end
                TLParen =>
                    let (e, rest) = parse_expr(list_tail(tokens))
                    match peek_kind(rest)
                        Some(TRParen) => (e, list_tail(rest))
                        _ => (e, rest)   # 缺失 ) —— 宽容继续
                    end
                end
                other => (EError("unexpected " + token_name(other) + " at line " + ln), list_tail(tokens))
            end
        end
    end
end

# 后缀索引：base[i]（可链式 xs[i][j]；宽容处理缺失的 ]）
fn parse_postfix(base: Expr, tokens: List<{t: Token, ln: Int}>) -> (Expr, List<{t: Token, ln: Int}>)
    match peek_kind(tokens)
        Some(TLBracket) =>
            let (idx, rest) = parse_expr(list_tail(tokens))
            match peek_kind(rest)
                Some(TRBracket) => parse_postfix(Index(base, idx), list_tail(rest))
                _ => parse_postfix(Index(base, idx), rest)
            end
        end
        _ => (base, tokens)
    end
end

fn parse_factor(tokens: List<{t: Token, ln: Int}>) -> (Expr, List<{t: Token, ln: Int}>)
    let (base, rest) = parse_atom(tokens)
    parse_postfix(base, rest)
end

fn parse_term_star(left: Expr, tokens: List<{t: Token, ln: Int}>) -> (Expr, List<{t: Token, ln: Int}>)
    let (r, rest) = parse_factor(list_tail(tokens))
    parse_term_rest(Mul(left, r), rest)
end

fn parse_term_slash(left: Expr, tokens: List<{t: Token, ln: Int}>) -> (Expr, List<{t: Token, ln: Int}>)
    let (r, rest) = parse_factor(list_tail(tokens))
    parse_term_rest(Div(left, r), rest)
end

fn parse_term_rest(left: Expr, tokens: List<{t: Token, ln: Int}>) -> (Expr, List<{t: Token, ln: Int}>)
    match peek_kind(tokens)
        Some(TStar) => parse_term_star(left, tokens)
        Some(TSlash) => parse_term_slash(left, tokens)
        _ => (left, tokens)
    end
end

fn parse_term(tokens: List<{t: Token, ln: Int}>) -> (Expr, List<{t: Token, ln: Int}>)
    let (left, rest) = parse_factor(tokens)
    parse_term_rest(left, rest)
end

fn parse_expr_plus(left: Expr, tokens: List<{t: Token, ln: Int}>) -> (Expr, List<{t: Token, ln: Int}>)
    let (r, rest) = parse_term(list_tail(tokens))
    parse_expr_rest(Add(left, r), rest)
end

fn parse_expr_minus(left: Expr, tokens: List<{t: Token, ln: Int}>) -> (Expr, List<{t: Token, ln: Int}>)
    let (r, rest) = parse_term(list_tail(tokens))
    parse_expr_rest(Sub(left, r), rest)
end

fn parse_expr_gt(left: Expr, tokens: List<{t: Token, ln: Int}>) -> (Expr, List<{t: Token, ln: Int}>)
    let (r, rest) = parse_term(list_tail(tokens))
    parse_expr_rest(Gt(left, r), rest)
end

fn parse_expr_eq(left: Expr, tokens: List<{t: Token, ln: Int}>) -> (Expr, List<{t: Token, ln: Int}>)
    let (r, rest) = parse_term(list_tail(tokens))
    parse_expr_rest(Eq(left, r), rest)
end

fn parse_expr_rest(left: Expr, tokens: List<{t: Token, ln: Int}>) -> (Expr, List<{t: Token, ln: Int}>)
    match peek_kind(tokens)
        Some(TPlus) => parse_expr_plus(left, tokens)
        Some(TMinus) => parse_expr_minus(left, tokens)
        Some(TGt) => parse_expr_gt(left, tokens)
        Some(TEq) => parse_expr_eq(left, tokens)
        _ => (left, tokens)
    end
end

fn parse_expr(tokens: List<{t: Token, ln: Int}>) -> (Expr, List<{t: Token, ln: Int}>)
    let (left, rest) = parse_term(tokens)
    parse_expr_rest(left, rest)
end

# ===== Stmt / Decl Parser（错误成为 SError 节点，消息带行号）=====

# 从 token 记录提取标识符名字
fn ident_of(tw: {t: Token, ln: Int}) -> String
    match tw.t
        TIdent(s) => s
        _ => ""
    end
end

# let name = expr（TAssign 是显式 token；结构不符时产出 SError）
fn parse_stmt_let(tokens: List<{t: Token, ln: Int}>) -> (Stmt, List<{t: Token, ln: Int}>)
    # 期望 tokens: TLet TIdent(name) TAssign expr ...
    match peek_kind(list_tail(tokens))
        Some(TIdent(name)) =>
            match peek_kind(list_tail(list_tail(tokens)))
                Some(TAssign) =>
                    let (e, rest) = parse_expr(list_tail(list_tail(list_tail(tokens))))
                    (SLet(name, e), rest)
                end
                Some(other) => (SError("let: expected '=' after name, got " + token_name(other) + " at line " + peek_line(tokens)), list_tail(list_tail(tokens)))
                None => (SError("let: unexpected end of input after name at line " + peek_line(tokens)), list_tail(tokens))
            end
        end
        Some(other) => (SError("let: expected variable name, got " + token_name(other) + " at line " + peek_line(tokens)), list_tail(tokens))
        None => (SError("let: unexpected end of input at line " + peek_line(tokens)), list_tail(tokens))
    end
end

# 块: 语句序列直到 TEnd（消耗之）或 TElse（不消耗，留给上层处理）
fn parse_block(tokens: List<{t: Token, ln: Int}>) -> (List<Stmt>, List<{t: Token, ln: Int}>)
    match peek_kind(tokens)
        Some(TEnd) => (list_empty(), list_tail(tokens))
        Some(TElse) => (list_empty(), tokens)
        None => (list_empty(), tokens)   # 缺失 end —— 宽容收尾
        Some(_) =>
            let (stmt, rest) = parse_stmt(tokens)
            let (block, rest2) = parse_block(rest)
            (list_cons(stmt, block), rest2)
        end
    end
end

# if cond
#     then-block
# else
#     else-block
# end
fn parse_if(tokens: List<{t: Token, ln: Int}>) -> (Stmt, List<{t: Token, ln: Int}>)
    # tokens: TIf cond ...
    let (cond, rest) = parse_expr(list_tail(tokens))
    let (then_block, rest2) = parse_block(rest)
    match peek_kind(rest2)
        Some(TElse) =>
            let (else_block, rest3) = parse_block(list_tail(rest2))
            (SIf(cond, then_block, else_block), rest3)
        end
        Some(TEnd) => (SIf(cond, then_block, list_empty()), list_tail(rest2))
        _ => (SIf(cond, then_block, list_empty()), rest2)   # 缺失 end —— 宽容收尾
    end
end

# while cond
#     body-block
# end
fn parse_while(tokens: List<{t: Token, ln: Int}>) -> (Stmt, List<{t: Token, ln: Int}>)
    # tokens: TWhile cond ...
    let (cond, rest) = parse_expr(list_tail(tokens))
    let (body, rest2) = parse_block(rest)
    (SWhile(cond, body), rest2)
end

fn parse_stmt(tokens: List<{t: Token, ln: Int}>) -> (Stmt, List<{t: Token, ln: Int}>)
    match peek_tok(tokens)
        None => (SError("unexpected end of input"), tokens)
        Some(tw) =>
            match tw.t
                TLet => parse_stmt_let(tokens)
                TIf => parse_if(tokens)
                TWhile => parse_while(tokens)
                TUnknown(c) => (SError("unexpected " + token_name(TUnknown(c)) + " at line " + tw.ln), list_tail(tokens))
                TEnd => (SError("unexpected 'end' at line " + tw.ln), list_tail(tokens))
                TElse => (SError("unexpected 'else' at line " + tw.ln), list_tail(tokens))
                _ =>
                    let (e, rest) = parse_expr(tokens)
                    (SExpr(e), rest)
                end
            end
        end
    end
end

# fn 参数名列表：(p1, p2, ...) —— tokens 从 TLParen 开始
fn parse_params(tokens: List<{t: Token, ln: Int}>) -> (List<String>, List<{t: Token, ln: Int}>)
    match peek_kind(list_tail(tokens))
        Some(TRParen) => (list_empty(), list_tail(list_tail(tokens)))
        Some(TIdent(_)) => parse_params_rec(list_tail(tokens))
        _ => (list_empty(), list_tail(tokens))   # 畸形参数表 —— 宽容跳过
    end
end

fn parse_params_rec(tokens: List<{t: Token, ln: Int}>) -> (List<String>, List<{t: Token, ln: Int}>)
    let name = ident_of(list_head(tokens))
    match peek_kind(list_tail(tokens))
        Some(TComma) =>
            let (more, rest) = parse_params_rec(list_tail(list_tail(tokens)))
            (list_cons(name, more), rest)
        end
        Some(TRParen) => (list_cons(name, list_empty()), list_tail(list_tail(tokens)))
        _ => (list_cons(name, list_empty()), list_tail(tokens))   # 缺失 ) —— 宽容收尾
    end
end

# fn name(p1, p2)
#     body-block
# end
fn parse_fn(tokens: List<{t: Token, ln: Int}>) -> (Decl, List<{t: Token, ln: Int}>)
    # tokens: TFn TIdent(name) TLParen ...
    match peek_kind(list_tail(tokens))
        Some(TIdent(name)) =>
            let (params, rest) = parse_params(list_tail(list_tail(tokens)))
            let (body, rest2) = parse_block(rest)
            (DFn(name, params, body), rest2)
        end
        _ => (DStmt(SError("fn: expected function name at line " + peek_line(tokens))), list_tail(tokens))
    end
end

fn parse_program(tokens: List<{t: Token, ln: Int}>) -> List<Decl>
    if list_is_empty(tokens)
        list_empty()
    else
        match peek_kind(tokens)
            Some(TFn) =>
                let (d, rest) = parse_fn(tokens)
                list_cons(d, parse_program(rest))
            end
            _ =>
                let (s, rest) = parse_stmt(tokens)
                list_cons(DStmt(s), parse_program(rest))
            end
        end
    end
end

# ===== Val 辅助 =====

# 列表显示：[a, b, c]（递归 show 每个元素）
fn show_list(elems: List<Val>, acc: String) -> String
    if list_is_empty(elems)
        acc
    else
        if len(acc) == 0
            show_list(list_tail(elems), show(list_head(elems)))
        else
            show_list(list_tail(elems), acc + ", " + show(list_head(elems)))
        end
    end
end

# 值的显示形式（println 用）：Bool 小写 true/false，与 Lom 一致；List 递归显示
fn show(v: Val) -> String
    match v
        VInt(n) => int_to_string(n)
        VStr(s) => s
        VBool(b) =>
            if b
                "true"
            else
                "false"
            end
        end
        VList(elems) => "[" + show_list(elems, "") + "]"
    end
end

# 类型名（诊断消息用）
fn type_name(v: Val) -> String
    match v
        VInt(n) => "Int"
        VStr(s) => "String"
        VBool(b) => "Bool"
        VList(elems) => "List"
    end
end

# 条件真值判断：VBool 直取；VInt 非零为真；VStr 非空为真；VList 非空为真
fn truthy(v: Val) -> Bool
    match v
        VBool(b) => b
        VInt(n) =>
            if n > 0
                True
            elif 0 > n
                True
            else
                False
            end
        end
        VStr(s) =>
            if len(s) > 0
                True
            else
                False
            end
        end
        VList(elems) => !list_is_empty(elems)
    end
end

# 列表结构相等：逐元素递归比较
fn list_vals_eq(a: List<Val>, b: List<Val>) -> Bool
    if list_is_empty(a)
        list_is_empty(b)
    elif list_is_empty(b)
        False
    else
        if truthy(values_eq(list_head(a), list_head(b)))
            list_vals_eq(list_tail(a), list_tail(b))
        else
            False
        end
    end
end

# 结构相等（== 的语义）：同变体才可比，不同变体 False
fn values_eq(a: Val, b: Val) -> Val
    match a
        VInt(x) =>
            match b
                VInt(y) => VBool(x == y)
                _ => VBool(False)
            end
        end
        VStr(x) =>
            match b
                VStr(y) => VBool(x == y)
                _ => VBool(False)
            end
        end
        VBool(x) =>
            match b
                VBool(y) => VBool(x == y)
                _ => VBool(False)
            end
        end
        VList(xs) =>
            match b
                VList(ys) => VBool(list_vals_eq(xs, ys))
                _ => VBool(False)
            end
        end
    end
end

# ===== Evaluator（全链路 Result + ? 传播）=====

fn env_lookup(env: Map<Val>, name: String) -> Result<Val, String>
    match map_get(env, name)
        Some(v) => Ok(v)
        None => Err("undefined variable '" + name + "'")
    end
end

fn eval(e: Expr, env: Map<Val>, fns: List<Decl>) -> Result<Val, String> ! [IO]
    match e
        Num(n) => Ok(VInt(n))
        StrLit(s) => Ok(VStr(s))
        EError(msg) => Err("parse error: " + msg)
        Var(name) => env_lookup(env, name)
        Add(a, b) =>
            let va = eval(a, env, fns)?
            let vb = eval(b, env, fns)?
            # 镜像 Lom v0.4.1：任一侧是 String 时另一侧 show() 提升拼接
            match va
                VInt(x) =>
                    match vb
                        VInt(y) => Ok(VInt(x + y))
                        VStr(y) => Ok(VStr(show(va) + y))
                        _ => Err("type error: Add expects Int or String, got Int and " + type_name(vb))
                    end
                end
                VStr(x) => Ok(VStr(x + show(vb)))
                _ => Err("type error: Add expects Int or String, got " + type_name(va) + " and " + type_name(vb))
            end
        end
        Sub(a, b) =>
            let va = eval(a, env, fns)?
            let vb = eval(b, env, fns)?
            match va
                VInt(x) =>
                    match vb
                        VInt(y) => Ok(VInt(x - y))
                        _ => Err("type error: Sub expects Int, got Int and " + type_name(vb))
                    end
                end
                _ => Err("type error: Sub expects Int, got " + type_name(va) + " and " + type_name(vb))
            end
        end
        Mul(a, b) =>
            let va = eval(a, env, fns)?
            let vb = eval(b, env, fns)?
            match va
                VInt(x) =>
                    match vb
                        VInt(y) => Ok(VInt(x * y))
                        _ => Err("type error: Mul expects Int, got Int and " + type_name(vb))
                    end
                end
                _ => Err("type error: Mul expects Int, got " + type_name(va) + " and " + type_name(vb))
            end
        end
        Div(a, b) =>
            let va = eval(a, env, fns)?
            let vb = eval(b, env, fns)?
            match va
                VInt(x) =>
                    match vb
                        VInt(y) =>
                            if y == 0
                                Err("division by zero")
                            else
                                Ok(VInt(x / y))
                            end
                        end
                        _ => Err("type error: Div expects Int, got Int and " + type_name(vb))
                    end
                end
                _ => Err("type error: Div expects Int, got " + type_name(va) + " and " + type_name(vb))
            end
        end
        Gt(a, b) =>
            let va = eval(a, env, fns)?
            let vb = eval(b, env, fns)?
            match va
                VInt(x) =>
                    match vb
                        VInt(y) => Ok(VBool(x > y))
                        _ => Err("type error: Gt expects Int, got Int and " + type_name(vb))
                    end
                end
                _ => Err("type error: Gt expects Int, got " + type_name(va) + " and " + type_name(vb))
            end
        end
        Eq(a, b) =>
            let va = eval(a, env, fns)?
            let vb = eval(b, env, fns)?
            Ok(values_eq(va, vb))
        end
        ListLit(elems) =>
            # 元素按序求值（复用 eval_args：顺序保持 + ? 传播）
            let vals = eval_args(elems, env, fns)?
            Ok(VList(vals))
        end
        Index(target, idx) =>
            let tv = eval(target, env, fns)?
            let iv = eval(idx, env, fns)?
            match tv
                VList(elems) =>
                    match iv
                        VInt(i) => list_at(elems, i, i)
                        _ => Err("type error: index must be Int, got " + type_name(iv))
                    end
                end
                _ => Err("type error: indexing expects List, got " + type_name(tv))
            end
        end
        Call(name, arg_exprs) =>
            let args = eval_args(arg_exprs, env, fns)?
            # 内建函数优先（try_intrinsic 统一分派），其余按用户函数解析
            match try_intrinsic(name, args)
                Some(r) => r
                None =>
                    let decl = find_fn(fns, name)?
                    call_fn(decl, args, fns)
                end
            end
        end
    end
end

# 索引取值（0 起；负索引/越界走诊断通道；orig 保留原始下标用于错误消息）
fn list_at(elems: List<Val>, i: Int, orig: Int) -> Result<Val, String>
    if 0 > i
        Err("index out of bounds: " + orig + " (negative)")
    elif list_is_empty(elems)
        Err("index out of bounds: " + orig + " (list too short)")
    elif i == 0
        Ok(list_head(elems))
    else
        list_at(list_tail(elems), i - 1, orig)
    end
end

# 参数按序求值（手写递归以用 ? 传播错误；Ok 包裹保持顺序）
fn eval_args(args: List<Expr>, env: Map<Val>, fns: List<Decl>) -> Result<List<Val>, String> ! [IO]
    if list_is_empty(args)
        Ok(list_empty())
    else
        let v = eval(list_head(args), env, fns)?
        let rest = eval_args(list_tail(args), env, fns)?
        Ok(list_cons(v, rest))
    end
end

# 按名查找函数（线性；未找到显式 Err）
fn find_fn(fns: List<Decl>, name: String) -> Result<Decl, String>
    if list_is_empty(fns)
        Err("undefined function '" + name + "'")
    else
        match list_head(fns)
            DFn(n, ps, body) =>
                if n == name
                    Ok(DFn(n, ps, body))
                else
                    find_fn(list_tail(fns), name)
                end
            end
            DStmt(s) => find_fn(list_tail(fns), name)
        end
    end
end

# 参数绑定：把形参按序写入环境（callee 用全新 Map，词法作用域——看不到调用者的局部变量）
fn bind_params(params: List<String>, args: List<Val>, env: Map<Val>) -> Unit
    let mut ps = params
    let mut argv = args
    while !(list_is_empty(ps))
        map_set(env, list_head(ps), list_head(argv))
        ps = list_tail(ps)
        argv = list_tail(argv)
    end
end

fn call_fn(decl: Decl, args: List<Val>, fns: List<Decl>) -> Result<Val, String> ! [IO]
    match decl
        DFn(name, params, body) =>
            if list_length(params) == list_length(args)
                let env = map_empty()
                bind_params(params, args, env)
                let v = exec_stmts(body, env, fns, True)?
                Ok(v)
            else
                Err("arity error: function '" + name + "' expects " + list_length(params) + " args, got " + list_length(args))
            end
        end
        DStmt(s) => Err("internal: DStmt is not callable")
    end
end

# 执行语句，返回 Result<语句值, String>（环境是 Map，就地突变，不再返回新环境）：
#   SError → 解析错误经诊断通道显式报告（错误是节点，不是崩溃）
#   SExpr  → 值是表达式求值结果（in_fn=True 时不打印）
#   SIf    → 值是被执行分支块的值（if 即表达式）
#   SLet / SWhile → 值为 VInt(0)
fn exec_stmt(s: Stmt, env: Map<Val>, fns: List<Decl>, in_fn: Bool) -> Result<Val, String> ! [IO]
    match s
        SError(msg) => Err("parse error: " + msg)
        SLet(name, e) =>
            let v = eval(e, env, fns)?
            map_set(env, name, v)
            Ok(VInt(0))
        end
        SExpr(e) =>
            let v = eval(e, env, fns)?
            if in_fn
                0
            else
                println(show(v))
            end
            Ok(v)
        end
        SIf(c, then_block, else_block) =>
            if truthy(eval(c, env, fns)?)
                exec_stmts(then_block, env, fns, in_fn)
            else
                exec_stmts(else_block, env, fns, in_fn)
            end
        end
        SWhile(c, body) =>
            # Map 就地突变：循环体对环境的修改直接可见，无需把新环境带入下一轮
            # ? 在循环内直接穿透——任一轮出错立即整体返回 Err
            while truthy(eval(c, env, fns)?)
                exec_stmts(body, env, fns, in_fn)?
            end
            Ok(VInt(0))
        end
    end
end

# 顺序执行语句序列，返回 Result<最后一条语句的值, String>
# list_fold 累积 Result：Err 短路穿透，Ok 继续执行（错误即值的折叠形态）
fn exec_stmts(stmts: List<Stmt>, env: Map<Val>, fns: List<Decl>, in_fn: Bool) -> Result<Val, String> ! [IO]
    list_fold(fn(acc: Result<Val, String>, s: Stmt) -> Result<Val, String>
        match acc
            Err(e) => Err(e)
            Ok(last) => exec_stmt(s, env, fns, in_fn)
        end
    end, Ok(VInt(0)), stmts)
end

# ===== 内建函数（Phase 5.16）=====
# 不需要 import、按名直接可用；返回 Option<Result<Val, String>>：
#   None = 不是内建（交给用户函数解析）；Some(Err) = 是内建但调用错误

fn try_intrinsic(name: String, args: List<Val>) -> Option<Result<Val, String>>
    if name == "len"
        Some(intrinsic_len(args))
    elif name == "split"
        Some(intrinsic_split(args))
    elif name == "contains"
        Some(intrinsic_contains(args))
    elif name == "trim"
        Some(intrinsic_trim(args))
    elif name == "to_string"
        Some(intrinsic_to_string(args))
    elif name == "push"
        Some(intrinsic_push(args))
    else
        None
    end
end

fn intrinsic_len(args: List<Val>) -> Result<Val, String>
    if list_length(args) == 1
        match list_head(args)
            VList(elems) => Ok(VInt(list_length(elems)))
            VStr(s) => Ok(VInt(len(s)))
            other => Err("type error: len expects List or String, got " + type_name(other))
        end
    else
        Err("arity error: len expects 1 arg, got " + list_length(args))
    end
end

fn intrinsic_split(args: List<Val>) -> Result<Val, String>
    if list_length(args) == 2
        let pair = (list_head(args), list_head(list_tail(args)))
        match pair.0
            VStr(s) =>
                match pair.1
                    VStr(sep) => Ok(VList(list_map(fn(p: String) -> Val
                        VStr(p)
                    end, split(s, sep))))
                    other => Err("type error: split expects (String, String), got (String, " + type_name(other) + ")")
                end
            end
            other => Err("type error: split expects (String, String), got (" + type_name(other) + ", ...)")
        end
    else
        Err("arity error: split expects 2 args, got " + list_length(args))
    end
end

fn intrinsic_contains(args: List<Val>) -> Result<Val, String>
    if list_length(args) == 2
        let pair = (list_head(args), list_head(list_tail(args)))
        match pair.0
            VStr(s) =>
                match pair.1
                    VStr(sub) => Ok(VBool(contains(s, sub)))
                    other => Err("type error: contains expects (String, String)")
                end
            end
            other => Err("type error: contains expects (String, String)")
        end
    else
        Err("arity error: contains expects 2 args, got " + list_length(args))
    end
end

fn intrinsic_trim(args: List<Val>) -> Result<Val, String>
    if list_length(args) == 1
        match list_head(args)
            VStr(s) => Ok(VStr(trim(s)))
            other => Err("type error: trim expects String, got " + type_name(other))
        end
    else
        Err("arity error: trim expects 1 arg, got " + list_length(args))
    end
end

fn intrinsic_to_string(args: List<Val>) -> Result<Val, String>
    if list_length(args) == 1
        Ok(VStr(show(list_head(args))))
    else
        Err("arity error: to_string expects 1 arg, got " + list_length(args))
    end
end

# push 是追加（与 list_cons 的头插互补）：保持元素顺序的尾插
fn append_val(elems: List<Val>, v: Val) -> List<Val>
    if list_is_empty(elems)
        list_cons(v, list_empty())
    else
        list_cons(list_head(elems), append_val(list_tail(elems), v))
    end
end

fn intrinsic_push(args: List<Val>) -> Result<Val, String>
    if list_length(args) == 2
        match list_head(args)
            VList(elems) => Ok(VList(append_val(elems, list_head(list_tail(args)))))
            other => Err("type error: push expects (List, value), got (" + type_name(other) + ", ...)")
        end
    else
        Err("arity error: push expects 2 args, got " + list_length(args))
    end
end

# ===== 主入口 =====

# 收集全部函数定义（cons 累积，顺序无关——按名查找）
fn collect_fns(decls: List<Decl>, acc: List<Decl>) -> List<Decl>
    if list_is_empty(decls)
        acc
    else
        match list_head(decls)
            DFn(n, ps, body) => collect_fns(list_tail(decls), list_cons(DFn(n, ps, body), acc))
            DStmt(s) => collect_fns(list_tail(decls), acc)
        end
    end
end

# 收集全部顶层语句（保持顺序）
fn collect_stmts(decls: List<Decl>) -> List<Stmt>
    if list_is_empty(decls)
        list_empty()
    else
        match list_head(decls)
            DFn(n, ps, body) => collect_stmts(list_tail(decls))
            DStmt(s) => list_cons(s, collect_stmts(list_tail(decls)))
        end
    end
end

fn run_program(src: String) -> Unit ! [IO]
    let tokens = lex(src)
    let decls = parse_program(tokens)
    # 先收集函数表再执行语句 → 前向引用/互递归天然支持
    let fns = collect_fns(decls, list_empty())
    let stmts = collect_stmts(decls)
    # 顶层捕获 Result，错误显式打印（诊断层的最终出口）
    match exec_stmts(stmts, map_empty(), fns, False)
        Ok(v) => 0
        Err(msg) => println("error: " + msg)
    end
end

fn main() -> Unit
    # 程序 1：let 绑定 + 表达式求值
    # let x = 3 / let y = 4 / x + y * 2   ->  11
    run_program("let x = 3\nlet y = 4\nx + y * 2")

    # 程序 2：if/else 语句 + 块 + 比较运算
    # let a = 5 / if a > 3 / let b = a * 2 / b / else / 0 / end   ->  10
    run_program("let a = 5\nif a > 3\nlet b = a * 2\nb\nelse\n0\nend")

    # 程序 3（Phase 5.10）：while 循环 + 环境遮蔽
    # ->  6
    run_program("let i = 3\nlet s = 0\nwhile i > 0\nlet s = s + i\nlet i = i - 1\nend\ns")

    # 程序 4（Phase 5.11）：函数定义与调用 + 词法作用域
    # ->  49
    run_program("fn add(a, b)\na + b\nend\nfn square(n)\nn * n\nend\nlet x = add(3, 4)\nlet y = square(x)\ny")

    # 程序 5（Phase 5.11/5.12）：递归 + 前向引用 + == 比较
    # collatz_len(6): 6→3→10→5→16→8→4→2→1   ->  8
    run_program("fn collatz_len(n)\nif 2 > n\n0\nelse\nif is_odd(n) > 0\n1 + collatz_len(n * 3 + 1)\nelse\n1 + collatz_len(n / 2)\nend\nend\nend\nfn is_odd(n)\nn - (n / 2) * 2\nend\ncollatz_len(6)")

    # 程序 6（Phase 5.12）：字符串值 + 拼接 + Bool 打印
    # ->  hello, lom / true
    run_program("let name = \"lom\"\nlet greeting = \"hello, \" + name\ngreeting")
    run_program("3 > 2")

    # 程序 7（Phase 5.12）：字符串函数 + while 累积 + == 比较
    # ->  ababab / true
    run_program("fn shout(s, n)\nlet r = \"\"\nlet i = n\nwhile i > 0\nlet r = r + s\nlet i = i - 1\nend\nr\nend\nshout(\"ab\", 3)")
    run_program("fn eq1(a, b)\na == b\nend\neq1(2 + 2, 4)")

    # 程序 8（Phase 5.13）：诊断层——运行时错误显式报告
    # ->  error: undefined variable 'x'
    # ->  error: arity error: function 'f' expects 1 args, got 2
    # ->  error: division by zero
    # ->  error: type error: Sub expects Int, got Int and String
    run_program("x + 1")
    run_program("fn f(a)\na\nend\nf(1, 2)")
    run_program("1 / 0")
    run_program("let n = 5\nn - \"abc\"")

    # 程序 9（Phase 5.14）：VList 递归值——字面量 / 索引 / len 内建 / 结构相等 / 越界诊断
    # ->  20 / true / 3 / [[1, 2], [3]] / error: index out of bounds: 5 (list too short)
    run_program("let xs = [10, 20, 30]\nxs[1]")
    run_program("[1, 2] == [1, 2]")
    run_program("len([1, 2, 3])")
    run_program("let m = [[1, 2], [3]]\nm")
    run_program("let xs = [1, 2, 3]\nxs[5]")

    # 程序 10（Phase 5.15）：容错解析——坏输入不崩溃，错误经诊断通道报告
    # ->  7 / error: parse error: unexpected unknown character '@' at line 4
    # ->  error: parse error: unexpected end of input
    # ->  （空输入无输出,不崩溃）
    run_program("let x = 3\nlet y = 4\nx + y\n@")
    run_program("1 +")
    run_program("")

    # 程序 11（Phase 5.16）：内建函数——split/contains/trim/to_string/push
    # ->  [a, b, c] / 3 / true / x / [1, 2, 3] / 42!
    run_program("split(\"a,b,c\", \",\")")
    run_program("len(split(\"a,b,c\", \",\"))")
    run_program("contains(\"hello\", \"ell\")")
    run_program("trim(\"  x  \")")
    run_program("push([1, 2], 3)")
    run_program("to_string(42) + \"!\"")

    # 程序 12（Phase 5.17）：诊断带行号——错误指到源行
    # ->  7 / error: parse error: unexpected unknown character '@' at line 4
    # ->  error: parse error: let: expected variable name, got '=' at line 1
    # ->  error: parse error: fn: expected function name at line 1
    run_program("let x = 3\nlet y = 4\nx + y\n@")
    run_program("let = 3")
    run_program("fn 5\nend")
end
