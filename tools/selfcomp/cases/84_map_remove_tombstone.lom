# L2.3 Map 批 B1：map_remove 墓碑语义——删后 size--/has=false/get 得
# None；同键重插复用 first_free 槽；未命中 remove 无副作用。
from map import { map_empty, map_set, map_get, map_has, map_remove, map_size }

fn main() -> Unit ! [IO]
    let m = map_empty()
    map_set(m, "a", 1)
    map_set(m, "b", 2)
    map_set(m, "c", 3)
    println(map_size(m))
    map_remove(m, "b")
    println(map_size(m))
    if map_has(m, "b")
        println(1)
    else
        println(0)
    end
    match map_get(m, "b")
        Some(_) => println(1)
        None => println(0)
    end
    map_set(m, "b", 20)
    println(map_size(m))
    match map_get(m, "b")
        Some(v) => println(v)
        None => println(0)
    end
    map_remove(m, "zz")
    println(map_size(m))
    match map_get(m, "c")
        Some(v) => println(v)
        None => println(0)
    end
end
