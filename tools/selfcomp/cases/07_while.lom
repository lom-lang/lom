fn collatz_steps(n0: Int) -> Int
    let mut n = n0
    let mut steps = 0
    while n != 1 and steps < 200
        if n / 2 * 2 == n
            n = n / 2
        else
            n = 3 * n + 1
        end
        steps = steps + 1
    end
    steps
end
fn main() -> Unit ! [IO]
    println(collatz_steps(27))
    println(collatz_steps(1))
    println(collatz_steps(6))
    let mut i = 0
    let mut sum = 0
    while i < 5
        sum = sum + i * i
        i = i + 1
    end
    println(i)
    println(sum)
    let mut x = 1.5
    let mut count = 0
    while x < 100.0
        x = x * 2.0
        count = count + 1
    end
    println(count)
    println(x)
end
