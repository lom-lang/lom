# L2.3 容器显示批（designs/0011 §10 #128）：List 全形态——空/单/多元素/
# String/Bool/Float/嵌套/混合类型各自（对拍基准 p1：String 元素无引号、
# Float 整值保 .0、嵌套递归）。
from list import { list_cons, list_empty }

fn main() -> Unit ! [IO]
    # 空表（注解定型——裸 list_empty 的 ls{?} 编译期不可特化）
    let e: List<Int> = list_empty()
    println(e)
    # 单元素 / 多元素
    println(list_cons(42, list_empty()))
    println(1..5)
    println(2..2)
    # String 元素（无引号——宿主 to_display 口径）
    let ss = list_cons("alpha", list_cons("beta", list_empty()))
    println(ss)
    # Bool 元素（小写 true/false）
    let bs = list_cons(True, list_cons(False, list_empty()))
    println(bs)
    # Float 元素（整值保 .0）
    let fs = list_cons(1.5, list_cons(2.0, list_cons(0.25, list_empty())))
    println(fs)
    # 嵌套 List（递归显示）
    let xs = 1..3
    let nest = list_cons(xs, list_cons(list_cons(9, list_empty()), list_empty()))
    println(nest)
    let deep = list_cons(nest, list_empty())
    println(deep)
    # 拼接提升（容器在右侧）
    println("e=" + e)
    println("xs=" + xs)
    println("fs=" + fs)
    # 拼接提升（容器在左侧）
    println(xs + "=xs")
end
