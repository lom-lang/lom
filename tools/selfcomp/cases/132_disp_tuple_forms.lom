# L2.3 容器显示批（designs/0011 §10 #132）：tuple 形态——二元/嵌套/
# Bool-Float 混/单元素 (a,)（宿主 rt_tuple_str 对齐解释器：单元素补逗号）。
from list import { list_cons, list_empty }

fn main() -> Unit ! [IO]
    # 二元（Int/String）
    println((1, "a"))
    println((10, 20))
    # 单元素（补逗号——宿主 (a,) 形态）
    println((1,))
    println(("solo",))
    println((2.5,))
    println((True,))
    # Bool-Float 混
    println((True, 2.5))
    println((False, 1.0, "x"))
    # 嵌套 tuple
    println((1, (2, 3)))
    println(((1, 2), (3, 4), (5,)))
    # tuple 含 List / record / 枚举
    println((1..3, list_cons(7, list_empty())))
    println(({a: 1, b: 2}, "rc"))
    println((Some(4), 5))
    let okv: Result<Int, String> = Ok(1)
    println((okv, "r"))
    # 三元以上
    println((1, 2, 3, 4, 5))
    # 拼接提升两侧
    println("t=" + (1, "a"))
    println((True,) + "=t")
end
