# L2.3 容器显示批（designs/0011 §10 #135）：拼接提升——容器在左侧 +
# 多段拼接链（显示值作中段；左结合链 A + B + C 逐段 concat）。
from list import { list_cons, list_empty }
from map import { map_empty, map_set }

enum Mode
    | Fast
    | Slow(Int)
end

fn main() -> Unit ! [IO]
    let xs = 1..3
    let m = map_empty()
    map_set(m, "k", 5)
    # 容器在左侧
    println(xs + "=xs")
    println(m + "=m")
    println(Fast + "=mode")
    println(Slow(9) + "=mode")
    println({a: 1} + "=rc")
    println((1, 2) + "=tp")
    # 多段链（容器作首/中/尾段）
    println("a=" + xs + "!")
    println(xs + "-" + m)
    println("[" + Slow(3) + "] " + {v: 1} + " (" + (True,) + ")")
    # 嵌套拼接（显示值含显示值）
    println("wrap=" + list_cons(xs, list_empty()) + "|end")
    # 拼接结果再拼接
    let s1 = "x=" + xs
    let s2 = s1 + "&y=" + (8,)
    println(s2)
    println(s2 + "#")
end
